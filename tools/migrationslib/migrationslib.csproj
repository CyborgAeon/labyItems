<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FluentMigrator" />
        <PackageReference Include="FluentMigrator.Runner" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
        <PackageReference Include="System.Drawing.Common" />
    </ItemGroup>

    <ItemGroup>
        <!-- Embed miracles seed data so migrations can populate the table even when raw assets are stripped -->
        <EmbeddedResource Include="..\..\labyItems\Resources\Raw\words_from_above\base-miracles1.json" Link="Resources/Raw/words_from_above/base-miracles1.json" />
        <!-- Embed spell seed data -->
        <EmbeddedResource Include="..\..\labyItems\Resources\Raw\grimoire\new_standard.json" Link="Resources/Raw/grimoire/new_standard.json" />
    </ItemGroup>
</Project>
