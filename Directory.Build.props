<Project>
  <PropertyGroup>
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
  </PropertyGroup>

  <!-- Optional local secrets file (ignored by git) -->
  <Import Project="Directory.Build.secrets.props" Condition="Exists('Directory.Build.secrets.props')" />

  <!-- Only enable signing when credentials are present (default: Debug builds unsigned) -->
  <PropertyGroup>
    <EnableAndroidSigning Condition="'$(EnableAndroidSigning)'=='' and '$(Configuration)'=='Release' and '$(AndroidSigningKeyPass)' != '' and '$(AndroidSigningStorePass)' != ''">true</EnableAndroidSigning>
    <EnableAndroidSigning Condition="'$(EnableAndroidSigning)'==''">false</EnableAndroidSigning>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <AndroidKeyStore>$(EnableAndroidSigning)</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildProjectDirectory)/labyItems.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' == ''">labyItemsSigningKey</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(AndroidSigningKeyPass)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(AndroidSigningStorePass)</AndroidSigningStorePass>
  </PropertyGroup>
</Project>
