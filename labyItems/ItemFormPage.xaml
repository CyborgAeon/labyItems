<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:labyItems.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="labyItems.ItemFormPage"
             Title="Submit Item">
<ContentPage.ToolbarItems>
    <ToolbarItem Text="View Saved" Clicked="OnViewSavedClicked" />
  </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
<Label x:Name="CharacterHeader" FontSize="18" FontAttributes="Bold" />

            <Label Text="Item Type" FontAttributes="Bold" />
            <Picker x:Name="ItemTypePicker"
                    Title="Select item type" />

            <Label Text="MakerPlayerName" FontAttributes="Bold" />
            <Entry x:Name="MakerPlayerNameEntry" Placeholder="Maker Player name" />
            <Label Text="MakerCharacterName" FontAttributes="Bold" />
            <Entry x:Name="MakerCharacterNameEntry" Placeholder="Maker Character name" />

            <Label Text="WitnessName" FontAttributes="Bold" />
            <Entry x:Name="WitnessNameEntry" Placeholder="Witness name" />

            <Label Text="RecipientPlayerName" FontAttributes="Bold" />
            <Entry x:Name="RecipientPlayerNameEntry" Placeholder="Recipient player name" />
            <Label Text="RecipientCharacterName" FontAttributes="Bold" />
            <Entry x:Name="RecipientCharacterNameEntry" Placeholder="Recipient character name" />
            <Label Text="RecipientCharacterClass" FontAttributes="Bold" />
            <Entry x:Name="RecipientCharacterClassEntry" Placeholder="Recipient character class" />

            <Label Text="Description" FontAttributes="Bold" />
            <Editor x:Name="DescriptionEditor" Placeholder="Describe the item..." AutoSize="TextChanges" />

            <Label Text="ISP" FontAttributes="Bold" />
            <Entry x:Name="IspEntry" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Created Date" FontAttributes="Bold" />
            <DatePicker x:Name="CreatedDatePicker" Date="{x:Static sys:DateTime.Now}" />

            <HorizontalStackLayout>
                <Label Text="DNBUOD" FontAttributes="Bold" VerticalOptions="Center" />
                <Switch x:Name="DnbuodSwitch" />
            </HorizontalStackLayout>

            <Button Text="Submit" Clicked="OnSubmitClicked"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
