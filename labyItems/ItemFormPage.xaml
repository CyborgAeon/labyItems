<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.ItemFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Models"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Submit Item">
    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="OnViewSavedClicked" Text="View Saved" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label
                x:Name="CharacterHeader"
                FontAttributes="Bold"
                FontSize="18" />

            <Label FontAttributes="Bold" Text="Item Type" />
            <Picker x:Name="ItemTypePicker" Title="Select item type" />
            <VerticalStackLayout IsVisible="{Binding ShowPlayerNameField}">
                <Label FontAttributes="Bold" Text="MakerPlayerName" />
                <Entry x:Name="MakerPlayerNameEntry" Placeholder="Maker Player name" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding ShowPlayerCharNameField}">
                <Label FontAttributes="Bold" Text="MakerCharacterName" />
                <Entry x:Name="MakerCharacterNameEntry" Placeholder="Maker Character name" />
            </VerticalStackLayout>

            <Label FontAttributes="Bold" Text="WitnessName" />
            <Entry x:Name="WitnessNameEntry" Placeholder="Witness name" />

            <Button
                x:Name="RecipientButton"
                Clicked="OnAddRecipientClicked"
                Text="Add Recipient" />

            <Label FontAttributes="Bold" Text="Description" />
            <Editor
                x:Name="DescriptionEditor"
                AutoSize="TextChanges"
                Placeholder="Describe the item..." />

            <Label FontAttributes="Bold" Text="ISP" />
            <HorizontalStackLayout Spacing="10">
                <Entry
                    x:Name="IspEntry"
                    Keyboard="Numeric"
                    Placeholder="0"
                    WidthRequest="120" />
                <Button Clicked="OnCalculateIsp" Text="Calculate" />
            </HorizontalStackLayout>

            <Label FontAttributes="Bold" Text="Created Date" />
            <DatePicker x:Name="CreatedDatePicker" Date="{x:Static sys:DateTime.Now}" />

            <HorizontalStackLayout>
                <Label
                    FontAttributes="Bold"
                    Text="DNBUOD"
                    VerticalOptions="Center" />
                <Switch x:Name="DnbuodSwitch" />
            </HorizontalStackLayout>

            <Button
                BackgroundColor="#007AFF"
                Clicked="OnSubmitClicked"
                CornerRadius="12"
                HeightRequest="50"
                Text="Submit"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
