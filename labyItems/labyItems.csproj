<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<PackageReference Include="ClosedXML" />
		<PackageReference Include="PdfSharpCore" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
		<PackageReference Include="System.Drawing.Common" />
	</ItemGroup>

	<PropertyGroup>
		<WarningLevel>0</WarningLevel>
		<!-- Default macOS local dev to Android to avoid requiring iOS workload for dotnet watch/build.
		     Set -p:UseIosWorkload=true when you explicitly want iOS enabled; we include both TFMs to keep restore assets valid when switching between iOS and Android commands. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(UseIosWorkload)' == 'true'">net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(UseIosWorkload)' != 'true'">net10.0-android</TargetFramework>
		<TargetFramework Condition="!$([MSBuild]::IsOSPlatform('osx')) and !$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFramework>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>labyItems</RootNamespace>
		<UseMaui>true</UseMaui>
		<EnableDefaultMauiItems>true</EnableDefaultMauiItems>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>laby tools</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>bard.uk.labyitems</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- Runtime XAML inflation in Debug requires embedded XAML resources to remain in the assembly. -->
		<MauiKeepXamlResources>true</MauiKeepXamlResources>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Opt-in flag to make iOS simulator runs behave closer to device constraints while still launching. -->
		<IosStrictAotSimulator>false</IosStrictAotSimulator>
		<!-- Optional fail-fast mode: force full-AOT runtime behavior on simulator (can abort at startup). -->
		<IosFailFastFullAotSimulator>false</IosFailFastFullAotSimulator>
		<!-- Allow iOS SDK to work with slightly older Xcode versions -->
		<IosUseXcodeSdk>false</IosUseXcodeSdk>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(IosStrictAotSimulator)' == 'true'">
		<UseInterpreter>false</UseInterpreter>
		<MtouchUseLlvm>true</MtouchUseLlvm>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(IosStrictAotSimulator)' == 'true' and '$(IosFailFastFullAotSimulator)' == 'true'">
		<MtouchExtraArgs>$(MtouchExtraArgs) --setenv=MONO_ENV_OPTIONS=--full-aot --setenv=MONO_LOG_LEVEL=debug --setenv=MONO_LOG_MASK=aot</MtouchExtraArgs>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\Splash\logo.svg" Color="#FFFFFF" />
		<MauiSplashScreen Include="Resources\Splash\logo.svg" Color="#000000" />
		<MauiImage Include="Resources\Images\**\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Remove="Resources\Raw\**\.DS_Store" />
		<MauiAsset Include="..\output\laby.db" LogicalName="laby.db" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Maui.Controls.Xaml" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<!-- SQLite access using sqlite-net-pcl -->
		<PackageReference Include="sqlite-net-pcl" />
		<!-- Microsoft.Data.Sqlite and SQLitePCL bundle for runtime provider on platforms like Android -->
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />

	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
		<!-- FluentMigrator runtime runner is disabled on iOS due SQL CE transitive AOT issues. -->
		<PackageReference Include="FluentMigrator.Runner" />
		<PackageReference Include="FluentMigrator.Runner.SQLite" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../tools/migrationslib/migrationslib.csproj" />
	</ItemGroup>

	<Target Name="ForceRegenerateAndroidNativeSourcesInDebug" BeforeTargets="_GeneratePackageManagerJava" Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Delete Files="$(_AndroidStampDirectory)_GeneratePackageManagerJava.stamp" Condition="Exists('$(_AndroidStampDirectory)_GeneratePackageManagerJava.stamp')" />
	</Target>

</Project>
