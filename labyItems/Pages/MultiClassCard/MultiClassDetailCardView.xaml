<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Pages.MultiClassCard.MultiClassDetailCardView" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:labyItems.Controls">
 <VerticalStackLayout Spacing="14">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="2"><Label Text="{Binding DisplayName, Source={x:Reference Root}}" FontSize="28" FontAttributes="Bold"/><Label Text="Multi-class" TextColor="{StaticResource MutedTextColor}" FontSize="13"/></VerticalStackLayout><Frame Grid.Column="1" WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}" BorderColor="{StaticResource SurfaceBorderColor}"><Label Text="{Binding IconGlyph, Source={x:Reference Root}}" FontFamily="FASolid" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/></Frame></Grid>
  <HorizontalStackLayout Spacing="8"><Border Style="{StaticResource SelectableFilterPillBorderStyle}" IsVisible="{Binding IsBracketPure, Source={x:Reference Root}}"><Label Text="Bracket pure" Style="{StaticResource FilterPillLabelStyle}"/></Border><Border Style="{StaticResource SelectableFilterPillBorderStyle}" IsVisible="{Binding RequiresPath, Source={x:Reference Root}}"><Label Text="Path" Style="{StaticResource FilterPillLabelStyle}"/></Border></HorizontalStackLayout>
  <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="10"><VerticalStackLayout Spacing="2"><Label Text="PRE-REQS" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PreReqsText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}" LineBreakMode="WordWrap"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="LEVEL CAP" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding LevelCapText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="3" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="4" Spacing="2"><Label Text="POWER" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PowerText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}" LineBreakMode="WordWrap"/></VerticalStackLayout></Grid>
  <VerticalStackLayout IsVisible="{Binding HasMaxAc, Source={x:Reference Root}}" Spacing="2"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><Label Text="MAX AC" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding MaxAcText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
  <VerticalStackLayout Spacing="7"><Label Text="COST PER LEVEL" Style="{StaticResource SectionHeaderLabelStyle}"/><Label Text="{Binding SelectedAvailabilityText, Source={x:Reference Root}}" TextColor="{StaticResource MutedTextColor}" FontSize="13"/><Border Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 9" BackgroundColor="#F9FAFB" Padding="0"><HorizontalStackLayout BindableLayout.ItemsSource="{Binding CostCells, Source={x:Reference Root}}" Spacing="0" HorizontalOptions="Fill"><BindableLayout.ItemTemplate><DataTemplate><Border Padding="10,7" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="0,0,1,0" BackgroundColor="Transparent" HorizontalOptions="FillAndExpand"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCostTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="2"><Label Text="{Binding Level}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center"/><Label Text="{Binding CostText}" FontSize="16" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></HorizontalStackLayout></Border></VerticalStackLayout>
  <VerticalStackLayout IsVisible="{Binding HasLifeScale, Source={x:Reference Root}}" Spacing="7"><Label Text="HUMAN LIFESCALE" Style="{StaticResource SectionHeaderLabelStyle}"/><FlexLayout BindableLayout.ItemsSource="{Binding LifeCells, Source={x:Reference Root}}" Wrap="NoWrap" JustifyContent="SpaceBetween"><BindableLayout.ItemTemplate><DataTemplate><Border Padding="8,7" Margin="0,0,5,0" Stroke="{StaticResource SurfaceBorderColor}" StrokeShape="RoundRectangle 7"><VerticalStackLayout Spacing="1"><Label Text="{Binding LevelText}" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/><Label Text="{Binding Value}" Style="{StaticResource KeyInfoValueStyle}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout></VerticalStackLayout>
  <VerticalStackLayout Spacing="7" IsVisible="{Binding HasAvailability, Source={x:Reference Root}}"><Label Text="AVAILABILITY" Style="{StaticResource SectionHeaderLabelStyle}"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailabilityRows, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding Display}" SecondaryText="{Binding TotalText}" PrimaryColumnWidth="*" SecondaryColumnWidth="82" ShowSecondaryText="True" SecondaryTextAlignment="Center" RowBackgroundColor="{Binding RowBackgroundColor}"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
  <VerticalStackLayout Spacing="7" IsVisible="{Binding HasLevels, Source={x:Reference Root}}"><Label Text="PROGRESSION BY LEVEL" Style="{StaticResource SectionHeaderLabelStyle}"/><Grid ColumnDefinitions="54,*,32" Padding="10,0"><Label Text="LVL" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="ABILITIES" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/><Label Grid.Column="2" Text="INFO" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/></Grid><VerticalStackLayout BindableLayout.ItemsSource="{Binding LevelRows, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding LevelText}" SecondaryText="{Binding Name}" PrimaryColumnWidth="44" SecondaryColumnWidth="*" InfoColumnWidth="18" PrimaryTextAlignment="Center" SecondaryTextAlignment="Center" ShowSecondaryText="True" ShowInfo="{Binding HasDetails}" ActionCommandParameter="{Binding .}" RowBackgroundColor="{Binding RowBackgroundColor}" InfoClicked="OnLevelInfoClicked" RowClicked="OnLevelInfoClicked"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
 </VerticalStackLayout>
</ContentView>
