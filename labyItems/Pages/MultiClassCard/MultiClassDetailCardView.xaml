<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Pages.MultiClassCard.MultiClassDetailCardView" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers">
 <ContentView><VerticalStackLayout Spacing="12">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Label Text="{Binding IconGlyph, Source={x:Reference Root}}" FontFamily="FASolid" FontSize="25" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="{Binding DisplayName, Source={x:Reference Root}}" FontSize="28" FontAttributes="Bold" LineBreakMode="WordWrap"/><Frame Grid.Column="2" Padding="8,4" CornerRadius="10" HasShadow="False" BackgroundColor="#FFF3D6" BorderColor="#E8C878" IsVisible="{Binding IsBracketPure, Source={x:Reference Root}}"><HorizontalStackLayout Spacing="4"><Label Text="{Binding BracketGlyph, Source={x:Reference Root}}" FontSize="12"/><Label Text="Bracket pure" FontSize="12" FontAttributes="Bold"/></HorizontalStackLayout></Frame></Grid>
  <Label Text="LEVELS" Style="{StaticResource SectionHeaderLabelStyle}"/>
  <Border Stroke="{StaticResource SurfaceBorderColor}" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FAFB"><VerticalStackLayout BindableLayout.ItemsSource="{Binding LevelRows, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="48,*,42" Padding="4,10" ColumnSpacing="8"><Label Text="{Binding Level}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="{Binding Name}" FontSize="17" LineBreakMode="WordWrap"/><Button Grid.Column="2" Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}" FontFamily="FASolid" FontSize="15" Padding="0" BackgroundColor="Transparent" Clicked="OnLevelInfoClicked" CommandParameter="{Binding .}"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></Border>
  <Label Text="AVAILABLE" Style="{StaticResource SectionHeaderLabelStyle}" IsVisible="{Binding HasAvailability, Source={x:Reference Root}}"/>
  <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasAvailability, Source={x:Reference Root}}"><VerticalStackLayout Spacing="0"><Grid ColumnDefinitions="220,55,55,55,55,55,55" Padding="4,8" BackgroundColor="{StaticResource SelectedSurfaceBackgroundColor}"><Label Text="DISPLAY" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="1" Text="1" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="2" Text="2" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="3" Text="3" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="4" Text="4" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="5" Text="5" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="6" Text="6" Style="{StaticResource KeyInfoLabelStyle}"/></Grid><VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailabilityRows, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="220,55,55,55,55,55,55" Padding="4,9"><Label Text="{Binding Display}" FontSize="15"/><Label Grid.Column="1" Text="{Binding L1}" HorizontalTextAlignment="Center"/><Label Grid.Column="2" Text="{Binding L2}" HorizontalTextAlignment="Center"/><Label Grid.Column="3" Text="{Binding L3}" HorizontalTextAlignment="Center"/><Label Grid.Column="4" Text="{Binding L4}" HorizontalTextAlignment="Center"/><Label Grid.Column="5" Text="{Binding L5}" HorizontalTextAlignment="Center"/><Label Grid.Column="6" Text="{Binding L6}" HorizontalTextAlignment="Center"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></ScrollView>
 </VerticalStackLayout></ContentView>
</ContentView>
