<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.ItemWalletPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Item Wallet">
    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="8">
        <Label x:Name="EmptyItemWalletLabel"
               Grid.Row="0"
               Text="No saved items yet."
               Opacity="0.7"
               IsVisible="False"/>

        <CollectionView x:Name="ItemWalletView"
                        Grid.Row="1"
                        SelectionMode="None"
                        ItemsSource="{Binding ItemWalletRows}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,10"
                           Padding="12"
                           CornerRadius="12"
                           HasShadow="False"
                           BorderColor="{StaticResource SurfaceBorderColor}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemWalletCardTapped"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding HeaderText}"
                                       FontAttributes="Bold"
                                       FontSize="16"/>
                                <Label Grid.Column="1"
                                       Text="{Binding ExpandGlyph}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"
                                       FontSize="20"/>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                 Spacing="8">
                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding DetailRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8"
                                                    BackgroundColor="{Binding BackgroundColor}"
                                                    StrokeThickness="0">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Text}"
                                                           LineBreakMode="WordWrap"/>
                                                    <Button Grid.Column="1"
                                                            Text="&#xF05A;"
                                                            FontFamily="FASolid"
                                                            FontSize="12"
                                                            Padding="0"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource SubtleTextColor}"
                                                            HeightRequest="18"
                                                            WidthRequest="18"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            IsVisible="{Binding HasInfoButton}"
                                                            Clicked="OnDetailRowInfoClicked"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,*,*,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="Delete"
                                            Clicked="OnDeleteItemClicked"/>
                                    <Button Grid.Column="1"
                                            Text="Email ISP"
                                            Clicked="OnEmailItemClicked"/>
                                    <Button Grid.Column="2"
                                            Text="Assign"
                                            IsVisible="{Binding ShowAssignButton}"
                                            Clicked="OnAssignItemClicked"/>
                                    <Button Grid.Column="3"
                                            Text="Change"
                                            IsVisible="{Binding ShowChangeButton}"
                                            Clicked="OnChangeAssignmentClicked"/>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
