<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.ItemWalletPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    xmlns:controls="clr-namespace:labyItems.Controls"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Item Wallet">
    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="8">
        <VerticalStackLayout Grid.Row="0"
                             Spacing="8">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                <Label Grid.Column="1"
                       Text="Item Wallet"
                       FontAttributes="Bold"
                       FontSize="24"
                       VerticalTextAlignment="Center" />
            </Grid>

            <Label x:Name="EmptyItemWalletLabel"
                   Text="No saved items yet."
                   Opacity="0.7"
                   IsVisible="False"/>
        </VerticalStackLayout>

        <CollectionView x:Name="ItemWalletView"
                        Grid.Row="1"
                        SelectionMode="None"
                        ItemsSource="{Binding ItemWalletRows}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10"
                           Padding="12"
                           StrokeShape="RoundRectangle 12"
                           Stroke="{StaticResource SurfaceBorderColor}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemWalletCardTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding HeaderText}"
                                       FontAttributes="Bold"
                                       FontSize="16"/>
                                <controls:ChevronIconView Grid.Column="1"
                                                          IsExpanded="{Binding IsExpanded}"
                                                          AnimateRotation="True"
                                                          InputTransparent="True"
                                                          IconSize="28" GlyphSize="14" />
                            </Grid>

                            <controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}">
                            <VerticalStackLayout Spacing="8">
                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding DetailRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8"
                                                    BackgroundColor="{Binding BackgroundColor}"
                                                    StrokeThickness="0">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Text}"
                                                           LineBreakMode="WordWrap"/>
                                                    <Button Grid.Column="1"
                                                            Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                                            FontFamily="FASolid"
                                                            FontSize="12"
                                                            Padding="0"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource SubtleTextColor}"
                                                            HeightRequest="18"
                                                            WidthRequest="18"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            IsVisible="{Binding HasInfoButton}"
                                                            Clicked="OnDetailRowInfoClicked"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,*,*,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="Delete"
                                            Clicked="OnDeleteItemClicked"/>
                                    <Button Grid.Column="1"
                                            Text="Email ISP"
                                            Clicked="OnEmailItemClicked"/>
                                    <Button Grid.Column="2"
                                            Text="Assign"
                                            IsVisible="{Binding ShowAssignButton}"
                                            Clicked="OnAssignItemClicked"/>
                                    <Button Grid.Column="3"
                                            Text="Change"
                                            IsVisible="{Binding ShowChangeButton}"
                                            Clicked="OnChangeAssignmentClicked"/>
                                </Grid>
                            </VerticalStackLayout>
                            </controls:AnimatedExpandView>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        Grid.RowSpan="2"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.ItemsWallet}" />
    </Grid>
</ContentPage>
