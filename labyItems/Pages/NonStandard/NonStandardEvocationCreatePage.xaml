<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="labyItems.Pages.NonStandard.NonStandardEvocationCreatePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:labyItems.Controls" Shell.NavBarIsVisible="False" NavigationPage.HasNavigationBar="False">
 <ContentPage.Resources>
  <Style x:Key="FormCard" TargetType="Border"><Setter Property="Stroke" Value="{StaticResource SurfaceBorderColor}"/><Setter Property="StrokeShape" Value="RoundRectangle 12"/><Setter Property="Padding" Value="14"/><Setter Property="BackgroundColor" Value="{StaticResource White}"/></Style>
  <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontSize" Value="12"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="{StaticResource MutedTextColor}"/></Style>
 </ContentPage.Resources>
 <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
  <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><controls:BackNavigationButton Command="{Binding BackCommand}"/><VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseCharacterCommand}"/></VerticalStackLayout.GestureRecognizers><Label Text="Create evocation" FontAttributes="Bold" FontSize="18"/><Label Text="{Binding CharacterName}" FontSize="12" TextColor="{StaticResource MutedTextColor}" LineBreakMode="TailTruncation"/></VerticalStackLayout><Button Grid.Column="2" Text="Template" Command="{Binding SearchCommand}" MinimumHeightRequest="44"/></Grid>
  <ScrollView Grid.Row="1"><VerticalStackLayout Padding="16,10,16,24" Spacing="12">
   <Border Style="{StaticResource FormCard}"><VerticalStackLayout Spacing="10"><Label Text="Assignment" FontSize="18" FontAttributes="Bold"/><Button Text="{Binding CharacterButtonText}" Command="{Binding ChooseCharacterCommand}" HorizontalOptions="Fill"/></VerticalStackLayout></Border>
   <Border Style="{StaticResource FormCard}"><VerticalStackLayout Spacing="8"><Label Text="Basics" FontSize="18" FontAttributes="Bold"/><Label Text="NAME *" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Draft.name, Mode=TwoWay}" Placeholder="Evocation name" TextChanged="OnDraftTextChanged" ReturnType="Next"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="4"><Label Text="EARTHPOWER" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding PowerText, Mode=TwoWay}" Keyboard="Numeric" Placeholder="0"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="TIER" Style="{StaticResource FieldLabel}"/><Grid ColumnDefinitions="*,Auto"><Label Text="Advanced" VerticalTextAlignment="Center"/><Switch Grid.Column="1" IsToggled="{Binding Draft.isAdvanced, Mode=TwoWay}"/></Grid></VerticalStackLayout></Grid><Label Text="RANGE" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Draft.range, Mode=TwoWay}" Placeholder="Range" ReturnType="Next"/><Label Text="DURATION" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Draft.duration, Mode=TwoWay}" Placeholder="Duration" ReturnType="Next"/></VerticalStackLayout></Border>
   <Border Style="{StaticResource FormCard}"><VerticalStackLayout Spacing="8"><Label Text="Fields" FontSize="18" FontAttributes="Bold"/><Label Text="Choose as many as apply. Changes take effect immediately." FontSize="12" TextColor="{StaticResource MutedTextColor}"/><controls:MultiChipGroup Items="{Binding AvailableFields}" SelectedItems="{Binding SelectedFields}"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="CustomFieldEntry" Placeholder="Custom field" ReturnType="Done" Completed="OnAddCustomFieldClicked"/><Button Grid.Column="1" Text="Add" Clicked="OnAddCustomFieldClicked"/></Grid></VerticalStackLayout></Border>
   <Border Style="{StaticResource FormCard}"><VerticalStackLayout Spacing="8"><Label Text="Description &amp; casting" FontSize="18" FontAttributes="Bold"/><Label Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/><Editor Text="{Binding Draft.description, Mode=TwoWay}" Placeholder="What the evocation does" AutoSize="TextChanges" MinimumHeightRequest="100"/><Label Text="VERBAL OR GESTURE" Style="{StaticResource FieldLabel}"/><Editor Text="{Binding Draft.verbal, Mode=TwoWay}" Placeholder="Words or gestures required" AutoSize="TextChanges" MinimumHeightRequest="72"/></VerticalStackLayout></Border>
   <Border Style="{StaticResource FormCard}"><VerticalStackLayout Spacing="8"><Label Text="Requirements &amp; effects" FontSize="18" FontAttributes="Bold"/><Button Text="{Binding PrerequisitesButtonText}" Clicked="OnPrerequisitesClicked"/><Button Text="{Binding ImmunityButtonText}" Clicked="OnImmunityClicked"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Edit damage" Clicked="OnDamageClicked"/><Button Grid.Column="1" Text="Edit healing" Clicked="OnHealClicked"/></Grid></VerticalStackLayout></Border>
  </VerticalStackLayout></ScrollView>
  <Grid Grid.Row="2" RowDefinitions="1,Auto"><BoxView HeightRequest="1" BackgroundColor="{StaticResource SurfaceBorderColor}"/><Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Padding="16,10,16,18" BackgroundColor="{StaticResource White}"><Button Text="Cancel" Command="{Binding BackCommand}"/><Label Grid.Column="1" Text="Name and character are required" FontSize="11" TextColor="{StaticResource MutedTextColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/><Button Grid.Column="2" Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"/></Grid></Grid>
  <Grid Grid.RowSpan="3" IsVisible="{Binding IsBusy}" BackgroundColor="#66000000"><ActivityIndicator IsRunning="True" Color="White" HorizontalOptions="Center" VerticalOptions="Center"/></Grid>
 </Grid>
</ContentPage>
