<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.NonStandard.NonStandardWalletPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Wallet">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,12,16,8"
                             Spacing="8">
            <Label Text="Non-standards Wallet"
                   FontAttributes="Bold"
                   FontSize="20"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Placeholder="Search non-standards..."
                       TextChanged="OnSearchTextChanged"/>
                <Button Grid.Column="1"
                        Text="Refresh"
                        Clicked="OnRefreshClicked"/>
            </Grid>

            <Label Text="{Binding SummaryText}"
                   FontSize="12"
                   Opacity="0.75"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredEntries}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource SectionCardFrameStyle}"
                           Margin="16,0,16,10">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16"/>
                                <Label Text="{Binding Subtitle}"
                                       FontSize="12"
                                       Opacity="0.75"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Edit"
                                    HeightRequest="36"
                                    Clicked="OnEditClicked"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
