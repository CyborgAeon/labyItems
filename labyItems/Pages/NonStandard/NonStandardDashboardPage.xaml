<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.NonStandard.NonStandardDashboardPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    xmlns:controls="clr-namespace:labyItems.Controls"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Create New">

    <ContentPage.Resources>
        <Style TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="76" />
            <Setter Property="Stroke" Value="{StaticResource SurfaceBorderColor}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <ScrollView>
            <VerticalStackLayout Padding="16,12,16,24"
                                 Spacing="16">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                    <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2">
                        <Label Text="Create New"
                               FontAttributes="Bold"
                               FontSize="24" />
                        <Label Text="Choose what you want to create"
                               FontSize="13"
                               Opacity="0.68" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="12">
                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" StrokeThickness="0" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 14"><Label FontFamily="FASolid"
                                       Text="{x:Static helpers:FontAwesomeGlyphs.CustomClass}"
                                       FontSize="18"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Class" FontSize="17" FontAttributes="Bold"/><Label Text="Build a custom class and progression" FontSize="13" TextColor="{StaticResource Gray500}"/></VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}"
                                        Style="{StaticResource ListRowGlyphIconButtonStyle}"
                                        TextColor="{StaticResource AccentMaroonColor}"
                                        Clicked="OnOpenClassClicked" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenClassTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" StrokeThickness="0" BackgroundColor="#EAF4EA" StrokeShape="RoundRectangle 14"><Label FontFamily="FASolid"
                                       Text="{x:Static helpers:FontAwesomeGlyphs.Paw}"
                                       FontSize="18"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Race" FontSize="17" FontAttributes="Bold"/><Label Text="Create ancestry, traits and abilities" FontSize="13" TextColor="{StaticResource Gray500}"/></VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}"
                                        Style="{StaticResource ListRowGlyphIconButtonStyle}"
                                        TextColor="{StaticResource AccentMaroonColor}"
                                        Clicked="OnOpenRaceClicked" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenRaceTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" StrokeThickness="0" BackgroundColor="#F6EEE0" StrokeShape="RoundRectangle 14"><Label FontFamily="FASolid"
                                       Text="{x:Static helpers:FontAwesomeGlyphs.Ability}"
                                       FontSize="18"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Ability" FontSize="17" FontAttributes="Bold"/><Label Text="Add a general character ability" FontSize="13" TextColor="{StaticResource Gray500}"/></VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}"
                                        Style="{StaticResource ListRowGlyphIconButtonStyle}"
                                        TextColor="{StaticResource AccentMaroonColor}"
                                        Clicked="OnOpenAbilityClicked" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenAbilityTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" StrokeThickness="0" BackgroundColor="#EDE9FE" StrokeShape="RoundRectangle 14"><Label FontFamily="FASolid"
                                       Text="{x:Static helpers:FontAwesomeGlyphs.Spell}"
                                       FontSize="18"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Spell" FontSize="17" FontAttributes="Bold"/><Label Text="Create a magical spell and effects" FontSize="13" TextColor="{StaticResource Gray500}"/></VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}"
                                        Style="{StaticResource ListRowGlyphIconButtonStyle}"
                                        TextColor="{StaticResource AccentMaroonColor}"
                                        Clicked="OnOpenSpellClicked" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenSpellTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" StrokeThickness="0" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 14"><Label FontFamily="FASolid"
                                       Text="{x:Static helpers:FontAwesomeGlyphs.Wand}"
                                       FontSize="18"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Miracle" FontSize="17" FontAttributes="Bold"/><Label Text="Create a spiritual invocation" FontSize="13" TextColor="{StaticResource Gray500}"/></VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}"
                                        Style="{StaticResource ListRowGlyphIconButtonStyle}"
                                        TextColor="{StaticResource AccentMaroonColor}"
                                        Clicked="OnOpenMiracleClicked" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenMiracleTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" StrokeThickness="0" BackgroundColor="#FFE8E0" StrokeShape="RoundRectangle 14"><Label FontFamily="FASolid"
                                       Text="{x:Static helpers:FontAwesomeGlyphs.Lightning}"
                                       FontSize="18"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Evocation" FontSize="17" FontAttributes="Bold"/><Label Text="Create an earthpower effect" FontSize="13" TextColor="{StaticResource Gray500}"/></VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}"
                                        Style="{StaticResource ListRowGlyphIconButtonStyle}"
                                        TextColor="{StaticResource AccentMaroonColor}"
                                        Clicked="OnOpenEvocationClicked" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenEvocationTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" StrokeThickness="0" BackgroundColor="#E7F0FF" StrokeShape="RoundRectangle 14"><Image Source="{x:Static helpers:IconAssets.Neuronic}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Neuronic" FontSize="17" FontAttributes="Bold"/><Label Text="Create a neuronic ability" FontSize="13" TextColor="{StaticResource Gray500}"/></VerticalStackLayout>
                                <Button Grid.Column="2" Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}" Style="{StaticResource ListRowGlyphIconButtonStyle}" TextColor="{StaticResource AccentMaroonColor}" Clicked="OnOpenNeuronicClicked" />
                            </Grid>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenNeuronicTapped" /></Border.GestureRecognizers>
                        </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        Grid.RowSpan="2"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.NonStandard}" />
    </Grid>
</ContentPage>
