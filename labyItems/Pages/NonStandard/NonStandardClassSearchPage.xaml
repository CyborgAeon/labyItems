<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.NonStandard.NonStandardClassSearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:characters="clr-namespace:labyItems.Pages.Characters"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Select Class"
    BackgroundColor="{StaticResource White}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ClassCardTemplate"
                          x:DataType="characters:ClassCardVm">
                <characters:ClassCardView
                    SelectCommand="{Binding SelectClassCommand, Source={x:Reference Root}}"
                    ToggleExpandedCommand="{Binding ToggleExpandedCommand, Source={x:Reference Root}}"/>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

        <Grid RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="8"
                    BackgroundColor="{StaticResource White}">
                <Grid Grid.Row="0"
                            Padding="12,8"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">
                        <Button Grid.Column="0"
                                        Text="&#xF060;"
                                        FontFamily="FASolid"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Gray300}"
                                        Clicked="OnBackClicked"/>
                        <SearchBar Grid.Column="1"
                                             Placeholder="Search classes..."
                                             BackgroundColor="{StaticResource White}"
                                             Text="{Binding SearchText, Mode=TwoWay}"/>
                </Grid>

                <CollectionView Grid.Row="1"
                                                Margin="16,0,16,0"
                        ItemsSource="{Binding FilterChips}"
                        SelectionMode="None"
                        ItemsLayout="HorizontalList"
                        HeightRequest="38">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                            Margin="0,0,8,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFilterChipCommand, Source={x:Reference Root}}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Label}"
                               Style="{StaticResource FilterPillLabelStyle}"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

                <CollectionView Grid.Row="2"
                                                Margin="16,0,16,0"
                        ItemsSource="{Binding FilteredClasses}"
                        ItemTemplate="{StaticResource ClassCardTemplate}"
                        SelectionMode="None"/>

                <Grid Grid.Row="3"
                            RowDefinitions="1,Auto">
                        <BoxView Grid.Row="0"
                                         HeightRequest="1"
                                         BackgroundColor="{StaticResource SurfaceBorderColor}"/>
                        <Grid Grid.Row="1"
                                    Padding="16,10,16,16">
                                <Button Text="Confirm class"
                                                IsEnabled="{Binding HasSelection}"
                                                Style="{StaticResource ExpandedActionButtonStyle}"
                                                Clicked="OnConfirmSelectionClicked"/>
                        </Grid>
                </Grid>
    </Grid>
</ContentPage>
