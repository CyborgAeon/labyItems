<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.NonStandard.NonStandardClassSearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    xmlns:characters="clr-namespace:labyItems.Pages.Characters"
    xmlns:controls="clr-namespace:labyItems.Controls"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Select Class"
    BackgroundColor="{StaticResource White}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ClassCardTemplate" x:DataType="characters:ClassCardVm">
                <Border Padding="12" Margin="0,0,0,8" Stroke="{StaticResource SubtleTextColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding CardBackgroundColor}">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClassTapped" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <controls:ClassBracketIconView IconSize="34" HasSplitIcon="{Binding HasSplitIcon}" SingleGlyph="{Binding SingleEmoji}" SingleIconFontFamily="{Binding SingleIconFontFamily}" SingleBackground="{Binding SingleBg}" SplitLeftGlyph="{Binding SplitLeftEmoji}" SplitRightGlyph="{Binding SplitRightEmoji}" SplitLeftBackground="{Binding SplitLeftBg}" SplitRightBackground="{Binding SplitRightBg}" BorderColor="{StaticResource SurfaceBorderColor}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"/><Label Text="{Binding BracketSubheading}" FontSize="12" TextColor="{StaticResource MutedTextColor}"/><Label Text="{Binding Summary}" FontSize="12" Opacity="0.8" MaxLines="2" LineBreakMode="TailTruncation"/></VerticalStackLayout>
                        <Button Grid.Column="2" Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}" FontFamily="FASolid" FontSize="13" Padding="0" BackgroundColor="Transparent" HeightRequest="28" WidthRequest="28" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnClassInfoClicked" CommandParameter="{Binding .}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

        <Grid RowDefinitions="Auto,*,Auto"
                    RowSpacing="8"
                    BackgroundColor="{StaticResource White}">
                <Grid Grid.Row="0"
                            Padding="12,8"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">
                        <Button Grid.Column="0"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.Back}"
                                        FontFamily="FASolid"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Gray300}"
                                        Clicked="OnBackClicked"/>
                        <Border Grid.Column="1" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F9FAFB" Padding="8,4"><Grid ColumnDefinitions="*,Auto"><Entry Placeholder="Search classes..." ClearButtonVisibility="WhileEditing" Text="{Binding SearchText, Mode=TwoWay}"/><Button Grid.Column="1" Text="{x:Static helpers:FontAwesomeGlyphs.Filter}" FontFamily="FASolid" FontSize="13" Padding="0" BackgroundColor="Transparent" HeightRequest="24" WidthRequest="24" MinimumHeightRequest="0" MinimumWidthRequest="0" Command="{Binding OpenFiltersCommand}"/></Grid></Border>
                </Grid>

                <CollectionView x:Name="ClassesCollection" Grid.Row="1"
                                                Margin="16,0,16,0"
                        ItemsSource="{Binding FilteredClasses}"
                        ItemTemplate="{StaticResource ClassCardTemplate}"
                        SelectionMode="None"/>

                <Grid Grid.Row="2"
                            RowDefinitions="1,Auto">
                        <BoxView Grid.Row="0"
                                         HeightRequest="1"
                                         BackgroundColor="{StaticResource SurfaceBorderColor}"/>
                        <Grid Grid.Row="1"
                                    Padding="16,10,16,16">
                                <Button Text="Confirm class"
                                                IsEnabled="{Binding HasSelection}"
                                                Style="{StaticResource ExpandedActionButtonStyle}"
                                                Clicked="OnConfirmSelectionClicked"/>
                        </Grid>
                </Grid>
                <Grid Grid.RowSpan="3" IsVisible="{Binding IsFilterModalOpen}" BackgroundColor="#66000000"><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelFiltersCommand}"/></Grid.GestureRecognizers><Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="360" MaximumWidthRequest="420" MaximumHeightRequest="560" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="14"><Border.GestureRecognizers><TapGestureRecognizer/></Border.GestureRecognizers><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><Label Text="Filters" FontAttributes="Bold" FontSize="18"/><ScrollView Grid.Row="1"><VerticalStackLayout Spacing="6"><Label Text="Class type" FontAttributes="Bold" FontSize="13"/><FlexLayout BindableLayout.ItemsSource="{Binding FilterChips}" Wrap="Wrap" Direction="Row"><BindableLayout.ItemTemplate><DataTemplate><Border Style="{StaticResource SelectableFilterPillBorderStyle}" Margin="0,0,8,8"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=ToggleFilterChipCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Label Text="{Binding Label}" Style="{StaticResource FilterPillLabelStyle}"/></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout></VerticalStackLayout></ScrollView><Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto"><Button Text="Cancel" Command="{Binding CancelFiltersCommand}"/><Button Grid.Column="2" Text="Search" Command="{Binding ApplyFiltersCommand}"/></Grid></Grid></Border></Grid>
    </Grid>
</ContentPage>
