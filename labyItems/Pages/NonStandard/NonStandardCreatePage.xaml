<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="labyItems.Pages.NonStandard.NonStandardCreatePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:labyItems.Pages.NonStandard"
    NavigationPage.HasNavigationBar="False"
    NavigationPage.HasBackButton="False"
    Shell.NavBarIsVisible="False"
    Title="">

    <ContentPage x:Name="BackTab"
                 Title="←">
        <Grid />
    </ContentPage>

    <pages:NonStandardClassCreatePage x:Name="ClassTab"
                                      Title="Class" />
    <pages:NonStandardLegacyCreatePage x:Name="RaceTab"
                                       FixedEntityTypeKey="CharacterRace"
                                       Title="Race" />
    <pages:NonStandardLegacyCreatePage x:Name="SpellTab"
                                       FixedEntityTypeKey="Spell"
                                       Title="Spell" />
    <pages:NonStandardLegacyCreatePage x:Name="MiracleTab"
                                       FixedEntityTypeKey="Miracle"
                                       Title="Miracle" />
    <pages:NonStandardLegacyCreatePage x:Name="EvocationTab"
                                       FixedEntityTypeKey="Evocation"
                                       Title="Evoc" />
    <pages:NonStandardLegacyCreatePage x:Name="AbilityTab"
                                       FixedEntityTypeKey="Ability"
                                       Title="Ability" />
    <pages:NonStandardWalletPage x:Name="WalletTab"
                                 Title="Wallet" />
</TabbedPage>
