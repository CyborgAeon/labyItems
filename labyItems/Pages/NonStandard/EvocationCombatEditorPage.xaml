<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="labyItems.Pages.NonStandard.EvocationCombatEditorPage" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False" NavigationPage.HasNavigationBar="False" BackgroundColor="#66000000">
 <Grid Padding="12"><Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="360" MaximumWidthRequest="420" MaximumHeightRequest="620" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="14">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold"/>
   <ScrollView Grid.Row="1"><VerticalStackLayout Spacing="14">
    <Label Text="Amounts" FontAttributes="Bold"/><Grid ColumnDefinitions="*,*,36" ColumnSpacing="8"><Label Text="TBLP" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="1" Text="LOC" Style="{StaticResource KeyInfoLabelStyle}"/></Grid>
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AmountRows}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,*,36" ColumnSpacing="8"><Entry Text="{Binding TblpText}" Keyboard="Numeric" Placeholder="0"/><Entry Grid.Column="1" Text="{Binding LocText}" Keyboard="Numeric" Placeholder="0"/><Button Grid.Column="2" Text="&#xF00D;" FontFamily="FASolid" Padding="0" BackgroundColor="Transparent" Clicked="OnRemoveAmountClicked" CommandParameter="{Binding .}"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
    <Button Text="+ Add amount" Clicked="OnAddAmountClicked" HorizontalOptions="Start"/>
    <VerticalStackLayout IsVisible="{Binding HasAmounts}" Spacing="10"><Label Text="TYPE" Style="{StaticResource KeyInfoLabelStyle}"/><Picker ItemsSource="{Binding EffectTypes}" SelectedItem="{Binding SelectedEffectType}" Title="Target LOC / Blast"/><VerticalStackLayout IsVisible="{Binding IsDamage}"><Label Text="DAMAGE TYPE" Style="{StaticResource KeyInfoLabelStyle}"/><Picker ItemsSource="{Binding DamageTypes}" SelectedItem="{Binding SelectedDamageType}" Title="Select damage type"/></VerticalStackLayout></VerticalStackLayout>
    <VerticalStackLayout IsVisible="{Binding IsDamage}" Spacing="10"><Label Text="Armour applies" FontAttributes="Bold"/><Grid ColumnDefinitions="*,*,36" ColumnSpacing="8"><Label Text="TBLP" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Column="1" Text="LOC" Style="{StaticResource KeyInfoLabelStyle}"/></Grid>
     <VerticalStackLayout BindableLayout.ItemsSource="{Binding ArmourRows}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,*,36" ColumnSpacing="8"><Entry Text="{Binding TblpText}" Keyboard="Numeric" Placeholder="0"/><Entry Grid.Column="1" Text="{Binding LocText}" Keyboard="Numeric" Placeholder="0"/><Button Grid.Column="2" Text="&#xF00D;" FontFamily="FASolid" Padding="0" BackgroundColor="Transparent" Clicked="OnRemoveArmourClicked" CommandParameter="{Binding .}"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
     <Button Text="+ Add armour applies" Clicked="OnAddArmourClicked" IsEnabled="{Binding CanAddArmour}" HorizontalOptions="Start"/><Label Text="ARMOUR TYPE" Style="{StaticResource KeyInfoLabelStyle}"/><Picker ItemsSource="{Binding ArmourTypes}" SelectedItem="{Binding SelectedArmourType}" Title="Select armour type"/>
    </VerticalStackLayout><Label Text="{Binding ValidationMessage}" TextColor="{StaticResource AccentMaroonColor}" IsVisible="{Binding HasValidationMessage}"/>
   </VerticalStackLayout></ScrollView><Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto"><Button Text="Cancel" Clicked="OnCancelClicked"/><Button Grid.Column="2" Text="Apply" Clicked="OnApplyClicked"/></Grid>
  </Grid></Border></Grid>
</ContentPage>
