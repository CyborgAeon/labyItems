<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.NonStandard.NonStandardAbilityLevelEditorPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    NavigationPage.HasBackButton="False"
    Shell.NavBarIsVisible="False"
    Title="">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="16"
          RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{Binding HeaderText}"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"/>
            <Button Grid.Column="1"
                    Text="&#xF00D;"
                    FontFamily="FASolid"
                    WidthRequest="36"
                    HeightRequest="36"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource AccentMaroonColor}"
                    Clicked="OnCloseClicked"/>
        </Grid>

        <Button Grid.Row="1"
                Text="&#xF002;  Search ability"
                FontFamily="FASolid"
                Clicked="OnSearchAbilityClicked"/>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding LevelRow.Abilities}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No abilities selected for this level."
                       Opacity="0.75"
                       Margin="0,12,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          Padding="0,6">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding AbilityName}"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding AbilityType}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   IsVisible="{Binding HasAbilityType}"/>
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding IsInnate}">
                                <Label Grid.Column="0"
                                       Text="Innate count at 8th"
                                       VerticalTextAlignment="Center"/>
                                <Entry Grid.Column="1"
                                       Keyboard="Numeric"
                                       Text="{Binding CountText, Mode=TwoWay}"/>
                            </Grid>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="&#xF1F8;"
                                FontFamily="FASolid"
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource AccentMaroonColor}"
                                Clicked="OnDeleteAbilityClicked"
                                CommandParameter="{Binding .}"
                                VerticalOptions="Start"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3"
                Text="Done"
                Clicked="OnDoneClicked"/>
    </Grid>
</ContentPage>
