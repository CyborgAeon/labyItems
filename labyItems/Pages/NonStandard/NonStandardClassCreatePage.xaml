<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.NonStandard.NonStandardClassCreatePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:pickers="clr-namespace:labyItems.Controls.Pickers"
    Title="Class">

    <ContentPage.Resources>
        <Color x:Key="CardBorderIssueLight">#F9A825</Color>
        <Color x:Key="CardBgIssueLight">#FFF8E1</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="12">

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="From Base"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding BaseClassName}"
                               IsReadOnly="True"/>
                        <Button Grid.Column="1"
                                Text="&#xF002;"
                                FontFamily="FASolid"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0"
                                Clicked="OnSearchBaseClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Name"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Label Text="class name"
                           FontSize="12"
                           Opacity="0.7"/>
                    <Entry Text="{Binding Name, Mode=TwoWay}"
                           Placeholder="Enter class name"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <Frame.Triggers>
                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding HasBracketWarning}"
                                 Value="True">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderIssueLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgIssueLight}"/>
                    </DataTrigger>
                </Frame.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Brackets"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <controls:MultiChipGroup Items="{Binding BracketOptions}"
                                             SelectedItems="{Binding SelectedBrackets, Mode=TwoWay}"/>
                    <Label Text="{Binding BracketWarningText}"
                           TextColor="{StaticResource MutedTextColor}"
                           IsVisible="{Binding HasBracketWarning}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Path"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding PathClassName}"
                               IsReadOnly="True"/>
                        <Button Grid.Column="1"
                                Text="&#xF002;"
                                FontFamily="FASolid"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0"
                                Clicked="OnSearchPathClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding IsRebirth, Mode=TwoWay}"/>
                        <Label Text="this is a rebirth"
                               VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="{Binding TagsPreview}"
                           FontSize="12"
                           Opacity="0.8"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Armour"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <controls:MultiChipGroup Items="{Binding ArmourOptions}"
                                             SelectedItems="{Binding SelectedArmourOptions, Mode=TwoWay}"/>

                    <Label Text="Restrictions"
                           FontSize="12"
                           Opacity="0.8"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Placeholder="Add restriction"
                               Text="{Binding ArmourRestrictionInput, Mode=TwoWay}"/>
                        <Button Grid.Column="1"
                                Text="Add"
                                Clicked="OnAddArmourRestrictionClicked"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding ArmourRestrictions}"
                                    SelectionMode="None"
                                    HeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Label Text="{Binding .}"/>
                                    <Button Grid.Column="1"
                                            Text="&#xF1F8;"
                                            FontFamily="FASolid"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0"
                                            Clicked="OnDeleteArmourRestrictionClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <Frame.Triggers>
                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding ShowMaxAcWarning}"
                                 Value="True">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderIssueLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgIssueLight}"/>
                    </DataTrigger>
                </Frame.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Max AC"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Entry Text="{Binding MaxAcText, Mode=TwoWay}"
                           Keyboard="Numeric"
                           Placeholder="0-24"/>
                    <Label Text="Usual limit 12"
                           TextColor="{StaticResource MutedTextColor}"
                           IsVisible="{Binding ShowMaxAcWarning}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Weapon Skills"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <CollectionView ItemsSource="{Binding WeaponSkillLevels}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="6"
                                                     Margin="0,0,0,8">
                                    <Label Text="{Binding Level, StringFormat='Level {0}'}"
                                           FontAttributes="Bold"
                                           FontSize="12"/>
                                    <controls:MultiChipGroup Items="{Binding Source={x:Reference Root}, Path=BindingContext.WeaponSkillOptions}"
                                                             SelectedItems="{Binding SelectedSkills, Mode=TwoWay}"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Weapon skill restrictions"
                           FontSize="12"
                           Opacity="0.8"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Placeholder="Add restriction"
                               Text="{Binding WeaponSkillRestrictionInput, Mode=TwoWay}"/>
                        <Button Grid.Column="1"
                                Text="Add"
                                Clicked="OnAddWeaponSkillRestrictionClicked"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding WeaponSkillRestrictions}"
                                    SelectionMode="None"
                                    HeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Label Text="{Binding .}"/>
                                    <Button Grid.Column="1"
                                            Text="&#xF1F8;"
                                            FontFamily="FASolid"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource AccentMaroonColor}"
                                            Clicked="OnDeleteWeaponSkillRestrictionClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="Abilities"
                               Style="{StaticResource SectionHeaderLabelStyle}"
                               VerticalTextAlignment="Center"/>
                        <Button Grid.Column="1"
                                Text="Add"
                                Clicked="OnAddAbilityRowClicked"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding AbilityRows}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Style="{StaticResource SectionCardFrameStyle}"
                                       Padding="8"
                                       Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              ColumnSpacing="8">
                                            <Picker Grid.Column="0"
                                                    WidthRequest="78"
                                                    ItemsSource="{Binding Source={x:Reference Root}, Path=BindingContext.LevelOptions}"
                                                    SelectedItem="{Binding Level, Mode=TwoWay}"/>
                                            <Entry Grid.Column="1"
                                                   Text="{Binding AbilityName, Mode=TwoWay}"
                                                   Placeholder="Ability"/>
                                            <Button Grid.Column="2"
                                                    Text="&#xF002;"
                                                    FontFamily="FASolid"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Padding="0"
                                                    Clicked="OnSearchAbilityClicked"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="3"
                                                    Text="&#xF1F8;"
                                                    FontFamily="FASolid"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Padding="0"
                                                    Clicked="OnRemoveAbilityRowClicked"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>

                                        <Label Text="{Binding AbilityType}"
                                               FontSize="12"
                                               Opacity="0.75"
                                               IsVisible="{Binding HasAbilityType}"/>

                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8"
                                              IsVisible="{Binding IsInnate}">
                                            <Label Grid.Column="0"
                                                   Text="Innate count at 8th"
                                                   VerticalTextAlignment="Center"/>
                                            <Entry Grid.Column="1"
                                                   Keyboard="Numeric"
                                                   Text="{Binding CountText, Mode=TwoWay}"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Buy as"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Entry Text="{Binding BuyAsText, Mode=TwoWay}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Alignment"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Label Text="Tap squares to enable/disable allowed alignments"
                           FontSize="12"
                           Opacity="0.7"/>
                    <pickers:AlignmentToggleGridPicker SelectedAlignments="{Binding SelectedAlignments, Mode=TwoWay}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Powerbase"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <controls:MultiChipGroup Items="{Binding PowerbaseOptions}"
                                             SelectedItems="{Binding SelectedPowerbases, Mode=TwoWay}"/>
                    <Label Text="{Binding PowerbaseExplanation}"
                           FontSize="12"
                           Opacity="0.8"
                           LineBreakMode="WordWrap"/>

                    <CollectionView ItemsSource="{Binding PowerCalculations}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Label Grid.Column="0"
                                           Text="{Binding PowerBaseDisplay}"
                                           VerticalTextAlignment="Center"/>
                                    <Entry Grid.Column="1"
                                           Placeholder="e.g. CL^2+CL"
                                           Text="{Binding Calculation, Mode=TwoWay}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}"
                   IsVisible="{Binding HasMagicPowerbase}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="CasterLevel"
                               Style="{StaticResource SectionHeaderLabelStyle}"/>
                        <Button Grid.Column="1"
                                Text="Add"
                                Clicked="OnAddCasterColourClicked"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding CasterLevelRows}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Picker Grid.Column="0"
                                            WidthRequest="170"
                                            IsEnabled="{Binding CanRemove}"
                                            ItemsSource="{Binding Source={x:Reference Root}, Path=BindingContext.CasterColourOptions}"
                                            SelectedItem="{Binding Colour, Mode=TwoWay}">
                                        <Picker.Triggers>
                                            <DataTrigger TargetType="Picker"
                                                         Binding="{Binding Colour}"
                                                         Value="All">
                                                <Setter Property="IsEnabled"
                                                        Value="False"/>
                                            </DataTrigger>
                                        </Picker.Triggers>
                                    </Picker>
                                    <Entry Grid.Column="1"
                                           Keyboard="Numeric"
                                           Placeholder="="
                                           Text="{Binding LevelText, Mode=TwoWay}"/>
                                    <Button Grid.Column="2"
                                            Text="&#xF1F8;"
                                            FontFamily="FASolid"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0"
                                            IsVisible="{Binding CanRemove}"
                                            Clicked="OnDeleteCasterColourClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SectionCardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="Lifescale"
                               Style="{StaticResource SectionHeaderLabelStyle}"
                               VerticalTextAlignment="Center"/>
                        <Button Grid.Column="1"
                                Text="&#xF002;"
                                FontFamily="FASolid"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0"
                                Clicked="OnSearchLifescaleClicked"/>
                    </Grid>

                    <Label Text="{Binding LifescaleSummary}"
                           FontSize="12"
                           Opacity="0.8"
                           IsVisible="{Binding HasLifeScaleSelection}"/>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding UseCustomLifeScale, Mode=TwoWay}"/>
                        <Label Text="Use custom lifescale"
                               VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>

                    <CollectionView ItemsSource="{Binding CustomLifeScaleRows}"
                                    IsVisible="{Binding UseCustomLifeScale}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="60,*,*"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Label Text="{Binding Level, StringFormat='Lv {0}'}"
                                           VerticalTextAlignment="Center"/>
                                    <Entry Grid.Column="1"
                                           Keyboard="Numeric"
                                           Placeholder="Body"
                                           Text="{Binding BodyText, Mode=TwoWay}"/>
                                    <Entry Grid.Column="2"
                                           Keyboard="Numeric"
                                           Placeholder="Loc"
                                           Text="{Binding LocText, Mode=TwoWay}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="{Binding LifescaleChevronText}"
                                Style="{StaticResource ChevronButtonStyle}"
                                Clicked="OnToggleLifescaleExpandedClicked"/>
                        <Label Grid.Column="1"
                               Text="Level 8 in collapsed view, full levels when expanded"
                               VerticalTextAlignment="Center"
                               FontSize="12"
                               Opacity="0.75"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding ExpandedLifeScaleRows}"
                                    IsVisible="{Binding IsLifescaleExpanded}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="60,*,*"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Label Text="{Binding Level, StringFormat='Lv {0}'}"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Body, StringFormat='Body {0}'}"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding Loc, StringFormat='Loc {0}'}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Whitelist races"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Button Text="Add to whitelist"
                            Clicked="OnAddWhitelistRaceClicked"/>
                    <CollectionView ItemsSource="{Binding RaceWhitelist}"
                                    SelectionMode="None"
                                    HeightRequest="130">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Label Text="{Binding .}"
                                           VerticalTextAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Text="&#xF362;"
                                            FontFamily="FASolid"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0"
                                            Clicked="OnMoveWhitelistToBlacklistClicked"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="2"
                                            Text="&#xF1F8;"
                                            FontFamily="FASolid"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0"
                                            Clicked="OnDeleteWhitelistRaceClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Blacklist races"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <Button Text="Add to blacklist"
                            Clicked="OnAddBlacklistRaceClicked"/>
                    <CollectionView ItemsSource="{Binding RaceBlacklist}"
                                    SelectionMode="None"
                                    HeightRequest="130">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8"
                                      Padding="0,2">
                                    <Label Text="{Binding .}"
                                           VerticalTextAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Text="&#xF362;"
                                            FontFamily="FASolid"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0"
                                            Clicked="OnMoveBlacklistToWhitelistClicked"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="2"
                                            Text="&#xF1F8;"
                                            FontFamily="FASolid"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            Padding="0"
                                            Clicked="OnDeleteBlacklistRaceClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Non-standard Class"
                    IsEnabled="{Binding CanSave}"
                    Clicked="OnSaveClicked"/>

            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"/>

            <Label Text="{Binding SaveStatus}"
                   TextColor="{StaticResource AccentMaroonColor}"
                   IsVisible="{Binding HasSaveStatus}"
                   LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
