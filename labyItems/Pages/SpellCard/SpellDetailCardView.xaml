<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.SpellCard.SpellDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <ContentView>
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="5" VerticalOptions="Start">
                    <Label Text="{Binding SpellName, Source={x:Reference Root}}"
                           FontSize="24"
                           FontAttributes="Bold"
                           MaxLines="2"
                           LineBreakMode="TailTruncation"/>
                    <HorizontalStackLayout Spacing="7">
                        <Frame Padding="0" WidthRequest="12" HeightRequest="12" CornerRadius="6" HasShadow="False" BorderColor="{Binding ColourCircleBorderColor, Source={x:Reference Root}}" BackgroundColor="{Binding ColourCircleColor, Source={x:Reference Root}}" VerticalOptions="Center"/>
                        <Label Text="{Binding ColourSubtitleText, Source={x:Reference Root}}" FontSize="14" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="LEVEL" Style="{StaticResource KeyInfoLabelStyle}"/>
                        <Label Text="{Binding LevelDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/>
                    </VerticalStackLayout>
                    <Frame Padding="8,4" CornerRadius="10" HasShadow="False" BackgroundColor="#FFF3D6" BorderColor="#E8C878" IsVisible="{Binding IsAdvanced, Source={x:Reference Root}}"><Label Text="★ Advanced" FontSize="12" FontAttributes="Bold"/></Frame>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout x:Name="SpellKeyInformationGrid" Margin="-16,0" Padding="12,10" Spacing="10" IsVisible="{Binding HasKeyInformation, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" IsVisible="{Binding HasRangeOrDuration, Source={x:Reference Root}}"/>
                <Grid ColumnDefinitions="*,1,*" IsVisible="{Binding HasBothRangeAndDuration, Source={x:Reference Root}}"><VerticalStackLayout><Label Text="RANGE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding RangeDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2"><Label Text="DURATION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding DurationDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout></Grid>
                <VerticalStackLayout IsVisible="{Binding HasOnlyRange, Source={x:Reference Root}}"><Label Text="RANGE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding RangeDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding HasOnlyDuration, Source={x:Reference Root}}"><Label Text="DURATION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding DurationDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasImmunity, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><Grid ColumnDefinitions="*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnImmunityTapped"/></Grid.GestureRecognizers><VerticalStackLayout><Label Text="IMMUNITY" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding ImmunityDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><Label Grid.Column="1" Text="&#xF05A;" FontFamily="FASolid" FontSize="14" Margin="8,0" VerticalTextAlignment="Center" IsVisible="{Binding HasImmunityLink, Source={x:Reference Root}}"/></Grid></VerticalStackLayout>
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasDamageQuickFacts, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><controls:CombatQuickFactsView Facts="{Binding DamageQuickFacts, Source={x:Reference Root}}"/></VerticalStackLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="DESCRIPTION"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <controls:ChevronIconView Grid.Column="1"
                                          IsExpanded="{Binding IsDescriptionExpanded, Source={x:Reference Root}}"
                                          AnimateRotation="True"
                                          GlyphSize="14"
                                          GlyphColor="{StaticResource MutedTextColor}"
                                          InputTransparent="True"
                                          IsVisible="{Binding ShowDescriptionChevron, Source={x:Reference Root}}"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowDescriptionSeeMore, Source={x:Reference Root}}"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVerbalSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="VERBAL"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <controls:ChevronIconView Grid.Column="1"
                                          IsExpanded="{Binding IsVerbalExpanded, Source={x:Reference Root}}"
                                          AnimateRotation="True"
                                          GlyphSize="14"
                                          GlyphColor="{StaticResource MutedTextColor}"
                                          InputTransparent="True"
                                          IsVisible="{Binding ShowVerbalChevron, Source={x:Reference Root}}"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"/>
            </Grid>

            <ContentView x:Name="VerbalTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVerbalSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="VerbalLabel"
                       Text="{Binding VerbalText, Source={x:Reference Root}}"
                       MaxLines="{Binding VerbalMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowVerbalSeeMore, Source={x:Reference Root}}"/>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasNotes, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotesSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="NOTES"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsNotesExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandNotes, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotesSectionTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="NotesLabel"
                           Text="{Binding NotesText, Source={x:Reference Root}}"
                           MaxLines="{Binding NotesMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                    <Label Text="... see more"
                           TextColor="{StaticResource MutedTextColor}"
                           FontSize="12"
                           IsVisible="{Binding ShowNotesSeeMore, Source={x:Reference Root}}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasMetaChips, Source={x:Reference Root}}">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

                <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            BindableLayout.ItemsSource="{Binding MetaChips, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource MetaChipFrameStyle}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Icon}"
                                           FontSize="12"
                                           VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Text}"
                                           FontSize="13"
                                           VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentView>
</ContentView>
