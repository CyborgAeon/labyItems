<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.SpellCard.SpellDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame Padding="16"
           CornerRadius="12"
           HasShadow="False"
           BorderColor="#E5E7EB">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding SpellName, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <Frame Padding="0"
                       WidthRequest="12"
                       HeightRequest="12"
                       CornerRadius="6"
                       HasShadow="False"
                       BorderColor="{Binding ColourCircleBorderColor, Source={x:Reference Root}}"
                       BackgroundColor="{Binding ColourCircleColor, Source={x:Reference Root}}"
                       VerticalOptions="Center"/>

                <Label Grid.Column="1"
                       Text="{Binding ColourDisplayText, Source={x:Reference Root}}"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"/>

                <Label Grid.Column="2"
                       Text="{Binding LevelDisplayText, Source={x:Reference Root}}"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <BoxView HeightRequest="1"
                     Color="#E5E7EB"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="DESCRIPTION"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        Text="{Binding DescriptionChevronText, Source={x:Reference Root}}"
                        IsVisible="{Binding ShowDescriptionChevron, Source={x:Reference Root}}"
                        Clicked="OnDescriptionToggleClicked"
                        BackgroundColor="Transparent"
                        TextColor="#6B7280"
                        FontSize="18"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="VERBAL"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        Text="{Binding VerbalChevronText, Source={x:Reference Root}}"
                        IsVisible="{Binding ShowVerbalChevron, Source={x:Reference Root}}"
                        Clicked="OnVerbalToggleClicked"
                        BackgroundColor="Transparent"
                        TextColor="#6B7280"
                        FontSize="18"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"/>
            </Grid>

            <ContentView x:Name="VerbalTextContainer">
                <Label x:Name="VerbalLabel"
                       Text="{Binding VerbalText, Source={x:Reference Root}}"
                       MaxLines="{Binding VerbalMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasNotes, Source={x:Reference Root}}">
                <Label Text="NOTES"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"/>

                <VerticalStackLayout Spacing="2">
                    <Label x:Name="NotesLabel"
                           Text="{Binding NotesText, Source={x:Reference Root}}"
                           MaxLines="{Binding NotesMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                    <Button Text="{Binding IsNotesExpanded, Source={x:Reference Root}, Converter={StaticResource ChevronConverter}}"
                            IsVisible="{Binding CanExpandNotes, Source={x:Reference Root}}"
                            Clicked="OnNotesToggleClicked"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            Padding="0"
                            WidthRequest="36"
                            HeightRequest="36"
                            HorizontalOptions="End"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasMetaChips, Source={x:Reference Root}}">
                <BoxView HeightRequest="1"
                         Color="#E5E7EB"/>

                <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            BindableLayout.ItemsSource="{Binding MetaChips, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10,4"
                                   CornerRadius="14"
                                   HasShadow="False"
                                   Margin="4,2"
                                   BorderColor="#E5E7EB"
                                   BackgroundColor="#F3F4F6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Icon}"
                                           FontSize="12"
                                           VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Text}"
                                           FontSize="13"
                                           VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentView>
