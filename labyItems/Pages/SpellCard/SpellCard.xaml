<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="labyItems.Pages.SpellCard.SpellCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:spellCard="clr-namespace:labyItems.Pages.SpellCard"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
    <controls:DetailPageHeader x:Name="DetailHeader" HeaderText="Wizard Grimoire"/>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16">
            <spellCard:SpellDetailCardView x:Name="SpellDetails" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
