<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="labyItems.Pages.Characters.AdvanceAbilitySpecialisationPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:labyItems.Pages.Characters" xmlns:viewModels="clr-namespace:labyItems.Pages.Characters.ViewModels" Title="Ability Specialisation" BackgroundColor="{StaticResource White}" NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False">
 <Grid RowDefinitions="Auto,*,Auto">
  <Border Padding="16,12" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1"><VerticalStackLayout><Label Text="Ability Specialisation" FontAttributes="Bold" FontSize="18"/><Label Text="Choose options for abilities that require specialisation." FontSize="12" Opacity="0.75"/></VerticalStackLayout></Border>
  <ScrollView Grid.Row="1"><VerticalStackLayout Padding="16" Spacing="12"><Label Text="No required choice sets for the selected abilities." IsVisible="{Binding HasNoCards}" Opacity="0.7" HorizontalTextAlignment="Center"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding AbilityCards}" Spacing="12"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:AdvanceAbilitySpecialisationAbilityVm"><Border Padding="10" Stroke="{StaticResource SurfaceBorderColor}" StrokeShape="RoundRectangle 12"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding AbilityName}" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding Subtitle}" Opacity="0.7"/></Grid><VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ChoiceSetGroupVm"><local:ChoiceSetGroupView/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></ScrollView>
  <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Padding="16,10,16,18" BackgroundColor="{StaticResource White}"><Button Text="Back" Command="{Binding BackCommand}"/><Button Grid.Column="2" Text="Save" Command="{Binding SaveCommand}"/></Grid>
 </Grid>
</ContentPage>
