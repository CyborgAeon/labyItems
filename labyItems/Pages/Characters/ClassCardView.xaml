<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.ClassCardView"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <Grid
        Margin="0,0,0,5">
        <Frame
            x:Name="CardFrame"
            CornerRadius="12"
            Padding="0"
            HasShadow="False"
            BorderColor="#E5E7EB"
            BackgroundColor="#FFFFFF">
            <Frame.Triggers>
                <DataTrigger TargetType="Frame"
                             Binding="{Binding IsSelected}"
                             Value="True">
                    <Setter Property="HasShadow"
                            Value="True"/>
                    <Setter Property="BorderColor"
                            Value="#7F1D1D"/>
                    <Setter Property="BackgroundColor"
                            Value="#FFF7ED"/>
                </DataTrigger>
            </Frame.Triggers>
            <Grid RowDefinitions="Auto,Auto">

                <Grid Padding="16"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="10">

                    <Grid ColumnDefinitions="Auto,*,40"
                          ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCommand, Source={x:Reference Self}}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                        <Grid Grid.Column="0"
                              WidthRequest="40"
                              HeightRequest="40">
                            <Frame x:Name="SingleIcon"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="#E5E7EB"
                                   BackgroundColor="{Binding SingleBg}">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding HasSplitIcon}"
                                                 Value="True">
                                        <Setter Property="IsVisible"
                                                Value="False"/>
                                    </DataTrigger>
                                </Frame.Triggers>
                                <Label Text="{Binding SingleEmoji}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18"/>
                            </Frame>

                            <controls:SplitEmojiIcon x:Name="SplitIcon"
                                                     IsVisible="False"
                                                     WidthRequest="40"
                                                     HeightRequest="40"
                                                     LeftEmoji="{Binding SplitLeftEmoji}"
                                                     RightEmoji="{Binding SplitRightEmoji}"
                                                     LeftColor="{Binding SplitLeftBg}"
                                                     RightColor="{Binding SplitRightBg}"
                                                     BorderColor="#E5E7EB">
                                <controls:SplitEmojiIcon.Triggers>
                                    <DataTrigger TargetType="controls:SplitEmojiIcon"
                                                 Binding="{Binding HasSplitIcon}"
                                                 Value="True">
                                        <Setter Property="IsVisible"
                                                Value="True"/>
                                    </DataTrigger>
                                </controls:SplitEmojiIcon.Triggers>
                            </controls:SplitEmojiIcon>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding BracketSubheading}"
                                   FontSize="12"
                                   Opacity="0.7"/>
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="{Binding IsExpanded, Converter={StaticResource ChevronConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            Padding="0"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Command="{Binding ToggleExpandedCommand, Source={x:Reference Self}}"
                            CommandParameter="{Binding .}"/>
                    </Grid>

                    <Label Grid.Row="1"
                           Text="{Binding Summary}"
                           FontSize="13"
                           Opacity="0.8"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"/>

                    <FlexLayout Grid.Row="2"
                                Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Start"
                                JustifyContent="Start"
                                Margin="0,2,0,0">
                        <Frame Padding="8,2"
                               CornerRadius="999"
                               Margin="0,0,8,8"
                               HasShadow="False"
                               BorderColor="#E5E7EB"
                               BackgroundColor="Transparent">
                            <Label Text="{Binding Tag1}"
                                   FontSize="12"/>
                        </Frame>

                        <Frame Padding="8,2"
                               CornerRadius="999"
                               Margin="0,0,8,8"
                               HasShadow="False"
                               BorderColor="#E5E7EB"
                               BackgroundColor="Transparent">
                            <Label Text="{Binding Tag2}"
                                   FontSize="12"/>
                        </Frame>

                        <Frame Padding="8,2"
                               CornerRadius="999"
                               Margin="0,0,8,8"
                               HasShadow="False"
                               BorderColor="#E5E7EB"
                               BackgroundColor="Transparent">
                            <Label Text="{Binding Tag3}"
                                   FontSize="12"/>
                        </Frame>
                    </FlexLayout>
                </Grid>

                <Grid x:Name="ExpandedContent"
                      Grid.Row="1"
                      IsVisible="False"
                      BackgroundColor="Transparent">
                    <Grid Padding="16"
                          BackgroundColor="Transparent">
                        <CollectionView ItemsSource="{Binding LevelRows}"
                                        SelectionMode="None">
                            <CollectionView.Header>
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="6">
                                    <Label Grid.Row="0"
                                           Text="Level Progression"
                                           FontSize="13"
                                           FontAttributes="Bold"/>
                                    <Grid Grid.Row="1"
                                          Grid.ColumnDefinitions="50,60,*,*"
                                          ColumnSpacing="8"
                                          Opacity="0.7">
                                        <Label Text="Lvl"/>
                                        <Label Grid.Column="1"
                                               Text="Body"/>
                                        <Label Grid.Column="2"
                                               Text="Loc"/>
                                        <Label Grid.Column="3"
                                               Text="Skills/Abilities"/>
                                    </Grid>
                                </Grid>
                            </CollectionView.Header>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="Auto"
                                          ColumnDefinitions="50,60,*,*"
                                          ColumnSpacing="8"
                                          Padding="0,2">
                                        <Label Text="{Binding Level}"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding Body}"/>
                                        <Label Grid.Column="2"
                                               Text="{Binding Loc}"/>
                                        <Label Grid.Column="3"
                                               Text="{Binding Skills}"
                                               Opacity="0.8"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

            </Grid>
        </Frame>
    </Grid>
</ContentView>
