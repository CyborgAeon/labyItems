<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.ClassCardView"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <Grid
        Margin="0,0,0,5">
        <Frame
            x:Name="CardFrame"
            BackgroundColor="{Binding CardBackgroundColor}"
            Style="{StaticResource SelectableCardFrameStyle}">
            <Frame.Triggers>
                <DataTrigger TargetType="Frame"
                             Binding="{Binding IsSelected}"
                             Value="True">
                    <Setter Property="HasShadow"
                            Value="True"/>
                    <Setter Property="BorderColor"
                            Value="{StaticResource AccentMaroonColor}"/>
                    <Setter Property="BackgroundColor"
                            Value="{StaticResource SelectedSurfaceBackgroundColor}"/>
                </DataTrigger>
            </Frame.Triggers>
            <Grid RowDefinitions="Auto,Auto">

                <Grid Padding="16"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="10">

                    <Grid ColumnDefinitions="Auto,*,40"
                          ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCommand, Source={x:Reference Self}}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                        <controls:ClassBracketIconView Grid.Column="0"
                                                       IconSize="40"
                                                       HasSplitIcon="{Binding HasSplitIcon}"
                                                       SingleGlyph="{Binding SingleEmoji}"
                                                       SingleIconFontFamily="{Binding SingleIconFontFamily}"
                                                       SingleBackground="{Binding SingleBg}"
                                                       SplitLeftGlyph="{Binding SplitLeftEmoji}"
                                                       SplitRightGlyph="{Binding SplitRightEmoji}"
                                                       SplitLeftBackground="{Binding SplitLeftBg}"
                                                       SplitRightBackground="{Binding SplitRightBg}"
                                                       BorderColor="{StaticResource SurfaceBorderColor}" />

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding BracketSubheading}"
                                   FontSize="12"
                                   Opacity="0.7"/>
                        </VerticalStackLayout>

                        <controls:ChevronIconView Grid.Column="2"
                                                  IsExpanded="{Binding IsExpanded}"
                                                  AnimateRotation="True"
                                                  GlyphColor="{StaticResource Gray500}"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center">
                            <controls:ChevronIconView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleExpandedCommand, Source={x:Reference Self}}"
                                                      CommandParameter="{Binding .}" />
                            </controls:ChevronIconView.GestureRecognizers>
                        </controls:ChevronIconView>
                    </Grid>
                    <controls:ChipGroup Grid.Row="1"
                                        Items="{Binding TagChips}"
                                        InputTransparent="True"/>
                </Grid>

                <Grid x:Name="ExpandedContent"
                      Grid.Row="1"
                      IsVisible="False"
                      BackgroundColor="Transparent">
                    <Grid Padding="16"
                          BackgroundColor="Transparent">
                        <controls:LevelAbilityTableView ItemsSource="{Binding LevelRows}"
                                                        ShowBodyAndLoc="{Binding ShowBodyAndLoc}"
                                                        AbilitiesHeaderText="Skills/Abilities"/>
                    </Grid>
                </Grid>

            </Grid>
        </Frame>
    </Grid>
</ContentView>
