<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.CharacterSpecialisation"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:specialisationControls="clr-namespace:labyItems.Controls.Specialisations"
    xmlns:pages="clr-namespace:labyItems.Pages.Characters">

    <ContentView.Resources>
        <Color x:Key="CardBorderNeutralLight">#E0E0E0</Color>
        <Color x:Key="CardBorderSuccessLight">#2E7D32</Color>
        <Color x:Key="CardBorderIssueLight">#F9A825</Color>
        <Color x:Key="CardBorderErrorLight">#C62828</Color>
        <Color x:Key="CardBgSuccessLight">#E8F5E9</Color>
        <Color x:Key="CardBgIssueLight">#FFF8E1</Color>
        <Color x:Key="CardBgErrorLight">#FFEBEE</Color>

        <DataTemplate x:Key="MappedSectionTemplate">
            <Border IsVisible="{Binding IsVisible}"
                    Stroke="{StaticResource SurfaceBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="0">
                    <Border Padding="12,9" StrokeThickness="0" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSubtreeComplete}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource CardBgSuccessLight}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="10">
                            <Border HeightRequest="30" WidthRequest="30" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Gray500}">
                                <Label Text="{Binding DisplayIndex}" TextColor="White" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSubtreeComplete}" Value="True">
                                            <Setter Property="Text" Value="{x:Static helpers:FontAwesomeGlyphs.Check}"/>
                                            <Setter Property="FontFamily" Value="FASolid"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding StatusText}" FontSize="12" Opacity="0.72"/>
                            </VerticalStackLayout>
                            <controls:ChevronIconView Grid.Column="2" IsExpanded="{Binding IsExpanded}"
                                                      AnimateRotation="True" GlyphSize="14" IconSize="30"
                                                      GlyphColor="{StaticResource MutedTextColor}"/>
                        </Grid>
                    </Border>
                    <controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}" AnimationName="MappedSpecialisationExpand">
                        <VerticalStackLayout Padding="12" Spacing="10">
                        <Label Text="{Binding DisplaySubtitle}" Opacity="0.75" LineBreakMode="WordWrap"/>
                        <specialisationControls:SpecialisationGridView
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding SelectedOptionDisplay, Mode=TwoWay}"/>

                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding HasSelection}">
                            <Grid ColumnDefinitions="72,*,24"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding AbilityRows.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                  Opacity="0.7">
                                <Label Text="Stage"/>
                                <Label Grid.Column="1"
                                       Text="Ability"/>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AbilityRows}"
                                                 IsVisible="False"
                                                 Spacing="2">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout"
                                                 Binding="{Binding AbilityRows.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                                 Value="True">
                                        <Setter Property="IsVisible"
                                                Value="True"/>
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="72,*,24"
                                              ColumnSpacing="8"
                                              Padding="0,2">
                                            <Label Text="{Binding LevelText}"
                                                   Opacity="0.85"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Ability}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   Opacity="0.85"/>
                                            <Button Grid.Column="2"
                                                    Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                                    FontFamily="FASolid"
                                                    FontSize="12"
                                                    Padding="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource SubtleTextColor}"
                                                    HeightRequest="18"
                                                    WidthRequest="18"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={x:Reference Root}, Path=ViewSpecialisationRowDetailsCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,24"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding HasAboutSelectionLink}">
                                <Label Text="{Binding AboutSelectionLabel}"
                                       Opacity="0.75"
                                       VerticalTextAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                        FontFamily="FASolid"
                                        FontSize="12"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SubtleTextColor}"
                                        HeightRequest="18"
                                        WidthRequest="18"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={x:Reference Root}, Path=ViewSpecialisationDetailsCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                    </controls:AnimatedExpandView>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceSectionTemplate">
            <Border IsVisible="{Binding IsVisible}"
                    Stroke="{StaticResource SurfaceBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="0">
                    <Border Padding="12,9" StrokeThickness="0" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSubtreeComplete}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource CardBgSuccessLight}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="10">
                            <Border HeightRequest="30" WidthRequest="30" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Gray500}">
                                <Label Text="{Binding DisplayIndex}" TextColor="White" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSubtreeComplete}" Value="True">
                                            <Setter Property="Text" Value="{x:Static helpers:FontAwesomeGlyphs.Check}"/>
                                            <Setter Property="FontFamily" Value="FASolid"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding StatusText}" FontSize="12" Opacity="0.72"/>
                            </VerticalStackLayout>
                            <controls:ChevronIconView Grid.Column="2" IsExpanded="{Binding IsExpanded}"
                                                      AnimateRotation="True" GlyphSize="14" IconSize="30"
                                                      GlyphColor="{StaticResource MutedTextColor}"/>
                        </Grid>
                    </Border>
                    <controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}" AnimationName="ChoiceSpecialisationExpand">
                        <VerticalStackLayout Padding="12" Spacing="10">
                        <Label Text="{Binding DisplaySubtitle}"
                               Opacity="0.75"
                               LineBreakMode="WordWrap"/>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Slots}"
                                             Spacing="0"
                                             HorizontalOptions="FillAndExpand">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10"
                                          Padding="0,6">
                                        <Label Text="{Binding LevelLabel}"
                                               VerticalOptions="Center"
                                               Opacity="0.85"/>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="6">
                                            <Label Text="{Binding LockedDisplayText}"
                                                   Opacity="0.8"
                                                   IsVisible="{Binding IsLocked}"/>

                                            <VerticalStackLayout Spacing="6"
                                                                 IsVisible="{Binding IsSelectable}">
                                                <specialisationControls:SpecialisationGridView
                                                        HorizontalOptions="FillAndExpand"
                                                        ItemsSource="{Binding FilteredOptionNames}"
                                                        SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                                                    <specialisationControls:SpecialisationGridView.Triggers>
                                                        <DataTrigger TargetType="specialisationControls:SpecialisationGridView"
                                                                     Binding="{Binding UseWardPactEnum}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="specialisationControls:SpecialisationGridView"
                                                                     Binding="{Binding UseMagicColourEnum}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="specialisationControls:SpecialisationGridView"
                                                                     Binding="{Binding UseVivomancerColourEnum}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="specialisationControls:SpecialisationGridView"
                                                                     Binding="{Binding UseDictionarySearch}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="specialisationControls:SpecialisationGridView"
                                                                     Binding="{Binding HideAbilityPicker}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="specialisationControls:SpecialisationGridView"
                                                                     Binding="{Binding ShowCustomisationInline}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                    </specialisationControls:SpecialisationGridView.Triggers>
                                                </specialisationControls:SpecialisationGridView>

                                                <Grid ColumnDefinitions="0.46*,0.54*"
                                                      ColumnSpacing="8"
                                                      IsVisible="{Binding ShowCustomisationInline}">
                                                    <Picker Grid.Column="0"
                                                            HorizontalOptions="FillAndExpand"
                                                            Title="Select an ability"
                                                            ItemsSource="{Binding FilteredOptionNames}"
                                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                                                        <Picker.Triggers>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseWardPactEnum}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseMagicColourEnum}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseVivomancerColourEnum}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseDictionarySearch}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding HideAbilityPicker}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                        </Picker.Triggers>
                                                    </Picker>

                                                    <controls:DictionarySearchBar Grid.Column="1"
                                                                                  x:TypeArguments="x:String"
                                                                                  ItemsSource="{Binding CustomisationOptions}"
                                                                                  SelectedText="{Binding CustomisationValue, Mode=TwoWay}"
                                                                                  PlaceholderText="{Binding CustomisationPlaceholder}"
                                                                                  AllowCustomOptions="{Binding CustomisationAllowsCustom}"
                                                                                  HorizontalOptions="FillAndExpand"/>
                                                </Grid>

                                                <controls:ChipGroup Items="{Binding FilteredOptionNames}"
                                                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                    IsVisible="{Binding UseVivomancerColourEnum}"
                                                                    HorizontalOptions="FillAndExpand"/>

                                                <VerticalStackLayout Spacing="6"
                                                                     IsVisible="{Binding UseDictionarySearch}">
                                                    <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                                  ItemsSource="{Binding SearchOptions}"
                                                                                  SelectedText="{Binding SelectedOption, Mode=TwoWay}"
                                                                                  PlaceholderText="Search abilities"
                                                                                  AllowCustomOptions="False"
                                                                                  HorizontalOptions="FillAndExpand"/>

                                                    <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                                  ItemsSource="{Binding CustomisationOptions}"
                                                                                  SelectedText="{Binding CustomisationValue, Mode=TwoWay}"
                                                                                  PlaceholderText="{Binding CustomisationPlaceholder}"
                                                                                  AllowCustomOptions="{Binding CustomisationAllowsCustom}"
                                                                                  HorizontalOptions="FillAndExpand"
                                                                                  IsVisible="{Binding ShowCustomisationPicker}"/>
                                                </VerticalStackLayout>

                                                <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                              ItemsSource="{Binding SearchOptions}"
                                                                              SelectedText="{Binding SelectedOption, Mode=TwoWay}"
                                                                              PlaceholderText="choose a colour of magic"
                                                                              AllowCustomOptions="False"
                                                                              HorizontalOptions="FillAndExpand"
                                                                              IsVisible="{Binding UseMagicColourEnum}"/>

                                                <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                              ItemsSource="{Binding CustomisationOptions}"
                                                                              SelectedText="{Binding CustomisationValue, Mode=TwoWay}"
                                                                              PlaceholderText="{Binding CustomisationPlaceholder}"
                                                                              AllowCustomOptions="{Binding CustomisationAllowsCustom}"
                                                                              HorizontalOptions="FillAndExpand"
                                                                              IsVisible="{Binding ShowCustomisationBelow}">
                                                    <controls:DictionarySearchBar.Triggers>
                                                        <DataTrigger TargetType="ContentView"
                                                                     Binding="{Binding UseDictionarySearch}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                    </controls:DictionarySearchBar.Triggers>
                                                </controls:DictionarySearchBar>

                                                <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                              ItemsSource="{Binding SearchOptions}"
                                                                              SelectedText="{Binding SelectedOption, Mode=TwoWay}"
                                                                              PlaceholderText="choose a ward pact"
                                                                              AllowCustomOptions="False"
                                                                              HorizontalOptions="FillAndExpand"
                                                                              IsVisible="{Binding UseWardPactEnum}"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <Button Grid.Column="2"
                                                Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource SubtleTextColor}"
                                                HeightRequest="18"
                                                WidthRequest="18"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                Margin="6,0,0,0"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding HasSelectedAbilityForDetails}"
                                                Command="{Binding Source={x:Reference Root}, Path=ViewSpecialisationAbilityDetailsCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding HasSelectedOptionAbilityRows}">
                            <Grid ColumnDefinitions="*,24"
                                  ColumnSpacing="8"
                                  Opacity="0.7">
                                <Label Text="Ability"/>
                                <Label Grid.Column="1"
                                       Text="Info"
                                       HorizontalTextAlignment="Center"/>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedOptionAbilityRows}"
                                                 Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,24"
                                              ColumnSpacing="8"
                                              Padding="0,2">
                                            <Label Text="{Binding Ability}"
                                                   Opacity="0.85"
                                                   LineBreakMode="WordWrap"/>
                                            <Button Grid.Column="1"
                                                    Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                                    FontFamily="FASolid"
                                                    FontSize="12"
                                                    Padding="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource SubtleTextColor}"
                                                    HeightRequest="18"
                                                    WidthRequest="18"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={x:Reference Root}, Path=ViewSpecialisationRowDetailsCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                    </controls:AnimatedExpandView>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <pages:SpecialisationSectionTemplateSelector x:Key="SectionTemplateSelector"
                                                    ChoiceTemplate="{StaticResource ChoiceSectionTemplate}"
                                                    MappedTemplate="{StaticResource MappedSectionTemplate}"/>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="12">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <controls:LoadingIndicator IsVisible="{Binding IsLoading}"
                                           IsRunning="{Binding IsLoading}"
                                           Message="Loading specialisations..."
                                           Margin="0,18,0,0"/>

                <Frame Padding="12"
                       CornerRadius="12"
                       HasShadow="False"
                       BorderColor="{StaticResource CardBorderNeutralLight}"
                       IsVisible="{Binding HasNoChoices}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="No specialisation choices required."
                               FontAttributes="Bold"/>
                        <Label Text="If your race or class grants specialisations, they will appear here."
                               Opacity="0.75"/>
                    </VerticalStackLayout>
                </Frame>

                <specialisationControls:CascadingSpecialisationView
                    ItemsSource="{Binding Sections}"
                    ItemTemplateSelector="{StaticResource SectionTemplateSelector}"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
