<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.CharacterSpecialisation"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:pickers="clr-namespace:labyItems.Controls.Pickers"
    xmlns:enums="clr-namespace:labyItems.Models.Enums">

    <ContentView.Resources>
        <Color x:Key="CardBorderNeutralLight">#E0E0E0</Color>
        <Color x:Key="CardBorderNeutralDark">#2A2A2A</Color>

        <Color x:Key="CardBorderSuccessLight">#2E7D32</Color>
        <Color x:Key="CardBorderSuccessDark">#66BB6A</Color>

        <Color x:Key="CardBorderErrorLight">#C62828</Color>
        <Color x:Key="CardBorderErrorDark">#EF5350</Color>

        <Color x:Key="CardBgSuccessLight">#E8F5E9</Color>
        <Color x:Key="CardBgSuccessDark">#14361A</Color>

        <Color x:Key="CardBgErrorLight">#FFEBEE</Color>
        <Color x:Key="CardBgErrorDark">#3B1414</Color>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="12">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="6">
            <Label Text="Specialisation"
                   FontSize="20"
                   FontAttributes="Bold"/>
            <Label
                Text="{Binding HeaderText}"
                Opacity="0.75"
                LineBreakMode="WordWrap"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Frame
                    Padding="12"
                    CornerRadius="12"
                    HasShadow="False"
                    BorderColor="{AppThemeBinding Light={StaticResource CardBorderNeutralLight}, Dark={StaticResource CardBorderNeutralDark}}"
                    IsVisible="{Binding HasNoChoices}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="No specialisation choices required."
                               FontAttributes="Bold"/>
                        <Label Text="If your race or class grants specialisations, they will appear here."
                               Opacity="0.75"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame
                    Padding="0"
                    CornerRadius="12"
                    HasShadow="False"
                    IsVisible="{Binding HasRaceSubtypeChoice}">
                    <Frame.Triggers>
                        <DataTrigger TargetType="Frame"
                                     Binding="{Binding RaceSubtypeCardState}"
                                     Value="Neutral">
                            <Setter Property="BorderColor"
                                    Value="{AppThemeBinding Light={StaticResource CardBorderNeutralLight}, Dark={StaticResource CardBorderNeutralDark}}"/>
                            <Setter Property="BackgroundColor"
                                    Value="Transparent"/>
                        </DataTrigger>

                        <DataTrigger TargetType="Frame"
                                     Binding="{Binding RaceSubtypeCardState}"
                                     Value="Success">
                            <Setter Property="BorderColor"
                                    Value="{AppThemeBinding Light={StaticResource CardBorderSuccessLight}, Dark={StaticResource CardBorderSuccessDark}}"/>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource CardBgSuccessLight}, Dark={StaticResource CardBgSuccessDark}}"/>
                        </DataTrigger>

                        <DataTrigger TargetType="Frame"
                                     Binding="{Binding RaceSubtypeCardState}"
                                     Value="Error">
                            <Setter Property="BorderColor"
                                    Value="{AppThemeBinding Light={StaticResource CardBorderErrorLight}, Dark={StaticResource CardBorderErrorDark}}"/>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource CardBgErrorLight}, Dark={StaticResource CardBgErrorDark}}"/>
                        </DataTrigger>
                    </Frame.Triggers>

                    <VerticalStackLayout Spacing="0">

                        <Grid Padding="12"
                              ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding RaceSubtypeTitle}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"/>

                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding RaceSubtypeStatusText}"
                                   Opacity="0.75"/>

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding RaceSubtypeSubtitle}"
                                   Opacity="0.75"
                                   LineBreakMode="WordWrap"/>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Opacity="0.25"/>

                        <VerticalStackLayout Padding="12"
                                             Spacing="10">

                            <controls:ChipGroup
                                Items="{Binding RaceSubtypeOptions}"
                                SelectedItem="{Binding SelectedRaceSubtype, Mode=TwoWay}"/>

                            <VerticalStackLayout Spacing="8"
                                                 IsVisible="{Binding HasRaceSubtypeSelection}">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Label Text="Level progression"
                                           FontAttributes="Bold"/>
                                    <Button Text="{Binding RaceSubtypeLevelsExpanded, Converter={StaticResource ChevronConverter}}"
                                            Command="{Binding ToggleRaceSubtypeLevelsCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                            Padding="0"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            HorizontalOptions="End"/>
                                </Grid>

                                <Grid IsVisible="{Binding RaceSubtypeLevelsExpanded}"
                                      RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="50,60,*,*"
                                          ColumnSpacing="8"
                                          Opacity="0.7"
                                          IsVisible="{Binding ShowRaceSubtypeLifeScale}">
                                        <Label Text="Lvl"/>
                                        <Label Grid.Column="1"
                                               Text="Body"/>
                                        <Label Grid.Column="2"
                                               Text="Loc"/>
                                        <Label Grid.Column="3"
                                               Text="Abilities"/>
                                    </Grid>

                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="50,*"
                                          ColumnSpacing="8"
                                          Opacity="0.7"
                                          IsVisible="{Binding HideRaceSubtypeLifeScale}">
                                        <Label Text="Lvl"/>
                                        <Label Grid.Column="1"
                                               Text="Abilities"/>
                                    </Grid>

                                    <CollectionView Grid.Row="1"
                                                    ItemsSource="{Binding RaceSubtypeLevelRows}"
                                                    SelectionMode="None"
                                                    IsVisible="{Binding ShowRaceSubtypeLifeScale}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="50,60,*,*"
                                                      ColumnSpacing="8"
                                                      Padding="0,2">
                                                    <Label Text="{Binding Level}"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Body}"/>
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Loc}"/>
                                                    <Label Grid.Column="3"
                                                           Text="{Binding Abilities}"
                                                           LineBreakMode="WordWrap"
                                                           Opacity="0.85"/>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <CollectionView Grid.Row="1"
                                                    ItemsSource="{Binding RaceSubtypeLevelRows}"
                                                    SelectionMode="None"
                                                    IsVisible="{Binding HideRaceSubtypeLifeScale}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="50,*"
                                                      ColumnSpacing="8"
                                                      Padding="0,2">
                                                    <Label Text="{Binding Level}"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Abilities}"
                                                           LineBreakMode="WordWrap"
                                                           Opacity="0.85"/>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding MappedSpecialisations}"
                    Spacing="12"
                    IsVisible="{Binding HasMappedSpecialisations}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="0"
                                   CornerRadius="12"
                                   HasShadow="False">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding CardState}"
                                                 Value="Neutral">
                                        <Setter Property="BorderColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBorderNeutralLight}, Dark={StaticResource CardBorderNeutralDark}}"/>
                                        <Setter Property="BackgroundColor"
                                                Value="Transparent"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding CardState}"
                                                 Value="Success">
                                        <Setter Property="BorderColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBorderSuccessLight}, Dark={StaticResource CardBorderSuccessDark}}"/>
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBgSuccessLight}, Dark={StaticResource CardBgSuccessDark}}"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding CardState}"
                                                 Value="Error">
                                        <Setter Property="BorderColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBorderErrorLight}, Dark={StaticResource CardBorderErrorDark}}"/>
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBgErrorLight}, Dark={StaticResource CardBgErrorDark}}"/>
                                    </DataTrigger>
                                </Frame.Triggers>

                                <VerticalStackLayout Spacing="0">

                                    <Grid Padding="12"
                                          ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto">
                                        <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"/>

                                        <Label Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding StatusText}"
                                               Opacity="0.75"/>

                                        <Label Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Subtitle}"
                                               Opacity="0.75"
                                               LineBreakMode="WordWrap"/>
                                    </Grid>

                                    <BoxView HeightRequest="1"
                                             Opacity="0.25"/>

                                    <VerticalStackLayout Padding="12"
                                                         Spacing="10">

                                        <controls:ChipGroup
                                            Items="{Binding Options}"
                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"/>

                                        <VerticalStackLayout Spacing="8"
                                                             IsVisible="{Binding HasSelection}">

                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <Label Text="Level progression"
                                                       FontAttributes="Bold"/>
                                                <Button Text="{Binding LevelsExpanded, Converter={StaticResource ChevronConverter}}"
                                                        Command="{Binding ToggleLevelsCommand}"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                        Padding="0"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        HorizontalOptions="End"/>
                                            </Grid>

                                            <Grid IsVisible="{Binding LevelsExpanded}"
                                                  RowSpacing="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0"
                                                      ColumnDefinitions="50,*"
                                                      ColumnSpacing="8"
                                                      Opacity="0.7">
                                                    <Label Text="Lvl"/>
                                                    <Label Grid.Column="1"
                                                           Text="Abilities"/>
                                                </Grid>

                                                <CollectionView Grid.Row="1"
                                                                ItemsSource="{Binding LevelRows}"
                                                                SelectionMode="None">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="50,*"
                                                                  ColumnSpacing="8"
                                                                  Padding="0,2">
                                                                <Label Text="{Binding Level}"/>
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding Abilities}"
                                                                       LineBreakMode="WordWrap"
                                                                       Opacity="0.85"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>
                                            </Grid>

                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>


                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Groups}"
                    Spacing="12"
                    IsVisible="{Binding HasChoices}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="0"
                                   CornerRadius="12"
                                   HasShadow="False">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding CardState}"
                                                 Value="Neutral">
                                        <Setter Property="BorderColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBorderNeutralLight}, Dark={StaticResource CardBorderNeutralDark}}"/>
                                        <Setter Property="BackgroundColor"
                                                Value="Transparent"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding CardState}"
                                                 Value="Success">
                                        <Setter Property="BorderColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBorderSuccessLight}, Dark={StaticResource CardBorderSuccessDark}}"/>
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBgSuccessLight}, Dark={StaticResource CardBgSuccessDark}}"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding CardState}"
                                                 Value="Error">
                                        <Setter Property="BorderColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBorderErrorLight}, Dark={StaticResource CardBorderErrorDark}}"/>
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource CardBgErrorLight}, Dark={StaticResource CardBgErrorDark}}"/>
                                    </DataTrigger>
                                </Frame.Triggers>

                                <VerticalStackLayout Spacing="0">

                                    <Grid
                                        Padding="12"
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/>
                                        </Grid.GestureRecognizers>

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation"/>

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding StatusText}"
                                            Opacity="0.75"/>

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding Subtitle}"
                                            Opacity="0.75"
                                            LineBreakMode="WordWrap"/>
                                    </Grid>

                                    <BoxView HeightRequest="1"
                                             Opacity="0.25"
                                             IsVisible="{Binding IsExpanded}"/>

                                    <VerticalStackLayout
                                        Padding="12"
                                        Spacing="10"
                                        IsVisible="{Binding IsExpanded}">

                                        <Label
                                            Text="{Binding HelperText}"
                                            Opacity="0.75"
                                            LineBreakMode="WordWrap"/>

                                        <CollectionView ItemsSource="{Binding Slots}"
                                                        SelectionMode="None"
                                                        HorizontalOptions="FillAndExpand">
                                            <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*"
                                                          Padding="0,6">
                                                            <Label Text="{Binding LevelLabel}"
                                                                   VerticalOptions="Center"
                                                                   Opacity="0.85"/>

                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Spacing="6">
                                                                <Picker
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Title="Select an ability"
                                                                    ItemsSource="{Binding FilteredOptionNames}"
                                                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                                                                    <Picker.Triggers>
                                                                        <DataTrigger TargetType="Picker"
                                                                                     Binding="{Binding UseWardPactEnum}"
                                                                                     Value="True">
                                                                            <Setter Property="IsVisible"
                                                                                    Value="False"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Picker"
                                                                                     Binding="{Binding UseMagicColourEnum}"
                                                                                     Value="True">
                                                                            <Setter Property="IsVisible"
                                                                                    Value="False"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Picker"
                                                                                     Binding="{Binding UseVivomancerColourEnum}"
                                                                                     Value="True">
                                                                            <Setter Property="IsVisible"
                                                                                    Value="False"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Picker"
                                                                                     Binding="{Binding UseDictionarySearch}"
                                                                                     Value="True">
                                                                            <Setter Property="IsVisible"
                                                                                    Value="False"/>
                                                                        </DataTrigger>
                                                                    </Picker.Triggers>
                                                                </Picker>

                                                                <controls:ChipGroup Items="{Binding FilteredOptionNames}"
                                                                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                                    IsVisible="{Binding UseVivomancerColourEnum}"
                                                                                    HorizontalOptions="FillAndExpand"/>

                                                                <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                                              ItemsSource="{Binding SearchOptions}"
                                                                                              SelectedText="{Binding SelectedOption, Mode=TwoWay}"
                                                                                              PlaceholderText="Search abilities"
                                                                                              AllowCustomOptions="False"
                                                                                              HorizontalOptions="FillAndExpand"
                                                                                              IsVisible="{Binding UseDictionarySearch}"/>

                                                                <controls:DictionarySearchBar x:TypeArguments="enums:MagicColours"
                                                                                              ItemsSource="{Binding MagicColourOptions}"
                                                                                              SelectedValue="{Binding SelectedMagicColour, Mode=TwoWay}"
                                                                                              PlaceholderText="Select a wizard colour"
                                                                                              AllowCustomOptions="False"
                                                                                              HorizontalOptions="FillAndExpand"
                                                                                              IsVisible="{Binding UseMagicColourEnum}"/>

                                                                <controls:DictionarySearchBar x:TypeArguments="enums:VivomancerColours"
                                                                                              ItemsSource="{Binding VivomancerColourOptions}"
                                                                                              SelectedValue="{Binding SelectedVivomancerColour, Mode=TwoWay}"
                                                                                              PlaceholderText="Select a vivomancer colour"
                                                                                              AllowCustomOptions="False"
                                                                                              HorizontalOptions="FillAndExpand"
                                                                                              IsVisible="{Binding UseVivomancerColourEnum}"/>

                                                                <controls:DictionarySearchBar x:TypeArguments="enums:StandardWardPacts"
                                                                                              ItemsSource="{x:Static pickers:WardPactOptions.Standard}"
                                                                                              SelectedValue="{Binding SelectedWardPact, Mode=TwoWay}"
                                                                                              PlaceholderText="Select a ward pact"
                                                                                              AllowCustomOptions="False"
                                                                                              HorizontalOptions="FillAndExpand"
                                                                                              IsVisible="{Binding UseWardPactEnum}"/>
                                                            </VerticalStackLayout>
                                                        </Grid>

                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>

                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentView>
