<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.CharacterSpecialisation"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:pages="clr-namespace:labyItems.Pages.Characters">

    <ContentView.Resources>
        <Color x:Key="CardBorderNeutralLight">#E0E0E0</Color>
        <Color x:Key="CardBorderSuccessLight">#2E7D32</Color>
        <Color x:Key="CardBorderIssueLight">#F9A825</Color>
        <Color x:Key="CardBorderErrorLight">#C62828</Color>
        <Color x:Key="CardBgSuccessLight">#E8F5E9</Color>
        <Color x:Key="CardBgIssueLight">#FFF8E1</Color>
        <Color x:Key="CardBgErrorLight">#FFEBEE</Color>

        <DataTemplate x:Key="MappedSectionTemplate">
            <Frame Padding="0"
                   IsVisible="{Binding IsVisible}"
                   CornerRadius="12"
                   HasShadow="False">
                <Frame.Triggers>
                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Neutral">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderNeutralLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="Transparent"/>
                    </DataTrigger>

                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Success">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderSuccessLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgSuccessLight}"/>
                    </DataTrigger>

                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Issue">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderIssueLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgIssueLight}"/>
                    </DataTrigger>

                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Error">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderErrorLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgErrorLight}"/>
                    </DataTrigger>
                </Frame.Triggers>

                <VerticalStackLayout Spacing="0">
                    <Grid Padding="12"
                          ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/>
                        </Grid.GestureRecognizers>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding Title}"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"/>

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding StatusText}"
                               Opacity="0.75"/>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="{Binding DisplaySubtitle}"
                               Opacity="0.75"
                               LineBreakMode="WordWrap"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Opacity="0.25"
                             IsVisible="{Binding IsExpanded}"/>

                    <VerticalStackLayout Padding="12"
                                         Spacing="10"
                                         IsVisible="{Binding IsExpanded}">
                        <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout"
                                             Binding="{Binding UseSingleOptionToggle}"
                                             Value="False">
                                    <Setter Property="IsVisible"
                                            Value="False"/>
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <CheckBox IsChecked="{Binding SingleOptionEnabled, Mode=TwoWay}"
                                      VerticalOptions="Center"/>
                            <Label Text="{Binding SingleOptionLabel}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <controls:ChipGroup
                            Items="{Binding Options}"
                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                            <controls:ChipGroup.Triggers>
                                <DataTrigger TargetType="controls:ChipGroup"
                                             Binding="{Binding UseSingleOptionToggle}"
                                             Value="True">
                                    <Setter Property="IsVisible"
                                            Value="False"/>
                                </DataTrigger>
                            </controls:ChipGroup.Triggers>
                        </controls:ChipGroup>

                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding HasSelection}">
                            <Grid ColumnDefinitions="72,*,24"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding AbilityRows.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                  Opacity="0.7">
                                <Label Text="Lvl"/>
                                <Label Grid.Column="1"
                                       Text="Ability"/>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AbilityRows}"
                                                 IsVisible="False"
                                                 Spacing="2">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout"
                                                 Binding="{Binding AbilityRows.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                                 Value="True">
                                        <Setter Property="IsVisible"
                                                Value="True"/>
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="72,*,24"
                                              ColumnSpacing="8"
                                              Padding="0,2">
                                            <Label Text="{Binding LevelText}"
                                                   Opacity="0.85"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Ability}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   Opacity="0.85"/>
                                            <Button Grid.Column="2"
                                                    Text="&#xF05A;"
                                                    FontFamily="FASolid"
                                                    FontSize="12"
                                                    Padding="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource SubtleTextColor}"
                                                    HeightRequest="18"
                                                    WidthRequest="18"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={x:Reference Root}, Path=ViewSpecialisationRowDetailsCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="No abilities available for this selection."
                                   Opacity="0.75">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding AbilityRows.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                                 Value="True">
                                        <Setter Property="IsVisible"
                                                Value="False"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceSectionTemplate">
            <Frame Padding="0"
                   IsVisible="{Binding IsVisible}"
                   CornerRadius="12"
                   HasShadow="False">
                <Frame.Triggers>
                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Neutral">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderNeutralLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="Transparent"/>
                    </DataTrigger>

                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Success">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderSuccessLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgSuccessLight}"/>
                    </DataTrigger>

                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Issue">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderIssueLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgIssueLight}"/>
                    </DataTrigger>

                    <DataTrigger TargetType="Frame"
                                 Binding="{Binding CardStateText}"
                                 Value="Error">
                        <Setter Property="BorderColor"
                                Value="{StaticResource CardBorderErrorLight}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource CardBgErrorLight}"/>
                    </DataTrigger>
                </Frame.Triggers>

                <VerticalStackLayout Spacing="0">
                    <Grid Padding="12"
                          ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/>
                        </Grid.GestureRecognizers>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding Title}"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"/>

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding StatusText}"
                               Opacity="0.75"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Opacity="0.25"
                             IsVisible="{Binding IsExpanded}"/>

                    <VerticalStackLayout Padding="12"
                                         Spacing="10"
                                         IsVisible="{Binding IsExpanded}">
                        <Label Text="{Binding DisplaySubtitle}"
                               Opacity="0.75"
                               LineBreakMode="WordWrap"/>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Slots}"
                                             Spacing="0"
                                             HorizontalOptions="FillAndExpand">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10"
                                          Padding="0,6">
                                        <Label Text="{Binding LevelLabel}"
                                               VerticalOptions="Center"
                                               Opacity="0.85"/>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="6">
                                            <Label Text="{Binding LockedDisplayText}"
                                                   Opacity="0.8"
                                                   IsVisible="{Binding IsLocked}"/>

                                            <VerticalStackLayout Spacing="6"
                                                                 IsVisible="{Binding IsSelectable}">
                                                <Picker HorizontalOptions="FillAndExpand"
                                                        Title="Select an ability"
                                                        ItemsSource="{Binding FilteredOptionNames}"
                                                        SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                                                    <Picker.Triggers>
                                                        <DataTrigger TargetType="Picker"
                                                                     Binding="{Binding UseWardPactEnum}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Picker"
                                                                     Binding="{Binding UseMagicColourEnum}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Picker"
                                                                     Binding="{Binding UseVivomancerColourEnum}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Picker"
                                                                     Binding="{Binding UseDictionarySearch}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Picker"
                                                                     Binding="{Binding HideAbilityPicker}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Picker"
                                                                     Binding="{Binding ShowCustomisationInline}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                    </Picker.Triggers>
                                                </Picker>

                                                <Grid ColumnDefinitions="0.46*,0.54*"
                                                      ColumnSpacing="8"
                                                      IsVisible="{Binding ShowCustomisationInline}">
                                                    <Picker Grid.Column="0"
                                                            HorizontalOptions="FillAndExpand"
                                                            Title="Select an ability"
                                                            ItemsSource="{Binding FilteredOptionNames}"
                                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                                                        <Picker.Triggers>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseWardPactEnum}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseMagicColourEnum}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseVivomancerColourEnum}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding UseDictionarySearch}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Picker"
                                                                         Binding="{Binding HideAbilityPicker}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible"
                                                                        Value="False"/>
                                                            </DataTrigger>
                                                        </Picker.Triggers>
                                                    </Picker>

                                                    <controls:DictionarySearchBar Grid.Column="1"
                                                                                  x:TypeArguments="x:String"
                                                                                  ItemsSource="{Binding CustomisationOptions}"
                                                                                  SelectedText="{Binding CustomisationValue, Mode=TwoWay}"
                                                                                  PlaceholderText="{Binding CustomisationPlaceholder}"
                                                                                  AllowCustomOptions="{Binding CustomisationAllowsCustom}"
                                                                                  HorizontalOptions="FillAndExpand"/>
                                                </Grid>

                                                <controls:ChipGroup Items="{Binding FilteredOptionNames}"
                                                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                    IsVisible="{Binding UseVivomancerColourEnum}"
                                                                    HorizontalOptions="FillAndExpand"/>

                                                <VerticalStackLayout Spacing="6"
                                                                     IsVisible="{Binding UseDictionarySearch}">
                                                    <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                                  ItemsSource="{Binding SearchOptions}"
                                                                                  SelectedText="{Binding SelectedOption, Mode=TwoWay}"
                                                                                  PlaceholderText="Search abilities"
                                                                                  AllowCustomOptions="False"
                                                                                  HorizontalOptions="FillAndExpand"/>

                                                    <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                                  ItemsSource="{Binding CustomisationOptions}"
                                                                                  SelectedText="{Binding CustomisationValue, Mode=TwoWay}"
                                                                                  PlaceholderText="{Binding CustomisationPlaceholder}"
                                                                                  AllowCustomOptions="{Binding CustomisationAllowsCustom}"
                                                                                  HorizontalOptions="FillAndExpand"
                                                                                  IsVisible="{Binding ShowCustomisationPicker}"/>
                                                </VerticalStackLayout>

                                                <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                              ItemsSource="{Binding SearchOptions}"
                                                                              SelectedText="{Binding SelectedOption, Mode=TwoWay}"
                                                                              PlaceholderText="choose a colour of magic"
                                                                              AllowCustomOptions="False"
                                                                              HorizontalOptions="FillAndExpand"
                                                                              IsVisible="{Binding UseMagicColourEnum}"/>

                                                <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                              ItemsSource="{Binding CustomisationOptions}"
                                                                              SelectedText="{Binding CustomisationValue, Mode=TwoWay}"
                                                                              PlaceholderText="{Binding CustomisationPlaceholder}"
                                                                              AllowCustomOptions="{Binding CustomisationAllowsCustom}"
                                                                              HorizontalOptions="FillAndExpand"
                                                                              IsVisible="{Binding ShowCustomisationBelow}">
                                                    <controls:DictionarySearchBar.Triggers>
                                                        <DataTrigger TargetType="ContentView"
                                                                     Binding="{Binding UseDictionarySearch}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible"
                                                                    Value="False"/>
                                                        </DataTrigger>
                                                    </controls:DictionarySearchBar.Triggers>
                                                </controls:DictionarySearchBar>

                                                <controls:DictionarySearchBar x:TypeArguments="x:String"
                                                                              ItemsSource="{Binding SearchOptions}"
                                                                              SelectedText="{Binding SelectedOption, Mode=TwoWay}"
                                                                              PlaceholderText="choose a ward pact"
                                                                              AllowCustomOptions="False"
                                                                              HorizontalOptions="FillAndExpand"
                                                                              IsVisible="{Binding UseWardPactEnum}"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <Button Grid.Column="2"
                                                Text="&#xF05A;"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource SubtleTextColor}"
                                                HeightRequest="18"
                                                WidthRequest="18"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                Margin="6,0,0,0"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding HasSelectedAbilityForDetails}"
                                                Command="{Binding Source={x:Reference Root}, Path=ViewSpecialisationAbilityDetailsCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding HasSelectedOptionAbilityRows}">
                            <Grid ColumnDefinitions="*,24"
                                  ColumnSpacing="8"
                                  Opacity="0.7">
                                <Label Text="Ability"/>
                                <Label Grid.Column="1"
                                       Text="Info"
                                       HorizontalTextAlignment="Center"/>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedOptionAbilityRows}"
                                                 Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,24"
                                              ColumnSpacing="8"
                                              Padding="0,2">
                                            <Label Text="{Binding Ability}"
                                                   Opacity="0.85"
                                                   LineBreakMode="WordWrap"/>
                                            <Button Grid.Column="1"
                                                    Text="&#xF05A;"
                                                    FontFamily="FASolid"
                                                    FontSize="12"
                                                    Padding="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource SubtleTextColor}"
                                                    HeightRequest="18"
                                                    WidthRequest="18"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={x:Reference Root}, Path=ViewSpecialisationRowDetailsCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </DataTemplate>

        <pages:SpecialisationSectionTemplateSelector x:Key="SectionTemplateSelector"
                                                    ChoiceTemplate="{StaticResource ChoiceSectionTemplate}"
                                                    MappedTemplate="{StaticResource MappedSectionTemplate}"/>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="12">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <Frame Padding="12"
                       CornerRadius="12"
                       HasShadow="False"
                       BorderColor="{StaticResource CardBorderNeutralLight}"
                       IsVisible="{Binding HasNoChoices}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="No specialisation choices required."
                               FontAttributes="Bold"/>
                        <Label Text="If your race or class grants specialisations, they will appear here."
                               Opacity="0.75"/>
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplateSelector>
                        <StaticResource Key="SectionTemplateSelector"/>
                    </BindableLayout.ItemTemplateSelector>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
