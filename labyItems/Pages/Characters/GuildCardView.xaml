<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.GuildCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <Frame x:Name="CardFrame"
           Padding="12"
           Margin="0,0,0,12"
           CornerRadius="14"
           HasShadow="True">
        <Frame.Triggers>
            <DataTrigger TargetType="Frame"
                         Binding="{Binding IsSelected}"
                         Value="True">
                <Setter Property="HasShadow"
                        Value="True"/>
                <Setter Property="BorderColor"
                        Value="{StaticResource AccentMaroonColor}"/>
                <Setter Property="BackgroundColor"
                        Value="{StaticResource SelectedSurfaceBackgroundColor}"/>
            </DataTrigger>
            <DataTrigger TargetType="Frame"
                         Binding="{Binding CanToggleSelection}"
                         Value="False">
                <Setter Property="HasShadow"
                        Value="False"/>
                <Setter Property="BorderColor"
                        Value="{StaticResource SoftStrokeColor}"/>
                <Setter Property="BackgroundColor"
                        Value="#E5E7EB"/>
            </DataTrigger>
        </Frame.Triggers>

        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="10">

            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,10,*,Auto"
                  VerticalOptions="Center">
                <Grid Grid.Column="0"
                      WidthRequest="28"
                      HeightRequest="28">
                    <Label Text="{Binding Icon}"
                           FontSize="18"
                              IsVisible="{Binding ShowIcon}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                    <Image Source="{Binding Logo}"
                           Aspect="AspectFill"
                           WidthRequest="28"
                           HeightRequest="28"
                              IsVisible="{Binding ShowLogo}"/>
                </Grid>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="2">
                    <Label Text="{Binding Name}"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding Type}"
                           Opacity="0.7"
                           FontSize="12"/>
                    <Label Text="{Binding ChoiceSetNoticeText}"
                           Opacity="0.9"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentMaroonColor}"
                           IsVisible="{Binding HasAnyChoiceOptions}"/>
                    <Label Text="{Binding NotSelectableReason}"
                           Opacity="0.8"
                           FontSize="11"
                           TextColor="{StaticResource MutedTextColor}"
                           IsVisible="{Binding HasNotSelectableReason}"/>
                </VerticalStackLayout>

                <controls:ChevronIconView Grid.Column="3"
                                          IsExpanded="{Binding IsExpanded}"
                                          AnimateRotation="True"
                                          GlyphColor="{StaticResource MutedTextColor}"
                                          VerticalOptions="Center"
                                          HorizontalOptions="End">
                    <controls:ChevronIconView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=ToggleExpandedCommand}"
                                              CommandParameter="{Binding .}" />
                    </controls:ChevronIconView.GestureRecognizers>
                </controls:ChevronIconView>

                <BoxView Grid.Column="0"
                         Grid.ColumnSpan="3"
                         BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=SelectCommand}"
                            CommandParameter="{Binding .}"/>
                    </BoxView.GestureRecognizers>
                </BoxView>

            </Grid>

            <!-- Expanded -->
            <VerticalStackLayout x:Name="ExpandedContent"
                                 Grid.Row="1"
                                 IsVisible="False"
                                 Spacing="10">
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding IsDetailsLoading}">
                    <Border Stroke="{StaticResource SoftStrokeColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"
                            Padding="12">
                        <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsDetailsLoading}"
                                               Color="{StaticResource Primary}" />
                            <Label Text="Loading guild details..."
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding DetailsLoaded}">

                    <!-- Lore -->
                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding HasLore}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LoreSections}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="3">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleCommand}"/>
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Header}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.85"/>
                                    <Label Text="{Binding Text}"
                                           FontSize="13"
                                           Opacity="0.85"
                                           MaxLines="{Binding MaxLines}"/>
                                    <Label Text="{Binding ToggleLabel}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           IsVisible="{Binding ShowToggle}"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Miracle list -->
                    <VerticalStackLayout Spacing="6"
                                         IsVisible="{Binding HasMiracles}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="MIRACLE LIST"
                               FontAttributes="Bold"
                               FontSize="12"
                               Opacity="0.85"
                               VerticalOptions="Center"/>
                        <controls:ChevronIconView Grid.Column="1"
                                                  IsExpanded="{Binding IsMiracleListExpanded}"
                                                  AnimateRotation="True"
                                                  GlyphSize="14"
                                                  IconSize="28"
                                                  GlyphColor="{StaticResource MutedTextColor}"
                                                  HorizontalOptions="End"
                                                  VerticalOptions="Center">
                            <controls:ChevronIconView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMiracleListCommand}" />
                            </controls:ChevronIconView.GestureRecognizers>
                        </controls:ChevronIconView>
                    </Grid>
                    <controls:AnimatedExpandView IsExpanded="{Binding IsMiracleListExpanded}"
                                                 AnimationName="GuildMiracleListExpand">
                        <Border Stroke="{StaticResource SoftStrokeColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F9FAFB"
                                Padding="8">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="6">
                                <Grid ColumnDefinitions="44,*,Auto"
                                      ColumnSpacing="8"
                                      Padding="6,2">
                                    <Label Text="Lvl"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Grid.Column="1"
                                           Text="Name"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Grid.Column="2"
                                           Text="Info"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"
                                           HorizontalTextAlignment="Center"/>
                                </Grid>
                                <VerticalStackLayout Grid.Row="1"
                                                     BindableLayout.ItemsSource="{Binding MiracleRows}"
                                                     Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{Binding RowBackgroundColor}">
                                                <Grid Padding="8,6"
                                                      ColumnDefinitions="44,*,Auto"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding LevelText}"
                                                           FontSize="13"
                                                           Opacity="0.85"
                                                           VerticalTextAlignment="Center"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="13"
                                                           VerticalTextAlignment="Center"/>
                                                    <Button Grid.Column="2"
                                                            Text="&#xF05A;"
                                                            FontFamily="FASolid"
                                                            FontSize="12"
                                                            Padding="0"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource SubtleTextColor}"
                                                            HeightRequest="18"
                                                            WidthRequest="18"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            VerticalOptions="Center"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=GuildMiracleInfoCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </controls:AnimatedExpandView>
                    </VerticalStackLayout>

                <!-- Denominational miracle -->
                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding HasDenominationalMiracle}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="DENOMINATIONAL MIRACLE"
                               FontAttributes="Bold"
                               FontSize="12"
                               Opacity="0.85"
                               VerticalOptions="Center"/>
                        <controls:ChevronIconView Grid.Column="1"
                                                  IsExpanded="{Binding IsDenominationalMiracleExpanded}"
                                                  AnimateRotation="True"
                                                  GlyphSize="14"
                                                  IconSize="28"
                                                  GlyphColor="{StaticResource MutedTextColor}"
                                                  HorizontalOptions="End"
                                                  VerticalOptions="Center">
                            <controls:ChevronIconView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDenominationalMiracleCommand}" />
                            </controls:ChevronIconView.GestureRecognizers>
                        </controls:ChevronIconView>
                    </Grid>
                    <controls:AnimatedExpandView IsExpanded="{Binding IsDenominationalMiracleExpanded}"
                                                 AnimationName="GuildDenominationalMiracleExpand">
                        <Border Stroke="{StaticResource SoftStrokeColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F9FAFB"
                                Padding="10">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding DenominationalMiracle.Note}"
                                       IsVisible="{Binding DenominationalMiracle.HasNote}"
                                       FontSize="13"
                                       Opacity="0.85"/>

                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="2">
                                    <Label Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Name"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding DenominationalMiracle.Name}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Cost"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Alignment"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Grid.Row="2"
                                           Grid.Column="2"
                                           Text="Duration"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Grid.Row="2"
                                           Grid.Column="3"
                                           Text="Range"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>

                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{Binding DenominationalMiracle.Cost}"
                                           FontSize="13"/>
                                    <Label Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding DenominationalMiracle.Alignment}"
                                           FontSize="13"/>
                                    <Label Grid.Row="3"
                                           Grid.Column="2"
                                           Text="{Binding DenominationalMiracle.Duration}"
                                           FontSize="13"/>
                                    <Label Grid.Row="3"
                                           Grid.Column="3"
                                           Text="{Binding DenominationalMiracle.Range}"
                                           FontSize="13"/>
                                </Grid>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Description"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Text="{Binding DenominationalMiracle.Description}"
                                           FontSize="13"
                                           Opacity="0.85"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Verbal"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           Opacity="0.75"/>
                                    <Label Text="{Binding DenominationalMiracle.Verbal}"
                                           FontSize="13"
                                           Opacity="0.85"/>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Sphere"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               Opacity="0.75"/>
                                        <Label Text="{Binding DenominationalMiracle.Sphere}"
                                               FontSize="13"
                                               Opacity="0.85"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2">
                                        <Label Text="Gesture"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               Opacity="0.75"/>
                                        <Label Text="{Binding DenominationalMiracle.Gesture}"
                                               FontSize="13"
                                               Opacity="0.85"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="2">
                                        <Label Text="IsAdvanced"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               Opacity="0.75"/>
                                        <Label Text="{Binding DenominationalMiracle.IsAdvancedText}"
                                               FontSize="13"
                                               Opacity="0.85"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </controls:AnimatedExpandView>
                </VerticalStackLayout>

                <!-- Benefits -->
                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding HasAnyBenefits}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="BENEFITS"
                               FontAttributes="Bold"
                               FontSize="12"
                               Opacity="0.85"
                               VerticalOptions="Center"/>
                        <controls:ChevronIconView Grid.Column="1"
                                                  IsExpanded="{Binding IsBenefitsExpanded}"
                                                  AnimateRotation="True"
                                                  GlyphSize="14"
                                                  IconSize="28"
                                                  GlyphColor="{StaticResource MutedTextColor}"
                                                  HorizontalOptions="End"
                                                  VerticalOptions="Center">
                            <controls:ChevronIconView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleBenefitsCommand}" />
                            </controls:ChevronIconView.GestureRecognizers>
                        </controls:ChevronIconView>
                    </Grid>
                    <controls:AnimatedExpandView IsExpanded="{Binding IsBenefitsExpanded}"
                                                 AnimationName="GuildBenefitsExpand">
                        <VerticalStackLayout Spacing="6">
                            <VerticalStackLayout Spacing="4"
                                                 IsVisible="{Binding HasBasic}">
                                <Label Text="Basic"
                                       FontAttributes="Bold"
                                       Opacity="0.85"/>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BasicBenefitRows}"
                                                     Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="0"
                                                                 BackgroundColor="{Binding RowBackgroundColor}">
                                                <Grid Padding="10,8"
                                                      ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding DisplayText}"
                                                           FontSize="13"
                                                           LineBreakMode="WordWrap"
                                                           VerticalTextAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Text="&#xF05A;"
                                                            FontFamily="FASolid"
                                                            FontSize="12"
                                                            Padding="0"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource SubtleTextColor}"
                                                            HeightRequest="18"
                                                            WidthRequest="18"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding HasDetails}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=GuildBenefitInfoCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ChildRows}"
                                                                     IsVisible="{Binding HasChildRows}"
                                                                     Spacing="0"
                                                                     Padding="0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="22,0,10,0"
                                                                  ColumnDefinitions="18,*"
                                                                  ColumnSpacing="8">
                                                                <Label Text="└"
                                                                       FontSize="12"
                                                                       Opacity="0.55"
                                                                       VerticalTextAlignment="Center"/>
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding Text}"
                                                                       FontSize="13"
                                                                       LineBreakMode="WordWrap"
                                                                       VerticalTextAlignment="Center"
                                                                       Padding="0,6,0,6">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label"
                                                                                     Binding="{Binding IsSelected}"
                                                                                     Value="True">
                                                                            <Setter Property="TextColor"
                                                                                    Value="{StaticResource AccentMaroonColor}"/>
                                                                            <Setter Property="FontAttributes"
                                                                                    Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4"
                                                 IsVisible="{Binding HasIntermediate}">
                                <Label Text="Intermediate"
                                       FontAttributes="Bold"
                                       Opacity="0.85"/>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding IntermediateBenefitRows}"
                                                     Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="0"
                                                                 BackgroundColor="{Binding RowBackgroundColor}">
                                                <Grid Padding="10,8"
                                                      ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding DisplayText}"
                                                           FontSize="13"
                                                           LineBreakMode="WordWrap"
                                                           VerticalTextAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Text="&#xF05A;"
                                                            FontFamily="FASolid"
                                                            FontSize="12"
                                                            Padding="0"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource SubtleTextColor}"
                                                            HeightRequest="18"
                                                            WidthRequest="18"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding HasDetails}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=GuildBenefitInfoCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ChildRows}"
                                                                     IsVisible="{Binding HasChildRows}"
                                                                     Spacing="0"
                                                                     Padding="0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="22,0,10,0"
                                                                  ColumnDefinitions="18,*"
                                                                  ColumnSpacing="8">
                                                                <Label Text="└"
                                                                       FontSize="12"
                                                                       Opacity="0.55"
                                                                       VerticalTextAlignment="Center"/>
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding Text}"
                                                                       FontSize="13"
                                                                       LineBreakMode="WordWrap"
                                                                       VerticalTextAlignment="Center"
                                                                       Padding="0,6,0,6">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label"
                                                                                     Binding="{Binding IsSelected}"
                                                                                     Value="True">
                                                                            <Setter Property="TextColor"
                                                                                    Value="{StaticResource AccentMaroonColor}"/>
                                                                            <Setter Property="FontAttributes"
                                                                                    Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4"
                                                 IsVisible="{Binding HasAdvanced}">
                                <Label Text="Advanced"
                                       FontAttributes="Bold"
                                       Opacity="0.85"/>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvancedBenefitRows}"
                                                     Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="0"
                                                                 BackgroundColor="{Binding RowBackgroundColor}">
                                                <Grid Padding="10,8"
                                                      ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding DisplayText}"
                                                           FontSize="13"
                                                           LineBreakMode="WordWrap"
                                                           VerticalTextAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Text="&#xF05A;"
                                                            FontFamily="FASolid"
                                                            FontSize="12"
                                                            Padding="0"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource SubtleTextColor}"
                                                            HeightRequest="18"
                                                            WidthRequest="18"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding HasDetails}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=GuildBenefitInfoCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ChildRows}"
                                                                     IsVisible="{Binding HasChildRows}"
                                                                     Spacing="0"
                                                                     Padding="0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="22,0,10,0"
                                                                  ColumnDefinitions="18,*"
                                                                  ColumnSpacing="8">
                                                                <Label Text="└"
                                                                       FontSize="12"
                                                                       Opacity="0.55"
                                                                       VerticalTextAlignment="Center"/>
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding Text}"
                                                                       FontSize="13"
                                                                       LineBreakMode="WordWrap"
                                                                       VerticalTextAlignment="Center"
                                                                       Padding="0,6,0,6">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label"
                                                                                     Binding="{Binding IsSelected}"
                                                                                     Value="True">
                                                                            <Setter Property="TextColor"
                                                                                    Value="{StaticResource AccentMaroonColor}"/>
                                                                            <Setter Property="FontAttributes"
                                                                                    Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </controls:AnimatedExpandView>
                </VerticalStackLayout>

                    <!-- City benefits -->
                    <VerticalStackLayout Spacing="6"
                                         IsVisible="{Binding HasCityBenefits}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="CITY BENEFITS"
                               FontAttributes="Bold"
                               FontSize="12"
                               Opacity="0.85"
                               VerticalOptions="Center"/>
                        <controls:ChevronIconView Grid.Column="1"
                                                  IsExpanded="{Binding IsCityBenefitsExpanded}"
                                                  AnimateRotation="True"
                                                  GlyphSize="14"
                                                  IconSize="28"
                                                  GlyphColor="{StaticResource MutedTextColor}"
                                                  HorizontalOptions="End"
                                                  VerticalOptions="Center">
                            <controls:ChevronIconView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCityBenefitsCommand}" />
                            </controls:ChevronIconView.GestureRecognizers>
                        </controls:ChevronIconView>
                    </Grid>
                    <controls:AnimatedExpandView IsExpanded="{Binding IsCityBenefitsExpanded}"
                                                 AnimationName="GuildCityBenefitsExpand">
                        <VerticalStackLayout Spacing="6"
                                             BindableLayout.ItemsSource="{Binding CityBenefits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               Opacity="0.9"/>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Effects}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                                           FontSize="13"
                                                           Opacity="0.9"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </controls:AnimatedExpandView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Frame>
</ContentView>
