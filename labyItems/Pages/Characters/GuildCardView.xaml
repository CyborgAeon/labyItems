<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.GuildCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <Frame x:Name="CardFrame"
           Padding="12"
           Margin="0,0,0,12"
           CornerRadius="14"
           HasShadow="True">
        <Frame.Triggers>
            <DataTrigger TargetType="Frame"
                         Binding="{Binding IsSelected}"
                         Value="True">
                <Setter Property="HasShadow"
                        Value="True"/>
                <Setter Property="BorderColor"
                        Value="#7F1D1D"/>
                <Setter Property="BackgroundColor"
                        Value="#FFF7ED"/>
            </DataTrigger>
        </Frame.Triggers>

        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="10">

            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,10,*,Auto,10,Auto"
                  VerticalOptions="Center">

                <Label Grid.Column="0"
                       Text="{Binding Icon}"
                       FontSize="18"
                       VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="2">
                    <Label Text="{Binding Name}"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding Type}"
                           Opacity="0.7"
                           FontSize="12"/>
                </VerticalStackLayout>

                <!-- Selected indicator -->
                <Label Grid.Column="3"
                       Text="Selected"
                       IsVisible="{Binding IsSelected}"
                       FontSize="12"
                       Opacity="0.8"
                       VerticalOptions="Center"/>

                <Button Grid.Column="5"
                        Text="⌄"
                        FontSize="18"
                        Rotation="{Binding ChevronRotation}"
                        BackgroundColor="Transparent"
                        TextColor="#6B7280"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=ToggleExpandedCommand}"
                        CommandParameter="{Binding .}"/>

            </Grid>

            <!-- Expanded -->
            <VerticalStackLayout x:Name="ExpandedContent"
                                 Grid.Row="1"
                                 IsVisible="False"
                                 Spacing="10">

                <!-- Restrictions -->
                <VerticalStackLayout Spacing="4"
                                     IsVisible="{Binding HasRestrictions}">
                    <Label Text="Restrictions"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding Restrictions}"
                           FontSize="13"
                           Opacity="0.85"/>
                </VerticalStackLayout>

                <!-- Benefits -->
                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding HasAnyBenefits}">
                    <Label Text="Benefits"
                           FontAttributes="Bold"/>

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HasBasic}">
                        <Label Text="Basic"
                               FontAttributes="Bold"
                               Opacity="0.85"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding BasicBenefits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                           FontSize="13"
                                           Opacity="0.9"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding HasBasicOptions}"
                                             BindableLayout.ItemsSource="{Binding BasicOptionGroups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="4">
                                        <controls:ChipGroup Items="{Binding OptionLabels}"
                                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"/>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedLines}"
                                                             IsVisible="{Binding HasSelection}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                                           FontSize="13"
                                                           Opacity="0.8"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HasIntermediate}">
                        <Label Text="Intermediate"
                               FontAttributes="Bold"
                               Opacity="0.85"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding IntermediateBenefits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                           FontSize="13"
                                           Opacity="0.9"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding HasIntermediateOptions}"
                                             BindableLayout.ItemsSource="{Binding IntermediateOptionGroups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="4">
                                        <controls:ChipGroup Items="{Binding OptionLabels}"
                                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"/>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedLines}"
                                                             IsVisible="{Binding HasSelection}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                                           FontSize="13"
                                                           Opacity="0.8"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HasAdvanced}">
                        <Label Text="Advanced"
                               FontAttributes="Bold"
                               Opacity="0.85"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvancedBenefits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                           FontSize="13"
                                           Opacity="0.9"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding HasAdvancedOptions}"
                                             BindableLayout.ItemsSource="{Binding AdvancedOptionGroups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="4">
                                        <controls:ChipGroup Items="{Binding OptionLabels}"
                                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"/>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedLines}"
                                                             IsVisible="{Binding HasSelection}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                                           FontSize="13"
                                                           Opacity="0.8"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Miracle list -->
                <CollectionView
                    IsVisible="{Binding HasMiracles}"
                    ItemsSource="{Binding MiracleRows}"
                    SelectionMode="None">
                    <CollectionView.Header>
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="6">
                            <Label Text="Miracle List"
                                   FontAttributes="Bold"/>
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="50,*"
                                  ColumnSpacing="8"
                                  Opacity="0.7">
                                <Label Text="Lvl"/>
                                <Label Grid.Column="1"
                                       Text="Miracles"/>
                            </Grid>
                        </Grid>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="50,*"
                                  ColumnSpacing="8"
                                  Padding="0,2">
                                <Label Text="{Binding Level}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding Miracles}"
                                       Opacity="0.8"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>
        <Frame.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={RelativeSource AncestorType={x:Type local:GuildCardView}}, Path=SelectCommand}"
                CommandParameter="{Binding .}"/>
        </Frame.GestureRecognizers>
    </Frame>
</ContentView>
