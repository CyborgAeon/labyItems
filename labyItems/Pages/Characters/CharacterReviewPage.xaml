<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.CharacterReviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters"
    Title="Character">

    <Grid Padding="0"
          RowDefinitions="*,Auto"
          RowSpacing="12">
        <local:CharacterReviewView x:Name="Review"
                                   Grid.Row="0"
                                   ShowSaveButton="False"/>

        <Button Grid.Row="1"
                Text="Advance character"
                Margin="16,0,16,16"
                Clicked="OnAdvanceClicked"/>
    </Grid>

</ContentPage>
