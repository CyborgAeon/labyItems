<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.CharacterReviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters"
    Title="Character"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid Padding="0">
        <local:CharacterReviewView x:Name="Review"
                                   Margin="0,60,0,0"
                                   ShowSaveButton="False"/>

        <BoxView x:Name="ActionBackdrop"
                 BackgroundColor="#88000000"
                 IsVisible="False"
                 InputTransparent="True"
                 Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnActionBackdropTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="HeaderBar"
              VerticalOptions="Start"
              BackgroundColor="{StaticResource White}"
              Padding="4,6,4,6"
              RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6">
                <ImageButton Grid.Column="0"
                             AutomationProperties.Name="Back"
                             Style="{StaticResource BackArrowImageButtonStyle}"
                             Clicked="OnBackClicked">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="FASolid"
                                         Glyph="&#xf060;"
                                         Size="24"
                                         Color="{StaticResource Gray300}"/>
                    </ImageButton.Source>
                </ImageButton>

                <HorizontalStackLayout x:Name="CollapsedActionIcons"
                                       Grid.Column="1"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center"
                                       Spacing="4">
                    <ImageButton AutomationProperties.Name="Battleboard"
                                 StyleId="character-action-battleboard"
                                 Style="{StaticResource EmojiActionIconButtonStyle}"
                                 Clicked="OnBattleboardClicked">
                        <ImageButton.Source>
                            <FontImageSource Glyph="⚔️" Size="20" Color="Black"/>
                        </ImageButton.Source>
                    </ImageButton>

                    <ImageButton AutomationProperties.Name="Manufacturing"
                                 StyleId="character-action-makesheet"
                                 Style="{StaticResource EmojiActionIconButtonStyle}"
                                 Clicked="OnManufacturingClicked">
                        <ImageButton.Source>
                            <FontImageSource Glyph="🛠️" Size="20" Color="Black"/>
                        </ImageButton.Source>
                    </ImageButton>

                    <ImageButton AutomationProperties.Name="Export battleboard"
                                 StyleId="character-action-export"
                                 Style="{StaticResource EmojiActionIconButtonStyle}"
                                 Clicked="OnExportExcelClicked">
                        <ImageButton.Source>
                            <FontImageSource Glyph="🖨️" Size="20" Color="Black"/>
                        </ImageButton.Source>
                    </ImageButton>

                    <ImageButton AutomationProperties.Name="Advance character"
                                 StyleId="character-action-advance"
                                 Style="{StaticResource EmojiActionIconButtonStyle}"
                                 Clicked="OnAdvanceClicked">
                        <ImageButton.Source>
                            <FontImageSource Glyph="⬆️" Size="20" Color="Black"/>
                        </ImageButton.Source>
                    </ImageButton>
                </HorizontalStackLayout>

                <Button x:Name="ActionsChevronButton"
                        Grid.Column="2"
                        Text="▾"
                        Style="{StaticResource HeaderChevronButtonStyle}"
                        Clicked="OnActionsChevronClicked"/>
            </Grid>

            <VerticalStackLayout x:Name="ExpandedActionsPanel"
                                 Grid.Row="1"
                                 IsVisible="False"
                                 Opacity="0"
                                 Spacing="8"
                                 Padding="8,8,8,4">
                <Button Text="Export battleboard 🖨️"
                        StyleId="character-action-export"
                        Style="{StaticResource ExpandedActionButtonStyle}"
                        Clicked="OnExportExcelClicked"/>
                <Button Text="Advance character ⬆️"
                        StyleId="character-action-advance"
                        Style="{StaticResource ExpandedActionButtonStyle}"
                        Clicked="OnAdvanceClicked"/>
                <Button Text="View battleboard ⚔️"
                        StyleId="character-action-battleboard"
                        Style="{StaticResource ExpandedActionButtonStyle}"
                        Clicked="OnBattleboardClicked"/>
                <Button Text="View make sheet 🛠️"
                        StyleId="character-action-makesheet"
                        Style="{StaticResource ExpandedActionButtonStyle}"
                        Clicked="OnManufacturingClicked"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
