<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.CharacterReviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters"
    Title="Character">

    <Grid Padding="0"
          RowDefinitions="*,Auto,Auto"
          RowSpacing="12">
        <local:CharacterReviewView x:Name="Review"
                                   Grid.Row="0"
                                   ShowSaveButton="False"/>

        <HorizontalStackLayout Grid.Row="1"
                               Margin="16,0,16,0"
                               Spacing="12"
                               HorizontalOptions="Center">
            <ImageButton AutomationProperties.Name="Battleboard"
                         BackgroundColor="Transparent"
                         Padding="6"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnBattleboardClicked">
                <ImageButton.Source>
                    <FontImageSource Glyph="⚔️" Size="20" Color="Black"/>
                </ImageButton.Source>
            </ImageButton>

            <ImageButton AutomationProperties.Name="Manufacturing"
                         BackgroundColor="Transparent"
                         Padding="6"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnManufacturingClicked">
                <ImageButton.Source>
                    <FontImageSource Glyph="🛠️" Size="20" Color="Black"/>
                </ImageButton.Source>
            </ImageButton>
        </HorizontalStackLayout>

        <Button Grid.Row="2"
                Text="Advance character"
                Margin="16,0,16,16"
                Clicked="OnAdvanceClicked"/>
    </Grid>

</ContentPage>
