<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.GuildBenefitSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    Title="Choose guild benefit"
    Shell.NavBarIsVisible="True"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16"
          RowSpacing="12">

        <VerticalStackLayout Spacing="4">
            <Label Text="Choose guild benefits"
                   FontAttributes="Bold"
                   FontSize="16"/>
            <Label Text="Set choices now. Higher-tier sections can still be selected early."
                   FontSize="13"
                   Opacity="0.7"/>
            <Label Text="{Binding Header}"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource SubtleTextColor}"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12"
                                 BindableLayout.ItemsSource="{Binding Sections}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12"
                               CornerRadius="12"
                               HasShadow="False"
                               BorderColor="{StaticResource SurfaceBorderColor}"
                               BackgroundColor="White">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding TierTitle}"
                                               FontAttributes="Bold"
                                               FontSize="14"/>
                                        <Label Text="{Binding AvailabilityText}"
                                               FontSize="11"
                                               Opacity="0.75"/>
                                    </VerticalStackLayout>

                                    <controls:ChevronIconView Grid.Column="1"
                                                              IsExpanded="{Binding IsExpanded}"
                                                              AnimateRotation="True"
                                                              GlyphSize="14"
                                                              IconSize="28"
                                                              GlyphColor="{StaticResource MutedTextColor}"
                                                              HorizontalOptions="End"
                                                              VerticalOptions="Center">
                                        <controls:ChevronIconView.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                        </controls:ChevronIconView.GestureRecognizers>
                                    </controls:ChevronIconView>
                                </Grid>

                                <controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}"
                                                             AnimationName="GuildChoiceTierExpand">
                                    <VerticalStackLayout Spacing="8"
                                                         BindableLayout.ItemsSource="{Binding ChoiceRows}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Stroke="{StaticResource SoftStrokeColor}"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="#FFFFFF"
                                                        Padding="10">
                                                    <VerticalStackLayout Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="8">
                                                            <Label Text="{Binding RowTitle}"
                                                                   FontAttributes="Bold"
                                                                   FontSize="13"/>
                                                            <Label Grid.Column="1"
                                                                   Text="Selected"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource AccentMaroonColor}"
                                                                   IsVisible="{Binding HasSelection}"/>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,*"
                                                              ColumnSpacing="6"
                                                              RowSpacing="6"
                                                              BindableLayout.ItemsSource="{Binding Options}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Grid.Row="{Binding Row}"
                                                                           Grid.Column="{Binding Column}"
                                                                           Grid.ColumnSpan="{Binding ColumnSpan}"
                                                                           Padding="12"
                                                                           StrokeShape="RoundRectangle 10"
                                                                           Stroke="{StaticResource SurfaceBorderColor}"
                                                                           BackgroundColor="White">
                                                                        <Border.Triggers>
                                                                            <DataTrigger TargetType="Border"
                                                                                         Binding="{Binding IsSelected}"
                                                                                         Value="True">
                                                                                <Setter Property="Stroke"
                                                                                        Value="{StaticResource AccentMaroonColor}"/>
                                                                                <Setter Property="StrokeThickness" Value="2"/>
                                                                                <Setter Property="BackgroundColor"
                                                                                        Value="{StaticResource SelectedSurfaceBackgroundColor}"/>
                                                                            </DataTrigger>
                                                                        </Border.Triggers>
                                                                        <Grid>
                                                                            <VerticalStackLayout Spacing="4">
                                                                                <Label Text="{Binding Label}"
                                                                                       FontAttributes="Bold"
                                                                                       FontSize="14"/>
                                                                                <VerticalStackLayout Spacing="2"
                                                                                                     Padding="0,4,0,0"
                                                                                                     BindableLayout.ItemsSource="{Binding Lines}">
                                                                                    <BindableLayout.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Label Text="{Binding .}"
                                                                                                   FontSize="12"
                                                                                                   Opacity="0.75"
                                                                                                   LineBreakMode="WordWrap"/>
                                                                                        </DataTemplate>
                                                                                    </BindableLayout.ItemTemplate>
                                                                                </VerticalStackLayout>
                                                                            </VerticalStackLayout>
                                                                        </Grid>
                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer Command="{Binding SelectCommand}"/>
                                                                        </Border.GestureRecognizers>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </Grid>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </controls:AnimatedExpandView>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Text="Done"
                Style="{StaticResource ExpandedActionButtonStyle}"
                Clicked="OnDoneClicked"/>
    </Grid>
</ContentPage>
