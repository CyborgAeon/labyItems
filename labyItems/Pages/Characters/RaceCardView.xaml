<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.RaceCardView"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <Grid Margin="0,0,0,5">
        <Frame
            x:Name="CardFrame"
            Style="{StaticResource SelectableCardFrameStyle}">
            <Frame.Triggers>
                <DataTrigger TargetType="Frame"
                             Binding="{Binding IsSelected}"
                             Value="True">
                    <Setter Property="HasShadow"
                            Value="True"/>
                    <Setter Property="BorderColor"
                            Value="{StaticResource AccentMaroonColor}"/>
                    <Setter Property="BackgroundColor"
                            Value="{StaticResource SelectedSurfaceBackgroundColor}"/>
                </DataTrigger>
            </Frame.Triggers>
            <Grid RowDefinitions="Auto,Auto">

                <Grid Padding="16"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectCommand, Source={x:Reference Self}}"
                            CommandParameter="{Binding .}"/>
                    </Grid.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,40"
                          ColumnSpacing="12">

                        <Frame
                            Grid.Column="0"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            HasShadow="False"
                            BorderColor="{StaticResource SurfaceBorderColor}"
                            BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}">
                            <Label
                                Text="{Binding Icon}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                FontSize="18"/>
                        </Frame>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="1"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding PeopleTypeDisplay}"
                                   FontSize="12"
                                   FontAttributes="Italic"
                                   Opacity="0.75"/>
                        </VerticalStackLayout>


                        <Button
                            Grid.Column="2"
                            Text="{Binding IsExpanded, Converter={StaticResource ChevronConverter}}"
                            Style="{StaticResource CardChevronButtonStyle}"
                            Command="{Binding ToggleRaceExpandedCommand, Source={x:Reference Self}}"
                            CommandParameter="{Binding .}"/>
                    </Grid>

                    <Label Grid.Row="1"
                           Text="{Binding Description}"
                           FontSize="13"
                           Opacity="0.8"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"/>
                </Grid>

                <Grid x:Name="ExpandedContent"
                      Grid.Row="1"
                      IsVisible="False"
                      BackgroundColor="Transparent">
                    <Grid Padding="16"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="12"
                          BackgroundColor="Transparent">

                        <Grid IsVisible="{Binding HasAnyAbilities}">
                            <controls:LevelAbilityTableView ItemsSource="{Binding LevelRows}"
                                                            ShowBodyAndLoc="False"
                                                            AbilitiesHeaderText="Abilities"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              IsVisible="{Binding HasAnyAbilities, Converter={StaticResource InverseBoolConverter}}">
                            <Label Text="{Binding Description}"
                                   FontSize="13"
                                   Opacity="0.85"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="3"/>
                        </Grid>

                        <Grid Grid.Row="2"
                              IsVisible="{Binding BuyAsChips.Count, Converter={StaticResource GreaterThanZeroConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Buy as"
                                       FontSize="13"
                                       FontAttributes="Bold"/>
                                <controls:ChipGroup Items="{Binding BuyAsChips}"
                                                    InputTransparent="True"/>
                            </VerticalStackLayout>
                        </Grid>

                    </Grid>
                </Grid>

            </Grid>
        </Frame>
    </Grid>
</ContentView>
