<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.Wizard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    x:Name="Root">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:StepIndicator
            Grid.Row="0"
            Steps="{Binding StepSteps}"
            CurrentStep="{Binding CurrentStep}"
            StepClickCommand="{Binding StepClickCommand}"
            BubbleSize="40"/>
        <ContentView
            Grid.Row="1"
            Content="{Binding CurrentStepView}"/>

        <Border Grid.Row="2"
                BackgroundColor="#FFFFFF"
                Stroke="#22000000"
                StrokeThickness="1">


            <Grid
                ColumnDefinitions="Auto,*,Auto"
                Padding="16,0,16,0">
                <Button Text="Back"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Grid.Column="0"/>

                <Button Grid.Column="2"
                        Text="{Binding NextButtonText}"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanGoNext}"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
