<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.Wizard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    xmlns:local="clr-namespace:labyItems.Pages.Characters"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    x:Name="Root">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:StepIndicator
            Grid.Row="0"
            Steps="{Binding StepSteps}"
            CurrentStep="{Binding CurrentStep}"
            StepClickCommand="{Binding StepClickCommand}"
            BubbleSize="40"
            Padding="0,6"/>
        <ContentView
            Grid.Row="1"
            Content="{Binding CurrentStepView}"/>

        <Grid Grid.Row="2"
              RowDefinitions="1,Auto">
            <BoxView Grid.Row="0"
                     HeightRequest="1"
                     BackgroundColor="{StaticResource Gray200}"/>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  Padding="16,0,16,0">
                <Button Text="Back"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Grid.Column="0"
                        HorizontalOptions="Start"/>

                <Grid Grid.Column="1"
                      IsVisible="{Binding IsGuildsStep}"
                      BackgroundColor="Transparent"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GuildsVm.OpenReviewCommand}"/>
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding GuildsVm.IsPoliticalFilled, Mode=OneWay}"
                              InputTransparent="True"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding GuildsVm.IsProfessionalFilled, Mode=OneWay}"
                              InputTransparent="True"/>
                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding GuildsVm.IsSocialFilled, Mode=OneWay}"
                              InputTransparent="True"/>
                </Grid>

                <Button Grid.Column="2"
                        Text="{Binding NextButtonText}"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        HorizontalOptions="End"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              Grid.RowSpan="2"
              RowDefinitions="*,1,Auto"
              BackgroundColor="{StaticResource White}"
              IsVisible="{Binding GuildsVm.IsReviewOpen}">
            <Grid RowDefinitions="Auto,*"
                  Padding="16"
                  RowSpacing="10">
                <Label Text="Selected guilds"
                       FontAttributes="Bold"
                       FontSize="18"/>
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding GuildsVm.ReviewGuilds}"
                                SelectionMode="None"
                                ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,8"
                                    Stroke="{StaticResource AccentMaroonColor}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SelectedSurfaceBackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.GuildsVm.ToggleSelectedCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Stroke="#D8B4FE" BackgroundColor="#F3E8FF"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 999"
                                            WidthRequest="26" HeightRequest="26" VerticalOptions="Start" Margin="0,2,0,0">
                                        <Label Text="{x:Static helpers:FontAwesomeGlyphs.Guild}"
                                               FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                                               FontSize="12" TextColor="#581C87"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"
                                               LineBreakMode="WordWrap" Margin="0,0,4,0" />
                                        <Label Text="{Binding Type}" FontSize="12" Opacity="0.75"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 999" WidthRequest="28" HeightRequest="28"
                                            VerticalOptions="Start" HorizontalOptions="End">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnGuildInfoTapped" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                               FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                                               FontSize="13" TextColor="{StaticResource SubtleTextColor}"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="{StaticResource Gray200}"/>
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto"
                  Padding="16,0,16,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding GuildsVm.CancelReviewCommand}"/>
                <Button Grid.Column="2"
                        Text="Save"
                        Command="{Binding GuildsVm.SaveReviewCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
