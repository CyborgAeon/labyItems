<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.CharacterWalletPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Character Wallet">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,Auto,*"
              Padding="16"
              RowSpacing="12">
            <Label Text="Saved characters"
                   FontSize="20"
                   FontAttributes="Bold"/>
            <Label Grid.Row="1"
                   x:Name="EmptyStateLabel"
                   Text="No characters saved yet."
                   Opacity="0.7"
                   IsVisible="False"/>

            <CollectionView x:Name="WalletView"
                            Grid.Row="2"
                            SelectionMode="None"
                            ItemsSource="{Binding Characters}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,12"
                               Padding="12"
                               CornerRadius="12"
                               HasShadow="False"
                               BorderColor="{StaticResource SurfaceBorderColor}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped"/>
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,*,*,*,*,*"
                                  RowSpacing="8">
                                <Label Grid.ColumnSpan="5"
                                       Grid.Row="0"
                                       Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="17"/>
                                <Label Text="{Binding Class}"
                                       Grid.ColumnSpan="2"
                                       Grid.Row="1"
                                       FontSize="13"
                                       Opacity="0.8"/>
                                <Label Text="{Binding PlayerName, StringFormat='{0}'}"
                                       FontSize="13"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="3"
                                       Grid.Row="1"
                                       Opacity="0.8"
                                       HorizontalTextAlignment="End"/>
                                <ImageButton Grid.Row="2"
                                             Grid.Column="0"
                                             AutomationProperties.Name="Summary"
                                             BackgroundColor="Transparent"
                                             Padding="6"
                                             HeightRequest="36"
                                             WidthRequest="36"
                                             Clicked="OnSummaryClicked"
                                             CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="📄"
                                                         Size="18"
                                                         Color="Black"/>
                                    </ImageButton.Source>
                                </ImageButton>

                                <ImageButton
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Character Wizard"
                                    BackgroundColor="Transparent"
                                    Padding="6"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Clicked="OnWizardClicked"
                                    CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🪄"
                                                         Size="18"
                                                         Color="Black"/>
                                    </ImageButton.Source>
                                </ImageButton>

                                <ImageButton
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    AutomationProperties.Name="Advance character"
                                    BackgroundColor="Transparent"
                                    Padding="6"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Clicked="OnAdvanceClicked"
                                    CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="⬆️"
                                                         Size="18"
                                                         Color="Black"/>
                                    </ImageButton.Source>
                                </ImageButton>

                                <ImageButton
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    AutomationProperties.Name="Battleboard"
                                    BackgroundColor="Transparent"
                                    Padding="6"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Clicked="OnBattleboardClicked"
                                    CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="⚔️"
                                                         Size="18"
                                                         Color="Black"/>
                                    </ImageButton.Source>
                                </ImageButton>

                                <ImageButton
                                    Grid.Row="2"
                                    Grid.Column="4"
                                    AutomationProperties.Name="Manufacturing"
                                    BackgroundColor="Transparent"
                                    Padding="6"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Clicked="OnManufacturingClicked"
                                    CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🛠️"
                                                         Size="18"
                                                         Color="Black"/>
                                    </ImageButton.Source>
                                </ImageButton>

                                <ImageButton
                                    Grid.Row="2"
                                    Grid.Column="5"
                                    AutomationProperties.Name="Delete character"
                                    BackgroundColor="Transparent"
                                    Padding="6"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Clicked="OnDeleteClicked"
                                    CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🗑️"
                                                         Size="18"
                                                         Color="{StaticResource AccentMaroonColor}"/>
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
