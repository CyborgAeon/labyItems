<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.CharacterWalletPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Characters">

    <Grid RowDefinitions="Auto,*"
          Padding="16,8,16,8"
          RowSpacing="0">
        <VerticalStackLayout Grid.Row="0"
                             Spacing="8"
                             Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                <Label Grid.Column="1"
                       Text="Characters"
                       FontAttributes="Bold"
                       FontSize="24"
                       VerticalTextAlignment="Center" />
                <Button Grid.Column="2"
                        Text="+"
                        Clicked="OnAddCharacterClicked"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0" />
            </Grid>

            <Label x:Name="EmptyStateLabel"
                   Text="No characters saved yet."
                   Opacity="0.7"
                   IsVisible="False" />
            <Button x:Name="CreateCharacterButton"
                    Text="Create a character"
                    Clicked="OnAddCharacterClicked"
                    IsVisible="False" />
        </VerticalStackLayout>

        <CollectionView x:Name="WalletView"
                        Grid.Row="1"
                        SelectionMode="None"
                        ItemsSource="{Binding CharacterRows}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,12"
                           Padding="0"
                           CornerRadius="8"
                           HasShadow="False"
                           BorderColor="{StaticResource SurfaceBorderColor}"
                           BindingContextChanged="OnWalletCardBindingContextChanged">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWalletCardTapped" />
                        </Frame.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="0">
                            <Grid Grid.Row="0"
                                  Padding="12"
                                  ColumnDefinitions="Auto,*,40"
                                  ColumnSpacing="12"
                                  MinimumHeightRequest="76">
                                <controls:ClassBracketIconView Grid.Column="0"
                                                               IconSize="52"
                                                               AvatarImageSource="{Binding AvatarImageSource}"
                                                               HasSplitIcon="{Binding HasSplitIcon}"
                                                               SingleGlyph="{Binding SingleGlyph}"
                                                               SingleIconFontFamily="{Binding SingleIconFontFamily}"
                                                               SingleBackground="{Binding SingleBackground}"
                                                               SplitLeftGlyph="{Binding SplitLeftGlyph}"
                                                               SplitRightGlyph="{Binding SplitRightGlyph}"
                                                               SplitLeftBackground="{Binding SplitLeftBackground}"
                                                               SplitRightBackground="{Binding SplitRightBackground}"
                                                               BorderColor="{StaticResource SurfaceBorderColor}"
                                                               VerticalOptions="Center">
                                    <controls:ClassBracketIconView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAvatarTapped" />
                                    </controls:ClassBracketIconView.GestureRecognizers>
                                </controls:ClassBracketIconView>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="17"
                                           LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding BracketSubtitle}"
                                               FontSize="12"
                                               TextColor="{StaticResource MutedTextColor}"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="TailTruncation" />

                                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 999"
                                                BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"
                                                Padding="8,2"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding PointsChipText}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Gray900}"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding LastPlayedText}"
                                           FontSize="12"
                                           TextColor="{StaticResource MutedTextColor}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <controls:ChevronIconView Grid.Column="2"
                                                          IsExpanded="{Binding IsExpanded}"
                                                          AnimateRotation="True"
                                                          GlyphSize="16"
                                                          GlyphColor="{StaticResource MutedTextColor}"
                                                          InputTransparent="True"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout Grid.Row="1"
                                                 StyleId="wallet-expanded-actions"
                                                 IsVisible="False"
                                                 Opacity="0"
                                                 Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding ActionRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <controls:GlyphActionRowView Glyph="{Binding IconGlyph}"
                                                                     GlyphFontFamily="{Binding IconFontFamily}"
                                                                     Text="{Binding Title}"
                                                                     IsDestructive="{Binding IsDestructive}"
                                                                     Clicked="OnActionRowClicked" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        Grid.RowSpan="2"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.Characters}" />
    </Grid>
</ContentPage>
