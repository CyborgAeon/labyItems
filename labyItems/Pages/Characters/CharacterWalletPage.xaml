<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Characters.CharacterWalletPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Character Wallet">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
            <Label Text="Saved characters"
                   FontSize="20"
                   FontAttributes="Bold"/>
            <Label Grid.Row="1"
                   x:Name="EmptyStateLabel"
                   Text="No characters saved yet."
                   Opacity="0.7"
                   IsVisible="False"/>

            <CollectionView x:Name="WalletView"
                            Grid.Row="2"
                            SelectionMode="None"
                            ItemsSource="{Binding Characters}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,12"
                               Padding="12"
                               CornerRadius="12"
                               HasShadow="False"
                               BorderColor="#E5E7EB">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped"/>
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <VerticalStackLayout Grid.Column="0"
                                                     Grid.ColumnSpan="4"
                                                     Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="17"/>
                                    <Label Text="{Binding Class}"
                                           FontSize="13"
                                           Opacity="0.8"/>
                                    <Label Text="{Binding PlayerName, StringFormat='Player: {0}'}"
                                           FontSize="12"
                                           Opacity="0.7"/>
                                    <Label Text="{Binding UpdatedUtc, StringFormat='Updated: {0:dd MMM yyyy HH:mm}'}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                                </VerticalStackLayout>

                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Text="View"
                                        Padding="12,6"
                                        Clicked="OnViewClicked"
                                        CommandParameter="{Binding .}"/>

                                <ImageButton Grid.Row="1"
                                             Grid.Column="2"
                                             Padding="8"
                                             HeightRequest="40"
                                             WidthRequest="40"
                                             Clicked="OnEditClicked"
                                             CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🖍️" Size="18" Color="Black"/>
                                    </ImageButton.Source>
                                </ImageButton>

                                <Button Grid.Row="1"
                                        Grid.Column="3"
                                        Text="Delete"
                                        Padding="12,6"
                                        BackgroundColor="#7F1D1D"
                                        TextColor="White"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
