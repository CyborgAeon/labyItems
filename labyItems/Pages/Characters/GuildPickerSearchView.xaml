<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Pages.Characters.GuildPickerSearchView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:labyItems.Helpers">
    <Grid RowDefinitions="Auto,*" RowSpacing="10" Padding="16">
        <Border Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="#F9FAFB"
                Padding="8,4">
            <Entry ClearButtonVisibility="WhileEditing"
                   Placeholder="Search guilds..."
                   Text="{Binding SearchText, Mode=TwoWay}" />
        </Border>

        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding FilteredResults}"
                            ItemSizingStrategy="MeasureAllItems"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Stroke="{StaticResource SubtleTextColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource White}"
                                Margin="0,0,0,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource AccentMaroonColor}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource SelectedSurfaceBackgroundColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResultTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Stroke="{Binding IconBorderColor}"
                                        BackgroundColor="{Binding IconBackgroundColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="26" HeightRequest="26"
                                        VerticalOptions="Start" Margin="0,2,0,0">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="FASolid"
                                           FontSize="12"
                                           TextColor="{Binding IconColor}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding MetaText}" FontSize="12" Opacity="0.75" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding DescriptionText}" FontSize="12" Opacity="0.8" MaxLines="2"
                                           LineBreakMode="WordWrap" IsVisible="{Binding HasDescription}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        Stroke="{StaticResource SubtleTextColor}"
                                        BackgroundColor="{StaticResource White}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="28" HeightRequest="28"
                                        VerticalOptions="Start" HorizontalOptions="End">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                           FontFamily="FASolid" FontSize="13"
                                           TextColor="{StaticResource SubtleTextColor}"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}"
                               VerticalOptions="Center" HorizontalOptions="Center" />
            <Label Text="{Binding EmptyStateText}" IsVisible="{Binding HasNoResults}"
                   Opacity="0.75" HorizontalTextAlignment="Center"
                   VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentView>
