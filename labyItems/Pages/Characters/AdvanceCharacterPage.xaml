<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="labyItems.Pages.Characters.AdvanceCharacterPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:sliders="clr-namespace:labyItems.Controls.Sliders"
    xmlns:viewModels="clr-namespace:labyItems.Pages.Characters.ViewModels"
    Title="Advance Character">

    <ContentPage x:Name="DetailsTab"
                 Title="Details">
        <ScrollView>
            <VerticalStackLayout Padding="16"
                                 Spacing="16">
                <Label Text="Details"
                       FontAttributes="Bold"
                       FontSize="18"/>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Points accrued"
                           FontAttributes="Bold"/>
                    <Entry Text="{Binding Points, Mode=TwoWay}"
                           Keyboard="Numeric"
                           Placeholder="Total points"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Current vitae"
                           FontAttributes="Bold"/>
                    <sliders:VitaeSlider Value="{Binding CurrentVitae, Mode=TwoWay}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Abilities"
                           FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <controls:DictionarySearchBar x:TypeArguments="viewModels:ManuAbilityOption"
                                                      ItemsSource="{Binding AbilityOptions}"
                                                      SelectedValue="{Binding SelectedAbilityOption, Mode=TwoWay}"
                                                      PlaceholderText="Type ability name"
                                                      SelectionDisplayMemberPath="Name"/>
                        <Button Grid.Column="1"
                                Text="Add"
                                Command="{Binding AddAbilityCommand}"
                                IsEnabled="{Binding CanAddAbility}"/>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Abilities}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           VerticalTextAlignment="Center"/>
                                    <ImageButton Grid.Column="1"
                                                 HeightRequest="36"
                                                 WidthRequest="36"
                                                 Padding="6"
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveAbilityCommand}"
                                                 CommandParameter="{Binding .}">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="🗑️"
                                                             Size="16"
                                                             Color="Black"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Notes"
                           FontAttributes="Bold"/>
                    <Editor Text="{Binding Notes, Mode=TwoWay}"
                            AutoSize="TextChanges"
                            Placeholder="Add notes about advancement, downtime, or approvals."/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="Items"
                               FontAttributes="Bold"/>
                        <Button Grid.Column="1"
                                Text="+ Add item"
                                Command="{Binding AddItemCommand}"/>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Entry Text="{Binding Text, Mode=TwoWay}"
                                           Placeholder="Item"/>
                                    <ImageButton Grid.Column="1"
                                                 HeightRequest="36"
                                                 WidthRequest="36"
                                                 Padding="6"
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveItemCommand}"
                                                 CommandParameter="{Binding .}">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="🗑️"
                                                             Size="16"
                                                             Color="Black"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

    <ContentPage x:Name="SpellsTab"
                 Title="Spells">
        <ScrollView>
            <VerticalStackLayout Padding="16"
                                 Spacing="12">
                <Label Text="{Binding SpellListsDisabledReason}"
                       FontSize="12"
                       Opacity="0.7"
                       IsVisible="{Binding SpellListsEnabled, Converter={StaticResource InverseBoolConverter}}"/>

                <VerticalStackLayout IsVisible="{Binding SpellListsEnabled}"
                                     Spacing="12">
                    <Label Text="Spell Lists"
                           FontAttributes="Bold"
                           FontSize="18"/>
                    <Button Text="+ Add spell list"
                            Command="{Binding AddSpellListCommand}"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SpellLists}"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12"
                                       CornerRadius="12"
                                       BorderColor="#E5E7EB"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <Entry Text="{Binding Name, Mode=TwoWay}"
                                                   Placeholder="Spell list name"/>
                                            <Button Grid.Column="1"
                                                    Text="Remove list"
                                                    Padding="10,4"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSpellListCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>

                                        <Button Text="+ Add spell"
                                                Padding="10,4"
                                                Command="{Binding AddEntryCommand}"/>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}"
                                                             Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <controls:DictionarySearchBar x:TypeArguments="viewModels:SpellOption"
                                                                                      ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.FilteredOptions}"
                                                                                      SelectedValue="{Binding SelectedSpell, Mode=TwoWay}"
                                                                                      PlaceholderText="Type spell name"/>
                                                        <ImageButton Grid.Column="1"
                                                                     HeightRequest="36"
                                                                     WidthRequest="36"
                                                                     Padding="6"
                                                                     BackgroundColor="Transparent"
                                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.RemoveEntryCommand}"
                                                                     CommandParameter="{Binding .}">
                                                            <ImageButton.Source>
                                                                <FontImageSource Glyph="🗑️"
                                                                                 Size="16"
                                                                                 Color="Black"/>
                                                            </ImageButton.Source>
                                                        </ImageButton>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

    <ContentPage x:Name="MiraclesTab"
                 Title="Miracles">
        <ScrollView>
            <VerticalStackLayout Padding="16"
                                 Spacing="12">
                <Label Text="Miracle Lists"
                       FontAttributes="Bold"
                       FontSize="18"/>
                <Button Text="{Binding AddMiracleListLabel}"
                        IsVisible="{Binding CanAddMiracleList}"
                        Command="{Binding AddMiracleListCommand}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MiracleLists}"
                                     Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="12"
                                   CornerRadius="12"
                                   BorderColor="#E5E7EB"
                                   HasShadow="False">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding HeaderTitle}"
                                                   FontAttributes="Bold"
                                                   FontSize="16"/>
                                            <Label Text="{Binding StateLabel}"
                                                   FontSize="12"
                                                   Opacity="0.6"/>
                                        </VerticalStackLayout>
                                        <ImageButton Grid.Column="1"
                                                     HeightRequest="32"
                                                     WidthRequest="32"
                                                     Padding="6"
                                                     BackgroundColor="Transparent"
                                                     IsVisible="{Binding CanReopenScriptures}"
                                                     Command="{Binding ReopenScripturesCommand}">
                                            <ImageButton.Source>
                                                <FontImageSource Glyph="✏️"
                                                                 Size="16"
                                                                 Color="Black"/>
                                            </ImageButton.Source>
                                        </ImageButton>
                                        <Button Grid.Column="2"
                                                Text="{Binding IsExpanded, Converter={StaticResource ChevronConverter}}"
                                                BackgroundColor="Transparent"
                                                TextColor="#6B7280"
                                                Padding="0"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                Command="{Binding ToggleExpandedCommand}"/>
                                    </Grid>

                                    <HorizontalStackLayout Spacing="8"
                                                           IsVisible="{Binding CanEdit}">
                                        <Button Text="Save list"
                                                Command="{Binding SaveListCommand}"
                                                IsEnabled="{Binding CanSaveList}"/>
                                        <Button Text="Delete list"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveMiracleListCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                         Spacing="10">
                                        <VerticalStackLayout IsVisible="{Binding CanEdit}"
                                                             Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <controls:DictionarySearchBar x:TypeArguments="viewModels:MiracleOption"
                                                                              ItemsSource="{Binding FilteredOptions}"
                                                                              SelectedValue="{Binding SelectedMiracleOption, Mode=TwoWay}"
                                                                              PlaceholderText="Type miracle name"
                                                                              SelectionDisplayMemberPath="Name"
                                                                              IsEnabled="{Binding CanEdit}"/>
                                                <Button Grid.Column="1"
                                                        Text="Add"
                                                        Command="{Binding AddSelectedCommand}"
                                                        IsEnabled="{Binding CanAddSelected}"/>
                                            </Grid>

                                            <ScrollView Orientation="Horizontal">
                                                <controls:MultiChipGroup Items="{Binding SphereFilterOptions}"
                                                                         SelectedItems="{Binding SelectedSphereFilters}"
                                                                         WrapMode="NoWrap"/>
                                            </ScrollView>
                                            <controls:MultiChipGroup Items="{Binding AdvancedFilterOptions}"
                                                                     SelectedItems="{Binding SelectedAdvancedFilters}"
                                                                     WrapMode="NoWrap"/>


                                            <VerticalStackLayout IsVisible="{Binding ShowNeutralAlignmentChoice}"
                                                                 Spacing="4">
                                                <Label Text="Neutral list alignment"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       Opacity="0.7"/>
                                                <controls:ChipGroup Items="{Binding NeutralAlignmentOptions}"
                                                                    SelectedItem="{Binding NeutralAlignmentChoice, Mode=TwoWay}"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Text="{Binding ScripturesProgressText}"
                                               IsVisible="{Binding IsScriptures}"
                                               FontSize="12"
                                               Opacity="0.8"/>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}"
                                                             Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <Label Text="{Binding DisplayText}"
                                                               VerticalTextAlignment="Center"/>
                                                        <ImageButton Grid.Column="1"
                                                                     HeightRequest="36"
                                                                     WidthRequest="36"
                                                                     Padding="6"
                                                                     BackgroundColor="Transparent"
                                                                     IsVisible="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.CanEdit}"
                                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.RemoveEntryCommand}"
                                                                     CommandParameter="{Binding .}">
                                                            <ImageButton.Source>
                                                                <FontImageSource Glyph="🗑️"
                                                                                 Size="16"
                                                                                 Color="Black"/>
                                                            </ImageButton.Source>
                                                        </ImageButton>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,*,*"
                                                  ColumnSpacing="8">
                                                <Label Text="{Binding GoodPoints, StringFormat='Good: {0}'}"
                                                       TextColor="Green"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding NeutralPoints, StringFormat='Neutral: {0}'}"
                                                       TextColor="#8B5E3C"/>
                                                <Label Grid.Column="2"
                                                       Text="{Binding EvilPoints, StringFormat='Evil: {0}'}"
                                                       TextColor="Red"/>
                                            </Grid>

                                            <Grid HeightRequest="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding GoodWidth}"/>
                                                    <ColumnDefinition Width="{Binding NeutralWidth}"/>
                                                    <ColumnDefinition Width="{Binding EvilWidth}"/>
                                                    <ColumnDefinition Width="{Binding UnselectedWidth}"/>
                                                </Grid.ColumnDefinitions>
                                                <BoxView Color="Green"/>
                                                <BoxView Grid.Column="1"
                                                         Color="#8B5E3C"/>
                                                <BoxView Grid.Column="2"
                                                         Color="Red"/>
                                                <BoxView Grid.Column="3"
                                                         Color="#D1D5DB"/>
                                            </Grid>

                                            <Label Text="{Binding ValidationMessage}"
                                                   TextColor="#7F1D1D"
                                                   IsVisible="{Binding HasValidationError}"
                                                   FontSize="12"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

    <ContentPage x:Name="EvocsTab"
                 Title="Evocs">
        <ScrollView>
            <VerticalStackLayout Padding="16"
                                 Spacing="12">
                <Label Text="Evocation List"
                       FontAttributes="Bold"
                       FontSize="18"/>
                <Button Text="+ Add evocation list"
                        IsVisible="{Binding CanAddEvocationList}"
                        Command="{Binding AddEvocationListCommand}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EvocationLists}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="12"
                                   CornerRadius="12"
                                   BorderColor="#E5E7EB"
                                   HasShadow="False">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <Label Text="Evocation List"
                                               FontAttributes="Bold"
                                               FontSize="16"/>
                                        <Button Grid.Column="1"
                                                Text="Delete list"
                                                Padding="10,4"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveEvocationListCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <controls:DictionarySearchBar x:TypeArguments="viewModels:EvocationOption"
                                                                      ItemsSource="{Binding FilteredOptions}"
                                                                      SelectedValue="{Binding SelectedEvocationOption, Mode=TwoWay}"
                                                                      PlaceholderText="Type evocation name"
                                                                      SelectionDisplayMemberPath="Name"/>
                                        <Button Grid.Column="1"
                                                Text="Add"
                                                Command="{Binding AddSelectedCommand}"
                                                IsEnabled="{Binding CanAddSelected}"/>
                                    </Grid>

                                    <ScrollView Orientation="Horizontal">
                                        <controls:MultiChipGroup Items="{Binding FieldFilterOptions}"
                                                                 SelectedItems="{Binding SelectedFieldFilters}"
                                                                 WrapMode="NoWrap"/>
                                    </ScrollView>

                                    <ScrollView Orientation="Horizontal">
                                        <controls:MultiChipGroup Items="{Binding TierFilterOptions}"
                                                                 SelectedItems="{Binding SelectedTierFilters}"
                                                                 WrapMode="NoWrap"/>
                                    </ScrollView>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}"
                                                         Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding DisplayText}"
                                                           VerticalTextAlignment="Center"/>
                                                    <ImageButton Grid.Column="1"
                                                                 HeightRequest="36"
                                                                 WidthRequest="36"
                                                                 Padding="6"
                                                                 BackgroundColor="Transparent"
                                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.RemoveEntryCommand}"
                                                                 CommandParameter="{Binding .}">
                                                        <ImageButton.Source>
                                                            <FontImageSource Glyph="🗑️"
                                                                             Size="16"
                                                                             Color="Black"/>
                                                        </ImageButton.Source>
                                                    </ImageButton>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <Label Text="{Binding TotalPower, StringFormat='Total EP: {0}/60'}"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding AdvancedPower, StringFormat='Advanced EP: {0}/20'}"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                    </Grid>

                                    <Label Text="{Binding ValidationMessage}"
                                           TextColor="#7F1D1D"
                                           IsVisible="{Binding HasValidationError}"
                                           FontSize="12"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>
</TabbedPage>
