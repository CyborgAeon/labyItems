<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="labyItems.Pages.Characters.AdvanceCharacterPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:sliders="clr-namespace:labyItems.Controls.Sliders"
    xmlns:viewModels="clr-namespace:labyItems.Pages.Characters.ViewModels"
    Title="Advance Character">

    <ContentPage x:Name="DetailsTab"
                 Title="Details">
        <Grid StyleId="__overlay_host__">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollView>
                <VerticalStackLayout Padding="16"
                                     Spacing="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Points accrued"
                               FontAttributes="Bold"/>
                        <Entry Text="{Binding Points, Mode=TwoWay}"
                               Keyboard="Numeric"
                               Placeholder="Total points"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Current vitae"
                               FontAttributes="Bold"/>
                        <sliders:VitaeSlider Value="{Binding CurrentVitae, Mode=TwoWay}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Abilities"
                               FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <controls:DictionarySearchBar x:Name="AbilitySearch"
                                                          x:TypeArguments="viewModels:ManuAbilityOption"
                                                          SelectedValue="{Binding SelectedAbilityOption, Mode=TwoWay}"
                                                          PlaceholderText="Type ability name"
                                                          SelectionDisplayMemberPath="Name"/>
                            <Button Grid.Column="1"
                                    Text="Add"
                                    Command="{Binding AddAbilityCommand}"
                                    IsEnabled="{Binding CanAddAbility}"/>
                        </Grid>
                        <Label Text="{Binding AbilityPointsSummary}"
                               FontSize="12"
                               Opacity="0.7"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Abilities}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                          ColumnSpacing="8">
                                        <Label Text="{Binding NameWithCost}"
                                               VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding RunningTotalText}"
                                               FontSize="12"
                                               Opacity="0.7"
                                               VerticalTextAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Text="&#xF05A;"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource SubtleTextColor}"
                                                HeightRequest="18"
                                                WidthRequest="18"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                Clicked="OnViewAbilityDetailsClicked"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="3"
                                                Text="&#xF2ED;"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource SubtleTextColor}"
                                                HeightRequest="18"
                                                WidthRequest="18"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveAbilityCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Notes"
                               FontAttributes="Bold"/>
                        <Editor Text="{Binding Notes, Mode=TwoWay}"
                                AutoSize="TextChanges"
                                Placeholder="Add notes about advancement, downtime, or approvals."/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Label Text="Items"
                                   FontAttributes="Bold"/>
                            <Button Grid.Column="1"
                                    Text="+ Add item"
                                    Command="{Binding AddItemCommand}"/>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <Entry Text="{Binding Text, Mode=TwoWay}"
                                               Placeholder="Item"/>
                                        <ImageButton Grid.Column="1"
                                                     HeightRequest="36"
                                                     WidthRequest="36"
                                                     Padding="6"
                                                     BackgroundColor="Transparent"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveItemCommand}"
                                                     CommandParameter="{Binding .}">
                                            <ImageButton.Source>
                                                <FontImageSource FontFamily="FASolid"
                                                                 Glyph="&#xF2ED;"
                                                                 Size="50"
                                                                 Color="{StaticResource SubtleTextColor}"/>
                                            </ImageButton.Source>
                                        </ImageButton>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage>

    <ContentPage x:Name="SpellsTab"
                 Title="Spells">
        <Grid StyleId="__overlay_host__">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollView>
                <VerticalStackLayout Padding="16"
                                     Spacing="12">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SpellLists}"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12"
                                       CornerRadius="12"
                                       BorderColor="{StaticResource SurfaceBorderColor}"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <Label Text="{Binding HeaderTitle}"
                                                   FontAttributes="Bold"
                                                   VerticalTextAlignment="Center"
                                                   IsVisible="True"/>
                                            <Button Grid.Column="1"
                                                    Text="{Binding IsExpanded, Converter={StaticResource ChevronConverter}}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource MutedTextColor}"
                                                    Padding="0"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    Command="{Binding ToggleExpandedCommand}"/>
                                        </Grid>
                                        <controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}"
                                                                     AnimationName="AdvanceSpellListExpand">
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="*"
                                                      ColumnSpacing="8"
                                                      IsVisible="{Binding CanEdit}">
                                                    <controls:DictionarySearchBar x:TypeArguments="viewModels:SpellOption"
                                                                                  ItemsSource="{Binding FilteredOptions}"
                                                                                  SelectedValue="{Binding SelectedSpellOption, Mode=TwoWay}"
                                                                                  SelectedText="{Binding SearchText, Mode=TwoWay}"
                                                                                  PlaceholderText="Type spell name"
                                                                                  SelectionDisplayMemberPath="Name"
                                                                                  ResultSelectedCommand="{Binding AddSelectedCommand}"
                                                                                  KeepFocusOnResultSelection="True"
                                                                                  ClearAfterResultSelection="True"
                                                                                  KeyboardAvoidanceEnabled="True"
                                                                                  IsEnabled="{Binding CanEdit}"/>
                                                </Grid>

                                                <ScrollView Orientation="Horizontal"
                                                            IsVisible="{Binding CanEdit}">
                                                    <controls:MultiChipGroup Items="{Binding ColourFilterOptions}"
                                                                             SelectedItems="{Binding SelectedColourFilters}"
                                                                             WrapMode="NoWrap"/>
                                                </ScrollView>
                                                <controls:MultiChipGroup Items="{Binding TierFilterOptions}"
                                                                         SelectedItems="{Binding SelectedTierFilters}"
                                                                         WrapMode="NoWrap"
                                                                         IsVisible="{Binding CanEdit}"/>

                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                      ColumnSpacing="8"
                                                      Padding="10,0">
                                                    <Label Text="Name"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           Opacity="0.75"/>
                                                    <Label Grid.Column="1"
                                                           Text="Level"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           Opacity="0.75"
                                                           HorizontalTextAlignment="End"/>
                                                    <Label Grid.Column="2"
                                                           Grid.ColumnSpan="2"
                                                           Text="Actions"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           Opacity="0.75"
                                                           HorizontalTextAlignment="Center"/>
                                                </Grid>

                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}"
                                                                     Spacing="8">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    BackgroundColor="{Binding RowBackgroundColor}">
                                                                <Grid Padding="10,8"
                                                                      ColumnDefinitions="*,Auto,Auto,Auto"
                                                                      ColumnSpacing="8">
                                                                    <Label Text="{Binding NameText}"
                                                                           FontSize="14"
                                                                           MaxLines="1"
                                                                           LineBreakMode="TailTruncation"
                                                                           VerticalTextAlignment="Center"/>
                                                                    <Label Grid.Column="1"
                                                                           Text="{Binding LevelText}"
                                                                           FontSize="14"
                                                                           FontAttributes="Bold"
                                                                           Opacity="0.75"
                                                                           HorizontalTextAlignment="End"
                                                                           VerticalTextAlignment="Center"/>
                                                                    <Button Grid.Column="2"
                                                                            Text="&#xF05A;"
                                                                            FontFamily="FASolid"
                                                                            FontSize="12"
                                                                            Padding="0"
                                                                            BackgroundColor="Transparent"
                                                                            TextColor="{StaticResource SubtleTextColor}"
                                                                            HeightRequest="18"
                                                                            WidthRequest="18"
                                                                            MinimumHeightRequest="0"
                                                                            MinimumWidthRequest="0"
                                                                            IsVisible="{Binding HasSpell}"
                                                                            Clicked="OnViewSpellDetailsClicked"
                                                                            CommandParameter="{Binding .}"/>
                                                                    <Button Grid.Column="3"
                                                                            Text="&#xF2ED;"
                                                                            FontFamily="FASolid"
                                                                            FontSize="12"
                                                                            Padding="0"
                                                                            BackgroundColor="Transparent"
                                                                            TextColor="{StaticResource SubtleTextColor}"
                                                                            HeightRequest="18"
                                                                            WidthRequest="18"
                                                                            MinimumHeightRequest="0"
                                                                            MinimumWidthRequest="0"
                                                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.CanEdit}"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.RemoveEntryCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout IsVisible="{Binding IsSpecialistList}"
                                                                     Spacing="6">
                                                    <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SpecialistSlotsSummary}"
                                                           TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SpecialistSlotsSummaryColor}"
                                                           FontSize="12"
                                                           Opacity="0.7"
                                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowSpecialistSlotsBar}"/>
                                                    <FlexLayout Direction="Row"
                                                                HeightRequest="10"
                                                                BindableLayout.ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SpecialistSlotSegments}"
                                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowSpecialistSlotsBar}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border FlexLayout.Grow="{Binding Weight}"
                                                                        Stroke="{StaticResource StrongStrokeColor}"
                                                                        StrokeThickness="0.75">
                                                                    <Border.Triggers>
                                                                        <DataTrigger TargetType="Border"
                                                                                     Binding="{Binding IsUnselected}"
                                                                                     Value="True">
                                                                            <Setter Property="StrokeThickness"
                                                                                    Value="0"/>
                                                                        </DataTrigger>
                                                                    </Border.Triggers>
                                                                    <BoxView Color="{Binding Colour}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>
                                                    <FlexLayout Direction="Row"
                                                                Wrap="Wrap"
                                                                BindableLayout.ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SpecialistSlotLegendItems}"
                                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowSpecialistSlotsLegend}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate>
                                                                <HorizontalStackLayout Spacing="4"
                                                                                       Margin="0,0,10,2">
                                                                    <Border WidthRequest="10"
                                                                            HeightRequest="10"
                                                                            Stroke="{StaticResource StrongStrokeColor}"
                                                                            StrokeThickness="0.75"
                                                                            BackgroundColor="{Binding Colour}"
                                                                            VerticalOptions="Center">
                                                                        <Border.Triggers>
                                                                            <DataTrigger TargetType="Border"
                                                                                         Binding="{Binding IsUnselected}"
                                                                                         Value="True">
                                                                                <Setter Property="StrokeThickness"
                                                                                        Value="0"/>
                                                                            </DataTrigger>
                                                                        </Border.Triggers>
                                                                    </Border>
                                                                    <Label Text="{Binding DisplayText}"
                                                                           FontSize="12"
                                                                           Opacity="0.8"
                                                                           VerticalTextAlignment="Center"/>
                                                                </HorizontalStackLayout>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </controls:AnimatedExpandView>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Email Excel"
                                Command="{Binding ExportSpellsToExcelCommand}"/>
                        <Button Text="Copy"
                                Command="{Binding CopySpellsCommand}"/>
                        <Button Text="Save .txt"
                                Command="{Binding SaveSpellsTextCommand}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage>

    <ContentPage x:Name="MiraclesTab"
                 Title="Miracles">
        <Grid StyleId="__overlay_host__">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollView>
                <VerticalStackLayout Padding="16"
                                     Spacing="12">
                    <VerticalStackLayout IsVisible="{Binding ShowEvilStairway}"
                                         Spacing="10">
                        <Label Text="Evil Stairway"
                               FontAttributes="Bold"
                               FontSize="18"/>
                        <Frame Padding="12"
                               CornerRadius="12"
                               BorderColor="{StaticResource SurfaceBorderColor}"
                               HasShadow="False"
                               BindingContext="{Binding EvilStairway}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding ListSourceLabel}"
                                       FontSize="12"
                                       Opacity="0.7"/>

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <controls:DictionarySearchBar x:TypeArguments="viewModels:MiracleOption"
                                                                  ItemsSource="{Binding FilteredOptions}"
                                                                  SelectedValue="{Binding SelectedMiracleOption, Mode=TwoWay}"
                                                                  SelectedText="{Binding SearchText, Mode=TwoWay}"
                                                                  PlaceholderText="Type miracle name"
                                                                  SelectionDisplayMemberPath="Name"/>
                                    <Button Grid.Column="1"
                                            Text="Add"
                                            Command="{Binding AddSelectedCommand}"
                                            IsEnabled="{Binding CanAddSelected}"/>
                                </Grid>

                                <ScrollView Orientation="Horizontal">
                                    <controls:MultiChipGroup Items="{Binding SphereFilterOptions}"
                                                             SelectedItems="{Binding SelectedSphereFilters}"
                                                             WrapMode="NoWrap"/>
                                </ScrollView>
                                <controls:MultiChipGroup Items="{Binding AdvancedFilterOptions}"
                                                         SelectedItems="{Binding SelectedAdvancedFilters}"
                                                         WrapMode="NoWrap"
                                                         IsVisible="{Binding ShowAdvancedFilters}"/>

                                <Grid ColumnDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="12">
                                    <Label Text="{Binding SpiritProgressText}"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding RemainingSpiritText}"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding CausingProgressText}"
                                           IsVisible="{Binding ShowCausingRequirement}"/>
                                </Grid>

                                <Grid ColumnDefinitions="50,*,40,90,Auto,Auto"
                                      ColumnSpacing="6">
                                    <Label Text="Lvl"
                                           FontAttributes="Bold"/>
                                    <Label Grid.Column="1"
                                           Text="Miracle"
                                           FontAttributes="Bold"/>
                                    <Label Grid.Column="2"
                                           Text="Uses"
                                           FontAttributes="Bold"/>
                                    <Label Grid.Column="3"
                                           Text="Running total"
                                           FontAttributes="Bold"/>
                                    <Label Grid.Column="4"
                                           Grid.ColumnSpan="2"
                                           Text="Adjust"
                                           FontAttributes="Bold"/>
                                </Grid>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:EvilStairwayRowVm">
                                            <Grid ColumnDefinitions="50,*,40,90,Auto,Auto"
                                                  ColumnSpacing="6"
                                                  Padding="0,2">
                                                <Label Text="{Binding Power}"
                                                       FontSize="12"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="12"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="2"
                                                       Text="{Binding UsesLabel}"
                                                       FontSize="12"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="3"
                                                       Text="{Binding TotalLabel}"
                                                       FontSize="12"
                                                       VerticalOptions="Center"/>
                                                <Button Grid.Column="4"
                                                        Text="+"
                                                        FontSize="12"
                                                        Padding="0"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        MinimumWidthRequest="28"
                                                        MinimumHeightRequest="28"
                                                        Command="{Binding IncreaseCommand}"
                                                        IsEnabled="{Binding CanIncrease}"/>
                                                <Button Grid.Column="5"
                                                        Text="-"
                                                        FontSize="12"
                                                        Padding="0"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        MinimumWidthRequest="28"
                                                        MinimumHeightRequest="28"
                                                        Command="{Binding DecreaseCommand}"
                                                        IsEnabled="{Binding CanDecrease}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="{Binding ValidationMessage}"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       FontSize="12"
                                       IsVisible="{Binding HasValidationError}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding ShowPriestMiracleLists}"
                                         Spacing="12">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MiracleLists}"
                                             Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="12"
                                           CornerRadius="12"
                                           BorderColor="{StaticResource SurfaceBorderColor}"
                                           HasShadow="False">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                  ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding HeaderTitle}"
                                                           FontAttributes="Bold"
                                                           FontSize="16"/>
                                                    <Label Text="{Binding StateLabel}"
                                                           FontSize="12"
                                                           Opacity="0.6"/>
                                                </VerticalStackLayout>
                                                <ImageButton Grid.Column="1"
                                                             HeightRequest="32"
                                                             WidthRequest="32"
                                                             Padding="6"
                                                             BackgroundColor="Transparent"
                                                             IsVisible="{Binding CanReopenScriptures}"
                                                             Command="{Binding ReopenScripturesCommand}">
                                                    <ImageButton.Source>
                                                        <FontImageSource Glyph="✏️"
                                                                         Size="16"
                                                                         Color="Black"/>
                                                    </ImageButton.Source>
                                                </ImageButton>
                                                <Button Grid.Column="2"
                                                        Text="{Binding IsExpanded, Converter={StaticResource ChevronConverter}}"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{StaticResource MutedTextColor}"
                                                        Padding="0"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Command="{Binding ToggleExpandedCommand}"/>
                                            </Grid>

                                            <controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}"
                                                                         AnimationName="AdvanceMiracleListExpand">
                                                <VerticalStackLayout Spacing="10">
                                                    <VerticalStackLayout IsVisible="{Binding CanEdit}"
                                                                         Spacing="10">
                                                        <Grid ColumnDefinitions="*"
                                                              ColumnSpacing="8">
                                                            <controls:DictionarySearchBar x:TypeArguments="viewModels:MiracleOption"
                                                                                          ItemsSource="{Binding FilteredOptions}"
                                                                                          SelectedValue="{Binding SelectedMiracleOption, Mode=TwoWay}"
                                                                                          SelectedText="{Binding SearchText, Mode=TwoWay}"
                                                                                          PlaceholderText="Type miracle name"
                                                                                          SelectionDisplayMemberPath="Name"
                                                                                          ResultSelectedCommand="{Binding AddSelectedCommand}"
                                                                                          KeepFocusOnResultSelection="True"
                                                                                          ClearAfterResultSelection="True"
                                                                                          KeyboardAvoidanceEnabled="True"
                                                                                          IsEnabled="{Binding CanEdit}"/>
                                                        </Grid>

                                                        <ScrollView Orientation="Horizontal">
                                                            <controls:MultiChipGroup Items="{Binding SphereFilterOptions}"
                                                                                     SelectedItems="{Binding SelectedSphereFilters}"
                                                                                     WrapMode="NoWrap"/>
                                                        </ScrollView>
                                                        <controls:MultiChipGroup Items="{Binding AdvancedFilterOptions}"
                                                                                 SelectedItems="{Binding SelectedAdvancedFilters}"
                                                                                 WrapMode="NoWrap"/>


                                                        <VerticalStackLayout IsVisible="{Binding ShowNeutralAlignmentChoice}"
                                                                             Spacing="4">
                                                            <Label Text="Neutral list alignment"
                                                                   FontAttributes="Bold"
                                                                   FontSize="12"
                                                                   Opacity="0.7"/>
                                                            <controls:ChipGroup Items="{Binding NeutralAlignmentOptions}"
                                                                                SelectedItem="{Binding NeutralAlignmentChoice, Mode=TwoWay}"/>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>

                                                    <Label Text="{Binding ScripturesProgressText}"
                                                           IsVisible="{Binding IsScriptures}"
                                                           FontSize="12"
                                                           Opacity="0.8"/>

                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                          ColumnSpacing="8"
                                                          Padding="10,0">
                                                        <Label Text="Name"
                                                               FontAttributes="Bold"
                                                               FontSize="12"
                                                               Opacity="0.75"/>
                                                        <Label Grid.Column="1"
                                                               Text="Level"
                                                               FontAttributes="Bold"
                                                               FontSize="12"
                                                               Opacity="0.75"
                                                               HorizontalTextAlignment="End"/>
                                                        <Label Grid.Column="2"
                                                               Grid.ColumnSpan="2"
                                                               Text="Actions"
                                                               FontAttributes="Bold"
                                                               FontSize="12"
                                                               Opacity="0.75"
                                                               HorizontalTextAlignment="Center"/>
                                                    </Grid>

                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}"
                                                                         Spacing="8">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        BackgroundColor="{Binding RowBackgroundColor}">
                                                                    <Grid Padding="10,8"
                                                                          ColumnDefinitions="*,Auto,Auto,Auto"
                                                                          ColumnSpacing="8">
                                                                        <Label Text="{Binding NameText}"
                                                                               FontSize="14"
                                                                               MaxLines="1"
                                                                               LineBreakMode="TailTruncation"
                                                                               VerticalTextAlignment="Center"/>
                                                                        <Label Grid.Column="1"
                                                                               Text="{Binding PowerText}"
                                                                               FontSize="14"
                                                                               FontAttributes="Bold"
                                                                               Opacity="0.75"
                                                                               HorizontalTextAlignment="End"
                                                                               VerticalTextAlignment="Center"/>
                                                                        <Button Grid.Column="2"
                                                                                Text="&#xF05A;"
                                                                                FontFamily="FASolid"
                                                                                FontSize="12"
                                                                                Padding="0"
                                                                                BackgroundColor="Transparent"
                                                                                TextColor="{StaticResource SubtleTextColor}"
                                                                                HeightRequest="18"
                                                                                WidthRequest="18"
                                                                                MinimumHeightRequest="0"
                                                                                MinimumWidthRequest="0"
                                                                                IsVisible="{Binding HasMiracle}"
                                                                                Clicked="OnViewMiracleDetailsClicked"
                                                                                CommandParameter="{Binding .}"/>
                                                                        <Button Grid.Column="3"
                                                                                Text="&#xF2ED;"
                                                                                FontFamily="FASolid"
                                                                                FontSize="12"
                                                                                Padding="0"
                                                                                BackgroundColor="Transparent"
                                                                                TextColor="{StaticResource SubtleTextColor}"
                                                                                HeightRequest="18"
                                                                                WidthRequest="18"
                                                                                MinimumHeightRequest="0"
                                                                                MinimumWidthRequest="0"
                                                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.CanEdit}"
                                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.RemoveEntryCommand}"
                                                                                CommandParameter="{Binding .}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Spacing="6"
                                                                         IsVisible="{Binding IsExpanded}">
                                                        <Label Text="Alignment split"
                                                               FontSize="12"
                                                               Opacity="0.7"/>
                                                        <Border Stroke="{StaticResource SoftStrokeColor}"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 6"
                                                                BackgroundColor="#F9FAFB"
                                                                Padding="0">
                                                            <Grid HeightRequest="10"
                                                                  ColumnSpacing="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding GoodWidth}"/>
                                                                    <ColumnDefinition Width="{Binding NeutralWidth}"/>
                                                                    <ColumnDefinition Width="{Binding EvilWidth}"/>
                                                                    <ColumnDefinition Width="{Binding UnselectedWidth}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Stroke="{StaticResource StrongStrokeColor}"
                                                                        StrokeThickness="0.75"
                                                                        BackgroundColor="{StaticResource White}">
                                                                    <Border.Shadow>
                                                                        <Shadow Brush="{StaticResource ShadowColor}"
                                                                                Offset="0,1"
                                                                                Radius="3"
                                                                                Opacity="0.45"/>
                                                                    </Border.Shadow>
                                                                </Border>
                                                                <Border Grid.Column="1"
                                                                        Stroke="{StaticResource StrongStrokeColor}"
                                                                        StrokeThickness="0.75"
                                                                        BackgroundColor="{StaticResource SubtleTextColor}">
                                                                    <Border.Shadow>
                                                                        <Shadow Brush="{StaticResource ShadowColor}"
                                                                                Offset="0,1"
                                                                                Radius="3"
                                                                                Opacity="0.45"/>
                                                                    </Border.Shadow>
                                                                </Border>
                                                                <Border Grid.Column="2"
                                                                        Stroke="{StaticResource StrongStrokeColor}"
                                                                        StrokeThickness="0.75"
                                                                        BackgroundColor="{StaticResource StrongBackgroundColor}">
                                                                    <Border.Shadow>
                                                                        <Shadow Brush="{StaticResource ShadowColor}"
                                                                                Offset="0,1"
                                                                                Radius="3"
                                                                                Opacity="0.45"/>
                                                                    </Border.Shadow>
                                                                </Border>
                                                                <Border Grid.Column="3"
                                                                        StrokeThickness="0"
                                                                        BackgroundColor="{StaticResource SoftStrokeColor}"/>
                                                            </Grid>
                                                        </Border>

                                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                                              ColumnSpacing="10">
                                                            <HorizontalStackLayout Spacing="4">
                                                                <BoxView WidthRequest="10"
                                                                         HeightRequest="10"
                                                                         Color="{StaticResource White}"
                                                                         VerticalOptions="Center"/>
                                                                <Label Text="{Binding GoodPoints, StringFormat='Goodly {0}'}"
                                                                       FontSize="12"
                                                                       Opacity="0.8"
                                                                       VerticalTextAlignment="Center"/>
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout Grid.Column="1"
                                                                                   Spacing="4">
                                                                <BoxView WidthRequest="10"
                                                                         HeightRequest="10"
                                                                         Color="{StaticResource SubtleTextColor}"
                                                                         VerticalOptions="Center"/>
                                                                <Label Text="{Binding NeutralPoints, StringFormat='Neutral {0}'}"
                                                                       FontSize="12"
                                                                       Opacity="0.8"
                                                                       VerticalTextAlignment="Center"/>
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout Grid.Column="2"
                                                                                   Spacing="4">
                                                                <BoxView WidthRequest="10"
                                                                         HeightRequest="10"
                                                                         Color="{StaticResource StrongBackgroundColor}"
                                                                         VerticalOptions="Center"/>
                                                                <Label Text="{Binding EvilPoints, StringFormat='Evil {0}'}"
                                                                       FontSize="12"
                                                                       Opacity="0.8"
                                                                       VerticalTextAlignment="Center"/>
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout Grid.Column="3"
                                                                                   Spacing="4">
                                                                <BoxView WidthRequest="10"
                                                                         HeightRequest="10"
                                                                         Color="{StaticResource SoftStrokeColor}"
                                                                         VerticalOptions="Center"/>
                                                                <Label Text="{Binding UnselectedPoints, StringFormat='Unset {0}'}"
                                                                       FontSize="12"
                                                                       Opacity="0.8"
                                                                       VerticalTextAlignment="Center"/>
                                                            </HorizontalStackLayout>
                                                        </Grid>
                                                    </VerticalStackLayout>

                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="8">
                                                        <Label Text="{Binding TotalPoints, StringFormat='Total spirit: {0}/60'}"
                                                               FontSize="12"
                                                               Opacity="0.8"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding AdvancedPoints, StringFormat='Advanced spirit: {0}/10'}"
                                                               FontSize="12"
                                                               Opacity="0.8"/>
                                                    </Grid>

                                                    <Label Text="{Binding ValidationMessage}"
                                                           TextColor="{StaticResource AccentMaroonColor}"
                                                           IsVisible="{Binding HasValidationError}"
                                                           FontSize="12"/>
                                                </VerticalStackLayout>
                                            </controls:AnimatedExpandView>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage>

    <ContentPage x:Name="EvocsTab"
                 Title="Evocations">
        <Grid StyleId="__overlay_host__">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollView>
                <VerticalStackLayout Padding="16"
                                     Spacing="12">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EvocationLists}"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12"
                                       CornerRadius="12"
                                       BorderColor="{StaticResource SurfaceBorderColor}"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <Label Text="{Binding HeaderTitle}"
                                                   FontAttributes="Bold"
                                                   FontSize="16"/>
                                            <Button Grid.Column="1"
                                                    Text="{Binding IsExpanded, Converter={StaticResource ChevronConverter}}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource MutedTextColor}"
                                                    Padding="0"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    Command="{Binding ToggleExpandedCommand}"/>
                                        </Grid>

                                        <controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}"
                                                                     AnimationName="AdvanceEvocationListExpand">
                                            <VerticalStackLayout Spacing="10">
                                                <Grid ColumnDefinitions="*"
                                                      ColumnSpacing="8">
                                                    <controls:DictionarySearchBar x:TypeArguments="viewModels:EvocationOption"
                                                                                  ItemsSource="{Binding FilteredOptions}"
                                                                                  SelectedValue="{Binding SelectedEvocationOption, Mode=TwoWay}"
                                                                                  PlaceholderText="Type evocation name"
                                                                                  SelectionDisplayMemberPath="Name"
                                                                                  ResultSelectedCommand="{Binding AddSelectedCommand}"
                                                                                  KeepFocusOnResultSelection="True"
                                                                                  ClearAfterResultSelection="True"
                                                                                  KeyboardAvoidanceEnabled="True"/>
                                                </Grid>

                                                <ScrollView Orientation="Horizontal">
                                                    <controls:MultiChipGroup Items="{Binding FieldFilterOptions}"
                                                                             SelectedItems="{Binding SelectedFieldFilters}"
                                                                             WrapMode="NoWrap"/>
                                                </ScrollView>

                                                <ScrollView Orientation="Horizontal">
                                                    <controls:MultiChipGroup Items="{Binding TierFilterOptions}"
                                                                             SelectedItems="{Binding SelectedTierFilters}"
                                                                             WrapMode="NoWrap"/>
                                                </ScrollView>

                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                      ColumnSpacing="8"
                                                      Padding="10,0">
                                                    <Label Text="Name"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           Opacity="0.75"/>
                                                    <Label Grid.Column="1"
                                                           Text="Level"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           Opacity="0.75"
                                                           HorizontalTextAlignment="End"/>
                                                    <Label Grid.Column="2"
                                                           Grid.ColumnSpan="2"
                                                           Text="Actions"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           Opacity="0.75"
                                                           HorizontalTextAlignment="Center"/>
                                                </Grid>

                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}"
                                                                     Spacing="8">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    BackgroundColor="{Binding RowBackgroundColor}">
                                                                <Grid Padding="10,8"
                                                                      ColumnDefinitions="*,Auto,Auto,Auto"
                                                                      ColumnSpacing="8">
                                                                    <Label Text="{Binding NameText}"
                                                                           FontSize="14"
                                                                           MaxLines="1"
                                                                           LineBreakMode="TailTruncation"
                                                                           VerticalTextAlignment="Center"/>
                                                                    <Label Grid.Column="1"
                                                                           Text="{Binding PowerText}"
                                                                           FontSize="14"
                                                                           FontAttributes="Bold"
                                                                           Opacity="0.75"
                                                                           HorizontalTextAlignment="End"
                                                                           VerticalTextAlignment="Center"/>
                                                                    <Button Grid.Column="2"
                                                                            Text="&#xF05A;"
                                                                            FontFamily="FASolid"
                                                                            FontSize="12"
                                                                            Padding="0"
                                                                            BackgroundColor="Transparent"
                                                                            TextColor="{StaticResource SubtleTextColor}"
                                                                            HeightRequest="18"
                                                                            WidthRequest="18"
                                                                            MinimumHeightRequest="0"
                                                                            MinimumWidthRequest="0"
                                                                            IsVisible="{Binding HasEvocation}"
                                                                            Clicked="OnViewEvocationDetailsClicked"
                                                                            CommandParameter="{Binding .}"/>
                                                                    <Button Grid.Column="3"
                                                                            Text="&#xF2ED;"
                                                                            FontFamily="FASolid"
                                                                            FontSize="12"
                                                                            Padding="0"
                                                                            BackgroundColor="Transparent"
                                                                            TextColor="{StaticResource SubtleTextColor}"
                                                                            HeightRequest="18"
                                                                            WidthRequest="18"
                                                                            MinimumHeightRequest="0"
                                                                            MinimumWidthRequest="0"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type Frame}}, Path=BindingContext.RemoveEntryCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Spacing="6"
                                                                     IsVisible="{Binding HasFieldBreakdown}">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <Label Text="Field split"
                                                               FontSize="12"
                                                               Opacity="0.7"/>
                                                        <Button Grid.Column="1"
                                                                Text="{Binding FieldLegendChevronText}"
                                                                BackgroundColor="Transparent"
                                                                TextColor="{StaticResource MutedTextColor}"
                                                                Padding="0"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                Command="{Binding ToggleFieldLegendCommand}"/>
                                                    </Grid>

                                                    <FlexLayout Direction="Row"
                                                                HeightRequest="10"
                                                                BindableLayout.ItemsSource="{Binding FieldBreakdownSegments}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate>
                                                                <BoxView Color="{Binding Colour}"
                                                                         FlexLayout.Grow="{Binding Weight}"/>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>

                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FieldLegendItems}"
                                                                         IsVisible="{Binding ShowFieldLegend}"
                                                                         Spacing="4">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                                      ColumnSpacing="8">
                                                                    <BoxView WidthRequest="10"
                                                                             HeightRequest="10"
                                                                             Color="{Binding Colour}"
                                                                             VerticalOptions="Center"/>
                                                                    <Label Grid.Column="1"
                                                                           Text="{Binding FieldName}"
                                                                           FontSize="12"
                                                                           VerticalTextAlignment="Center"/>
                                                                    <Label Grid.Column="2"
                                                                           Text="{Binding SummaryText}"
                                                                           FontSize="12"
                                                                           Opacity="0.8"
                                                                           HorizontalTextAlignment="End"
                                                                           VerticalTextAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>

                                                <Grid ColumnDefinitions="*,*"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding TotalPower, StringFormat='Total EP: {0}/60'}"
                                                           FontSize="12"
                                                           Opacity="0.8"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding AdvancedPower, StringFormat='Advanced EP: {0}/20'}"
                                                           FontSize="12"
                                                           Opacity="0.8"/>
                                                </Grid>

                                                <Label Text="{Binding ValidationMessage}"
                                                       TextColor="{StaticResource AccentMaroonColor}"
                                                       IsVisible="{Binding HasValidationError}"
                                                       FontSize="12"/>
                                            </VerticalStackLayout>
                                        </controls:AnimatedExpandView>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage>
</TabbedPage>
