<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.CharacterInfoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:pickers="clr-namespace:labyItems.Controls.Pickers">

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="12">
            <Label Text="Player name"
                   FontAttributes="Bold"/>
            <Entry Placeholder="e.g. Alex"
                   Text="{Binding PlayerName, Mode=TwoWay}"/>

            <Label Text="Character name"
                   FontAttributes="Bold"/>
            <Entry Placeholder="e.g. Stormcaller"
                   Text="{Binding CharacterName, Mode=TwoWay}"/>

            <Label Text="Alignment"
                   FontAttributes="Bold"/>
            <pickers:AlignmentGridPicker SelectedAlignment="{Binding SelectedAlignment, Mode=TwoWay}"
                                          AvailableAlignments="{Binding AlignmentOptions}"/>

            <Label Text="Armour"
                   FontAttributes="Bold"/>
            <Label Text="{Binding ArmourAvailabilityText}"
                   FontSize="12"
                   Opacity="0.7"/>
            <controls:DictionarySliderHeader
                KeyText="{Binding KeyText, Source={x:Reference ArmourSlider}}"
                ValueText="{Binding ValueText, Source={x:Reference ArmourSlider}}"/>
            <controls:DictionarySlider x:Name="ArmourSlider"
                                       KeyFormat=""
                                       ValueFormat=""
                                       ItemsSource="{Binding ArmourPacItems}"
                                       Labels="{Binding ArmourPacLabels}"
                                       SnapToStep="True"
                                       StepSize="1"
                                       SelectedIndex="{Binding ArmourSliderIndex, Mode=TwoWay}"
                                       IsEnabled="{Binding IsArmourSelectionEnabled}"/>
            <Label Text="{Binding ArmourBaseSummary}"
                   FontSize="12"
                   Opacity="0.8"/>

            <Label Text="Notes"
                   FontAttributes="Bold"/>
            <Editor Placeholder="Anything you want to remember for this character"
                    HeightRequest="140"
                    AutoSize="TextChanges"
                    Text="{Binding NotesText, Mode=TwoWay}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
