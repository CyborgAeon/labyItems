<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="labyItems.Pages.Characters.MultiRaceSpecialisationPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:labyItems.Pages.Characters" xmlns:viewModels="clr-namespace:labyItems.Pages.Characters.ViewModels" Title="Multi-Race Specialisation" BackgroundColor="{StaticResource White}" NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False">
 <Grid RowDefinitions="Auto,*,Auto">
  <Border Padding="16,12" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Multi-Race Specialisation" FontAttributes="Bold" FontSize="18"/><Label Text="{Binding SelectedRaceName}" FontSize="12" Opacity="0.75"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding SelectedLevelsText}" VerticalOptions="Center" Opacity="0.7"/></Grid></Border>
  <ScrollView Grid.Row="1"><VerticalStackLayout Padding="16" Spacing="10"><Label Text="No multi-race choice sets are unlocked at the current level." IsVisible="{Binding HasNoGroups}" Opacity="0.7" HorizontalTextAlignment="Center"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="10"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ChoiceSetGroupVm"><local:ChoiceSetGroupView/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></ScrollView>
  <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Padding="16,10,16,18" BackgroundColor="{StaticResource White}"><Button Text="Back" Command="{Binding BackCommand}"/><Button Grid.Column="2" Text="Save" Command="{Binding SaveCommand}"/></Grid>
 </Grid>
</ContentPage>
