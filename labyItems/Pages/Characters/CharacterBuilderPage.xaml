<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  x:Class="labyItems.Pages.CharacterBuilderPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

  <Grid RowDefinitions="Auto,Auto,Auto,*"
        Padding="16"
        RowSpacing="14">

    <!-- Tabs (Class / Race) -->
    <toolkit:TabView
      SelectedIndex="{Binding Step1.SelectedTabIndex}"
      TabStripPlacement="Top"
      Grid.Row="0">

      <toolkit:TabViewItem Text="Class">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="14">

          <!-- Search -->
          <SearchBar
            Placeholder="Search classes..."
            Text="{Binding Step1.ClassSearchText}"/>

          <!-- Filter chips -->
          <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Step1.ClassFilters}"
            ItemsLayout="HorizontalList"
            SelectionMode="Single"
            SelectedItem="{Binding Step1.SelectedClassFilter}">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Frame Padding="10,6"
                       CornerRadius="16"
                       HasShadow="False"
                       Margin="0,0,8,0">
                  <Label Text="{Binding}"/>
                </Frame>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <!-- Cards -->
          <CollectionView Grid.Row="2"
                          ItemsSource="{Binding Step1.FilteredClasses}"
                          SelectionMode="None">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Frame Margin="0,0,0,12"
                       Padding="14"
                       CornerRadius="12">
                  <Grid RowDefinitions="Auto,Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="8">

                    <!-- Header -->
                    <VerticalStackLayout Grid.Row="0"
                                         Grid.Column="0"
                                         Spacing="2">
                      <Label Text="{Binding Name}"
                             FontAttributes="Bold"
                             FontSize="18"/>
                      <Label Text="{Binding Category}"
                             FontSize="12"
                             Opacity="0.7"/>
                    </VerticalStackLayout>

                    <!-- Caret / expand -->
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Text="˅"
                            Command="{Binding BindingContext.Step1.ToggleClassExpandedCommand, Source={x:Reference Name=Root}}"
                            CommandParameter="{Binding .}"
                            Padding="6"
                            BackgroundColor="Transparent"/>

                    <!-- Summary -->
                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding Summary}"
                           LineBreakMode="TailTruncation"
                           MaxLines="3"
                           Opacity="0.9"/>

                    <!-- Tags / stats row -->
                    <HorizontalStackLayout Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Spacing="10">
                      <Frame Padding="10,4"
                             CornerRadius="14"
                             HasShadow="False">
                        <Label Text="{Binding Tag1}"
                               FontSize="12"/>
                      </Frame>
                      <Frame Padding="10,4"
                             CornerRadius="14"
                             HasShadow="False">
                        <Label Text="{Binding Tag2}"
                               FontSize="12"/>
                      </Frame>
                      <Frame Padding="10,4"
                             CornerRadius="14"
                             HasShadow="False">
                        <Label Text="{Binding Tag3}"
                               FontSize="12"/>
                      </Frame>
                    </HorizontalStackLayout>

                    <!-- Expanded details -->
                    <VerticalStackLayout Grid.Row="3"
                                         Grid.ColumnSpan="2"
                                         IsVisible="{Binding IsExpanded}"
                                         Spacing="8"
                                         Margin="0,6,0,0">
                      <Label Text="{Binding FullDetails}"
                             Opacity="0.9"/>
                      <Button Text="Select"
                              Command="{Binding BindingContext.Step1.SelectClassCommand, Source={x:Reference Name=Root}}"
                              CommandParameter="{Binding .}"/>
                    </VerticalStackLayout>

                  </Grid>
                </Frame>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

        </Grid>
      </toolkit:TabViewItem>

      <toolkit:TabViewItem Text="Race">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="14">

          <SearchBar
            Placeholder="Search races..."
            Text="{Binding Step1.RaceSearchText}"/>

          <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Step1.RaceFilters}"
            ItemsLayout="HorizontalList"
            SelectionMode="Single"
            SelectedItem="{Binding Step1.SelectedRaceFilter}">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Frame Padding="10,6"
                       CornerRadius="16"
                       HasShadow="False"
                       Margin="0,0,8,0">
                  <Label Text="{Binding}"/>
                </Frame>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <CollectionView Grid.Row="2"
                          ItemsSource="{Binding Step1.FilteredRaces}"
                          SelectionMode="None">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Frame Margin="0,0,0,12"
                       Padding="14"
                       CornerRadius="12">
                  <Grid RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="8">
                    <VerticalStackLayout>
                      <Label Text="{Binding Name}"
                             FontAttributes="Bold"
                             FontSize="18"/>
                      <Label Text="{Binding Summary}"
                             MaxLines="3"
                             LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Select"
                            Command="{Binding BindingContext.Step1.SelectRaceCommand, Source={x:Reference Name=Root}}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="Transparent"/>
                  </Grid>
                </Frame>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

        </Grid>
      </toolkit:TabViewItem>

    </toolkit:TabView>

  </Grid>
</ContentView>
