<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.Guilds"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:local="clr-namespace:labyItems.Pages.Characters">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="16"
          RowSpacing="10">

        <FlexLayout Grid.Row="0"
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Center"
                    JustifyContent="Start"
                    BindableLayout.ItemsSource="{Binding SelectedGuilds}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding DisplayName}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleSelectedCommand}"
                            CommandParameter="{Binding .}"
                            Padding="12,6"
                            FontSize="13"
                            Margin="0,0,8,8"
                            BackgroundColor="{StaticResource SelectedSurfaceBackgroundColor}"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="18"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
                <controls:BackNavigationButton Grid.Column="0"
                                               IsVisible="{Binding Source={x:Reference Root}, Path=ShowBackButton}"
                                               Command="{Binding Source={x:Reference Root}, Path=BackCommand}" />
                <Entry Grid.Column="1"
                       Placeholder="Search guilds..."
                       ClearButtonVisibility="WhileEditing"
                       Text="{Binding SearchText}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Picker Title="Type"
                    ItemsSource="{Binding TypeFilters}"
                    SelectedItem="{Binding SelectedTypeFilter}"
                    IsVisible="{Binding Source={x:Reference Root}, Path=UseTypePills, Converter={StaticResource InverseBoolConverter}}"/>

            <CollectionView ItemsSource="{Binding TypeFilterChips}"
                            SelectionMode="None"
                            IsVisible="{Binding Source={x:Reference Root}, Path=UseTypePills}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="38">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                                Margin="0,0,8,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleTypeFilterChipCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}"
                                   Style="{StaticResource FilterPillLabelStyle}"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding FilteredGuilds}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureAllItems">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <local:GuildCardView
                        ToggleExpandedCommand="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleExpandedCommand}"
                        SelectCommand="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleSelectedCommand}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
