<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.Guilds"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <FlexLayout Grid.Row="0"
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Center"
                    JustifyContent="Start"
                    BindableLayout.ItemsSource="{Binding SelectedGuilds}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Name}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleSelectedCommand}"
                            CommandParameter="{Binding .}"
                            Padding="12,6"
                            FontSize="13"
                            Margin="0,0,8,8"
                            BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#241010}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="18"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,12,160">
            <SearchBar Grid.Column="0"
                       Placeholder="Search guilds..."
                       Text="{Binding SearchText}"/>
            <Picker Grid.Column="2"
                    Title="Type"
                    ItemsSource="{Binding TypeFilters}"
                    SelectedItem="{Binding SelectedTypeFilter}"/>
        </Grid>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredGuilds}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <local:GuildCardView
                        ToggleExpandedCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ToggleExpandedCommand}"
                        SelectCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ToggleSelectedCommand}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
