<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.Guilds"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="4">
            <Label Text="Guilds"
                   FontSize="20"
                   FontAttributes="Bold"/>
            <Label Text="Optional: tap a guild to expand. Use the Select button to add/remove from the draft."
                   Opacity="0.7"/>
        </VerticalStackLayout>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,12,160">
            <SearchBar Grid.Column="0"
                       Placeholder="Search guilds..."
                       Text="{Binding SearchText}"/>
            <Picker Grid.Column="2"
                    Title="Type"
                    ItemsSource="{Binding TypeFilters}"
                    SelectedItem="{Binding SelectedTypeFilter}"/>
        </Grid>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredGuilds}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <local:GuildCardView
                        ToggleExpandedCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ToggleExpandedCommand}"
                        SelectCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ToggleSelectedCommand}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
