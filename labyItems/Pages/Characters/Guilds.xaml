<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.Guilds"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:local="clr-namespace:labyItems.Pages.Characters">

    <Grid>
    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="16"
          RowSpacing="10">

        <FlexLayout Grid.Row="0"
                    IsVisible="{Binding Source={x:Reference Root}, Path=ShowSelectedChips}"
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Center"
                    JustifyContent="Start"
                    BindableLayout.ItemsSource="{Binding SelectedGuilds}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding DisplayName}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleSelectedCommand}"
                            CommandParameter="{Binding .}"
                            Padding="12,6"
                            FontSize="13"
                            Margin="0,0,8,8"
                            BackgroundColor="{StaticResource SelectedSurfaceBackgroundColor}"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="18"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
                <ContentView x:Name="HeaderLeadingHost"
                             Grid.Column="0" />
                <Border Grid.Column="1"
                        Stroke="{StaticResource SurfaceBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#F9FAFB"
                        Padding="8,4"
                        VerticalOptions="Center">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="6">
                        <Entry Placeholder="Search guilds..."
                               ClearButtonVisibility="WhileEditing"
                               Text="{Binding SearchText}"/>
                        <Button Grid.Column="1"
                                Text="{x:Static helpers:FontAwesomeGlyphs.Filter}"
                                FontFamily="FASolid"
                                FontSize="13"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SubtleTextColor}"
                                HeightRequest="24"
                                WidthRequest="24"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                VerticalOptions="Center"
                                IsVisible="{Binding Source={x:Reference Root}, Path=UseTypePills}"
                                Command="{Binding OpenFiltersCommand}"/>
                        <ActivityIndicator IsRunning="{Binding IsSearchInProgress}"
                                           IsVisible="{Binding IsSearchInProgress}"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Margin="0,0,36,0"
                                           InputTransparent="True"/>
                    </Grid>
                </Border>
        </Grid>

        <Grid Grid.Row="2"
              IsVisible="{Binding Source={x:Reference Root}, Path=UseTypePills, Converter={StaticResource InverseBoolConverter}}">
            <Picker Title="Type"
                    ItemsSource="{Binding TypeFilters}"
                    SelectedItem="{Binding SelectedTypeFilter}"/>
        </Grid>

        <Grid Grid.Row="3">
            <CollectionView x:Name="GuildList"
                            ItemsSource="{Binding FilteredGuilds}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemsUpdatingScrollMode="KeepScrollOffset">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Stroke="{StaticResource SubtleTextColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource White}"
                                Margin="0,0,0,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource AccentMaroonColor}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource SelectedSurfaceBackgroundColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGuildTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Stroke="#D8B4FE"
                                        BackgroundColor="#F3E8FF"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="26" HeightRequest="26"
                                        VerticalOptions="Start" Margin="0,2,0,0">
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.Guild}"
                                           FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                                           FontSize="12" TextColor="#581C87"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"
                                           LineBreakMode="WordWrap" Margin="0,0,4,0" />
                                    <Label Text="{Binding Type}" FontSize="12" Opacity="0.75"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding NotSelectableReason}" FontSize="12" Opacity="0.8"
                                           MaxLines="2" LineBreakMode="WordWrap"
                                           IsVisible="{Binding HasNotSelectableReason}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" StrokeThickness="0"
                                        BackgroundColor="Transparent" StrokeShape="RoundRectangle 999"
                                        WidthRequest="28" HeightRequest="28"
                                        VerticalOptions="Start" HorizontalOptions="End">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnGuildInfoTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                           FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                                           FontSize="13" TextColor="{StaticResource SubtleTextColor}"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border IsVisible="{Binding IsLoading}"
                    BackgroundColor="#CCFFFFFF"
                    StrokeThickness="0"
                    InputTransparent="True">
                <controls:LoadingIndicator IsRunning="{Binding IsLoading}"
                                           Message="Loading guilds..."/>
            </Border>
        </Grid>

    </Grid>

    <Grid IsVisible="{Binding IsFilterModalOpen}"
          BackgroundColor="#66000000">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelFiltersCommand}"/>
        </Grid.GestureRecognizers>
        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="360"
                MaximumWidthRequest="420"
                MaximumHeightRequest="560"
                Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource White}"
                Padding="14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="10">
                <Label Text="Filters"
                       FontAttributes="Bold"
                       FontSize="18"/>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Type"
                               FontAttributes="Bold"
                               FontSize="13"/>
                        <FlexLayout BindableLayout.ItemsSource="{Binding FilterModalChips}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    AlignItems="Start"
                                    JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                                            Margin="0,0,8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.TogglePendingTypeFilterCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}"
                                               Style="{StaticResource FilterPillLabelStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            Command="{Binding CancelFiltersCommand}"/>
                    <Button Grid.Column="2"
                            Text="Search"
                            Command="{Binding ApplyFiltersCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ContentView>
