<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.Characters.Guilds"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:labyItems.Pages.Characters">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <FlexLayout Grid.Row="0"
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Center"
                    JustifyContent="Start"
                    BindableLayout.ItemsSource="{Binding SelectedGuilds}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding DisplayName}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleSelectedCommand}"
                            CommandParameter="{Binding .}"
                            Padding="12,6"
                            FontSize="13"
                            Margin="0,0,8,8"
                            BackgroundColor="{StaticResource SelectedSurfaceBackgroundColor}"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="18"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,12,160">
            <Grid Grid.Column="0"
                  ColumnDefinitions="Auto,*">
                <ImageButton Grid.Column="0"
                             AutomationProperties.Name="Back"
                             IsVisible="{Binding Source={x:Reference Root}, Path=ShowBackButton}"
                             Command="{Binding Source={x:Reference Root}, Path=BackCommand}"
                             BackgroundColor="Transparent"
                             Padding="6"
                             WidthRequest="36"
                             HeightRequest="36"
                             Margin="0,0,4,0">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="FASolid"
                                         Glyph="&#xf060;"
                                         Size="22"
                                         Color="{StaticResource Gray300}"/>
                    </ImageButton.Source>
                </ImageButton>
                <SearchBar Grid.Column="1"
                           Placeholder="Search guilds..."
                           Text="{Binding SearchText}"/>
            </Grid>
            <Picker Grid.Column="2"
                    Title="Type"
                    ItemsSource="{Binding TypeFilters}"
                    SelectedItem="{Binding SelectedTypeFilter}"/>
        </Grid>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredGuilds}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <local:GuildCardView
                        ToggleExpandedCommand="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleExpandedCommand}"
                        SelectCommand="{Binding Source={RelativeSource AncestorType={x:Type local:Guilds}}, Path=BindingContext.ToggleSelectedCommand}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
