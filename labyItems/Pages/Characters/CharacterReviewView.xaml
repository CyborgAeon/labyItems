<?xml version="1.0" encoding="utf-8" ?>
<ContentView
       x:Class="labyItems.Pages.Characters.CharacterReviewView"
       x:Name="Root"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:controls="clr-namespace:labyItems.Controls">

       <ScrollView>
              <VerticalStackLayout Padding="16"
                                   Spacing="14">
                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="8">
                                   <Grid ColumnDefinitions="Auto,*,Auto"
                                         ColumnSpacing="8">
                                          <Label Text="&#xF6DE;"
                                                 FontFamily="FASolid"
                                                 FontSize="14"
                                                 VerticalTextAlignment="Center"/>
                                          <Label Grid.Column="1"
                                                 Text="Level Progression"
                                                 FontAttributes="Bold"
                                                 VerticalTextAlignment="Center"/>
                                          <controls:ChevronIconView x:Name="LevelProgressionChevron"
                                                                    Grid.Column="2"
                                                                    GlyphSize="18"
                                                                    GlyphColor="{StaticResource MutedTextColor}">
                                                 <controls:ChevronIconView.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLevelProgressionChevronTapped" />
                                                 </controls:ChevronIconView.GestureRecognizers>
                                          </controls:ChevronIconView>
                                   </Grid>

                                   <VerticalStackLayout x:Name="LevelProgressionExpandedContent"
                                                        Spacing="8">
                                          <ScrollView Orientation="Horizontal"
                                                      HorizontalScrollBarVisibility="Always"
                                                      VerticalScrollBarVisibility="Never">
                                                 <Grid x:Name="LevelProgressionTableHost" />
                                          </ScrollView>
                                   </VerticalStackLayout>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="4">
                                   <Label Text="Guilds"
                                          FontAttributes="Bold"/>
                                   <Grid IsVisible="{Binding HasGuildReviewRows}"
                                         ColumnDefinitions="96,*,64"
                                         ColumnSpacing="8">
                                          <Label Grid.Column="0"
                                                 Text="Guild Type"
                                                 FontSize="11"
                                                 FontAttributes="Bold"
                                                 TextColor="{StaticResource MutedTextColor}"/>
                                          <Label Grid.Column="1"
                                                 Text="Guild"
                                                 FontSize="11"
                                                 FontAttributes="Bold"
                                                 TextColor="{StaticResource MutedTextColor}"/>
                                          <Label Grid.Column="2"
                                                 Text="Actions"
                                                 FontSize="11"
                                                 FontAttributes="Bold"
                                                 TextColor="{StaticResource MutedTextColor}"
                                                 HorizontalTextAlignment="Center"/>
                                   </Grid>

                                   <VerticalStackLayout IsVisible="{Binding HasGuildReviewRows}"
                                                        Spacing="6"
                                                        BindableLayout.ItemsSource="{Binding GuildReviewRows}">
                                          <BindableLayout.ItemTemplate>
                                                 <DataTemplate>
                                                                 <Grid ColumnDefinitions="96,*,64"
                                                              ColumnSpacing="8"
                                                                        RowDefinitions="Auto"
                                                                        BackgroundColor="{Binding RowBackgroundColor}">
                                                               <Label Grid.Column="0"
                                                                      Text="{Binding GuildType}"
                                                                      FontSize="11"
                                                                      LineBreakMode="TailTruncation"/>
                                                               <Label Grid.Column="1"
                                                                      Text="{Binding GuildName}"
                                                                      LineBreakMode="WordWrap"
                                                                      VerticalTextAlignment="Center"/>
                                                               <HorizontalStackLayout Grid.Column="2"
                                                                                    Spacing="4"
                                                                                    HorizontalOptions="Center">
                                                                      <Button Text="&#xF05A;"
                                                                              FontFamily="FASolid"
                                                                              FontSize="12"
                                                                              Padding="0"
                                                                              BackgroundColor="Transparent"
                                                                              TextColor="{StaticResource SubtleTextColor}"
                                                                              HeightRequest="18"
                                                                              WidthRequest="18"
                                                                              MinimumHeightRequest="0"
                                                                              MinimumWidthRequest="0"
                                                                              Clicked="OnViewGuildDetailsClicked"
                                                                              CommandParameter="{Binding .}"/>
                                                                      <Button Text="&#xF1FC;"
                                                                              FontFamily="FASolid"
                                                                              FontSize="12"
                                                                              Padding="0"
                                                                              BackgroundColor="Transparent"
                                                                              TextColor="{StaticResource SubtleTextColor}"
                                                                              HeightRequest="18"
                                                                              WidthRequest="18"
                                                                              MinimumHeightRequest="0"
                                                                              MinimumWidthRequest="0"
                                                                              IsVisible="{Binding HasChoices}"
                                                                              Clicked="OnEditGuildChoicesClicked"
                                                                              CommandParameter="{Binding .}"/>
                                                               </HorizontalStackLayout>
                                                        </Grid>
                                                 </DataTemplate>
                                          </BindableLayout.ItemTemplate>
                                   </VerticalStackLayout>

                                   <Label Text="{Binding GuildSummary}"
                                          IsVisible="{Binding HasGuildReviewRows, Converter={StaticResource InverseBoolConverter}}"
                                          LineBreakMode="WordWrap"/>
                                   <Label Text="{Binding GuildChoiceWarningText}"
                                          FontSize="12"
                                          FontAttributes="Bold"
                                          TextColor="{StaticResource AccentMaroonColor}"
                                          IsVisible="{Binding HasGuildChoiceWarning}"
                                          LineBreakMode="WordWrap"/>
                                   <VerticalStackLayout IsVisible="{Binding HasGuildStackingWarnings}"
                                                        Spacing="2"
                                                        BindableLayout.ItemsSource="{Binding GuildStackingWarnings}">
                                          <BindableLayout.ItemTemplate>
                                                 <DataTemplate>
                                                        <Label Text="{Binding ., StringFormat='- {0}'}"
                                                               FontSize="12"
                                                               TextColor="{StaticResource AccentMaroonColor}"
                                                               LineBreakMode="WordWrap"/>
                                                 </DataTemplate>
                                          </BindableLayout.ItemTemplate>
                                   </VerticalStackLayout>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame x:Name="Post8CardFrame"
                            HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            IsVisible="{Binding Source={x:Reference Root}, Path=ShowPost8Card}"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="6">
                                   <Grid ColumnDefinitions="*,Auto">
                                          <HorizontalStackLayout Spacing="6">
                                                 <Label Text="&#xF6DE;"
                                                        FontFamily="FASolid"
                                                        FontSize="14"
                                                        VerticalTextAlignment="Center"/>
                                                 <Label Text="Post-8th Advancement"
                                                        FontAttributes="Bold"
                                                        VerticalTextAlignment="Center"/>
                                          </HorizontalStackLayout>
                                           <controls:ChevronIconView Grid.Column="1"
                                                                     IsExpanded="{Binding IsAdvancementExpanded}"
                                                                     AnimateRotation="True"
                                                                     GlyphSize="18"
                                                                     GlyphColor="{StaticResource MutedTextColor}"
                                                                     HorizontalOptions="End"
                                                                     VerticalOptions="Center">
                                                  <controls:ChevronIconView.GestureRecognizers>
                                                         <TapGestureRecognizer Command="{Binding ToggleAdvancementExpandedCommand}" />
                                                  </controls:ChevronIconView.GestureRecognizers>
                                           </controls:ChevronIconView>
                                   </Grid>

                                   <VerticalStackLayout x:Name="Post8ExpandedContent"
                                                        IsVisible="False"
                                                        Spacing="8">
                                          <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvancementAbilityLines}"
                                                               Spacing="4">

                                                 <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                               <Grid ColumnDefinitions="*,Auto,Auto"
                                                                     ColumnSpacing="8"
                                                                     Padding="0,2">
                                                                      <Label Text="{Binding Name}"
                                                                             LineBreakMode="WordWrap"
                                                                             VerticalTextAlignment="Center"/>
                                                                      <Label Grid.Column="1"
                                                                             Text="{Binding CostText}"
                                                                             FontSize="12"
                                                                             VerticalTextAlignment="Center"/>
                                                                      <Label Grid.Column="2"
                                                                             Text="{Binding OrderText}"
                                                                             FontSize="12"
                                                                             Opacity="0.7"
                                                                             VerticalTextAlignment="Center"/>
                                                               </Grid>
                                                        </DataTemplate>
                                                 </BindableLayout.ItemTemplate>
                                          </VerticalStackLayout>
                                          <Button Text="Open Advancement"
                                                  FontSize="12"
                                                  FontAttributes="Bold"
                                                  BackgroundColor="{StaticResource Primary}"
                                                  TextColor="White"
                                                  CornerRadius="10"
                                                  Clicked="OnOpenAdvancementClicked" />
                                   </VerticalStackLayout>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="6">
                                   <Grid ColumnDefinitions="*,Auto,Auto"
                                         ColumnSpacing="8">
                                          <Label Text="Notes"
                                                 FontAttributes="Bold"
                                                 VerticalTextAlignment="Center"/>
                                          <Button Grid.Column="1"
                                                  Text="&#xF1FC;"
                                                  FontFamily="FASolid"
                                                  FontSize="12"
                                                  Padding="0"
                                                  BackgroundColor="Transparent"
                                                  TextColor="{StaticResource SubtleTextColor}"
                                                  HeightRequest="18"
                                                  WidthRequest="18"
                                                  MinimumHeightRequest="0"
                                                  MinimumWidthRequest="0"
                                                  VerticalOptions="Center"
                                                  Clicked="OnEditNotesClicked"/>
                                          <controls:ChevronIconView x:Name="NotesChevron"
                                                                    Grid.Column="2"
                                                                    GlyphSize="18"
                                                                    GlyphColor="{StaticResource MutedTextColor}">
                                                 <controls:ChevronIconView.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnNotesChevronTapped" />
                                                 </controls:ChevronIconView.GestureRecognizers>
                                          </controls:ChevronIconView>
                                   </Grid>

                                   <Label x:Name="NotesContentLabel"
                                          IsVisible="False"
                                          Text="{Binding NotesSummary}"
                                          LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                     </Frame>
              </VerticalStackLayout>
       </ScrollView>
</ContentView>
