<?xml version="1.0" encoding="utf-8" ?>
<ContentView
       x:Class="labyItems.Pages.Characters.CharacterReviewView"
       x:Name="Root"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:controls="clr-namespace:labyItems.Controls">

       <ScrollView>
              <VerticalStackLayout Padding="16"
                                   Spacing="14">
                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="4">
                                   <Label Text="Identity"
                                          FontAttributes="Bold"/>
                                   <Label Text="{Binding PlayerNameSummary}"/>
                                   <Label Text="{Binding CharacterNameSummary}"/>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            IsVisible="{Binding Source={x:Reference Root}, Path=ShowSaveButton}"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="8">
                                   <Label Text="Battleboard"
                                          FontAttributes="Bold"/>
                                   <Button Text="Get battleboard"
                                           Style="{StaticResource ExpandedActionButtonStyle}"
                                           Clicked="OnGetBattleboardClicked"/>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="4">
                                   <Label Text="Race and class"
                                          FontAttributes="Bold"/>
                                   <Label Text="{Binding RaceSummary}"/>
                                   <Label Text="{Binding RaceSubtypeSummary}"/>
                                   <Label Text="{Binding ClassSummary}"/>
                                   <Label Text="{Binding AlignmentSummary}"/>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            IsVisible="{Binding HasClassLevelAbilityRows}"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="8">
                                   <Label Text="{Binding ClassLevelAbilityHeader}"
                                          FontAttributes="Bold"/>
                                   <controls:LevelAbilityTableView ItemsSource="{Binding ClassLevelAbilityRows}"
                                                                   ShowBodyAndLoc="True"
                                                                   AbilitiesHeaderText="Skills/Abilities"/>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            IsVisible="{Binding HasRaceLevelAbilityRows}"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="8">
                                   <Label Text="{Binding RaceLevelAbilityHeader}"
                                          FontAttributes="Bold"/>
                                   <controls:LevelAbilityTableView ItemsSource="{Binding RaceLevelAbilityRows}"
                                                                   ShowBodyAndLoc="False"
                                                                   AbilitiesHeaderText="Abilities"/>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="4">
                                   <Label Text="Guilds"
                                          FontAttributes="Bold"/>
                                   <Label Text="{Binding GuildSummary}"
                                          LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="8">
                                   <Label Text="Specialisations"
                                          FontAttributes="Bold"/>
                                   <Label Text="{Binding SpecialisationSummaryHeader}"
                                          Opacity="0.7"/>

                                   <VerticalStackLayout BindableLayout.ItemsSource="{Binding SpecialisationSummaryLines}"
                                                        Spacing="6">
                                          <BindableLayout.ItemTemplate>
                                                 <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="8">
                                                               <Label Text="{Binding Text}"
                                                                      LineBreakMode="WordWrap"
                                                                      VerticalTextAlignment="Center"/>
                                                               <Button Grid.Column="1"
                                                                       Text="&#xF05A;"
                                                                       FontFamily="FASolid"
                                                                       FontSize="12"
                                                                       Padding="0"
                                                                       BackgroundColor="Transparent"
                                                                       TextColor="{StaticResource SubtleTextColor}"
                                                                       HeightRequest="18"
                                                                       WidthRequest="18"
                                                                       MinimumHeightRequest="0"
                                                                       MinimumWidthRequest="0"
                                                                       VerticalOptions="Center"
                                                                       IsVisible="{Binding HasDetails}"
                                                                       Clicked="OnViewSpecialisationAbilityDetailsClicked"
                                                                       CommandParameter="{Binding .}"/>
                                                        </Grid>
                                                 </DataTemplate>
                                          </BindableLayout.ItemTemplate>
                                   </VerticalStackLayout>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame x:Name="Post8CardFrame"
                            HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            IsVisible="{Binding Source={x:Reference Root}, Path=ShowPost8Card}"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="6">
                                   <Grid ColumnDefinitions="*,Auto">
                                          <Label Text="Post 8th"
                                                 FontAttributes="Bold"
                                                 VerticalTextAlignment="Center"/>
                                          <Button Grid.Column="1"
                                                  Text="{Binding IsAdvancementExpanded, Converter={StaticResource ChevronConverter}}"
                                                  BackgroundColor="Transparent"
                                                  TextColor="{StaticResource MutedTextColor}"
                                                  FontSize="18"
                                                  Padding="0"
                                                  WidthRequest="40"
                                                  HeightRequest="40"
                                                  HorizontalOptions="End"
                                                  VerticalOptions="Center"
                                                  Command="{Binding ToggleAdvancementExpandedCommand}"/>
                                   </Grid>

                                   <VerticalStackLayout x:Name="Post8ExpandedContent"
                                                        IsVisible="False"
                                                        Spacing="6">
                                          <Grid ColumnDefinitions="*,*">

                                                 <Label Grid.Column="0"
                                                        Text="{Binding AdvancementAbilitiesHeader}"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Start"/>

                                                 <Label Grid.Column="1"
                                                        Text="{Binding AdvancementPointsSummary}"
                                                        HorizontalTextAlignment="End"/>
                                          </Grid>


                                          <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvancementAbilityLines}"
                                                               Spacing="4">

                                                 <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                               <Grid ColumnDefinitions="*,Auto"
                                                                     ColumnSpacing="8">
                                                                      <Label Text="{Binding NameWithCost}"
                                                                             LineBreakMode="WordWrap"/>
                                                                      <Label Grid.Column="1"
                                                                             Text="{Binding RunningTotalText}"
                                                                             FontSize="12"
                                                                             Opacity="0.7"
                                                                             VerticalTextAlignment="Center"/>
                                                                      <!--todo, fit these in. <Label Text="{Binding AdvancementItemsSummary}"
                                                                             LineBreakMode="WordWrap"/>
                                                                      <Label Text="{Binding AdvancementNotesSummary}"
                                                                             LineBreakMode="WordWrap"/> -->
                                                               </Grid>
                                                        </DataTemplate>
                                                 </BindableLayout.ItemTemplate>
                                          </VerticalStackLayout>
                                   </VerticalStackLayout>
                            </VerticalStackLayout>
                     </Frame>

                     <Frame HasShadow="False"
                            CornerRadius="12"
                            Padding="12"
                            BorderColor="{StaticResource SurfaceBorderColor}">
                            <VerticalStackLayout Spacing="4">
                                   <Label Text="Notes"
                                          FontAttributes="Bold"/>
                                   <Label Text="{Binding NotesSummary}"
                                          LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                     </Frame>
              </VerticalStackLayout>
       </ScrollView>
</ContentView>
