<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  x:Class="labyItems.Pages.Characters.CharacterBuilder"
  x:Name="Root"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:helpers="clr-namespace:labyItems.Helpers"
  xmlns:vm="clr-namespace:labyItems.Pages.Characters">

  <ContentView.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="ClassCardTemplate"
                    x:DataType="vm:ClassCardVm">
        <Border Padding="12"
                Margin="0,0,0,8"
                Stroke="{StaticResource SubtleTextColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource White}">
          <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsSelected}"
                         Value="True">
              <Setter Property="Stroke"
                      Value="{StaticResource AccentMaroonColor}"/>
              <Setter Property="BackgroundColor"
                      Value="{StaticResource SelectedSurfaceBackgroundColor}"/>
            </DataTrigger>
          </Border.Triggers>
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding BindingContext.SelectClassCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding .}"/>
          </Border.GestureRecognizers>

          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <controls:ClassBracketIconView IconSize="26"
                                           HasSplitIcon="{Binding HasSplitIcon}"
                                           SingleGlyph="{Binding SingleEmoji}"
                                           SingleIconFontFamily="{Binding SingleIconFontFamily}"
                                           SingleBackground="{Binding SingleBg}"
                                           SplitLeftGlyph="{Binding SplitLeftEmoji}"
                                           SplitRightGlyph="{Binding SplitRightEmoji}"
                                           SplitLeftBackground="{Binding SplitLeftBg}"
                                           SplitRightBackground="{Binding SplitRightBg}"
                                           BorderColor="{StaticResource SurfaceBorderColor}"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2">
              <Label Text="{Binding Name}"
                     FontSize="18"
                     FontAttributes="Bold"
                     LineBreakMode="WordWrap"
                     Margin="0,0,4,0"/>
              <Label Text="{Binding BracketSubheading}"
                     FontSize="12"
                     Opacity="0.75"
                     LineBreakMode="WordWrap"/>
              <Label Text="{Binding Summary}"
                     FontSize="12"
                     Opacity="0.8"
                     LineBreakMode="WordWrap"
                     MaxLines="2"/>
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 999"
                    BackgroundColor="Transparent"
                    WidthRequest="28"
                    HeightRequest="28"
                    VerticalOptions="Start"
                    HorizontalOptions="End">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnClassInfoTapped"
                                      CommandParameter="{Binding .}"/>
              </Border.GestureRecognizers>
              <Label Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                     FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                     FontSize="13"
                     TextColor="{StaticResource SubtleTextColor}"
                     HorizontalTextAlignment="Center"
                     VerticalTextAlignment="Center"/>
            </Border>
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="RaceCardTemplate"
                    x:DataType="vm:RaceCardVm">
        <Border Padding="12"
                Margin="0,0,0,8"
                Stroke="{StaticResource SubtleTextColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource White}">
          <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsSelected}"
                         Value="True">
              <Setter Property="Stroke"
                      Value="{StaticResource AccentMaroonColor}"/>
              <Setter Property="BackgroundColor"
                      Value="{StaticResource SelectedSurfaceBackgroundColor}"/>
            </DataTrigger>
          </Border.Triggers>
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding BindingContext.SelectRaceCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding .}"/>
          </Border.GestureRecognizers>

          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Stroke="#FDBA74"
                    BackgroundColor="#FFEDD5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 999"
                    WidthRequest="26"
                    HeightRequest="26"
                    VerticalOptions="Start"
                    Margin="0,2,0,0">
              <Label Text="{Binding Icon}"
                     FontSize="12"
                     TextColor="#C2410C"
                     HorizontalTextAlignment="Center"
                     VerticalTextAlignment="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2">
              <Label Text="{Binding Name}"
                     FontSize="18"
                     FontAttributes="Bold"
                     LineBreakMode="WordWrap"
                     Margin="0,0,4,0"/>
              <Label Text="{Binding PeopleTypeDisplay}"
                     FontSize="12"
                     Opacity="0.75"
                     LineBreakMode="WordWrap"/>
              <Label Text="{Binding Description}"
                     FontSize="12"
                     Opacity="0.8"
                     LineBreakMode="WordWrap"
                     MaxLines="2"/>
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 999"
                    BackgroundColor="Transparent"
                    WidthRequest="28"
                    HeightRequest="28"
                    VerticalOptions="Start"
                    HorizontalOptions="End">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRaceInfoTapped"
                                      CommandParameter="{Binding .}"/>
              </Border.GestureRecognizers>
              <Label Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                     FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                     FontSize="13"
                     TextColor="{StaticResource SubtleTextColor}"
                     HorizontalTextAlignment="Center"
                     VerticalTextAlignment="Center"/>
            </Border>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </ContentView.Resources>

  <Grid>
  <Grid RowDefinitions="*"
        Padding="16">
    <Grid Grid.Row="0">
      <ContentView IsVisible="{Binding IsClassTabSelected}">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="8"
              Padding="12,8">
          <Border Grid.Row="0"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 10"
                  BackgroundColor="#F9FAFB"
                  Padding="8,4">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="6">
              <Entry Placeholder="Search classes..."
                     ClearButtonVisibility="WhileEditing"
                     Text="{Binding ClassSearchText}"/>
              <Button Grid.Column="1"
                      Text="{x:Static helpers:FontAwesomeGlyphs.Filter}"
                      FontFamily="FASolid"
                      FontSize="13"
                      Padding="0"
                      BackgroundColor="Transparent"
                      TextColor="{StaticResource SubtleTextColor}"
                      HeightRequest="24"
                      WidthRequest="24"
                      MinimumHeightRequest="0"
                      MinimumWidthRequest="0"
                      VerticalOptions="Center"
                      Command="{Binding OpenClassFiltersCommand}"/>
            </Grid>
          </Border>

          <CollectionView Grid.Row="1"
                          ItemsSource="{Binding FilteredClasses}"
                          ItemTemplate="{StaticResource ClassCardTemplate}"
                          SelectionMode="None"/>
        </Grid>
      </ContentView>

      <ContentView IsVisible="{Binding IsRaceTabSelected}">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="12">
          <Border Grid.Row="0"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 10"
                  BackgroundColor="#F9FAFB"
                  Padding="8,4">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="6">
              <Entry Placeholder="Search races..."
                     ClearButtonVisibility="WhileEditing"
                     Text="{Binding RaceSearchText}"/>
              <Button Grid.Column="1"
                      Text="{x:Static helpers:FontAwesomeGlyphs.Filter}"
                      FontFamily="FASolid"
                      FontSize="13"
                      Padding="0"
                      BackgroundColor="Transparent"
                      TextColor="{StaticResource SubtleTextColor}"
                      HeightRequest="24"
                      WidthRequest="24"
                      MinimumHeightRequest="0"
                      MinimumWidthRequest="0"
                      VerticalOptions="Center"
                      Command="{Binding OpenRaceFiltersCommand}"/>
            </Grid>
          </Border>

          <CollectionView Grid.Row="1"
                          ItemsSource="{Binding FilteredRaces}"
                          ItemTemplate="{StaticResource RaceCardTemplate}"
                          SelectionMode="None"/>
        </Grid>
      </ContentView>
    </Grid>
  </Grid>

  <Grid IsVisible="{Binding IsClassFilterModalOpen}"
        BackgroundColor="#66000000">
    <Grid.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding CancelClassFiltersCommand}"/>
    </Grid.GestureRecognizers>
    <Border HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="360"
            MaximumWidthRequest="420"
            MaximumHeightRequest="560"
            Stroke="{StaticResource SurfaceBorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{StaticResource White}"
            Padding="14">
      <Border.GestureRecognizers>
        <TapGestureRecognizer />
      </Border.GestureRecognizers>
      <Grid RowDefinitions="Auto,*,Auto"
            RowSpacing="10">
        <Label Text="Filters"
               FontAttributes="Bold"
               FontSize="18"/>
        <ScrollView Grid.Row="1">
          <VerticalStackLayout Spacing="6">
            <Label Text="Class type"
                   FontAttributes="Bold"
                   FontSize="13"/>
            <FlexLayout BindableLayout.ItemsSource="{Binding ClassFilterModalChips}"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Start">
              <BindableLayout.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                          Margin="0,0,8,8">
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer Command="{Binding BindingContext.TogglePendingClassFilterCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Label}"
                           Style="{StaticResource FilterPillLabelStyle}"/>
                  </Border>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </FlexLayout>
          </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
          <Button Grid.Column="0"
                  Text="Cancel"
                  Command="{Binding CancelClassFiltersCommand}"/>
          <Button Grid.Column="2"
                  Text="Search"
                  Command="{Binding ApplyClassFiltersCommand}"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsRaceFilterModalOpen}"
        BackgroundColor="#66000000">
    <Grid.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding CancelRaceFiltersCommand}"/>
    </Grid.GestureRecognizers>
    <Border HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="360"
            MaximumWidthRequest="420"
            MaximumHeightRequest="560"
            Stroke="{StaticResource SurfaceBorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{StaticResource White}"
            Padding="14">
      <Border.GestureRecognizers>
        <TapGestureRecognizer />
      </Border.GestureRecognizers>
      <Grid RowDefinitions="Auto,*,Auto"
            RowSpacing="10">
        <Label Text="Filters"
               FontAttributes="Bold"
               FontSize="18"/>
        <ScrollView Grid.Row="1">
          <VerticalStackLayout Spacing="6">
            <Label Text="Race type"
                   FontAttributes="Bold"
                   FontSize="13"/>
            <FlexLayout BindableLayout.ItemsSource="{Binding RaceFilterModalChips}"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Start">
              <BindableLayout.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                          Margin="0,0,8,8">
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer Command="{Binding BindingContext.TogglePendingRaceFilterCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Label}"
                           Style="{StaticResource FilterPillLabelStyle}"/>
                  </Border>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </FlexLayout>
          </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
          <Button Grid.Column="0"
                  Text="Cancel"
                  Command="{Binding CancelRaceFiltersCommand}"/>
          <Button Grid.Column="2"
                  Text="Search"
                  Command="{Binding ApplyRaceFiltersCommand}"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
  </Grid>
</ContentView>
