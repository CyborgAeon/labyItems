<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  x:Class="labyItems.Pages.Characters.CharacterBuilder"
  x:Name="Root"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:labyItems.Pages.Characters">

  <ContentView.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="ClassCardTemplate"
                    x:DataType="vm:ClassCardVm">
        <vm:ClassCardView
          SelectCommand="{Binding BindingContext.SelectClassCommand, Source={x:Reference Root}}"
          ToggleExpandedCommand="{Binding BindingContext.ToggleClassExpandedCommand, Source={x:Reference Root}}"/>
      </DataTemplate>

      <DataTemplate x:Key="RaceCardTemplate"
                    x:DataType="vm:RaceCardVm">
        <vm:RaceCardView
          SelectCommand="{Binding BindingContext.SelectRaceCommand, Source={x:Reference Root}}"
          ToggleRaceExpandedCommand="{Binding BindingContext.ToggleRaceExpandedCommand, Source={x:Reference Root}}"/>
      </DataTemplate>
    </ResourceDictionary>
  </ContentView.Resources>

  <Grid RowDefinitions="*"
        Padding="16">
    <Grid Grid.Row="0">
      <ContentView IsVisible="{Binding IsClassTabSelected}">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8"
              Padding="12,8">
          <Entry Grid.Row="0"
                 Placeholder="Search classes..."
                 ClearButtonVisibility="WhileEditing"
                 Text="{Binding ClassSearchText}"/>
          <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding ClassFilterChips}"
            SelectionMode="None"
            ItemsLayout="HorizontalList"
            HeightRequest="38">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Button Text="{Binding Label}"
                        FontSize="12"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"
                        TextColor="{StaticResource PrimaryTextStrongColor}"
                        BorderColor="{StaticResource SoftStrokeColor}"
                        BorderWidth="1"
                        CornerRadius="999"
                        Command="{Binding BindingContext.ToggleClassFilterChipCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding .}">
                  <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsSelected}"
                                 Value="True">
                      <Setter Property="BackgroundColor"
                              Value="{StaticResource AccentMaroonColor}"/>
                      <Setter Property="TextColor"
                              Value="White"/>
                      <Setter Property="BorderColor"
                              Value="{StaticResource AccentMaroonColor}"/>
                    </DataTrigger>
                  </Button.Triggers>
                </Button>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <CollectionView Grid.Row="2"
                          ItemsSource="{Binding FilteredClasses}"
                          ItemTemplate="{StaticResource ClassCardTemplate}"
                          SelectionMode="None"/>
        </Grid>
      </ContentView>

      <ContentView IsVisible="{Binding IsRaceTabSelected}">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="12">
          <Entry Grid.Row="0"
                 Placeholder="Search races..."
                 ClearButtonVisibility="WhileEditing"
                 Text="{Binding RaceSearchText}"/>

          <CollectionView Grid.Row="1"
                          ItemsSource="{Binding RaceFilters}"
                          SelectionMode="None"
                          ItemsLayout="HorizontalList"
                          HeightRequest="30">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Button Text="{Binding .}"
                        FontSize="12"
                        Padding="12,6"
                        BackgroundColor="{StaticResource ModalScrimColor}"
                        TextColor="White"
                        BorderColor="{StaticResource SurfaceBorderColor}"
                        BorderWidth="1"
                        CornerRadius="999"
                        Command="{Binding BindingContext.SelectRaceFilterCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding .}">
                  <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding BindingContext.SelectedRaceFilter, Source={x:Reference Root}}"
                                 Value="{Binding .}">
                      <Setter Property="FontAttributes"
                              Value="Bold"/>
                      <Setter Property="TextColor"
                              Value="{StaticResource AccentMaroonColor}"/>
                      <Setter Property="BorderColor"
                              Value="{StaticResource AccentMaroonColor}"/>
                    </DataTrigger>
                  </Button.Triggers>
                </Button>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <CollectionView Grid.Row="2"
                          ItemsSource="{Binding FilteredRaces}"
                          ItemTemplate="{StaticResource RaceCardTemplate}"
                          SelectionMode="None"/>
        </Grid>
      </ContentView>
    </Grid>
  </Grid>
</ContentView>
