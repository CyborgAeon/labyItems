<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.MiracleCard.MiracleDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame Padding="16"
           CornerRadius="12"
           HasShadow="False"
           BorderColor="#E5E7EB">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding MiracleName, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <Label Text="{Binding SphereIconGlyph, Source={x:Reference Root}}"
                       FontFamily="FASolid"
                       FontSize="14"
                       TextColor="#4B5563"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding SphereDisplayText, Source={x:Reference Root}}"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Column="2"
                       Text="{Binding PowerDisplayText, Source={x:Reference Root}}"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <Label Text="{Binding AlignmentDisplayText, Source={x:Reference Root}}"
                   FontSize="12"
                   Opacity="0.8"
                   IsVisible="{Binding HasAlignment, Source={x:Reference Root}}"/>

            <BoxView HeightRequest="1"
                     Color="#E5E7EB"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="DESCRIPTION"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        Text="{Binding DescriptionChevronText, Source={x:Reference Root}}"
                        IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                        Clicked="OnDescriptionToggleClicked"
                        BackgroundColor="Transparent"
                        TextColor="#6B7280"
                        FontSize="18"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasPrereqs, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="PREREQUISITES"
                           FontAttributes="Bold"
                           FontSize="12"
                           Opacity="0.7"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding PrereqChevronText, Source={x:Reference Root}}"
                            IsVisible="{Binding CanExpandPrereqs, Source={x:Reference Root}}"
                            Clicked="OnPrereqToggleClicked"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            Padding="0"
                            WidthRequest="32"
                            HeightRequest="32"/>
                </Grid>

                <ContentView x:Name="PrereqTextContainer">
                    <Label x:Name="PrereqLabel"
                           Text="{Binding PrereqText, Source={x:Reference Root}}"
                           MaxLines="{Binding PrereqMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasDamageSummary, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="DAMAGE"
                           FontAttributes="Bold"
                           FontSize="12"
                           Opacity="0.7"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding DamageChevronText, Source={x:Reference Root}}"
                            IsVisible="{Binding CanExpandDamage, Source={x:Reference Root}}"
                            Clicked="OnDamageToggleClicked"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            Padding="0"
                            WidthRequest="32"
                            HeightRequest="32"/>
                </Grid>

                <ContentView x:Name="DamageTextContainer">
                    <Label x:Name="DamageLabel"
                           Text="{Binding DamageSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding DamageMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasHealSummary, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="HEAL"
                           FontAttributes="Bold"
                           FontSize="12"
                           Opacity="0.7"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding HealChevronText, Source={x:Reference Root}}"
                            IsVisible="{Binding CanExpandHeal, Source={x:Reference Root}}"
                            Clicked="OnHealToggleClicked"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            Padding="0"
                            WidthRequest="32"
                            HeightRequest="32"/>
                </Grid>

                <ContentView x:Name="HealTextContainer">
                    <Label x:Name="HealLabel"
                           Text="{Binding HealSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding HealMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentView>
