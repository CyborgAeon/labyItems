<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.MiracleCard.MiracleDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <ContentView>
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding MiracleName, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNameTapped"/></Label.GestureRecognizers></Label>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSphereTapped"/></Grid.GestureRecognizers>
                <Label Text="{Binding SphereIconGlyph, Source={x:Reference Root}}" FontFamily="FASolid" FontSize="14" TextColor="{StaticResource SubtleTextColor}" VerticalTextAlignment="Center"/>
                <Label Grid.Column="1" Text="{Binding SphereDisplayText, Source={x:Reference Root}}" FontSize="14" VerticalTextAlignment="Center"/>
                <Frame Grid.Column="2" Padding="8,4" CornerRadius="10" HasShadow="False" BackgroundColor="{Binding TierBackgroundColor, Source={x:Reference Root}}" BorderColor="#E8C878" IsVisible="{Binding ShowTier, Source={x:Reference Root}}"><Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnTierTapped"/></Frame.GestureRecognizers><Label Text="{Binding TierDisplayText, Source={x:Reference Root}}" FontSize="12" FontAttributes="Bold"/></Frame>
            </Grid>

            <Label Text="Non-standard"
                   TextColor="{StaticResource AccentMaroonColor}"
                   FontSize="12"
                   FontAttributes="Bold"
                   IsVisible="{Binding IsNonStandard, Source={x:Reference Root}}"/>

            <VerticalStackLayout x:Name="MiracleKeyInformationGrid" Margin="-16,0" Padding="12,10" Spacing="10">
                <Grid ColumnDefinitions="*,1,*,1,*" IsVisible="{Binding ShowDurationRow, Source={x:Reference Root}}"><VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnLevelTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="LEVEL" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding LevelDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnPowerTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="POWER" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PowerDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="3" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="4"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnDurationTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="DURATION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding DurationDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout></Grid>
                <Grid ColumnDefinitions="*,1,*" IsVisible="{Binding ShowCompactRow, Source={x:Reference Root}}"><VerticalStackLayout><Label Text="LEVEL" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding LevelDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2"><Label Text="POWER" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PowerDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout></Grid>
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/>
                <Grid ColumnDefinitions="2*,1,*"><VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnGestureTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="GESTURE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding GestureDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnAlignmentTapped"/></VerticalStackLayout.GestureRecognizers><HorizontalStackLayout HorizontalOptions="Center" Spacing="4"><Label Text="&#xF24E;" FontFamily="FASolid" FontSize="10" TextColor="{StaticResource MutedTextColor}"/><Label Text="ALIGNMENT" Style="{StaticResource KeyInfoLabelStyle}"/></HorizontalStackLayout><Label Text="{Binding AlignmentDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout></Grid>
                <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowImmunity, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><Grid ColumnDefinitions="*,44"><VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnImmunityTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="IMMUNITY" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding ImmunityDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="&#xF05A;" FontFamily="FASolid" Padding="0" BackgroundColor="Transparent" IsVisible="{Binding HasImmunityLink, Source={x:Reference Root}}" Clicked="OnImmunityInfoClicked"/></Grid></VerticalStackLayout>
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasDamageQuickFacts, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><controls:CombatQuickFactsView Facts="{Binding DamageQuickFacts, Source={x:Reference Root}}"/></VerticalStackLayout>
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasHealQuickFacts, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><controls:CombatQuickFactsView Facts="{Binding HealQuickFacts, Source={x:Reference Root}}"/></VerticalStackLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="DESCRIPTION"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <controls:ChevronIconView Grid.Column="1"
                                          IsExpanded="{Binding IsDescriptionExpanded, Source={x:Reference Root}}"
                                          AnimateRotation="True"
                                          GlyphSize="14"
                                          GlyphColor="{StaticResource MutedTextColor}"
                                          InputTransparent="True"
                                          IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowDescriptionSeeMore, Source={x:Reference Root}}"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVerbalSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="VERBAL"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <controls:ChevronIconView Grid.Column="1"
                                          IsExpanded="{Binding IsVerbalExpanded, Source={x:Reference Root}}"
                                          AnimateRotation="True"
                                          GlyphSize="14"
                                          GlyphColor="{StaticResource MutedTextColor}"
                                          InputTransparent="True"
                                          IsVisible="{Binding CanExpandVerbal, Source={x:Reference Root}}"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"/>
            </Grid>

            <ContentView x:Name="VerbalTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVerbalSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="VerbalLabel"
                       Text="{Binding VerbalText, Source={x:Reference Root}}"
                       MaxLines="{Binding VerbalMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowVerbalSeeMore, Source={x:Reference Root}}"/>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowPrereqs, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrereqSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="PREREQUISITES"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsPrereqExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandPrereqs, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <ContentView x:Name="PrereqTextContainer">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrereqSectionTapped"/>
                    </ContentView.GestureRecognizers>
                    <Label x:Name="PrereqLabel"
                           Text="{Binding PrereqText, Source={x:Reference Root}}"
                           MaxLines="{Binding PrereqMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
                <Label Text="... see more"
                       TextColor="{StaticResource MutedTextColor}"
                       FontSize="12"
                       IsVisible="{Binding ShowPrereqSeeMore, Source={x:Reference Root}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowDamageSection, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDamageSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="DAMAGE"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsDamageExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandDamage, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <ContentView x:Name="DamageTextContainer">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDamageSectionTapped"/>
                    </ContentView.GestureRecognizers>
                    <Label x:Name="DamageLabel"
                           Text="{Binding DamageSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding DamageMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
                <Label Text="... see more"
                       TextColor="{StaticResource MutedTextColor}"
                       FontSize="12"
                       IsVisible="{Binding ShowDamageSeeMore, Source={x:Reference Root}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowHealSection, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHealSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="HEAL"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsHealExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandHeal, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <ContentView x:Name="HealTextContainer">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHealSectionTapped"/>
                    </ContentView.GestureRecognizers>
                    <Label x:Name="HealLabel"
                           Text="{Binding HealSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding HealMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
                <Label Text="... see more"
                       TextColor="{StaticResource MutedTextColor}"
                       FontSize="12"
                       IsVisible="{Binding ShowHealSeeMore, Source={x:Reference Root}}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentView>
</ContentView>
