<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="labyItems.Pages.MiracleCard.MiracleCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:miracleCard="clr-namespace:labyItems.Pages.MiracleCard"
    x:Name="Root"
    Title="Miracle">
    <Grid RowDefinitions="Auto,*"
          Padding="12,8,12,12">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
            <Button Text="Close"
                    Clicked="OnCloseClicked"
                    HeightRequest="32"
                    MinimumHeightRequest="0"
                    Padding="10,0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource SubtleTextColor}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="4">
                <miracleCard:MiracleDetailCardView x:Name="MiracleDetails" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
