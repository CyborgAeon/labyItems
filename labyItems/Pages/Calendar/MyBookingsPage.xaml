<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calendar.MyBookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="My Bookings">

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28"
                             Spacing="14">
            <Grid ColumnDefinitions="48,*,48">
                <Button Clicked="OnBackClicked"
                        FontSize="22"
                        Padding="8"
                        Text="{x:Static helpers:FontAwesomeGlyphs.Previous}"
                        TextColor="{StaticResource Gray950}">
                    <Button.BackgroundColor>Transparent</Button.BackgroundColor>
                </Button>

                <Label Grid.Column="1"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       Text="My Bookings"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="2"
                       WidthRequest="48"
                       InputTransparent="True" />
            </Grid>

            <Label x:Name="LastUpdatedLabel"
                   IsVisible="False"
                   FontSize="13"
                   FontAttributes="Italic"
                   TextColor="{StaticResource Gray500}" />

            <Border Padding="16,14"
                    Stroke="{StaticResource SurfaceBorderColor}"
                    StrokeShape="RoundRectangle 18">
                <VerticalStackLayout x:Name="LegendHost"
                                     Spacing="8" />
            </Border>

            <ActivityIndicator x:Name="BookingsLoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               SemanticProperties.Description="Loading your bookings" />

            <VerticalStackLayout x:Name="BookingsHost"
                                 Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
