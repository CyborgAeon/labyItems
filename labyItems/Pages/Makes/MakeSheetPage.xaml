<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.MakeSheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:makes="clr-namespace:labyItems.Pages.Makes"
    Title="Make Sheet">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Frame BorderColor="{StaticResource Gray200}" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label FontAttributes="Bold" FontSize="18" Text="{Binding CharacterName}" />
                    <Label Text="{Binding PlayerName, StringFormat='Player: {0}'}" />
                    <Label Text="{Binding CharacterClass, StringFormat='Class: {0}'}" />
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Clicked="OnBuildTabClicked" Text="Build" />
                <Button Grid.Column="1" Clicked="OnConsequencesTabClicked" Text="Consequences" />
                <Button Grid.Column="2" Clicked="OnCriticalTabClicked" Text="Critical" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding ShowBuildTab}" Spacing="12">
                <Frame
                    BorderColor="{Binding ItemSetupBorderColor}"
                    BackgroundColor="{Binding ItemSetupBackgroundColor}"
                    Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" Text="Item Setup" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Discipline" />
                                <Picker
                                    ItemsSource="{Binding Disciplines}"
                                    SelectedItem="{Binding SelectedDiscipline, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Item Type" />
                                <Picker
                                    ItemsSource="{Binding ItemTypes}"
                                    SelectedItem="{Binding SelectedItemType, Mode=TwoWay}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding ShowAdvancedWeaponOptions}" Spacing="4">
                            <Label Text="Weapon Tier" />
                            <Picker
                                ItemsSource="{Binding WeaponTierOptions}"
                                SelectedItem="{Binding SelectedWeaponTier, Mode=TwoWay}" />
                        </VerticalStackLayout>

                        <Grid
                            IsVisible="{Binding ShowAdvancedArmourOptions}"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8"
                            RowSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Armour Weight" />
                                <Picker
                                    ItemsSource="{Binding ArmourWeightOptions}"
                                    SelectedItem="{Binding SelectedArmourWeight, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Armour Enhancement" />
                                <Picker
                                    ItemsSource="{Binding ArmourEnhancementOptions}"
                                SelectedItem="{Binding SelectedArmourEnhancement, Mode=TwoWay}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding ShowNeuronicTorqueOptions}" Spacing="8">
                            <Label Text="Torque Features" />
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding TorqueFocusMind, Mode=TwoWay}" />
                                <Label VerticalOptions="Center" Text="Focus the Mind (+5 rolls, +5% difficulty)" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Shield the Mind (NAC)" />
                                <Picker
                                    ItemsSource="{Binding TorqueNacOptions}"
                                    SelectedItem="{Binding SelectedTorqueNacOption, Mode=TwoWay}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding TorquePsionicRetard, Mode=TwoWay}" />
                                <Label VerticalOptions="Center" Text="Psionic Retard (10 rolls, +10% difficulty)" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowSmithedTemplateOptions}" Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding SmithedUseTemplates, Mode=TwoWay}" />
                                <Label VerticalOptions="Center" Text="Manufacture templates instead of a finished item" />
                            </HorizontalStackLayout>

                            <Grid
                                IsVisible="{Binding ShowSmithedTemplateCount}"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">
                                <Label Text="Template count" VerticalOptions="Center" />
                                <Entry
                                    Grid.Column="1"
                                    Keyboard="Numeric"
                                    Text="{Binding SmithedTemplateCount, Mode=TwoWay}" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowSmithedQualityOptions}" Spacing="4">
                            <Label Text="Smithed Quality" />
                            <Picker
                                ItemsSource="{Binding SmithedQualityOptions}"
                                SelectedItem="{Binding SelectedSmithedQuality, Mode=TwoWay}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowSmithedWeaponOptions}" Spacing="4">
                            <Label Text="Weapon Enhancement" />
                            <Picker
                                ItemsSource="{Binding SmithedWeaponEnhancementOptions}"
                                SelectedItem="{Binding SelectedSmithedWeaponEnhancement, Mode=TwoWay}" />

                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding SmithedWeaponDifferentMaterial, Mode=TwoWay}" />
                                <Label
                                    VerticalOptions="Center"
                                    Text="Different material (+5% difficulty, doubles setup/roll costs)" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowSmithedArmourOptions}" Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Armour AC" VerticalOptions="Center" />
                                <Entry
                                    Grid.Column="1"
                                    Keyboard="Numeric"
                                    Text="{Binding SmithedArmourAc, Mode=TwoWay}" />
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Armour Enhancement" />
                                <Picker
                                    ItemsSource="{Binding SmithedArmourEnhancementOptions}"
                                    SelectedItem="{Binding SelectedSmithedArmourEnhancement, Mode=TwoWay}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding SmithedArmourWellFitted, Mode=TwoWay}" />
                                <Label
                                    VerticalOptions="Center"
                                    Text="Well fitted (+5 rolls, +5% difficulty)" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <HorizontalStackLayout IsVisible="{Binding ShowAlignmentOption}" Spacing="8">
                            <CheckBox IsChecked="{Binding IsColouredOrAligned, Mode=TwoWay}" />
                            <Label
                                VerticalOptions="Center"
                                Text="Coloured/aligned item (+1 roll, +5% difficulty)" />
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="Base chance (%)" VerticalOptions="Center" />
                            <Entry
                                Grid.Column="1"
                                Keyboard="Numeric"
                                Text="{Binding BaseChancePercent, Mode=TwoWay}" />
                        </Grid>

                        <Label
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            Text="{Binding ItemSetupStatusText}"
                            TextColor="{Binding ItemSetupBorderColor}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Gray200}" IsVisible="{Binding ShowEffectEditor}" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" Text="Spell / Effect Builder" />

                        <controls:DictionarySearchBar
                            x:TypeArguments="makes:MakeEffectLookupOption"
                            IsVisible="{Binding ShowEffectSearch}"
                            ItemsSource="{Binding EffectLookupOptions}"
                            KeyboardAvoidanceEnabled="True"
                            PlaceholderText="{Binding EffectSearchPlaceholder}"
                            SelectedValue="{Binding SelectedEffectLookup, Mode=TwoWay}"
                            SelectionDisplayMemberPath="Name" />

                        <Entry
                            IsVisible="{Binding ShowEffectNameEntry}"
                            Placeholder="Effect name"
                            Text="{Binding NewEffectName, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry
                                Grid.Column="0"
                                Grid.ColumnSpan="{Binding EffectPowerColumnSpan}"
                                Keyboard="Numeric"
                                Placeholder="Cost"
                                Text="{Binding NewEffectPower, Mode=TwoWay}" />
                            <Entry
                                Grid.Column="1"
                                IsVisible="{Binding ShowEffectUsesPerDay}"
                                Keyboard="Numeric"
                                Placeholder="Uses/day"
                                Text="{Binding NewEffectUses, Mode=TwoWay}" />
                        </Grid>
                        <controls:ChipGroup
                            Items="{Binding EffectCategoryOptions}"
                            SelectedItem="{Binding NewEffectCategory, Mode=TwoWay}"
                            DisabledItems="{Binding EffectCategoryDisabledOptions}" />
                        <Button Clicked="OnAddEffectClicked" Text="Add Effect" />

                        <Label FontAttributes="Bold" Text="Current Effects" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EffectRows}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Grid
                                            Padding="6,4"
                                            ColumnDefinitions="*,92,Auto,Auto,Auto"
                                            ColumnSpacing="8">
                                            <Label
                                                Grid.Column="0"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Name}"
                                                FontAttributes="Bold"
                                                VerticalTextAlignment="Center" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding RollSummary}"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Grid.Column="2"
                                                Text="&#xF044;"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource SubtleTextColor}"
                                                HeightRequest="18"
                                                WidthRequest="18"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                Clicked="OnEditEffectClicked"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="3"
                                                Text="&#xF05A;"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource SubtleTextColor}"
                                                HeightRequest="18"
                                                WidthRequest="18"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding HasInfoCard}"
                                                Clicked="OnEffectInfoClicked"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="4"
                                                Text="&#xF2ED;"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource SubtleTextColor}"
                                                HeightRequest="18"
                                                WidthRequest="18"
                                                MinimumHeightRequest="0"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                Clicked="OnRemoveEffectClicked"
                                                CommandParameter="{Binding .}" />
                                        </Grid>

                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="1"
                                            BackgroundColor="{StaticResource Gray200}"
                                            Opacity="0.6" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Gray200}" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" Text="Bonus Mode" />
                        <Picker
                            ItemsSource="{Binding BonusModes}"
                            SelectedItem="{Binding SelectedBonusMode, Mode=TwoWay}" />

                        <VerticalStackLayout IsVisible="{Binding ShowAutomatedBonusMode}" Spacing="8">
                            <Label FontAttributes="Bold" Text="Detected Automated Bonuses" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AutomatedBonusLines}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding ., StringFormat='- {0}'}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding CanUseTrinketMode}" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding UseTrinketMode, Mode=TwoWay}" />
                                    <Label
                                        VerticalOptions="Center"
                                        Text="{Binding TrinketModeLabel}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding CanUseReciprocatesBinding}" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding UseReciprocatesBinding, Mode=TwoWay}" />
                                    <Label
                                        VerticalOptions="Center"
                                        Text="Use Reciprocates Binding (-5% and bind to named user)." />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowManualBonusMode}" Spacing="8">
                            <Label FontAttributes="Bold" Text="Manual Bonuses" />
                            <Entry
                                Placeholder="Reason (e.g. workshop support)"
                                Text="{Binding NewManualBonusReason, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry
                                    Grid.Column="0"
                                    Keyboard="Numeric"
                                    Placeholder="Percent (e.g. 2 or -5)"
                                    Text="{Binding NewManualBonusPercent, Mode=TwoWay}" />
                                <Button Grid.Column="1" Clicked="OnAddManualBonusClicked" Text="Add" />
                            </Grid>
                            <Button Clicked="OnSearchAbilityClicked" Text="Add Bonus From Ability Search" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ManualBonusRows}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#F9FAFB"
                                            Padding="10,8">
                                            <Grid ColumnDefinitions="*,72,Auto,Auto,Auto" ColumnSpacing="8">
                                                <Label
                                                    Grid.Column="0"
                                                    Text="{Binding DisplayReasonText}"
                                                    VerticalTextAlignment="Center"
                                                    LineBreakMode="WordWrap" />

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding PercentText}"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalTextAlignment="Center"
                                                    FontAttributes="Bold" />

                                                <Button
                                                    Grid.Column="2"
                                                    Text="&#xF1FC;"
                                                    FontFamily="FASolid"
                                                    FontSize="12"
                                                    Padding="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource SubtleTextColor}"
                                                    HeightRequest="18"
                                                    WidthRequest="18"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding CanEditSpecialisation}"
                                                    Clicked="OnEditManualBonusClicked"
                                                    CommandParameter="{Binding .}" />

                                                <Button
                                                    Grid.Column="3"
                                                    Text="&#xF05A;"
                                                    FontFamily="FASolid"
                                                    FontSize="12"
                                                    Padding="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource SubtleTextColor}"
                                                    HeightRequest="18"
                                                    WidthRequest="18"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding HasAbilityDetails}"
                                                    Clicked="OnManualBonusInfoClicked"
                                                    CommandParameter="{Binding .}" />

                                                <Button
                                                    Grid.Column="4"
                                                    Text="&#xF2ED;"
                                                    FontFamily="FASolid"
                                                    FontSize="12"
                                                    Padding="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource SubtleTextColor}"
                                                    HeightRequest="18"
                                                    WidthRequest="18"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Clicked="OnRemoveManualBonusClicked"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Gray200}" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label FontAttributes="Bold" Text="Results" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ResultRows}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="{Binding Label}" />
                                        <Label Grid.Column="1" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Clicked="OnExportMakeSheetClicked" Text="Export Make Sheet" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Gray200}" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label FontAttributes="Bold" Text="Make Requirements / Notes" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RequirementLines}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label LineBreakMode="WordWrap" Text="{Binding ., StringFormat='- {0}'}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Gray200}" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label FontAttributes="Bold" Text="Detected Character / Item Abilities" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding OwnedAbilityLines}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label LineBreakMode="WordWrap" Text="{Binding ., StringFormat='- {0}'}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowConsequencesTab}" Spacing="10">
                <Label FontAttributes="Bold" FontSize="18" Text="Failure Table" />
                <Label
                    LineBreakMode="WordWrap"
                    Text="Roll on this table when a failed make roll is outside your margin of error." />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FailureRows}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="78,*" ColumnSpacing="8">
                                <Label FontAttributes="Bold" Text="{Binding RollRange}" />
                                <Label Grid.Column="1" LineBreakMode="WordWrap" Text="{Binding Outcome}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowCriticalTab}" Spacing="10">
                <Label FontAttributes="Bold" FontSize="18" Text="Catastrophic Failure Table" />
                <Label
                    LineBreakMode="WordWrap"
                    Text="Use this when the failure table result escalates to catastrophic consequences." />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CriticalFailureRows}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="78,*" ColumnSpacing="8">
                                <Label FontAttributes="Bold" Text="{Binding RollRange}" />
                                <Label Grid.Column="1" LineBreakMode="WordWrap" Text="{Binding Outcome}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
