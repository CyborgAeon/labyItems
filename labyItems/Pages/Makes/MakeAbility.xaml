<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.MakeAbility"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    Title="Manufacture"
    BackgroundColor="{StaticResource White}">

    <Grid>
    <Grid Padding="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">

        <Border Grid.Row="0"
                Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="#F9FAFB"
                Padding="8,4">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="6">
                <SearchBar x:Name="Search"
                           Placeholder="Search by name or description"
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchChanged" />
                <Button Grid.Column="1"
                        Text="&#xF0B0;"
                        FontFamily="FASolid"
                        FontSize="13"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource SubtleTextColor}"
                        HeightRequest="24"
                        WidthRequest="24"
                        MinimumHeightRequest="0"
                        MinimumWidthRequest="0"
                        VerticalOptions="Center"
                        Clicked="OnOpenFiltersClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <CollectionView x:Name="Results"
                            SelectionMode="None"
                            ItemsSource="{Binding Rows, Source={x:Reference Root}}"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemsLayout="VerticalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8"
                                Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource White}"
                                Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResultTapped"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="8">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalOptions="Start"
                                          CheckedChanged="OnRowCheckedChanged" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding MetaText}"
                                           FontSize="12"
                                           Opacity="0.75" />
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           Opacity="0.85"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="&#xF05A;"
                                        FontFamily="FASolid"
                                        FontSize="12"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SubtleTextColor}"
                                        HeightRequest="18"
                                        WidthRequest="18"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        VerticalOptions="Start"
                                        Clicked="OnInfoClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="No abilities found for the current search."
                   IsVisible="{Binding HasRows, Source={x:Reference Root}, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Opacity="0.7" />
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Clicked="OnCancelClicked" />
            <Label Grid.Column="1"
                   Text="{Binding SelectionSummaryText, Source={x:Reference Root}}"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"
                   Opacity="0.75" />
            <Button Grid.Column="2"
                    Text="{Binding ConfirmButtonText, Source={x:Reference Root}}"
                    IsEnabled="{Binding HasSelectedRows, Source={x:Reference Root}}"
                    Clicked="OnConfirmClicked" />
        </Grid>
    </Grid>

    <Grid IsVisible="{Binding IsFilterModalOpen, Source={x:Reference Root}}"
          BackgroundColor="#66000000">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCancelFiltersClicked"/>
        </Grid.GestureRecognizers>
        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="360"
                MaximumWidthRequest="420"
                MaximumHeightRequest="560"
                Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource White}"
                Padding="14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="10">
                <Label Text="Filters"
                       FontAttributes="Bold"
                       FontSize="18"/>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4"
                                             IsVisible="{Binding ShowAvailabilityFilter, Source={x:Reference Root}}">
                            <Label Text="Available"
                                   FontAttributes="Bold"
                                   FontSize="13"/>
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Text="Show abilities available to this character"
                                       FontSize="12"
                                       Opacity="0.75"
                                       VerticalTextAlignment="Center"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding PendingShowAvailableOnly, Source={x:Reference Root}, Mode=TwoWay}"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding ShowSourceBookFilters, Source={x:Reference Root}}">
                            <Label Text="Source Book"
                                   FontAttributes="Bold"
                                   FontSize="13"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding SourceBookChips, Source={x:Reference Root}}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        AlignItems="Start"
                                        JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                                                Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFilterChipTapped"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Label}"
                                                   Style="{StaticResource FilterPillLabelStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding ShowBracketFilters, Source={x:Reference Root}}">
                            <Label Text="Class Bracket"
                                   FontAttributes="Bold"
                                   FontSize="13"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding BracketChips, Source={x:Reference Root}}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        AlignItems="Start"
                                        JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                                                Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFilterChipTapped"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Label}"
                                                   Style="{StaticResource FilterPillLabelStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            Clicked="OnCancelFiltersClicked"/>
                    <Button Grid.Column="2"
                            Text="Search"
                            Clicked="OnApplyFiltersClicked"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
