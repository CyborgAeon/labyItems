<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="labyItems.Pages.MakeAbility"
             Title="Manufacture"
             >

  <VerticalStackLayout Padding="16" Spacing="12">
    <SearchBar x:Name="Search"
               Placeholder="Search by name or description"
               TextChanged="OnSearchChanged" />

    <CollectionView x:Name="Results" SelectionMode="Single" SelectionChanged="OnPick">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Margin="12" Padding="16" BackgroundColor="#21FFFFFF"  StrokeShape="RoundRectangle 14">
            <VerticalStackLayout Spacing="4">
              <Label Text="{Binding Name}" FontAttributes="Bold"/>
              <Label Text="{Binding Cost}" FontSize="12" Opacity="0.7"/>
              <Label Text="{Binding Table}" FontSize="12" Opacity="0.7"/>
              <Label Text="{Binding Description}" FontSize="12" Opacity="1"
                LineBreakMode="TailTruncation"
                MaxLines="1"/>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </VerticalStackLayout>
</ContentPage>
