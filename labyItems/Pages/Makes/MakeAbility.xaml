<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.MakeAbility"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    Title="Manufacture"
    BackgroundColor="{StaticResource White}">

    <Grid Padding="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">

        <Border Grid.Row="0"
                Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource White}"
                Padding="8,4">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,Auto,*"
                      ColumnSpacing="8">
                    <CheckBox Grid.Column="0"
                              IsVisible="{Binding ShowAvailabilityFilter, Source={x:Reference Root}}"
                              VerticalOptions="Center"
                              IsChecked="{Binding ShowAvailableOnly, Source={x:Reference Root}, Mode=TwoWay}"
                              CheckedChanged="OnAvailabilityToggleChanged" />
                    <Label Grid.Column="1"
                           IsVisible="{Binding ShowAvailabilityFilter, Source={x:Reference Root}}"
                           Text="{Binding AvailabilityToggleText, Source={x:Reference Root}}"
                           VerticalTextAlignment="Center"
                           FontAttributes="Bold"
                           FontSize="12"
                           Opacity="0.8" />
                    <SearchBar Grid.Column="{Binding SearchColumn, Source={x:Reference Root}}"
                               Grid.ColumnSpan="{Binding SearchColumnSpan, Source={x:Reference Root}}"
                               x:Name="Search"
                               Placeholder="Search by name or description"
                               BackgroundColor="{StaticResource White}"
                               TextChanged="OnSearchChanged" />
                </Grid>

                <controls:ChipGroup
                    IsVisible="{Binding ShowSourceBookFilters, Source={x:Reference Root}}"
                    Items="{Binding SourceBookFilterOptions, Source={x:Reference Root}}"
                    SelectedItem="{Binding SelectedSourceBookFilter, Source={x:Reference Root}, Mode=TwoWay}" />

                <controls:ChipGroup
                    IsVisible="{Binding ShowBracketFilters, Source={x:Reference Root}}"
                    Items="{Binding BracketFilterOptions, Source={x:Reference Root}}"
                    SelectedItem="{Binding SelectedBracketFilter, Source={x:Reference Root}, Mode=TwoWay}" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1">
            <CollectionView x:Name="Results"
                            SelectionMode="None"
                            ItemsSource="{Binding Rows, Source={x:Reference Root}}"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemsLayout="VerticalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8"
                                Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource White}"
                                Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResultTapped"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="8">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalOptions="Start"
                                          CheckedChanged="OnRowCheckedChanged" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding MetaText}"
                                           FontSize="12"
                                           Opacity="0.75" />
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           Opacity="0.85"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="&#xF05A;"
                                        FontFamily="FASolid"
                                        FontSize="12"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SubtleTextColor}"
                                        HeightRequest="18"
                                        WidthRequest="18"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        VerticalOptions="Start"
                                        Clicked="OnInfoClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="No abilities found for the current search."
                   IsVisible="{Binding HasRows, Source={x:Reference Root}, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Opacity="0.7" />
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Clicked="OnCancelClicked" />
            <Label Grid.Column="1"
                   Text="{Binding SelectionSummaryText, Source={x:Reference Root}}"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"
                   Opacity="0.75" />
            <Button Grid.Column="2"
                    Text="{Binding ConfirmButtonText, Source={x:Reference Root}}"
                    IsEnabled="{Binding HasSelectedRows, Source={x:Reference Root}}"
                    Clicked="OnConfirmClicked" />
        </Grid>
    </Grid>
</ContentPage>
