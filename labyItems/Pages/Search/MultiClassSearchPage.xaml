<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Search.MultiClassSearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    xmlns:controls="clr-namespace:labyItems.Controls"
    BackgroundColor="{StaticResource White}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ClassCardTemplate">
                <Border Padding="12" Margin="0,0,0,8" Stroke="{StaticResource SubtleTextColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Frame WidthRequest="34" HeightRequest="34" CornerRadius="17" Padding="0" HasShadow="False" BorderColor="{StaticResource SurfaceBorderColor}" BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"><Label Text="{Binding Icon}" FontFamily="FASolid" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/></Frame><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"/><Label Text="{Binding Subtitle}" FontSize="12" TextColor="{StaticResource MutedTextColor}"/><Label Text="{Binding Summary}" FontSize="12" Opacity="0.8" MaxLines="2" LineBreakMode="TailTruncation"/></VerticalStackLayout><Button Grid.Column="2" Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}" FontFamily="FASolid" FontSize="13" Padding="0" BackgroundColor="Transparent" TextColor="{StaticResource SubtleTextColor}" HeightRequest="28" WidthRequest="28" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnInfoClicked" CommandParameter="{Binding .}"/></Grid></Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*"
              RowSpacing="8"
              Padding="16,12,16,8">

            <!-- Header Row: Burger Menu, Search Input -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="10"
                  VerticalOptions="Center">
                <controls:BurgerMenuButton Grid.Column="0"
                                           Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                <controls:SearchFilterBar Grid.Column="1" Placeholder="Search multi-classes..." SearchText="{Binding SearchText, Mode=TwoWay}" OpenFiltersCommand="{Binding OpenFiltersCommand}"/>
            </Grid>

            <!-- MultiClass Cards CollectionView -->
            <Grid Grid.Row="1">
                <CollectionView x:Name="MultiClassesCollection"
                                ItemsSource="{Binding FilteredMultiClasses}"
                                ItemTemplate="{StaticResource ClassCardTemplate}"
                                SelectionMode="None"
                                ItemSizingStrategy="MeasureAllItems" />

                <VerticalStackLayout IsVisible="{Binding HasNoResults}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="8">
                    <Label Text="No matching multi-classes found."
                           FontSize="13"
                           Opacity="0.75"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <controls:LoadingIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Message="Loading multi-classes..." />
            </Grid>
        </Grid>

        <!-- Slide-out Burger Menu -->
        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.SearchMultiClasses}" />
        <Grid IsVisible="{Binding IsFilterModalOpen}" BackgroundColor="#66000000"><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelFiltersCommand}"/></Grid.GestureRecognizers><Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="360" MaximumWidthRequest="420" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="14"><Border.GestureRecognizers><TapGestureRecognizer/></Border.GestureRecognizers><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><Label Text="Filters" FontAttributes="Bold" FontSize="18"/><FlexLayout Grid.Row="1" BindableLayout.ItemsSource="{Binding FilterChips}" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate><Border Style="{StaticResource SelectableFilterPillBorderStyle}" Margin="0,0,8,8"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=ToggleFilterChipCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Label Text="{Binding Label}" Style="{StaticResource FilterPillLabelStyle}"/></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout><Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto"><Button Text="Cancel" Command="{Binding CancelFiltersCommand}"/><Button Grid.Column="2" Text="Search" Command="{Binding ApplyFiltersCommand}"/></Grid></Grid></Border></Grid>
    </Grid>
</ContentPage>
