<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Search.GlobalSearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

<Grid>
    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="10"
          Padding="16">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
            <controls:BurgerMenuButton Grid.Column="0"
                                       IsVisible="{Binding ShowKindChips}"
                                       Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
            <Border Grid.Column="1"
                    Stroke="{StaticResource SurfaceBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#F9FAFB"
                    Padding="8,4"
                    VerticalOptions="Center">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="6">
                    <Entry Grid.Column="0"
                           ClearButtonVisibility="WhileEditing"
                           Placeholder="{Binding SearchPlaceholder}"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="&#xF0B0;"
                            FontFamily="FASolid"
                            FontSize="13"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource SubtleTextColor}"
                            HeightRequest="24"
                            WidthRequest="24"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            VerticalOptions="Center"
                            Command="{Binding OpenFiltersCommand}"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding FilteredResults}"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemsLayout="VerticalList"
                            SelectionMode="None"
                            Margin="0,2,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Stroke="{StaticResource SubtleTextColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource White}"
                                Margin="0,0,0,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter Property="Stroke"
                                            Value="{StaticResource AccentMaroonColor}"/>
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource SelectedSurfaceBackgroundColor}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResultTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">
                                <Border Stroke="{Binding IconBorderColor}"
                                        BackgroundColor="{Binding IconBackgroundColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        VerticalOptions="Start"
                                        Margin="0,2,0,0">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="FASolid"
                                           FontSize="12"
                                           TextColor="{Binding IconColor}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap"
                                           Margin="0,0,4,0"/>
                                    <Label Text="{Binding MetaText}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding DescriptionText}"
                                           FontSize="12"
                                           Opacity="0.8"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2"
                                           IsVisible="{Binding HasDescription}"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        Stroke="{StaticResource SubtleTextColor}"
                                        BackgroundColor="{StaticResource White}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        VerticalOptions="Start"
                                        HorizontalOptions="End"
                                        IsVisible="{Binding CanOpenDetails}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnResultInfoTapped"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                           FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                                           FontSize="13"
                                           TextColor="{StaticResource SubtleTextColor}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding HasNoResults}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8">
                <Label Text="{Binding EmptyStateText}"
                       FontSize="13"
                       Opacity="0.75"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsLoading}"
                               IsRunning="{Binding IsLoading}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="2"
              IsVisible="{Binding IsPickerMode}"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Clicked="OnPickerCancelClicked"/>
            <Button Grid.Column="2"
                    Text="Save"
                    Clicked="OnPickerSaveClicked"/>
        </Grid>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        Grid.RowSpan="3"
                                        IsVisible="{Binding ShowKindChips}"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.Search}" />
    </Grid>

    <Grid IsVisible="{Binding IsFilterModalOpen}"
          BackgroundColor="#66000000">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelFiltersCommand}"/>
        </Grid.GestureRecognizers>
        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="360"
                MaximumWidthRequest="420"
                MaximumHeightRequest="560"
                Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource White}"
                Padding="14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="10">
                <Label Text="Filters"
                       FontAttributes="Bold"
                       FontSize="18"/>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding ShowKindChips}">
                            <Label Text="Categories"
                                   FontAttributes="Bold"
                                   FontSize="13"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding KindChips}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        AlignItems="Start"
                                        JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                                                Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFilterChipCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Label}"
                                                   Style="{StaticResource FilterPillLabelStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12"
                                             BindableLayout.ItemsSource="{Binding FilterSections}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8"
                                              BackgroundColor="Transparent">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/>
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding Title}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   VerticalTextAlignment="Center"/>
                                            <controls:ChevronIconView Grid.Column="1"
                                                                      IsExpanded="{Binding IsExpanded}"
                                                                      AnimateRotation="True"
                                                                      IconSize="28"
                                                                      GlyphSize="14"
                                                                      GlyphColor="{StaticResource MutedTextColor}"
                                                                      InputTransparent="True"/>
                                        </Grid>
                                        <FlexLayout BindableLayout.ItemsSource="{Binding Chips}"
                                                    IsVisible="{Binding IsExpanded}"
                                                    Wrap="Wrap"
                                                    Direction="Row"
                                                    AlignItems="Start"
                                                    JustifyContent="Start">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                                                            Opacity="{Binding ChipOpacity}"
                                                            Margin="0,0,8,8">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFilterChipCommand}"
                                                                                  CommandParameter="{Binding .}"/>
                                                        </Border.GestureRecognizers>
                                                        <Label Text="{Binding Label}"
                                                               Style="{StaticResource FilterPillLabelStyle}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            Command="{Binding CancelFiltersCommand}"/>
                    <Button Grid.Column="2"
                            Text="Search"
                            Command="{Binding ApplyFiltersCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Grid>
</ContentPage>
