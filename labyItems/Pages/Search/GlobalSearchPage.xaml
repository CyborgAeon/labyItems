<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Search.GlobalSearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="10"
          Padding="16">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
            <controls:BurgerMenuButton Grid.Column="0"
                                       Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
            <Entry Grid.Column="1"
                   ClearButtonVisibility="WhileEditing"
                   Placeholder="Search abilities, spells, miracles, evocations, neuronics..."
                   Text="{Binding SearchText, Mode=TwoWay}"
                   VerticalOptions="Center"/>
        </Grid>
        <CollectionView x:Name="FilterChipView"
                        Grid.Row="1"
                        ItemsSource="{Binding ActiveFilterChips}"
                        SelectionMode="None"
                        ItemsLayout="HorizontalList"
                        HeightRequest="38">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SelectableFilterPillBorderStyle}"
                            Margin="0,0,8,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterChipTapped"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Label}"
                               Style="{StaticResource FilterPillLabelStyle}"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding FilteredResults}"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemsLayout="VerticalList"
                            SelectionMode="None"
                            Margin="0,2,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Stroke="{StaticResource SubtleTextColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource White}"
                                Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResultTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">
                                <Border Stroke="{Binding IconBorderColor}"
                                        BackgroundColor="{Binding IconBackgroundColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        VerticalOptions="Start"
                                        Margin="0,2,0,0">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="FASolid"
                                           FontSize="12"
                                           TextColor="{Binding IconColor}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap"
                                           Margin="0,0,4,0"/>
                                    <Label Text="{Binding MetaText}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding DescriptionText}"
                                           FontSize="12"
                                           Opacity="0.8"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2"
                                           IsVisible="{Binding HasDescription}"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        Stroke="{StaticResource SubtleTextColor}"
                                        BackgroundColor="{StaticResource White}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        VerticalOptions="Start"
                                        HorizontalOptions="End"
                                        IsVisible="{Binding CanOpenDetails}">
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.InfoCircle}"
                                           FontFamily="{x:Static helpers:FontAwesomeGlyphs.SolidFamily}"
                                           FontSize="13"
                                           TextColor="{StaticResource SubtleTextColor}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding HasNoResults}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8">
                <Label Text="{Binding EmptyStateText}"
                       FontSize="13"
                       Opacity="0.75"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsLoading}"
                               IsRunning="{Binding IsLoading}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
        </Grid>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        Grid.RowSpan="3"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.Search}" />
    </Grid>
</ContentPage>
