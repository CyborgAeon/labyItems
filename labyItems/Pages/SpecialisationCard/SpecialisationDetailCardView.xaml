<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.SpecialisationCard.SpecialisationDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame Style="{StaticResource DetailCardFrameStyle}">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding TitleText, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Label Text="{Binding SubheadingText, Source={x:Reference Root}}"
                   FontAttributes="Italic"
                   TextColor="{StaticResource MutedTextColor}"
                   IsVisible="{Binding HasSubheading, Source={x:Reference Root}}"/>

            <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="DESCRIPTION"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding DescriptionChevronText, Source={x:Reference Root}}"
                       IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                       TextColor="{StaticResource MutedTextColor}"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>

            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowDescriptionSeeMore, Source={x:Reference Root}}"/>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasSpecialistAbilityRows, Source={x:Reference Root}}">
                <Label Text="GRANTS ONE OF"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SpecialistAbilityRows, Source={x:Reference Root}}"
                                     Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="{StaticResource MutedTextColor}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding HasDescription}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="&#xF05A;"
                                        FontFamily="FASolid"
                                        FontSize="12"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SubtleTextColor}"
                                        HeightRequest="18"
                                        WidthRequest="18"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        Clicked="OnSpecialistAbilityInfoClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasAsPerEntries, Source={x:Reference Root}}">
                <Label Text="AS PER"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AsPerEntries, Source={x:Reference Root}}"
                                     Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Text="{Binding DisplayName}"
                                       LineBreakMode="WordWrap"
                                       VerticalTextAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Text="&#xF05A;"
                                        FontFamily="FASolid"
                                        FontSize="12"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SubtleTextColor}"
                                        HeightRequest="18"
                                        WidthRequest="18"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        IsVisible="{Binding HasDetails}"
                                        Clicked="OnAsPerInfoClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasHint, Source={x:Reference Root}}">
                <Label Text="HINT"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding HintText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        AlignItems="Start"
                        JustifyContent="Start"
                        BindableLayout.ItemsSource="{Binding MetadataChips, Source={x:Reference Root}}"
                        IsVisible="{Binding HasMetadataChips, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FilterPillBorderStyle}"
                                Margin="0,0,8,8">
                            <Label Text="{Binding .}"
                                   Style="{StaticResource FilterPillLabelStyle}"/>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasRoleplay, Source={x:Reference Root}}">
                <Label Text="ROLEPLAY"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding RoleplayText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasLore, Source={x:Reference Root}}">
                <Label Text="LORE"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding LoreText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentView>
