<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="labyItems.Pages.SpecialisationCard.SpecialisationCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:specialisationCard="clr-namespace:labyItems.Pages.SpecialisationCard"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
    <controls:DetailPageHeader x:Name="DetailHeader" HeaderText="Specialisation"/>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16">
            <specialisationCard:SpecialisationDetailCardView x:Name="SpecialisationDetails"/>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
