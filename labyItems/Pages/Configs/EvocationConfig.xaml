<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:labyItems.Controls"
             x:Class="labyItems.Pages.EvocationConfigPage"
             Title="Configure Evocation">

  <VerticalStackLayout Padding="20" Spacing="12">
    <Label Text="{Binding BaseEvocation.Name}" FontAttributes="Bold" FontSize="20" />

    <Label Text="Cast basic times per day" />
    <controls:PlusMinusControl Count="{Binding BasicPerDay, Mode=TwoWay}" AllowMultiple="True" />

    <Label Text="Cast advanced times per day" />
    <controls:PlusMinusControl Count="{Binding AdvancedPerDay, Mode=TwoWay}" AllowMultiple="True" />

    <CheckBox IsChecked="{Binding AddBasic}" />
    <Label Text="Add basic to base list (+15)" />

    <CheckBox IsChecked="{Binding AddAdvanced}" />
    <Label Text="Add advanced to base list (+18)" />

    <CheckBox IsChecked="{Binding AddPrep}" />
    <Label Text="Add to base list with 30s prep (+50%)" />

    <Label Text="{Binding Total, StringFormat='Total ISP: {0}'}"
           FontAttributes="Bold" FontSize="18" />

    <Button Text="Return" Clicked="OnReturn" />
  </VerticalStackLayout>
</ContentPage>