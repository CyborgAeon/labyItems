<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:labyItems.Helpers"
             xmlns:controls="clr-namespace:labyItems.Controls"
             xmlns:models="clr-namespace:labyItems.Models.WorldMap"
             x:Class="labyItems.Pages.WorldMap.PrimusMapPage"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False" Title="Primus">
    <Grid BackgroundColor="#FAF8F3">
        <CollectionView x:Name="TownResults" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">
                    <Grid>
                        <Image Source="login_watermark.png" HeightRequest="120" Aspect="AspectFill" InputTransparent="True" />
                        <BoxView Color="{StaticResource Primary}" Opacity="0.82" InputTransparent="True" />
                        <VerticalStackLayout Padding="12,8,12,14" Spacing="8">
                            <Grid ColumnDefinitions="44,*,44">
                                <Button Text="{x:Static helpers:FontAwesomeGlyphs.Menu}" TextColor="White" BackgroundColor="Transparent"
                                        FontSize="26" Padding="0" MinimumHeightRequest="44" Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}"
                                        SemanticProperties.Description="Open toolset menu" />
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Label Text="LABYRINTHE" FontAttributes="Bold" FontSize="20" TextColor="White" HorizontalTextAlignment="Center" />
                                    <Label Text="CITIES AND WILDS" FontSize="11" TextColor="White" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="PRIMUS" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                            <Button x:Name="HeaderDate" Text="Statistics month" Clicked="OnSelectDateClicked" TextColor="White" BackgroundColor="Transparent" Padding="0" MinimumHeightRequest="44" />
                            <Label x:Name="OverviewPlace" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.Deity}" FontFamily="FASolid" TextColor="White" FontSize="22" HorizontalTextAlignment="Center" />
                                    <Label Text="Highest deity / order" TextColor="White" FontSize="11" HorizontalTextAlignment="Center" />
                                    <Label x:Name="DeityHighlight" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.Administration}" FontFamily="FASolid" TextColor="White" FontSize="22" HorizontalTextAlignment="Center" />
                                    <Label Text="Strongest administration" TextColor="White" FontSize="11" HorizontalTextAlignment="Center" />
                                    <Label x:Name="AdministrationHighlight" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="{x:Static helpers:FontAwesomeGlyphs.Dragon}" FontFamily="FASolid" TextColor="White" FontSize="22" HorizontalTextAlignment="Center" />
                                    <Label Text="Highest dragon" TextColor="White" FontSize="11" HorizontalTextAlignment="Center" />
                                    <Label x:Name="DragonHighlight" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="StatusLabel" IsVisible="False" Margin="12,8" TextColor="{StaticResource MutedTextColor}" FontSize="13" />
                    <controls:PrimusMapView x:Name="Map" HeightRequest="290" SizeChanged="OnMapSizeChanged" />
                    <Grid Padding="8" ColumnDefinitions="44,44,44,*,*,44" ColumnSpacing="4">
                        <Button Text="{x:Static helpers:FontAwesomeGlyphs.Add}" FontFamily="FASolid" Padding="0" Clicked="OnZoomInClicked" SemanticProperties.Description="Zoom in" />
                        <Button Grid.Column="1" Text="{x:Static helpers:FontAwesomeGlyphs.Minus}" FontFamily="FASolid" Padding="0" Clicked="OnZoomOutClicked" SemanticProperties.Description="Zoom out" />
                        <Button Grid.Column="2" Text="{x:Static helpers:FontAwesomeGlyphs.Map}" FontFamily="FASolid" Padding="0" Clicked="OnFitClicked" SemanticProperties.Description="Fit whole map" />
                        <Button Grid.Column="3" x:Name="PlacesButton" Text="All places" FontSize="13" Padding="6,0" Clicked="OnSelectPlaceClicked" />
                        <Button Grid.Column="4" x:Name="ToolbarDate" Text="Month" FontSize="12" Padding="4,0" Clicked="OnSelectDateClicked" SemanticProperties.Description="Select statistics month" />
                        <Button Grid.Column="5" x:Name="FilterButton" Text="{x:Static helpers:FontAwesomeGlyphs.Filter}" FontFamily="FASolid" Padding="0" Clicked="OnOpenFiltersClicked" SemanticProperties.Description="Filter towns" />
                    </Grid>
                    <Border x:Name="SelectedPlaceCard" Margin="12,4,12,12" Padding="12" Style="{StaticResource SelectableCardBorderStyle}">
                        <Grid ColumnDefinitions="*,1.3*,44" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:FontAwesomeGlyphs.Map}" FontFamily="FASolid" FontSize="26" TextColor="{StaticResource Primary}" />
                                <Label x:Name="SelectedName" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label x:Name="SelectedCategory" FontSize="12" TextColor="{StaticResource MutedTextColor}" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="22,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:FontAwesomeGlyphs.Deity}" FontFamily="FASolid" VerticalTextAlignment="Center" />
                                <Label x:Name="CardDeity" Grid.Column="1" FontSize="13" />
                                <Label Grid.Row="1" Text="{x:Static helpers:FontAwesomeGlyphs.Administration}" FontFamily="FASolid" VerticalTextAlignment="Center" />
                                <Label x:Name="CardAdministration" Grid.Row="1" Grid.Column="1" FontSize="13" />
                                <Label Grid.Row="2" Text="{x:Static helpers:FontAwesomeGlyphs.Dragon}" FontFamily="FASolid" VerticalTextAlignment="Center" />
                                <Label x:Name="CardDragon" Grid.Row="2" Grid.Column="1" FontSize="13" />
                            </Grid>
                            <Button Grid.Column="2" Text="{x:Static helpers:FontAwesomeGlyphs.Chevron}" FontFamily="FASolid" Padding="0" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Clicked="OnOpenSelectedClicked" SemanticProperties.Description="Open selected place statistics" />
                        </Grid>
                    </Border>
                    <Label x:Name="ResultsHeading" IsVisible="False" Margin="16,4,16,8" Style="{StaticResource SectionHeaderLabelStyle}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView><Label x:Name="EmptyResults" IsVisible="False" Margin="16" Text="No towns match these filters for the selected month." TextColor="{StaticResource MutedTextColor}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorldTownResult">
                    <controls:ListItemRowView PrimaryText="{Binding Name}" SecondaryText="{Binding Summary}" ShowSecondaryText="True" PrimaryTextMaxLines="2"
                                              PrimaryColumnWidth="*" SecondaryColumnWidth="*" ShowInfo="True" ActionCommandParameter="{Binding .}"
                                              RowClicked="OnTownResultClicked" InfoClicked="OnTownInfoClicked" Margin="12,0" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu" />
        <Grid x:Name="FilterOverlay" IsVisible="False" BackgroundColor="#66000000">
            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCancelFiltersTapped" /></Grid.GestureRecognizers>
            <Border x:Name="FilterPanel" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="360" MaximumWidthRequest="420" HeightRequest="560" MaximumHeightRequest="560"
                    Margin="16" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="14">
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Label Text="Filter towns" FontAttributes="Bold" FontSize="18" />
                    <ScrollView Grid.Row="1"><VerticalStackLayout Spacing="12">
                        <Label Text="Town name" FontAttributes="Bold" FontSize="13" />
                        <Entry x:Name="NameFilter" Placeholder="Search published towns" />
                        <Label Text="Hiring Hall score (Volksmight)" FontAttributes="Bold" FontSize="13" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Entry x:Name="HallMinimum" Placeholder="Minimum" Keyboard="Numeric" SemanticProperties.Description="Minimum Hiring Hall score" />
                            <Entry x:Name="HallMaximum" Grid.Column="1" Placeholder="Maximum" Keyboard="Numeric" SemanticProperties.Description="Maximum Hiring Hall score" />
                        </Grid>
                        <Label Text="Administration" FontAttributes="Bold" FontSize="13" />
                        <Picker x:Name="AdministrationMetric" Title="Administration statistic" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Entry x:Name="AdministrationMinimum" Placeholder="Minimum" Keyboard="Numeric" /><Entry Grid.Column="1" x:Name="AdministrationMaximum" Placeholder="Maximum" Keyboard="Numeric" /></Grid>
                        <Label Text="Dragons" FontAttributes="Bold" FontSize="13" />
                        <Picker x:Name="DragonMetric" Title="Dragon" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Entry x:Name="DragonMinimum" Placeholder="Minimum" Keyboard="Numeric" /><Entry Grid.Column="1" x:Name="DragonMaximum" Placeholder="Maximum" Keyboard="Numeric" /></Grid>
                        <Label Text="Deities and orders" FontAttributes="Bold" FontSize="13" />
                        <Picker x:Name="DeityMetric" Title="Deity or order" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Entry x:Name="DeityMinimum" Placeholder="Minimum" Keyboard="Numeric" /><Entry Grid.Column="1" x:Name="DeityMaximum" Placeholder="Maximum" Keyboard="Numeric" /></Grid>
                        <Label Text="Blank limits impose no restriction. Minimum and maximum are inclusive; use the same value for an exact score." FontSize="12" TextColor="{StaticResource MutedTextColor}" />
                        <Label Text="Council positions and separate Hiring Hall levels: unknown. This dataset does not publish office-holder assignments or building levels." FontSize="12" TextColor="{StaticResource MutedTextColor}" />
                        <Label x:Name="FilterError" IsVisible="False" TextColor="{StaticResource Primary}" FontSize="13" />
                    </VerticalStackLayout></ScrollView>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Button Text="Cancel" Clicked="OnCancelFiltersClicked" />
                        <Button Grid.Column="1" Text="Reset" Clicked="OnResetFiltersClicked" />
                        <Button Grid.Column="2" Text="Search" Clicked="OnApplyFiltersClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
