<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.EvocationCard.EvocationDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <ContentView>
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding EvocationName, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNameTapped"/></Label.GestureRecognizers>
            </Label>

            <Border Padding="10,5" HorizontalOptions="Start" StrokeShape="RoundRectangle 999"
                    Stroke="{StaticResource AccentMaroonColor}" BackgroundColor="{StaticResource White}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Evocation.isAdvanced, Source={x:Reference Root}}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource AccentMaroonColor}"/>
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTierTapped"/></Border.GestureRecognizers>
                <Label Text="{Binding TierDisplayText, Source={x:Reference Root}}" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource AccentMaroonColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Evocation.isAdvanced, Source={x:Reference Root}}" Value="True">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <VerticalStackLayout x:Name="EvocationKeyInformationGrid" Margin="-16,0" Padding="12,10" Spacing="10">
                <Grid ColumnDefinitions="*,1,*,1,*">
                    <VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnPowerTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="POWER" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PowerDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                    <BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/>
                    <VerticalStackLayout Grid.Column="2"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="RANGE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding RangeDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                    <BoxView Grid.Column="3" Color="{StaticResource SurfaceBorderColor}"/>
                    <VerticalStackLayout Grid.Column="4"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnDurationTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="DURATION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding DurationDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" IsVisible="{Binding ShowFields, Source={x:Reference Root}}"/>
                <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowFields, Source={x:Reference Root}}">
                    <Grid ColumnDefinitions="*,Auto" Padding="8,2"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnFieldsTapped"/></Grid.GestureRecognizers><VerticalStackLayout Spacing="1"><Label Text="FIELDS" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Start"/><Label x:Name="FieldsSummaryLabel" Text="{Binding FieldsDisplayText, Source={x:Reference Root}}" FontSize="16" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" SizeChanged="OnFieldsSummarySizeChanged"/></VerticalStackLayout><controls:ChevronIconView Grid.Column="1" IsExpanded="{Binding IsFieldsExpanded, Source={x:Reference Root}}" AnimateRotation="True" GlyphSize="13" InputTransparent="True" IsVisible="{Binding CanExpandFields, Source={x:Reference Root}}" VerticalOptions="Center"/></Grid>
                    <controls:AnimatedExpandView IsExpanded="{Binding IsFieldsExpanded, Source={x:Reference Root}}" AnimationName="EvocationFieldsExpand"><VerticalStackLayout BindableLayout.ItemsSource="{Binding FieldEntries, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><Label Text="{Binding .}" Padding="8,6" FontSize="14"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></controls:AnimatedExpandView>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowImmunity, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><Grid ColumnDefinitions="*,44"><VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnImmunityTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="IMMUNITY" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding ImmunityDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="&#xF05A;" FontFamily="FASolid" Padding="0" BackgroundColor="Transparent" IsVisible="{Binding HasImmunityLink, Source={x:Reference Root}}" Clicked="OnImmunityInfoClicked"/></Grid></VerticalStackLayout>
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasDamageQuickFacts, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><controls:CombatQuickFactsView Facts="{Binding DamageQuickFacts, Source={x:Reference Root}}"/></VerticalStackLayout>
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasHealQuickFacts, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><controls:CombatQuickFactsView Facts="{Binding HealQuickFacts, Source={x:Reference Root}}"/></VerticalStackLayout>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="DESCRIPTION"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <controls:ChevronIconView Grid.Column="1"
                                          IsExpanded="{Binding IsDescriptionExpanded, Source={x:Reference Root}}"
                                          AnimateRotation="True"
                                          GlyphSize="14"
                                          GlyphColor="{StaticResource MutedTextColor}"
                                          InputTransparent="True"
                                          IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowDescriptionSeeMore, Source={x:Reference Root}}"/>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowVerbal, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVerbalSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="VERBAL"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsVerbalExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandVerbal, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <ContentView x:Name="VerbalTextContainer">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVerbalSectionTapped"/>
                    </ContentView.GestureRecognizers>
                    <Label x:Name="VerbalLabel"
                           Text="{Binding VerbalText, Source={x:Reference Root}}"
                           MaxLines="{Binding VerbalMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
                <Label Text="... see more"
                       TextColor="{StaticResource MutedTextColor}"
                       FontSize="12"
                       IsVisible="{Binding ShowVerbalSeeMore, Source={x:Reference Root}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowPrereqs, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrereqSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="PREREQUISITES"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsPrereqExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandPrereqs, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <ContentView x:Name="PrereqTextContainer">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrereqSectionTapped"/>
                    </ContentView.GestureRecognizers>
                    <Label x:Name="PrereqLabel"
                           Text="{Binding PrereqText, Source={x:Reference Root}}"
                           MaxLines="{Binding PrereqMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
                <Label Text="... see more"
                       TextColor="{StaticResource MutedTextColor}"
                       FontSize="12"
                       IsVisible="{Binding ShowPrereqSeeMore, Source={x:Reference Root}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowDamageSection, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDamageSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="DAMAGE"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsDamageExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandDamage, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <ContentView x:Name="DamageTextContainer">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDamageSectionTapped"/>
                    </ContentView.GestureRecognizers>
                    <Label x:Name="DamageLabel"
                           Text="{Binding DamageSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding DamageMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
                <Label Text="Tap to add damage" FontSize="13" TextColor="{StaticResource MutedTextColor}"
                       IsVisible="{Binding HasDamageSummary, Source={x:Reference Root}, Converter={StaticResource InverseBoolConverter}}">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnDamageSectionTapped"/></Label.GestureRecognizers>
                </Label>
                <Label Text="... see more"
                       TextColor="{StaticResource MutedTextColor}"
                       FontSize="12"
                       IsVisible="{Binding ShowDamageSeeMore, Source={x:Reference Root}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowHealSection, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHealSectionTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="HEAL"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsHealExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              InputTransparent="True"
                                              IsVisible="{Binding CanExpandHeal, Source={x:Reference Root}}"
                                              HorizontalOptions="End"
                                              VerticalOptions="Center"/>
                </Grid>

                <ContentView x:Name="HealTextContainer">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHealSectionTapped"/>
                    </ContentView.GestureRecognizers>
                    <Label x:Name="HealLabel"
                           Text="{Binding HealSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding HealMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
                <Label Text="Tap to add healing" FontSize="13" TextColor="{StaticResource MutedTextColor}"
                       IsVisible="{Binding HasHealSummary, Source={x:Reference Root}, Converter={StaticResource InverseBoolConverter}}">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnHealSectionTapped"/></Label.GestureRecognizers>
                </Label>
                <Label Text="... see more"
                       TextColor="{StaticResource MutedTextColor}"
                       FontSize="12"
                       IsVisible="{Binding ShowHealSeeMore, Source={x:Reference Root}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasMetaChips, Source={x:Reference Root}}">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

                <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            BindableLayout.ItemsSource="{Binding MetaChips, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource MetaChipFrameStyle}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="FASolid"
                                           FontSize="11"
                                           VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Text}"
                                           FontSize="12"
                                           VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentView>
</ContentView>
