<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.EvocationCard.EvocationDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame Style="{StaticResource DetailCardFrameStyle}">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding EvocationName, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <Label Text="&#xF06C;"
                       FontFamily="FASolid"
                       FontSize="14"
                       TextColor="{StaticResource SubtleTextColor}"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding PowerDisplayText, Source={x:Reference Root}}"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="DESCRIPTION"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        Text="{Binding DescriptionChevronText, Source={x:Reference Root}}"
                        IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                        Clicked="OnDescriptionToggleClicked"
                        Style="{StaticResource ChevronButtonStyle}"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasVerbal, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="VERBAL"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding VerbalChevronText, Source={x:Reference Root}}"
                            IsVisible="{Binding CanExpandVerbal, Source={x:Reference Root}}"
                            Clicked="OnVerbalToggleClicked"
                            Style="{StaticResource ChevronButtonStyle}"/>
                </Grid>

                <ContentView x:Name="VerbalTextContainer">
                    <Label x:Name="VerbalLabel"
                           Text="{Binding VerbalText, Source={x:Reference Root}}"
                           MaxLines="{Binding VerbalMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasPrereqs, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="PREREQUISITES"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding PrereqChevronText, Source={x:Reference Root}}"
                            IsVisible="{Binding CanExpandPrereqs, Source={x:Reference Root}}"
                            Clicked="OnPrereqToggleClicked"
                            Style="{StaticResource ChevronButtonStyle}"/>
                </Grid>

                <ContentView x:Name="PrereqTextContainer">
                    <Label x:Name="PrereqLabel"
                           Text="{Binding PrereqText, Source={x:Reference Root}}"
                           MaxLines="{Binding PrereqMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasDamageSummary, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="DAMAGE"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding DamageChevronText, Source={x:Reference Root}}"
                            IsVisible="{Binding CanExpandDamage, Source={x:Reference Root}}"
                            Clicked="OnDamageToggleClicked"
                            Style="{StaticResource ChevronButtonStyle}"/>
                </Grid>

                <ContentView x:Name="DamageTextContainer">
                    <Label x:Name="DamageLabel"
                           Text="{Binding DamageSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding DamageMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasHealSummary, Source={x:Reference Root}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="HEAL"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1"
                            Text="{Binding HealChevronText, Source={x:Reference Root}}"
                            IsVisible="{Binding CanExpandHeal, Source={x:Reference Root}}"
                            Clicked="OnHealToggleClicked"
                            Style="{StaticResource ChevronButtonStyle}"/>
                </Grid>

                <ContentView x:Name="HealTextContainer">
                    <Label x:Name="HealLabel"
                           Text="{Binding HealSummaryText, Source={x:Reference Root}}"
                           MaxLines="{Binding HealMaxLines, Source={x:Reference Root}}"
                           LineBreakMode="WordWrap"
                           SizeChanged="OnExpandableLabelSizeChanged"/>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasMetaChips, Source={x:Reference Root}}">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

                <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            BindableLayout.ItemsSource="{Binding MetaChips, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource MetaChipFrameStyle}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="FASolid"
                                           FontSize="11"
                                           VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Text}"
                                           FontSize="12"
                                           VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentView>
