<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="labyItems.Pages.AddCharacter"
             Title="New Character">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Name" />
      <Entry x:Name="NameEntry" />
      <Label Text="Class" />
      <Entry x:Name="ClassEntry" />
      <Label Text="Player Name (optional)" />
      <Entry x:Name="PlayerEntry" />

      <Button Text="Save" Clicked="OnSave" HeightRequest="50" CornerRadius="12" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
