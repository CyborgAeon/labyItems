<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.AddCharacter"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:models="clr-namespace:labyItems.Models"
  Title="New Character">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <Label Text="Name" />
      <Entry x:Name="NameEntry" />
      <Label Text="Class" />
      <Entry x:Name="ClassEntry" />
      <Label Text="Points" />
      <Entry x:Name="PointsEntry" />
      <Label Text="Player Name (optional)" />
      <Entry x:Name="PlayerEntry" />
      
      
      <Button
        Clicked="OnSave"
        CornerRadius="12"
        HeightRequest="50"
        Text="Save" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
