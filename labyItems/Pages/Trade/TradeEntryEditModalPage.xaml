<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Trade.TradeEntryEditModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    x:Name="RootPage"
    Title="Edit trade item">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18"
                                 Spacing="12">
                <Label Text="{Binding TitleLine}"
                       FontAttributes="Bold"
                       FontSize="18" />
                <Label Text="{Binding MetaLine}"
                       FontSize="12"
                       Opacity="0.75"
                       LineBreakMode="WordWrap" />

                <Border IsVisible="{Binding ShowAbilitySearch}"
                        Padding="0"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerShadowColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="0">
                        <Entry x:Name="AbilitySearchEntry"
                               Grid.Row="0"
                               Margin="10,8"
                               BackgroundColor="{StaticResource White}"
                               TextColor="{StaticResource Black}"
                               PlaceholderColor="{StaticResource MutedTextColor}"
                               Placeholder="Search spells, miracles, evocations"
                               Text="{Binding Source={x:Reference RootPage}, Path=AbilitySearchText, Mode=TwoWay}"
                               Focused="OnAbilitySearchFocused"
                               Unfocused="OnAbilitySearchUnfocused" />

                        <CollectionView Grid.Row="1"
                                        HeightRequest="220"
                                        IsVisible="{Binding Source={x:Reference RootPage}, Path=ShowAbilityResults}"
                                        ItemsSource="{Binding Source={x:Reference RootPage}, Path=FilteredAbilityOptions}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="0" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,8"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="1">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAbilitySearchResultTapped" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Row="0"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               Text="{Binding Title}" />
                                        <Label Grid.Row="1"
                                               FontSize="11"
                                               Opacity="0.7"
                                               Text="{Binding Meta}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <controls:CheckboxControl IsVisible="{Binding ShowSpellModeOptions}"
                                          IsChecked="{Binding IsSpellTeachingScroll, Mode=TwoWay}"
                                          LabelText="Treat as teaching scroll" />
                <controls:CheckboxControl IsVisible="{Binding ShowSpellModeOptions}"
                                          IsChecked="{Binding IsSpellScroll, Mode=TwoWay}"
                                          LabelText="Treat as scroll" />

                <controls:CheckboxControl IsVisible="{Binding ShowMiracleModeOptions}"
                                          IsChecked="{Binding IsMiracleScripture, Mode=TwoWay}"
                                          LabelText="Treat as scripture of faith" />
                <controls:CheckboxControl IsVisible="{Binding ShowMiracleModeOptions}"
                                          IsChecked="{Binding IsMiracleScroll, Mode=TwoWay}"
                                          LabelText="Treat as scroll" />

                <controls:CheckboxControl IsVisible="{Binding ShowEvocationModeOptions}"
                                          IsChecked="{Binding IsEvocationTalisman, Mode=TwoWay}"
                                          LabelText="Treat as talisman" />

                <controls:PlusMinusControl IsVisible="{Binding ShowUsesEditor}"
                                           LabelText="Uses per day"
                                           AllowMultiple="True"
                                           Min="1"
                                           Count="{Binding UsesPerDay, Mode=TwoWay}" />

                <Button Text="Open ISP Calculator"
                        IsVisible="{Binding ShowCustomEditor}"
                        Clicked="OnOpenIspCalculatorClicked" />

                <Label Text="{Binding CustomBreakdownText}"
                       FontSize="12"
                       IsVisible="{Binding HasCustomBreakdown}"
                       LineBreakMode="WordWrap" />

                <Label Text="{Binding CostFormulaDisplay}"
                       FontSize="12"
                       LineBreakMode="WordWrap" />
                <Label Text="{Binding ResolvedCostText}"
                       FontAttributes="Bold" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Cost override"
                           FontAttributes="Bold"
                           FontSize="14" />
                    <Entry x:Name="OverrideCostEntry"
                           Keyboard="Numeric"
                           Placeholder="Leave blank to use at-cost value" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              Padding="16"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="Remove"
                    TextColor="{StaticResource AccentMaroonColor}"
                    Clicked="OnRemoveClicked" />
            <Button Grid.Column="1"
                    Text="Close"
                    Clicked="OnCloseClicked" />
            <Button Grid.Column="2"
                    Text="Save changes"
                    Clicked="OnSaveClicked" />
        </Grid>
    </Grid>
</ContentPage>
