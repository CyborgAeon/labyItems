<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
       x:Class="labyItems.Pages.Trade.TradePage"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:controls="clr-namespace:labyItems.Controls"
       xmlns:trade="clr-namespace:labyItems.Pages.Trade"
       x:Name="RootPage"
       NavigationPage.HasNavigationBar="False"
       Shell.NavBarIsVisible="False"
       Title="Initiate Trade">
       <ContentPage.Resources>
              <DataTemplate x:Key="TradeEntryTemplate"
                            x:DataType="trade:TradeEntryVm">
                     <Grid RowDefinitions="Auto,1"
                           RowSpacing="0">
                            <Border Grid.Row="0"
                                    Padding="8,6"
                                    Background="{Binding CardBackgroundBrush}"
                                    Stroke="{Binding CardBorderBrush}"
                                    StrokeThickness="{Binding CardBorderThickness}"
                                    StrokeShape="RoundRectangle 4">
                                   <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                         ColumnDefinitions="*,Auto"
                                         ColumnSpacing="6"
                                         RowSpacing="1">
                                          <Label Grid.Row="0"
                                                 Grid.Column="0"
                                                 Text="{Binding TitleLine}"
                                                 FontAttributes="Bold"
                                                 FontSize="14"
                                                 LineBreakMode="TailTruncation"/>
                                          <Button Grid.Row="0"
                                                  Grid.Column="1"
                                                  Text="&#xF1FC;"
                                                  FontFamily="FASolid"
                                                  FontSize="13"
                                                  Padding="0"
                                                  BackgroundColor="Transparent"
                                                  TextColor="{StaticResource SubtleTextColor}"
                                                  HeightRequest="22"
                                                  WidthRequest="22"
                                                  MinimumHeightRequest="0"
                                                  MinimumWidthRequest="0"
                                                  Clicked="OnEditEntryClicked"
                                                  CommandParameter="{Binding .}"/>

                                          <Label Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Text="{Binding MetaLine}"
                                                 FontSize="11"
                                                 Opacity="0.8"
                                                 LineBreakMode="TailTruncation"/>

                                          <Label Grid.Row="2"
                                                 Grid.ColumnSpan="2"
                                                 Text="{Binding ResolvedCostText}"
                                                 FontAttributes="Bold"
                                                 FontSize="14"/>

                                          <Label Grid.Row="3"
                                                 Grid.ColumnSpan="2"
                                                 Text="{Binding CostFormulaDisplay}"
                                                 FontSize="11"
                                                 Opacity="0.75"
                                                 LineBreakMode="WordWrap"/>

                                          <VerticalStackLayout Grid.Row="4"
                                                               Grid.ColumnSpan="2"
                                                               Spacing="0">
                                                 <Label Text="{Binding OverrideDisplay}"
                                                        TextColor="#166534"
                                                        FontSize="11"
                                                        IsVisible="{Binding HasCostOverride}"
                                                        LineBreakMode="WordWrap"/>
                                                 <Label Text="{Binding EstimateWarningText}"
                                                        TextColor="#92400E"
                                                        FontSize="11"
                                                        IsVisible="{Binding ShowEstimateWarning}"
                                                        LineBreakMode="WordWrap"/>
                                                 <Label Text="{Binding CustomBreakdownText}"
                                                        FontSize="11"
                                                        IsVisible="{Binding ShowCustomBreakdownOnCard}"
                                                        LineBreakMode="WordWrap"/>
                                          </VerticalStackLayout>
                                   </Grid>
                            </Border>

                            <BoxView Grid.Row="1"
                                     HeightRequest="1"
                                     Color="{StaticResource DividerShadowColor}"
                                     Opacity="0.45"/>
                     </Grid>
              </DataTemplate>
       </ContentPage.Resources>

       <Grid RowDefinitions="Auto,Auto,*"
             RowSpacing="0">
              <Grid Grid.Row="0"
                    Padding="16,12,16,8"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8">
                     <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                     <Label Grid.Column="1"
                            Text="Trade"
                            FontAttributes="Bold"
                            FontSize="24"
                            VerticalTextAlignment="Center" />
              </Grid>

              <VerticalStackLayout Grid.Row="1"
                                   Padding="10,6,10,8"
                                   Spacing="6">
                     <Label Text="Search spells, miracles, evocations"
                            FontAttributes="Bold"
                            FontSize="16"/>

                     <controls:DictionarySearchBar x:Name="AbilitySearch"
                                                   x:TypeArguments="trade:TradeAbilityOption"
                                                   ItemsSource="{Binding Source={x:Reference RootPage}, Path=AbilityLookup}"
                                                   SelectedValue="{Binding Source={x:Reference RootPage}, Path=SelectedAbility, Mode=TwoWay}"
                                                   PlaceholderText="Type to search"
                                                   SelectionDisplayMemberPath="Name"
                                                   KeyboardAvoidanceEnabled="True"/>
                     <Button Text="Add Custom Item (ISP)"
                             HeightRequest="40"
                             HorizontalOptions="Center"
                             Clicked="OnAddCustomItemClicked"/>
                     <Grid ColumnDefinitions="*,*"
                           ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="3">
                                   <Label Text="{Binding Source={x:Reference RootPage}, Path=LeftHeaderText}"
                                          FontSize="13"
                                          FontAttributes="Bold"/>
                                   <Button Text="Add"
                                           HeightRequest="42"
                                           Clicked="OnAddLeftClicked"
                                           IsEnabled="{Binding Source={x:Reference RootPage}, Path=CanAddSelectedAbility}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3">
                                   <Label Text="{Binding Source={x:Reference RootPage}, Path=RightHeaderText}"
                                          FontSize="13"
                                          FontAttributes="Bold"/>
                                   <Button Text="Add"
                                           HeightRequest="42"
                                           Clicked="OnAddRightClicked"
                                           IsEnabled="{Binding Source={x:Reference RootPage}, Path=CanAddSelectedAbility}"/>
                            </VerticalStackLayout>
                     </Grid>
              </VerticalStackLayout>

              <Grid Grid.Row="2"
                    RowDefinitions="1,*"
                    ColumnDefinitions="*,1,*"
                    RowSpacing="0"
                    ColumnSpacing="0">
                     <BoxView Grid.Row="0"
                              Grid.ColumnSpan="3"
                              HeightRequest="1"
                              Color="{StaticResource DividerShadowColor}"/>

                     <CollectionView Grid.Row="1"
                                     Grid.Column="0"
                                     ItemsSource="{Binding Source={x:Reference RootPage}, Path=LeftEntries}"
                                     ItemTemplate="{StaticResource TradeEntryTemplate}"
                                     SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                   <LinearItemsLayout Orientation="Vertical"
                                                      ItemSpacing="0"/>
                            </CollectionView.ItemsLayout>
                     </CollectionView>

                     <BoxView Grid.Row="1"
                              Grid.Column="1"
                              Color="{StaticResource DividerShadowColor}"/>

                     <CollectionView Grid.Row="1"
                                     Grid.Column="2"
                                     ItemsSource="{Binding Source={x:Reference RootPage}, Path=RightEntries}"
                                     ItemTemplate="{StaticResource TradeEntryTemplate}"
                                     SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                   <LinearItemsLayout Orientation="Vertical"
                                                      ItemSpacing="0"/>
                            </CollectionView.ItemsLayout>
                     </CollectionView>
              </Grid>

              <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                              Grid.RowSpan="3"
                                              SelectedRoute="{x:Static controls:ToolsetRouteKeys.Trade}" />
       </Grid>
</ContentPage>
