<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.AbilityCard.AbilityCardComparisonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:abilityCard="clr-namespace:labyItems.Pages.AbilityCard"
    Title="Ability Details">

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="12">
            <Label Text="{Binding TitleText}"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cards}"
                                 Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <abilityCard:AbilityDetailCardView Ability="{Binding Ability}"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
