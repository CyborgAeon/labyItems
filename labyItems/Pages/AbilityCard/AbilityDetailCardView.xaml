<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.AbilityCard.AbilityDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame Padding="16"
           CornerRadius="12"
           HasShadow="False"
           BorderColor="#E5E7EB">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding AbilityIndex, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*"
                  RowSpacing="6"
                  ColumnSpacing="8">
                <Label Text="TABLE"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding TableDisplayText, Source={x:Reference Root}}"
                       VerticalTextAlignment="Center"/>

                <Label Grid.Row="1"
                       Text="AVAILABILITY"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding AvailabilityText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       VerticalTextAlignment="Center"/>

                <Label Grid.Row="2"
                       Text="COST"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding CostDisplayText, Source={x:Reference Root}}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding ShowCostText, Source={x:Reference Root}}"/>
                <HorizontalStackLayout Grid.Row="2"
                                       Grid.Column="1"
                                       Spacing="2"
                                       IsVisible="{Binding ShowInfiniteCost, Source={x:Reference Root}}">
                    <Label Text="{Binding InfiniteCostPrefixText, Source={x:Reference Root}}"
                           VerticalTextAlignment="Center"/>
                    <Label Text="{Binding InfinityGlyph, Source={x:Reference Root}}"
                           FontFamily="FASolid"
                           VerticalTextAlignment="Center"/>
                    <Label Text=")"
                           VerticalTextAlignment="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <BoxView HeightRequest="1"
                     Color="#E5E7EB"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="DESCRIPTION"
                       FontAttributes="Bold"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        Text="{Binding DescriptionChevronText, Source={x:Reference Root}}"
                        IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                        Clicked="OnDescriptionToggleClicked"
                        BackgroundColor="Transparent"
                        TextColor="#6B7280"
                        FontSize="18"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
        </VerticalStackLayout>
    </Frame>
</ContentView>
