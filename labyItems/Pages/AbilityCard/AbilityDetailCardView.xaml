<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.AbilityCard.AbilityDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <ContentView>
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding AbilityIndex, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Label Text="Non-standard"
                   TextColor="{StaticResource AccentMaroonColor}"
                   FontSize="12"
                   FontAttributes="Bold"
                   IsVisible="{Binding ShowNonStandardBadge, Source={x:Reference Root}}"/>

            <Grid x:Name="AbilityKeyInformationGrid" Margin="-16,0" Padding="12,10" ColumnDefinitions="*,1,*">
                <VerticalStackLayout><Label Text="COST" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding CostValueText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                <BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/>
                <VerticalStackLayout Grid.Column="2"><Label Text="TABLE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding TableValueText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Border Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F9FAFB" Padding="12,10">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAvailabilityTapped"/></Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="&#xF0C0;" FontFamily="FASolid" FontSize="18" TextColor="{StaticResource SubtleTextColor}" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="Available to" FontSize="11" TextColor="{StaticResource Gray900}" Opacity="0.7"/>
                            <Label Text="{Binding AvailabilitySummaryText, Source={x:Reference Root}}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Gray900}" MaxLines="1" LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <controls:ChevronIconView Grid.Column="2" IsExpanded="{Binding IsAvailabilityExpanded, Source={x:Reference Root}}" AnimateRotation="True" GlyphSize="13" GlyphColor="{StaticResource SubtleTextColor}" InputTransparent="True" VerticalOptions="Center" IsVisible="{Binding CanExpandAvailability, Source={x:Reference Root}}"/>
                    </Grid>
                </Border>
                <controls:AnimatedExpandView IsExpanded="{Binding IsAvailabilityExpanded, Source={x:Reference Root}}" AnimationName="AbilityAvailabilityExpand">
                    <Border Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="8">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailabilityEntries, Source={x:Reference Root}}" Spacing="0">
                            <BindableLayout.ItemTemplate><DataTemplate><Grid Padding="8,7"><Label Text="{Binding .}" FontSize="14" LineBreakMode="WordWrap"/></Grid></DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </controls:AnimatedExpandView>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="DESCRIPTION"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <controls:ChevronIconView Grid.Column="1"
                                          IsExpanded="{Binding IsDescriptionExpanded, Source={x:Reference Root}}"
                                          AnimateRotation="True"
                                          GlyphSize="14"
                                          GlyphColor="{StaticResource MutedTextColor}"
                                          InputTransparent="True"
                                          IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowDescriptionSeeMore, Source={x:Reference Root}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </Label.GestureRecognizers>
            </Label>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasNotesSection, Source={x:Reference Root}}">
                <Label Text="NOTES"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>

                <Label Text="{Binding NotesText, Source={x:Reference Root}}"
                       IsVisible="{Binding HasNotesText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>

                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding HasPreReqs, Source={x:Reference Root}}">
                    <Label Text="PREREQUISITES"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreReqEntries, Source={x:Reference Root}}"
                                         Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           LineBreakMode="WordWrap"
                                           VerticalTextAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Text="&#xF05A;"
                                            FontFamily="FASolid"
                                            FontSize="12"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource SubtleTextColor}"
                                            HeightRequest="18"
                                            WidthRequest="18"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            IsVisible="{Binding HasDetails}"
                                            Clicked="OnPreReqInfoClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasAsPer, Source={x:Reference Root}}">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>
                <Label Text="RELATED / AS PER" Style="{StaticResource SectionHeaderLabelStyle}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AsPerEntries, Source={x:Reference Root}}" Spacing="2"><BindableLayout.ItemTemplate><DataTemplate><Grid Padding="8,6" ColumnDefinitions="*,Auto"><Label Text="{Binding Name}"/><Button Grid.Column="1" Text="&#xF05A;" FontFamily="FASolid" FontSize="12" Padding="0" BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24" IsVisible="{Binding HasDetails}" Clicked="OnAsPerInfoClicked" CommandParameter="{Binding .}"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentView>
</ContentView>
