<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.AbilityCard.AbilityDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame Style="{StaticResource DetailCardFrameStyle}">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding AbilityIndex, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <Label Text="{Binding TableDisplayText, Source={x:Reference Root}}"
                       FontAttributes="Italic"
                       TextColor="{StaticResource MutedTextColor}"
                       VerticalTextAlignment="Center"/>

                <Label Grid.Column="1"
                       Text="{Binding AvailabilityText, Source={x:Reference Root}}"
                       FontAttributes="Italic"
                       TextColor="{StaticResource MutedTextColor}"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"
                       VerticalTextAlignment="Center"/>

                <Label Grid.Column="2"
                       Text="{Binding CostDisplayText, Source={x:Reference Root}}"
                       FontAttributes="Italic"
                       TextColor="{StaticResource MutedTextColor}"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding ShowCostText, Source={x:Reference Root}}"/>

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="2"
                                       HorizontalOptions="End"
                                       IsVisible="{Binding ShowInfiniteCost, Source={x:Reference Root}}">
                    <Label Text="{Binding InfiniteCostPrefixText, Source={x:Reference Root}}"
                           FontAttributes="Italic"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalTextAlignment="Center"/>
                    <Label Text="{Binding InfinityGlyph, Source={x:Reference Root}}"
                           FontFamily="FASolid"
                           FontAttributes="Italic"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalTextAlignment="Center"/>
                    <Label Text=")"
                           FontAttributes="Italic"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalTextAlignment="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="DESCRIPTION"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       VerticalTextAlignment="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding DescriptionChevronText, Source={x:Reference Root}}"
                       IsVisible="{Binding CanExpandDescription, Source={x:Reference Root}}"
                       TextColor="{StaticResource MutedTextColor}"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="End"/>
            </Grid>

            <ContentView x:Name="DescriptionTextContainer">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDescriptionSectionTapped"/>
                </ContentView.GestureRecognizers>
                <Label x:Name="DescriptionLabel"
                       Text="{Binding DescriptionText, Source={x:Reference Root}}"
                       MaxLines="{Binding DescriptionMaxLines, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnExpandableLabelSizeChanged"/>
            </ContentView>
            <Label Text="... see more"
                   TextColor="{StaticResource MutedTextColor}"
                   FontSize="12"
                   IsVisible="{Binding ShowDescriptionSeeMore, Source={x:Reference Root}}"/>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasNotesSection, Source={x:Reference Root}}">
                <Label Text="NOTES"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>

                <Label Text="{Binding NotesText, Source={x:Reference Root}}"
                       IsVisible="{Binding HasNotesText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>

                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding HasPreReqs, Source={x:Reference Root}}">
                    <Label Text="PREREQUISITES"
                           Style="{StaticResource SectionHeaderLabelStyle}"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreReqEntries, Source={x:Reference Root}}"
                                         Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           LineBreakMode="WordWrap"
                                           VerticalTextAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Text="&#xF05A;"
                                            FontFamily="FASolid"
                                            FontSize="12"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource SubtleTextColor}"
                                            HeightRequest="18"
                                            WidthRequest="18"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            IsVisible="{Binding HasDetails}"
                                            Clicked="OnPreReqInfoClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentView>
