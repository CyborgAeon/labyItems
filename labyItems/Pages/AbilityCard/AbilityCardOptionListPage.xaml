<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.AbilityCard.AbilityCardOptionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:labyItems.Pages.Characters.ViewModels"
    Title="Ability Options">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{Binding TitleText}"
                   FontSize="20"
                   FontAttributes="Bold"/>

            <Label Text="Tap the info icon to view ability details."
                   Opacity="0.7"
                   IsVisible="{Binding ShowHeaderDescription}"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  Opacity="0.7">
                <Label Text="Ability"/>
                <Label Grid.Column="1"
                       Text="Info"
                       HorizontalTextAlignment="Center"/>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}"
                                 Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ChoiceSetAbilityRowVm">
                        <Border Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Text="{Binding DisplayName}"
                                       LineBreakMode="WordWrap"/>
                                <Button Grid.Column="1"
                                        Text="&#xF05A;"
                                        FontFamily="FASolid"
                                        FontSize="12"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SubtleTextColor}"
                                        HeightRequest="18"
                                        WidthRequest="18"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        Clicked="OnInfoClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
