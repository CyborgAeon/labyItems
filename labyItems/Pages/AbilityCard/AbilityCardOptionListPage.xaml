<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.AbilityCard.AbilityCardOptionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:labyItems.Pages.Characters.ViewModels"
    Title="Ability Options">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{Binding TitleText}"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ChoiceSetAbilityRowVm">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{Binding RowBackgroundColor}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <Label Text="{Binding DisplayName}"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"/>
                                <Button Grid.Column="1"
                                        Text="&#xF05A;"
                                        FontFamily="FASolid"
                                        FontSize="14"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SubtleTextColor}"
                                        HeightRequest="20"
                                        WidthRequest="20"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        VerticalOptions="Center"
                                        Clicked="OnInfoClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
