<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="labyItems.Pages.AbilityCard.AbilityCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:abilityCard="clr-namespace:labyItems.Pages.AbilityCard"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
    <controls:DetailPageHeader x:Name="DetailHeader" HeaderText="Ability"/>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16">
            <abilityCard:AbilityDetailCardView x:Name="AbilityDetails"/>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
