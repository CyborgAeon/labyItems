<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.Evocation"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  Title="EarthPower">
<Grid Padding="16" RowDefinitions="Auto,*">
    <SearchBar x:Name="Search"
               Placeholder="Search by name or field (e.g. Rivers, Horned Man)..."
               TextChanged="OnSearchChanged"
               Grid.Row="0" />

    <CollectionView x:Name="Results"
                    ItemsLayout="VerticalList"
                    SelectionMode="Single"
                    SelectionChanged="OnPick"
                    Grid.Row="1">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Margin="12" Padding="16" BackgroundColor="#21FFFFFF" StrokeShape="RoundRectangle 14">
            <VerticalStackLayout Spacing="4">
              <Label Text="{Binding Name}" FontAttributes="Bold"/>
              <Label Text="{Binding Fields}" FontSize="12" Opacity="0.7"/>
              <Label Text="{Binding Power, StringFormat=Power: {0}}" FontSize="12" Opacity="0.7"/>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
