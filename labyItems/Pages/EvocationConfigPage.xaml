<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.EvocationConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:conv="clr-namespace:labyItems.Converters"
  Title="Configure Evocation">
  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:IntConverter x:Key="IntConverter" />
    </ResourceDictionary>
  </ContentPage.Resources>
  <VerticalStackLayout Padding="20" Spacing="14">

    <!--  Title / selected evocation  -->
    <Label
      FontAttributes="Bold"
      FontSize="20"
      Text="{Binding Title}" />

    <!--  Power cost + Search  -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Entry
        Grid.Column="0"
        Keyboard="Numeric"
        Placeholder="EarthPower cost"
        Text="{Binding Power, Mode=TwoWay, Converter={StaticResource IntConverter}}" />
      <Button
        Grid.Column="1"
        Clicked="OnSearchEvocation"
        Text="Search" />
    </Grid>

    <Label Text="Cast basic times per day" />
    <controls:PlusMinusControl AllowMultiple="True" Count="{Binding BasicPerDay, Mode=TwoWay}" />

    <Label Text="Cast advanced times per day" />
    <controls:PlusMinusControl AllowMultiple="True" Count="{Binding AdvancedPerDay, Mode=TwoWay}" />

    <CheckBox IsChecked="{Binding AddBasic}" />
    <Label Text="Add basic to base list (+15)" />

    <CheckBox IsChecked="{Binding AddAdvanced}" />
    <Label Text="Add advanced to base list (+18)" />

    <CheckBox IsChecked="{Binding AddPrep}" />
    <Label Text="Add to base list with 30s prep (+50%)" />

    <Label
      FontAttributes="Bold"
      FontSize="18"
      Text="{Binding Total, StringFormat='Total ISP: {0}'}" />

    <Button Clicked="OnReturn" Text="Return" />
  </VerticalStackLayout>
</ContentPage>
