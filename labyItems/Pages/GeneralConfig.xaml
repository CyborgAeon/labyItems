<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.GeneralConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  Title="Configure General Charm">

  <ContentPage.Resources>
    <Style TargetType="Label" x:Key="SectionHeader">
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
  </ContentPage.Resources>

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"> 
        <Label
          FontAttributes="Bold"
          FontSize="20"
          Text="{Binding Title}" /> 
        <Button
          Grid.Column="2"
          Clicked="OnSearchGeneral"
          Text="Search" /> 
      </Grid>
      <controls:PlusMinusControl LabelText="+1 Level of Resistance (all)"
                                 Count="{Binding ResistanceAllLevels, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+1 Level of Resistance (Magic/Spirit)"
                                 Count="{Binding ResistanceMagicOrSpiritLevels, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+1 Level of Resistance (EP/Neuronics)"
                                 Count="{Binding ResistanceEpOrNeuroLevels, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+2 Resistance (all) ×3 cost"
                                 Count="{Binding ResistanceAllPlus2Count, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+2 Resistance (Magic/Spirit) ×3 cost"
                                 Count="{Binding ResistanceMagOrSpiritPlus2Count, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+2 Resistance (EP/Neuronics) ×3 cost"
                                 Count="{Binding ResistanceEpOrNeuroPlus2Count, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+Casting Levels (all magic) — 14/level"
                                 Count="{Binding CastingLevelsAll, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+Casting Levels (one colour) — 7/level"
                                 Count="{Binding CastingLevelsOneColour, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+1 Str (non-stacking) — 15"
                                 Count="{Binding StrengthPlus1NonStackingCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+1 Str (stacking to +2) — 20"
                                 Count="{Binding StrengthPlus1StackingTo2Count, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="+2 Str (non-stacking) — 45"
                                 Count="{Binding StrengthPlus2NonStackingCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="25% Cold Rage 1/day — 10"
                                 Count="{Binding ColdRage25PerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="50% Berserk Rage 1/day — 25"
                                 Count="{Binding BerserkRage50PerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="25% Cold Rage vs one Group (always) — 40"
                                 Count="{Binding ColdRage25VsOneGroupAlwaysCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Repel/Attract one Type 1/day — 6"
                                 Count="{Binding RepelAttractOneTypePerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Repel/Attract one Group 1/day — 8"
                                 Count="{Binding RepelAttractOneGroupPerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Repel Life 1/day — 10"
                                 Count="{Binding RepelLifePerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Discipline 1/day — 15"
                                 Count="{Binding DisciplinePerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Ward Pact (8 levels) — 20"
                                 Count="{Binding WardPact8LevelsCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Ki / Primal Strike 1/day — 15"
                                 Count="{Binding KiOrPrimalStrikePerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Empower +0 magic dmg (5 mins) — 8"
                                 Count="{Binding EmpowerWeaponMagicCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Empower +0 spirit dmg (5 mins) — 10"
                                 Count="{Binding EmpowerWeaponSpiritCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Empower +0 mantic dmg (5 mins) — 20"
                                 Count="{Binding EmpowerWeaponManticCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Extra colours (per) — +2"
                                 Count="{Binding ExtraColoursForEmpowerments, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Extra alignments (per) — +3"
                                 Count="{Binding ExtraAlignmentsForEmpowerments, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Undead touch 1/day — 15"
                                 Count="{Binding UndeadTouchPerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Gaseous Form 1/day — 35"
                                 Count="{Binding GaseousFormPerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Plane Shift 1/day — 20"
                                 Count="{Binding PlaneShiftPerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Walk Through Walls 1/day — 20"
                                 Count="{Binding WalkThroughWallsPerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Scholarly Interest 1/day — 15"
                                 Count="{Binding ScholarlyInterestPerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Knowledge of the Arcane 1/day — 8"
                                 Count="{Binding KnowledgeOfArcanePerDayCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Major Prayer 1/day (powerbase) — 10"
                                 Count="{Binding MajorPrayerPerDayPowerbaseCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Major Prayer 1/day (powerbase+subject) — 6"
                                 Count="{Binding MajorPrayerPerDayPowerbaseSubjectCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Minor Prayer 1/day (powerbase) — 4"
                                 Count="{Binding MinorPrayerPerDayPowerbaseCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Blocks of +6 (max 4) — 5/block"
                                 Count="{Binding AdditionalLifeBlocks, Mode=TwoWay}" />
      <controls:CheckboxControl LabelText="Kick-in is Magic or Spirit (×2 cost)"
                                IsChecked="{Binding LifeKickInIsMagicOrSpirit, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="4th level innates — 20"
                                 Count="{Binding ElfDraveInnateLevel4Count, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="6th level innates — 45"
                                 Count="{Binding ElfDraveInnateLevel6Count, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="8th level innates — 70"
                                 Count="{Binding ElfDraveInnateLevel8Count, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="×2 innates (from 8th) — +70"
                                 Count="{Binding ExtraInnatesX2From8thCount, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="×3 innates (from ×2) — +70"
                                 Count="{Binding ExtraInnatesX3FromX2Count, Mode=TwoWay}" />
      <controls:CheckboxControl LabelText="Read languages — 6"
                                IsChecked="{Binding ReadLanguages, Mode=TwoWay}" />
      <controls:CheckboxControl LabelText="Disarm traps (as scout) — 10"
                                IsChecked="{Binding DisarmTrapsAsScout, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Potion recipes known — 5/recipe"
                                 Count="{Binding PotionRecipesKnownCount, Mode=TwoWay}" />
      <controls:CheckboxControl LabelText="Regeneration (non-stacking) — 40"
                                IsChecked="{Binding Regeneration, Mode=TwoWay}" />
      <controls:CheckboxControl LabelText="Forearm Parry — 25"
                                IsChecked="{Binding ForearmParry, Mode=TwoWay}" />

      <Label FontAttributes="Bold" FontSize="18"
             Text="{Binding Total, StringFormat='Total ISP: {0}'}" />
      <Button Text="Return"
              Clicked="OnReturn"
              HeightRequest="44"
              CornerRadius="12" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
