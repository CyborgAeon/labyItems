<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="labyItems.Pages.CharactersPage"
             Title="Select Character">

  <ContentPage.ToolbarItems>
    <ToolbarItem Text="Add" Clicked="OnAddClicked" />
  </ContentPage.ToolbarItems>

  <CollectionView x:Name="CharsView" SelectionMode="Single" SelectionChanged="OnSelected">
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Frame Margin="12" Padding="16" CornerRadius="14" HasShadow="True">
          <VerticalStackLayout Spacing="4">
            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding Class}" Opacity="0.7" />
          </VerticalStackLayout>
        </Frame>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
