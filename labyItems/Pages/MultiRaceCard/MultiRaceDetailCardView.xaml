<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Pages.MultiRaceCard.MultiRaceDetailCardView" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:labyItems.Controls">
 <VerticalStackLayout Spacing="14">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="2"><Label Text="{Binding DisplayName, Source={x:Reference Root}}" FontSize="28" FontAttributes="Bold"/><Label Text="Multi-race" TextColor="{StaticResource MutedTextColor}" FontSize="13"/></VerticalStackLayout><Frame Grid.Column="1" WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}" BorderColor="{StaticResource SurfaceBorderColor}"><Label Text="{Binding IconGlyph, Source={x:Reference Root}}" FontFamily="FASolid" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/></Frame></Grid>
  <HorizontalStackLayout Spacing="8"><Border Style="{StaticResource SelectableFilterPillBorderStyle}" IsVisible="{Binding IsBracketPure, Source={x:Reference Root}}"><Label Text="Bracket pure" Style="{StaticResource FilterPillLabelStyle}"/></Border><Border Style="{StaticResource SelectableFilterPillBorderStyle}" IsVisible="{Binding RequiresPath, Source={x:Reference Root}}"><Label Text="Path" Style="{StaticResource FilterPillLabelStyle}"/></Border></HorizontalStackLayout>
  <Grid ColumnDefinitions="*,1,*" ColumnSpacing="10" IsVisible="{Binding HasPower, Source={x:Reference Root}}"><VerticalStackLayout Spacing="2"><Label Text="PRE-REQS" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PreReqsText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><Grid Grid.Column="2" ColumnDefinitions="*,1,*" ColumnSpacing="10"><VerticalStackLayout Spacing="2"><Label Text="LEVEL CAP" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding LevelCapText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="POWER" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PowerText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout></Grid></Grid>
  <Grid ColumnDefinitions="*,1,*" ColumnSpacing="10" IsVisible="{Binding HasNoPower, Source={x:Reference Root}}"><VerticalStackLayout Spacing="2"><Label Text="PRE-REQS" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PreReqsText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="LEVEL CAP" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding LevelCapText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout></Grid>
  <VerticalStackLayout IsVisible="{Binding HasOptions, Source={x:Reference Root}}" Spacing="7"><Label Text="OPTIONS" Style="{StaticResource SectionHeaderLabelStyle}"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding Options, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="36,*" Padding="4,9"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOptionTapped" CommandParameter="{Binding .}"/></Grid.GestureRecognizers><Label Text="{Binding RadioGlyph}" FontFamily="FASolid" FontSize="18" TextColor="{StaticResource AccentMaroonColor}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="{Binding Name}" FontSize="17" VerticalTextAlignment="Center"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
  <VerticalStackLayout Spacing="7"><Label Text="COST PER LEVEL" Style="{StaticResource SectionHeaderLabelStyle}"/><Label Text="{Binding SelectedAvailabilityText, Source={x:Reference Root}}" TextColor="{StaticResource MutedTextColor}" FontSize="13"/><Border Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 9" BackgroundColor="#F9FAFB" Padding="0"><FlexLayout BindableLayout.ItemsSource="{Binding CostCells, Source={x:Reference Root}}" Direction="Row" Wrap="NoWrap" JustifyContent="SpaceBetween"><BindableLayout.ItemTemplate><DataTemplate><Grid Padding="8,7" FlexLayout.Grow="1" FlexLayout.Basis="0"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCostTapped"/></Grid.GestureRecognizers><BoxView WidthRequest="1" HorizontalOptions="Start" Margin="-8,-7,0,-7" Color="{StaticResource SurfaceBorderColor}" IsVisible="{Binding ShowDivider}"/><VerticalStackLayout Spacing="2"><Label Text="{Binding Level}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center"/><Label Text="{Binding CostText}" FontSize="16" HorizontalTextAlignment="Center"/></VerticalStackLayout></Grid></DataTemplate></BindableLayout.ItemTemplate></FlexLayout></Border></VerticalStackLayout>
  <VerticalStackLayout Spacing="7" IsVisible="{Binding HasAvailability, Source={x:Reference Root}}"><Label Text="AVAILABLE" Style="{StaticResource SectionHeaderLabelStyle}"/><Grid ColumnDefinitions="*,92" Padding="10,0" ColumnSpacing="8"><Label Text="" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="TOTAL COST" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/></Grid><VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailabilityRows, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding Display}" SecondaryText="{Binding TotalText}" PrimaryColumnWidth="*" SecondaryColumnWidth="84" PrimaryTextAlignment="Center" SecondaryTextAlignment="Center" ShowSecondaryText="True" ActionCommandParameter="{Binding .}" RowBackgroundColor="{Binding RowBackgroundColor}" BorderColor="{Binding BorderColor}" BorderThickness="{Binding BorderThickness}" RowClicked="OnAvailabilityRowClicked"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
  <VerticalStackLayout Spacing="7" IsVisible="{Binding HasLevels, Source={x:Reference Root}}"><Label Text="LEVELS" Style="{StaticResource SectionHeaderLabelStyle}"/><Grid ColumnDefinitions="54,*,32" Padding="10,0"><Label Text="LVL" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="ABILITY" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/><Label Grid.Column="2" Text="INFO" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Center"/></Grid><VerticalStackLayout BindableLayout.ItemsSource="{Binding LevelRows, Source={x:Reference Root}}" Spacing="0"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding LevelText}" SecondaryText="{Binding Name}" PrimaryColumnWidth="44" SecondaryColumnWidth="*" InfoColumnWidth="18" PrimaryTextAlignment="Center" SecondaryTextAlignment="Center" ShowSecondaryText="True" ShowInfo="{Binding HasDetails}" ActionCommandParameter="{Binding .}" RowBackgroundColor="{Binding RowBackgroundColor}" InfoClicked="OnLevelInfoClicked" RowClicked="OnLevelInfoClicked"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
  <VerticalStackLayout IsVisible="{Binding HasNotes, Source={x:Reference Root}}" Spacing="7"><Label Text="NOTES" Style="{StaticResource SectionHeaderLabelStyle}"/><Label Text="{Binding NotesText, Source={x:Reference Root}}" FontSize="16" LineBreakMode="WordWrap"/></VerticalStackLayout>
 </VerticalStackLayout>
</ContentView>
