<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Spell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Magic">

  <Grid Padding="16" RowDefinitions="Auto,*">

    <!-- Search -->
    <SearchBar
        x:Name="Search"
        Grid.Row="0"
        Placeholder="Search by name or colour (e.g. brown, purge the...)"
        TextChanged="OnSearchChanged" />

    <!-- Results -->
    <CollectionView
        x:Name="Results"
        Grid.Row="1"
        ItemsLayout="VerticalList"
        SelectionMode="Single"
        SelectionChanged="OnPick">

      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border
              Margin="12"
              Padding="16"
              BackgroundColor="#21FFFFFF"
              StrokeShape="RoundRectangle 14">

            <!-- Two rows (top/bottom), two columns (left/right) -->
            <Grid
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto"
                RowSpacing="6"
                ColumnSpacing="12">

              <!-- Top-left: Name -->
              <Label
                  Grid.Row="0"
                  Grid.Column="0"
                  Text="{Binding Name}"
                  FontAttributes="Bold"
                  LineBreakMode="TailTruncation" />

              <!-- Top-right: Colour -->
              <Label
                  Grid.Row="0"
                  Grid.Column="1"
                  FontSize="12"
                  Opacity="0.7"
                  HorizontalOptions="End">
                <Label.FormattedText>
                  <FormattedString>
                    <Span Text="Colour: " />
                    <Span Text="{Binding ColourText}" />
                  </FormattedString>
                </Label.FormattedText>
              </Label>

              <!-- Bottom-left: Power -->
              <Label
                  Grid.Row="1"
                  Grid.Column="0"
                  FontSize="12"
                  Opacity="0.7">
                <Label.FormattedText>
                  <FormattedString>
                    <Span Text="Power: " />
                    <Span Text="{Binding Power}" />
                  </FormattedString>
                </Label.FormattedText>
              </Label>

              <!-- Bottom-right: Advanced badge -->
              <Label
                  Grid.Row="1"
                  Grid.Column="1"
                  Text="Advanced"
                  FontSize="12"
                  Opacity="0.7"
                  HorizontalOptions="End"
                  IsVisible="{Binding IsAdvanced}" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
