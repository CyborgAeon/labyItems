<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="labyItems.Pages.Battleboard.BattleboardDamageModalPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:viewModels="clr-namespace:labyItems.Pages.Battleboard.ViewModels"
    Title="Damage"
    BackgroundColor="White">

    <ContentPage Title="Damage">
        <Grid RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="16"
                                     Spacing="14">
                <VerticalStackLayout Spacing="6">
                        <Label Text="Target location"
                               FontAttributes="Bold"/>
                        <Picker ItemsSource="{Binding Locations}"
                                SelectedItem="{Binding SelectedLocation}"
                                ItemDisplayBinding="{Binding Name}"/>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource SectionCardBorderStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Manual damage"
                                   FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*,*,Auto"
                                  ColumnSpacing="8">
                                <Entry Text="{Binding TblpDamage}"
                                       Keyboard="Numeric"
                                       Placeholder="TBLP"/>
                                <Entry Grid.Column="1"
                                       Text="{Binding LocDamage}"
                                       Keyboard="Numeric"
                                       Placeholder="Location"/>
                                <Button Grid.Column="2"
                                        Text="Apply"
                                        Padding="10,4"
                                        Command="{Binding ApplyManualDamageCommand}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SectionCardBorderStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Damage grades"
                                   FontAttributes="Bold"/>
                            <CollectionView ItemsSource="{Binding DamagePresets}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                                                     Span="2"
                                                     HorizontalItemSpacing="8"
                                                     VerticalItemSpacing="8"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DamagePresetVm">
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="10"
                                               StrokeShape="RoundRectangle 12"
                                               Stroke="{StaticResource SurfaceBorderColor}">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <Label Text="{Binding Label}"
                                                       FontAttributes="Bold"
                                                       VerticalTextAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Text="Apply"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApplyPresetCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SectionCardBorderStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Damage type"
                                   FontAttributes="Bold"/>
                            <controls:ChipGroup Items="{Binding DamageTypeOptions}"
                                                SelectedItem="{Binding SelectedDamageType}"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  Padding="0">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      Padding="16"
                      ColumnSpacing="8">
                    <Button Text="Cancel"
                            Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1"
                            Text="Submit"
                            Clicked="OnDoneClicked"/>
                </Grid>
            </Grid>
        </Grid>
    </ContentPage>

    <ContentPage Title="Supernatural">
        <Grid RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="16"
                                     Spacing="12">
                    <Entry Text="{Binding Search}"
                           Placeholder="Search spells, miracles, or evocations"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DamageSpells}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DamageSpellVm">
                                <Border Style="{StaticResource SectionCardBorderStyle}"
                                       IsVisible="{Binding IsVisible}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding Kind}"
                                                   FontSize="11"
                                                   Opacity="0.6"/>
                                            <Label Text="{Binding Summary}"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Apply"
                                                Padding="10,4"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApplySpellCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  Padding="0">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      Padding="16"
                      ColumnSpacing="8">
                    <Button Text="Cancel"
                            Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1"
                            Text="Submit"
                            Clicked="OnDoneClicked"/>
                </Grid>
            </Grid>
        </Grid>
    </ContentPage>

    <ContentPage Title="Heal">
        <Grid RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="16"
                                     Spacing="12">
                    <Button Text="Total heal"
                            Command="{Binding TotalHealCommand}"/>

                    <Border Style="{StaticResource SectionCardBorderStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Manual healing"
                                   FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*,*,Auto"
                                  ColumnSpacing="8">
                                <Entry Text="{Binding TblpHeal}"
                                       Keyboard="Numeric"
                                       Placeholder="TBLP"/>
                                <Entry Grid.Column="1"
                                       Text="{Binding LocHeal}"
                                       Keyboard="Numeric"
                                       Placeholder="Location"/>
                                <Button Grid.Column="2"
                                        Text="Apply"
                                        Padding="10,4"
                                        Command="{Binding ApplyManualHealingCommand}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Entry Text="{Binding HealingSearch}"
                           Placeholder="Search healing miracles"/>

                    <Label Text="No healing entries yet."
                           Opacity="0.7"
                           IsVisible="{Binding HasHealingEntries, Converter={StaticResource InverseBoolConverter}}"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding HealingEntries}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:HealingEntryVm">
                                <Border Style="{StaticResource SectionCardBorderStyle}"
                                       IsVisible="{Binding IsVisible}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding Summary}"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Apply"
                                                Padding="10,4"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApplyHealingEntryCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  Padding="0">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      Padding="16"
                      ColumnSpacing="8">
                    <Button Text="Cancel"
                            Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1"
                            Text="Submit"
                            Clicked="OnDoneClicked"/>
                </Grid>
            </Grid>
        </Grid>
    </ContentPage>
</TabbedPage>
