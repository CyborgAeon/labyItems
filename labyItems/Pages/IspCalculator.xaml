<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.IspCalculator"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  Title="ISP Calculator">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="18">

      <!--  Category selector  -->
      <Label FontAttributes="Bold" Text="Select Category" />
      <HorizontalStackLayout x:Name="CategoryRow" Spacing="12">
        <RadioButton
          x:Name="RbArmour"
          Content="Armour/Shield"
          GroupName="cat" />
        <RadioButton
          x:Name="RbWeapon"
          Content="Weapon"
          GroupName="cat" />
        <RadioButton
          x:Name="RbCharm"
          Content="Charm"
          GroupName="cat" 
          IsChecked="True" />
        <RadioButton
          x:Name="RbConsumable"
          Content="Consumable"
          GroupName="cat" />
      </HorizontalStackLayout>
      <!-- armour/shield -->
        <VerticalStackLayout x:Name="ArmourCategoryPage"
        IsVisible="False"
        Spacing="10">
        <Button Clicked="OnShield" Text="Shield" />
        <Label x:Name="ShieldPickedLabel" IsVisible="False" />
        
        <Button Clicked="OnArmour" Text="Armour" />
        <Label x:Name="ArmourPickedLabel" IsVisible="False" />
        

      </VerticalStackLayout>
   <VerticalStackLayout x:Name="WeaponCategoryPage"
        IsVisible="False"
        Spacing="10">
        
        <Button Clicked="OnWeapon" Text="Add Weapon" />
        <Label x:Name="WeaponPickedLabel" IsVisible="False" />
        </VerticalStackLayout>
      <!--  Charm options  -->
      <VerticalStackLayout x:Name="CharmCategoryPage"
        IsVisible="True"
        Spacing="10">
        <Button Clicked="OnCharmGeneral" Text="General" />
        <Label x:Name="GeneralCharmPickedLabel" IsVisible="False" />
        
        <Button Clicked="OnCharmMagic" Text="Magic" />
        <Label x:Name="MagicCharmPickedLabel" IsVisible="False" />
        
        <Button Clicked="OnCharmEarthPower" Text="Earth Power" />
        <Label x:Name="EarthPowerCharmPickedLabel" IsVisible="False" />
        

      </VerticalStackLayout>
<VerticalStackLayout x:Name="ConsumableCategoryPage"
                     IsVisible="False"
                     Spacing="10">
  <Button Clicked="OnConsumableMagicScroll" Text="Create magic scroll" />
  <Label x:Name="ConsumableMagicPickedLabel" IsVisible="False" />

  <Button Clicked="OnConsumableSpiritScroll" Text="Create spirit scroll" />
  <Label x:Name="ConsumableSpiritPickedLabel" IsVisible="False" />

  <Button Clicked="OnConsumableNeuroCrystal" Text="Create Neuro crystal" />
  <Label x:Name="ConsumableNeuroPickedLabel" IsVisible="False" />

  <Button Clicked="OnConsumableEPTalisman" Text="Create EP Talisman" />
  <Label x:Name="ConsumableEPPickedLabel" IsVisible="False" />
</VerticalStackLayout>
      <!--  Totals + Return  -->
      <VerticalStackLayout Padding="8,16,8,8" Spacing="6">
        <Label
          x:Name="TotalLabel"
          FontAttributes="Bold"
          Text="Total: 0 ISP" />
        <Button
          Clicked="OnReturn"
          CornerRadius="12"
          HeightRequest="50"
          Text="Return to Form" />
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
