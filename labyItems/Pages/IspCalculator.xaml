<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.IspCalculator"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  Title="ISP Calculator">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="18">

      <!--  Category selector  -->
      <Label FontAttributes="Bold" Text="Select Category" />
      <HorizontalStackLayout x:Name="CategoryRow" Spacing="12">
        <RadioButton
          x:Name="RbArmour"
          Content="Armour/Shield"
          GroupName="cat" />
        <RadioButton
          x:Name="RbWeapon"
          Content="Weapon"
          GroupName="cat"
          IsChecked="True" />
        <RadioButton
          x:Name="RbCharm"
          Content="Charm"
          GroupName="cat" />
        <RadioButton
          x:Name="RbConsumable"
          Content="Consumable"
          GroupName="cat" />
      </HorizontalStackLayout>
      <!--  Charm options  -->
      <VerticalStackLayout
        x:Name="CharmCategoryPage"
        IsVisible="False"
        Spacing="10">
        <Button Clicked="OnCharmMagic" Text="Magic" />
        <Label x:Name="MagicCharmPickedLabel" IsVisible="False" />
        
        <Button Clicked="OnCharmEarthPower" Text="EarthPower" />
        <Label x:Name="EarthPowerCharmPickedLabel" IsVisible="False" />
      </VerticalStackLayout>
      <!--  Weapon options  -->
      <VerticalStackLayout x:Name="WeaponSection" Spacing="10">

        <Label FontAttributes="Bold" Text="Magic / Vs Group" />
        <CollectionView x:Name="MagicRows">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="6" ColumnDefinitions="*,Auto,120">
                <Label Text="{Binding Name}" />
                <Label
                  Grid.Column="1"
                  HorizontalTextAlignment="End"
                  Text="{Binding CostLabel}" />
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

        <Label FontAttributes="Bold" Text="Spirit" />
        <CollectionView x:Name="SpiritRows">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="6" ColumnDefinitions="*,Auto,120">
                <Label
                  Grid.Column="1"
                  HorizontalTextAlignment="End"
                  Text="{Binding CostLabel}" />
                <controls:PlusMinusControl
                  LabelText="{Binding Name}" 
                  Grid.Column="2"
                  AllowMultiple="{Binding AllowMultiple}"
                  Count="{Binding Count, Mode=TwoWay}" />
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

        <Label FontAttributes="Bold" Text="Mantic / Physical / Specials" />
        <CollectionView x:Name="OtherRows">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="6" ColumnDefinitions="*,Auto,120">
                
                <Label
                  Grid.Column="1"
                  HorizontalTextAlignment="End"
                  Text="{Binding CostLabel}" />
                <HorizontalStackLayout
                  Grid.Column="2"
                  HorizontalOptions="End"
                  Spacing="6">
                  <controls:PlusMinusControl
                    LabelText="{Binding Name}"
                    Grid.Column="2"
                    AllowMultiple="{Binding AllowMultiple}"
                    Count="{Binding Count, Mode=TwoWay}" />
                </HorizontalStackLayout>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

      </VerticalStackLayout>

      <!--  Totals + Return  -->
      <VerticalStackLayout Padding="8,16,8,8" Spacing="6">
        <Label
          x:Name="TotalLabel"
          FontAttributes="Bold"
          Text="Total: 0 ISP" />
        <Button
          Clicked="OnReturn"
          CornerRadius="12"
          HeightRequest="50"
          Text="Return to Form" />
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
