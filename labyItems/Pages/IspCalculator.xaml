<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="labyItems.Pages.IspCalculator"
             Title="ISP Calculator">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="18">

      <!-- Category selector -->
      <Label Text="Select Category" FontAttributes="Bold" />
      <HorizontalStackLayout x:Name="CategoryRow" Spacing="12">
        <RadioButton x:Name="RbArmour" Content="Armour/Shield" GroupName="cat" />
        <RadioButton x:Name="RbWeapon" Content="Weapon" GroupName="cat" IsChecked="True" />
        <RadioButton x:Name="RbCharm" Content="Charm" GroupName="cat" />
        <RadioButton x:Name="RbConsumable" Content="Consumable" GroupName="cat" />
      </HorizontalStackLayout>

      <!-- Weapon options (first implemented) -->
      <VerticalStackLayout x:Name="WeaponSection" Spacing="10">

        <Label Text="Magic / Vs Group" FontAttributes="Bold" />
        <CollectionView x:Name="MagicRows">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,120" Padding="6">
                <Label Text="{Binding Name}" />
                <Label Text="{Binding CostLabel}" Grid.Column="1" HorizontalTextAlignment="End" />
                <HorizontalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                  <Button Text="-" Clicked="OnMinusClicked" CommandParameter="{Binding}" />
                  <Label Text="{Binding Count}" WidthRequest="24" HorizontalTextAlignment="Center" />
                  <Button Text="+" Clicked="OnPlusClicked" CommandParameter="{Binding}" />
                </HorizontalStackLayout>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Spirit" FontAttributes="Bold" />
        <CollectionView x:Name="SpiritRows">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,120" Padding="6">
                <Label Text="{Binding Name}" />
                <Label Text="{Binding CostLabel}" Grid.Column="1" HorizontalTextAlignment="End" />
                <HorizontalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                  <Button Text="-" Clicked="OnMinusClicked" CommandParameter="{Binding}" />
                  <Label Text="{Binding Count}" WidthRequest="24" HorizontalTextAlignment="Center" />
                  <Button Text="+" Clicked="OnPlusClicked" CommandParameter="{Binding}" />
                </HorizontalStackLayout>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Mantic / Physical / Specials" FontAttributes="Bold" />
        <CollectionView x:Name="OtherRows">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,120" Padding="6">
                <Label Text="{Binding Name}" />
                <Label Text="{Binding CostLabel}" Grid.Column="1" HorizontalTextAlignment="End" />
                <HorizontalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                  <Button Text="-" Clicked="OnMinusClicked" CommandParameter="{Binding}" />
                  <Label Text="{Binding Count}" WidthRequest="24" HorizontalTextAlignment="Center" />
                  <Button Text="+" Clicked="OnPlusClicked" CommandParameter="{Binding}" />
                </HorizontalStackLayout>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

      </VerticalStackLayout>

      <!-- Totals + Return -->
      <VerticalStackLayout Spacing="6" Padding="8,16,8,8">
        <Label x:Name="TotalLabel" Text="Total: 0 ISP" FontAttributes="Bold" />
        <Button Text="Return to Form" Clicked="OnReturn" HeightRequest="50" CornerRadius="12" />
      </VerticalStackLayout>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
