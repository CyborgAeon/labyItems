<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.RecipientPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Add Recipient">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="16">
      <Label Text="{Binding BreakdownTitle}"
             FontAttributes="Bold"
             FontSize="24" />

      <Border IsVisible="{Binding HasSubmissionSummary}"
              Padding="14"
              BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"
              Stroke="{StaticResource DividerShadowColor}"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 16">
        <Grid HeightRequest="220">
          <CollectionView IsVisible="{Binding HasSubmissionSummaryRows}"
                          ItemsSource="{Binding SubmissionSummaryRows}"
                          SelectionMode="None">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Label>
                  <Label.FormattedText>
                    <FormattedString>
                      <Span Text="{Binding Text}" />
                      <Span Text=" (" TextColor="Gray" />
                      <Span Text="{Binding RunningTotal}" TextColor="Gray" />
                      <Span Text=")" TextColor="Gray" />
                    </FormattedString>
                  </Label.FormattedText>
                </Label>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <VerticalStackLayout IsVisible="{Binding IsSummaryEmptyStateVisible}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center">
            <Label Text="{Binding SummaryEmptyText}"
                   TextColor="{StaticResource MutedTextColor}"
                   HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Grid>
      </Border>

      <Border Padding="14"
              BackgroundColor="{StaticResource White}"
              Stroke="{StaticResource DividerShadowColor}"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 16">
        <VerticalStackLayout Spacing="10">
          <Label Text="Email to desk"
                 FontAttributes="Bold"
                 FontSize="18" />
          <Entry x:Name="ItemNameEntry" Placeholder="Item name" MaxLength="30" IsVisible="{Binding RequiresItemName}" />
          <Entry x:Name="RecipientPlayerNameEntry" Placeholder="Recipient player name" />
          <Entry x:Name="RecipientCharacterNameEntry" Placeholder="Recipient character name" />
          <Entry x:Name="RecipientCharacterClassEntry" Placeholder="Recipient character class" />
          <Button Text="Email to desk" Clicked="OnSubmit" />
        </VerticalStackLayout>
      </Border>

      <Button Text="{Binding SaveButtonText}"
              Clicked="OnSaveClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
