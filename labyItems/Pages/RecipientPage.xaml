<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.RecipientPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add Recipient">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="10">
      <Label Text="Recipient Player Name" FontAttributes="Bold" />
      <Entry x:Name="RecipientPlayerNameEntry" Placeholder="Player name" />

      <Label Text="Recipient Character Name" FontAttributes="Bold" />
      <Entry x:Name="RecipientCharacterNameEntry" Placeholder="Character name" />

      <Label Text="Recipient Character Class" FontAttributes="Bold" />
      <Entry x:Name="RecipientCharacterClassEntry" Placeholder="Character class" />

      <Label Text="Item Summary" FontAttributes="Bold" IsVisible="{Binding HasSubmissionSummary}" />
      <Border IsVisible="{Binding HasSubmissionSummary}"
              Padding="8"
              BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"
              Stroke="{StaticResource DividerShadowColor}"
              StrokeThickness="1">
        <Grid HeightRequest="220">
          <CollectionView IsVisible="{Binding HasSubmissionSummaryRows}"
                          ItemsSource="{Binding SubmissionSummaryRows}"
                          SelectionMode="None">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Label>
                  <Label.FormattedText>
                    <FormattedString>
                      <Span Text="{Binding Text}" />
                      <Span Text=" (" TextColor="Gray" />
                      <Span Text="{Binding RunningTotal}" TextColor="Gray" />
                      <Span Text=")" TextColor="Gray" />
                    </FormattedString>
                  </Label.FormattedText>
                </Label>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <VerticalStackLayout IsVisible="{Binding IsSummaryEmptyStateVisible}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center">
            <Label Text="{Binding SummaryEmptyText}"
                   TextColor="{StaticResource MutedTextColor}"
                   HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Grid>
      </Border>

      <Button Text="Submit" Clicked="OnSubmit" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
