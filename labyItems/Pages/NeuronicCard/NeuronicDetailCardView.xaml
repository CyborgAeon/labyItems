<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.NeuronicCard.NeuronicDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <ContentView>
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding NeuronicName, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnNameTapped"/></Label.GestureRecognizers></Label>

            <HorizontalStackLayout Spacing="7"><HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnTypeTapped"/></HorizontalStackLayout.GestureRecognizers><Label Text="&#xF5DC;" FontFamily="FASolid" FontSize="14" TextColor="{StaticResource SubtleTextColor}"/><Label Text="{Binding TypeDisplayText, Source={x:Reference Root}}" FontSize="14"/></HorizontalStackLayout>

            <VerticalStackLayout x:Name="NeuronicKeyInformationGrid" Margin="-16,0" Padding="12,10" Spacing="10">
                <Grid ColumnDefinitions="*,1,*,1,*"><VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnPowerTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="POWER" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PowerDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="RANGE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding RangeDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><BoxView Grid.Column="3" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="4"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnDurationTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="DURATION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding DurationDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout></Grid>
                <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowImmunity, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><Grid ColumnDefinitions="*,44"><VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnImmunityTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="IMMUNITY" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding ImmunityDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="&#xF05A;" FontFamily="FASolid" Padding="0" BackgroundColor="Transparent" IsVisible="{Binding HasImmunityLink, Source={x:Reference Root}}" Clicked="OnImmunityInfoClicked"/></Grid></VerticalStackLayout>
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasDamageQuickFacts, Source={x:Reference Root}}"><BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}"/><controls:CombatQuickFactsView Facts="{Binding DamageQuickFacts, Source={x:Reference Root}}"/></VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnDescriptionTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="DESCRIPTION" Style="{StaticResource SectionHeaderLabelStyle}"/><Label Text="{Binding DescriptionText, Source={x:Reference Root}}" LineBreakMode="WordWrap"/></VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding ShowDamage, Source={x:Reference Root}}">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnDamageTapped"/></VerticalStackLayout.GestureRecognizers>
                <Label Text="DAMAGE"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding DamageSummaryText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowHeal, Source={x:Reference Root}}"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnHealTapped"/></VerticalStackLayout.GestureRecognizers><Label Text="HEAL" Style="{StaticResource SectionHeaderLabelStyle}"/><Label Text="{Binding HealSummaryText, Source={x:Reference Root}}" LineBreakMode="WordWrap"/><Label Text="Tap to configure healing" IsVisible="{Binding IsEditing, Source={x:Reference Root}}" Opacity="0.7"/></VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding ShowAsPer, Source={x:Reference Root}}">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnAsPerTapped"/></VerticalStackLayout.GestureRecognizers>
                <Label Text="AS PER"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AsPerEntries, Source={x:Reference Root}}" Spacing="2">
                    <BindableLayout.ItemTemplate><DataTemplate><Grid Padding="8,6" ColumnDefinitions="*,Auto"><Label Text="{Binding Name}" VerticalTextAlignment="Center"/><Button Grid.Column="1" Text="&#xF05A;" FontFamily="FASolid" FontSize="12" Padding="0" BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24" Clicked="OnAsPerInfoClicked" CommandParameter="{Binding .}"/></Grid></DataTemplate></BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding ShowNotes, Source={x:Reference Root}}">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnNotesTapped"/></VerticalStackLayout.GestureRecognizers>
                <Label Text="NOTES"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding NotesText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding ShowTodo, Source={x:Reference Root}}">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnTodoTapped"/></VerticalStackLayout.GestureRecognizers>
                <Label Text="TODO"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding TodoText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasMetaChips, Source={x:Reference Root}}">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

                <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            BindableLayout.ItemsSource="{Binding MetaChips, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource MetaChipFrameStyle}">
                                <Label Text="{Binding Text}"
                                       FontSize="12"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentView>
</ContentView>
