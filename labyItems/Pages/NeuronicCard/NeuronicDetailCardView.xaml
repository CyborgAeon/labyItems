<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.NeuronicCard.NeuronicDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentView>
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding NeuronicName, Source={x:Reference Root}}"
                   FontSize="28"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"/>

            <Grid x:Name="NeuronicKeyInformationGrid" Margin="-16,0" Padding="12,10"
                  ColumnDefinitions="*,1,*,1,*">
                <VerticalStackLayout><Label Text="POWER" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding PowerDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                <BoxView Grid.Column="1" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="2"><Label Text="RANGE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding RangeDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
                <BoxView Grid.Column="3" Color="{StaticResource SurfaceBorderColor}"/><VerticalStackLayout Grid.Column="4"><Label Text="DURATION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding DurationDisplayText, Source={x:Reference Root}}" Style="{StaticResource KeyInfoValueStyle}"/></VerticalStackLayout>
            </Grid>

            <Border Padding="10" Stroke="{StaticResource SoftStrokeColor}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}" IsVisible="{Binding HasImmunity, Source={x:Reference Root}}">
                <HorizontalStackLayout Spacing="8"><Label Text="&#xF3ED;" FontFamily="FASolid"/><VerticalStackLayout><Label Text="IMMUNITY" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding ImmunityDisplayText, Source={x:Reference Root}}" FontSize="15"/></VerticalStackLayout></HorizontalStackLayout>
            </Border>

            <Label Text="DESCRIPTION"
                   Style="{StaticResource SectionHeaderLabelStyle}"/>
            <Label Text="{Binding DescriptionText, Source={x:Reference Root}}"
                   LineBreakMode="WordWrap"/>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasDamageSummary, Source={x:Reference Root}}">
                <Label Text="DAMAGE"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding DamageSummaryText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasAsPer, Source={x:Reference Root}}">
                <Label Text="AS PER"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AsPerEntries, Source={x:Reference Root}}" Spacing="2">
                    <BindableLayout.ItemTemplate><DataTemplate><Grid Padding="8,6" ColumnDefinitions="*,Auto"><Label Text="{Binding Name}" VerticalTextAlignment="Center"/><Button Grid.Column="1" Text="&#xF05A;" FontFamily="FASolid" FontSize="12" Padding="0" BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24" Clicked="OnAsPerInfoClicked" CommandParameter="{Binding .}"/></Grid></DataTemplate></BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasNotes, Source={x:Reference Root}}">
                <Label Text="NOTES"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding NotesText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding HasTodo, Source={x:Reference Root}}">
                <Label Text="TODO"
                       Style="{StaticResource SectionHeaderLabelStyle}"/>
                <Label Text="{Binding TodoText, Source={x:Reference Root}}"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasMetaChips, Source={x:Reference Root}}">
                <BoxView Style="{StaticResource SectionDividerBoxStyle}"/>

                <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            BindableLayout.ItemsSource="{Binding MetaChips, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource MetaChipFrameStyle}">
                                <Label Text="{Binding Text}"
                                       FontSize="12"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentView>
</ContentView>
