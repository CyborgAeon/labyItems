<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="labyItems.Pages.NeuronicCard.NeuronicCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:neuronicCard="clr-namespace:labyItems.Pages.NeuronicCard"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
    <controls:DetailPageHeader x:Name="DetailHeader" HeaderText="Oraculum Insight"/>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16">
            <neuronicCard:NeuronicDetailCardView x:Name="NeuronicDetails" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
