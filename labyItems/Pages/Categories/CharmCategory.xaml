<VerticalStackLayout Spacing="16" IsVisible="False">
  <Label Text="Choose Charm Type" FontAttributes="Bold" FontSize="18" />

  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
    <Button Text="Magic"    Grid.Row="0" Grid.Column="0" HeightRequest="48" Clicked="OnCharmMagic" />
    <Button Text="Spirit"   Grid.Row="0" Grid.Column="1" HeightRequest="48" Clicked="OnCharmSpirit" />
    <Button Text="Neuronic" Grid.Row="1" Grid.Column="0" HeightRequest="48" Clicked="OnCharmNeuronic" />
    <Button Text="EarthPower" Grid.Row="1" Grid.Column="1" HeightRequest="48" Clicked="OnCharmEarthPower" />
  </Grid>

</VerticalStackLayout>
