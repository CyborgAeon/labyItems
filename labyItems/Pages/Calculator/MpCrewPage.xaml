<?xml version="1.0" encoding="utf-8" ?>
<local:MpCalculatorPageBase x:Class="labyItems.Pages.Calculator.MpCrewPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:enums="clr-namespace:labyItems.Models.Enums"
  xmlns:local="clr-namespace:labyItems.Pages.Calculator" x:Name="RootPage" Title="Crew">

  <Grid RowDefinitions="*,Auto">
    <ScrollView>
      <VerticalStackLayout Padding="20" Spacing="12">
        <!-- Spells -->
        <Label Text="Add standard spell (1st-10th) or advanced (0-3)" FontAttributes="Bold" />
        <Grid ColumnDefinitions="*" ColumnSpacing="12">
          <controls:DictionarySearchBar Grid.Column="0"
                                        x:Name="SpellSearch"
                                        x:TypeArguments="local:SpellOption"
                                        PlaceholderText="Type spell name"
                                        SelectionDisplayMemberPath="Name"
                                        SelectedValue="{Binding SelectedSpellOption, Mode=TwoWay}"
                                        ResultSelectedCommand="{Binding AddSelectedSpellCommand}"
                                        KeepFocusOnResultSelection="True"
                                        ClearAfterResultSelection="True" />
        </Grid>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SpellSelections}" IsVisible="{Binding HasSpellSelections}" Spacing="6">
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <controls:PlusMinusControl LabelText="{Binding DisplayText}" AllowMultiple="True" Count="{Binding Uses, Mode=TwoWay}" Min="0" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Miracles -->
        <Label Text="Add standard miracle (1st-5th) or advanced (1-3)" FontAttributes="Bold" />
        <Grid ColumnDefinitions="*" ColumnSpacing="12">
          <controls:DictionarySearchBar Grid.Column="0"
                                        x:Name="MiracleSearch"
                                        x:TypeArguments="local:MiracleOption"
                                        PlaceholderText="Type miracle name"
                                        SelectionDisplayMemberPath="Name"
                                        SelectedValue="{Binding SelectedMiracleOption, Mode=TwoWay}"
                                        ResultSelectedCommand="{Binding AddSelectedMiracleCommand}"
                                        KeepFocusOnResultSelection="True"
                                        ClearAfterResultSelection="True" />
        </Grid>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MiracleSelections}" IsVisible="{Binding HasMiracleSelections}" Spacing="6">
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <controls:PlusMinusControl LabelText="{Binding DisplayText}" AllowMultiple="True" Count="{Binding Uses, Mode=TwoWay}" Min="0" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Evocations -->
        <Label Text="Add 0-4th standard evocation" FontAttributes="Bold" />
        <Grid ColumnDefinitions="*" ColumnSpacing="12">
          <controls:DictionarySearchBar IsEnabled="{Binding DbEnabled}"
                                        Grid.Column="0"
                                        x:Name="EvocationSearch"
                                        x:TypeArguments="local:EvocationOption"
                                        PlaceholderText="Type evocation name"
                                        SelectionDisplayMemberPath="Name"
                                        SelectedValue="{Binding SelectedEvocationOption, Mode=TwoWay}"
                                        ResultSelectedCommand="{Binding AddSelectedEvocationCommand}"
                                        KeepFocusOnResultSelection="True"
                                        ClearAfterResultSelection="True" />
        </Grid>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EvocationSelections}" IsVisible="{Binding HasEvocationSelections}" Spacing="6">
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <controls:PlusMinusControl LabelText="{Binding DisplayText}" AllowMultiple="True" Count="{Binding Uses, Mode=TwoWay}" Min="0" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="8">
          <controls:PlusMinusControl LabelText="Active neuro" AllowMultiple="True" Count="{Binding ActiveNeuroCount, Mode=TwoWay}" IsEnabled="False" />
          <controls:PlusMinusControl LabelText="Passive neuro" AllowMultiple="True" Count="{Binding PassiveNeuroCount, Mode=TwoWay}" IsEnabled="False" />
        </VerticalStackLayout>

        <!-- Life slider -->
        <VerticalStackLayout Spacing="4">
          <controls:DictionarySliderHeader KeyText="{Binding KeyText, Source={x:Reference LifeSlider}}" ValueText="{Binding ValueText, Source={x:Reference LifeSlider}}" />
          <controls:DictionarySlider x:Name="LifeSlider" KeyFormat="Life: {0}" ValueFormat="" SelectionChanged="OnLifeSelectionChanged" />
        </VerticalStackLayout>

        <!-- AC bumps -->
        <VerticalStackLayout Spacing="8">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <HorizontalStackLayout Grid.Column="0" Grid.Row="0" Spacing="6">
              <CheckBox IsChecked="{Binding PacChecked, Mode=TwoWay}" />
              <Label Text="+1 PAC" FontAttributes="Bold" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Grid.Row="0" Spacing="6">
              <CheckBox IsChecked="{Binding DacChecked, Mode=TwoWay}" />
              <Label Text="+1 DAC" FontAttributes="Bold" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="0" Grid.Row="1" Spacing="6">
              <CheckBox IsChecked="{Binding MacChecked, Mode=TwoWay}" />
              <Label Text="+1 MAC" FontAttributes="Bold" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="6">
              <CheckBox IsChecked="{Binding SacChecked, Mode=TwoWay}" />
              <Label Text="+1 SAC" FontAttributes="Bold" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="0" Grid.Row="2" Spacing="6">
              <CheckBox IsChecked="{Binding Mac2Checked, Mode=TwoWay}" />
              <Label Text="+2 MAC" FontAttributes="Bold" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Grid.Row="2" Spacing="6">
              <CheckBox IsChecked="{Binding Sac2Checked, Mode=TwoWay}" />
              <Label Text="+2 SAC" FontAttributes="Bold" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
          </Grid>
        </VerticalStackLayout>

        <!-- Repel -->
        <VerticalStackLayout Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Label Grid.Column="0" Text="Repel" FontAttributes="Bold" VerticalTextAlignment="Center" />
            <controls:ChipGroup Grid.Column="1" Items="{Binding RepelGoodEvilOptions}" SelectedItem="{Binding RepelGoodEvilTarget, Mode=TwoWay}" VerticalOptions="Center" />
            <controls:PlusMinusControl Grid.Column="2" AllowMultiple="True" Count="{Binding RepelGoodEvilCount, Mode=TwoWay}" Min="0" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label Grid.Column="0" FontAttributes="Bold" Text="Repel Life" VerticalTextAlignment="Center" />
            <controls:PlusMinusControl Grid.Column="1" AllowMultiple="True" Count="{Binding RepelLifeCount, Mode=TwoWay}" Min="0" />
          </Grid>
        </VerticalStackLayout>

        <Label Text="Weapon" FontAttributes="Bold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <controls:ChipGroup Grid.Column="0" Items="{Binding WeaponPowerOptions}" SelectedItem="{Binding SelectedWeaponPowerType, Mode=TwoWay}" />
          <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
            <CheckBox IsChecked="{Binding WeaponApprenticeStatus, Mode=TwoWay}" />
            <Label Text="Apprentice status" FontAttributes="Bold" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
        </Grid>
        <controls:DictionarySearchBar Grid.Column="0" x:Name="CrewWeaponSearch" IsVisible="{Binding IsWeaponSelectionVisible}" x:TypeArguments="enums:WeaponType" PlaceholderText="Pick weapon type" ItemsSource="{controls:EnumDictionary Type={x:Type enums:WeaponType}}" SelectedValue="{Binding SelectedWeaponType, Mode=TwoWay}" />
        <controls:DictionarySearchBar x:Name="CrewWeaponColourSearch" x:TypeArguments="enums:MagicColours" IsVisible="{Binding IsWeaponColourVisible}" ItemsSource="{controls:EnumDictionary Type={x:Type enums:MagicColours}}" PlaceholderText="type a colour" SelectedValue="{Binding SelectedWeaponColour, Mode=TwoWay}" />
        <controls:DictionarySearchBar x:Name="CrewWeaponAlignmentSearch" x:TypeArguments="enums:Alignments" IsVisible="{Binding IsWeaponAlignmentVisible}" ItemsSource="{controls:EnumDictionary Type={x:Type enums:Alignments}}" PlaceholderText="good, neutral, or evil" SelectedValue="{Binding SelectedWeaponAlignment, Mode=TwoWay}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <controls:ChipGroup Grid.Column="0" Items="{Binding StatusBagOptions}" SelectedItem="{Binding SelectedBagType, Mode=TwoWay}" />
          <Label Grid.Column="1" Text="Status bag" FontAttributes="Bold" VerticalTextAlignment="Center" />
        </Grid>
      </VerticalStackLayout>
    </ScrollView>

    <controls:StickyFooterControl Grid.Row="1" ButtonText="Continue" ReturnCommand="{Binding ContinueCommand}" Total="{Binding TotalMp}" TotalFormat="MP cost: {0}/500" BreakdownItems="{Binding Breakdown}" />
  </Grid>
</local:MpCalculatorPageBase>
