<?xml version="1.0" encoding="utf-8" ?>
<cfg:ConfigPageBase x:Class="labyItems.Pages.Configs.MiracleConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:cfg="clr-namespace:labyItems.Pages.Configs"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:conv="clr-namespace:labyItems.Converters"
  xmlns:enums="clr-namespace:labyItems.Models.Enums"
  xmlns:calc="clr-namespace:labyItems.Pages.Calculator"
  x:Name="RootPage"
  Title="Configure Miracles"
  x:TypeArguments="cfg:MiracleConfig">
  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </ContentPage.Resources>
  <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
      <VerticalStackLayout Padding="20" Spacing="14">
        <Label FontAttributes="Bold"
               FontSize="20"
               Text="Miracles" />

        <controls:DictionarySearchBar x:Name="MiracleSearch"
                                      x:TypeArguments="calc:MiracleSearchOption"
                                      ItemsSource="{Binding Source={x:Reference RootPage}, Path=MiracleLookup}"
                                      SelectedValue="{Binding Source={x:Reference RootPage}, Path=SelectedSearchMiracle, Mode=TwoWay}"
                                      PlaceholderText="Search basic and advanced miracles"
                                      SelectionDisplayMemberPath="Name"
                                      ResultSelectedCommand="{Binding Source={x:Reference RootPage}, Path=AddSelectedMiracleCommand}"
                                      ClearAfterResultSelection="True"
                                      KeyboardAvoidanceEnabled="True" />

        <Label Text="No miracles selected yet."
               Opacity="0.7"
               IsVisible="{Binding HasSelectedMiracles, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

        <controls:ConfigSelectionList ItemsSource="{Binding SelectedMiracles}"
                                      EditCommand="{Binding Source={x:Reference RootPage}, Path=EditMiracleCommand}"
                                      InfoCommand="{Binding Source={x:Reference RootPage}, Path=ViewMiracleInfoCommand}"
                                      DeleteCommand="{Binding Source={x:Reference RootPage}, Path=DeleteMiracleCommand}" />

        <Label FontAttributes="Bold"
               Text="Global miracle item modifiers" />

        <controls:DictionarySliderHeader KeyText="{Binding KeyText, Source={x:Reference GeneralSpiritSlider}}"
                                         ValueText="{Binding ValueText, Source={x:Reference GeneralSpiritSlider}}" />
        <controls:DictionarySlider x:Name="GeneralSpiritSlider"
                                   KeyFormat="{}{0} Additional spirit store"
                                   MaxCount="12"
                                   MinCount="0"
                                   Multiplier="4"
                                   SelectedCount="{Binding GeneralSpiritStore, Mode=TwoWay}"
                                   VerticalOptions="Center" />

        <Grid ColumnDefinitions="0.3*,*">
          <controls:DictionarySearchBar x:Name="SphereSel"
                                        Grid.Column="0"
                                        x:TypeArguments="enums:SpiritualSpheres"
                                        AllowCustomOptions="False"
                                        PlaceholderText="Pick a sphere"
                                        ItemsSource="{controls:EnumDictionary Type={x:Type enums:SpiritualSpheres}}"
                                        SelectedValue="{Binding AdditionalSphereSelected, Mode=TwoWay}" />

          <VerticalStackLayout Grid.Column="1"
                               Spacing="4">
            <controls:DictionarySliderHeader KeyText="{Binding KeyText, Source={x:Reference SphereSpiritSlider}}"
                                             ValueText="{Binding ValueText, Source={x:Reference SphereSpiritSlider}}" />
            <controls:DictionarySlider x:Name="SphereSpiritSlider"
                                       FormatArg1="{Binding SelectedValue, Source={x:Reference SphereSel}}"
                                       KeyFormat="{}{0} Additional {1} spirits"
                                       MaxCount="12"
                                       MinCount="0"
                                       Multiplier="3"
                                       SelectedCount="{Binding SphereSpiritStore, Mode=TwoWay}"
                                       VerticalOptions="Center" />
          </VerticalStackLayout>
        </Grid>

        <controls:CheckboxControl IsChecked="{Binding SpiritStoreRegenerates}"
                                  IsVisible="{Binding AnySpiritStore, Converter={StaticResource BoolToVisibilityConverter}}"
                                  LabelText="Spirit store regenerates" />

        <controls:PlusMinusControl AllowMultiple="True"
                                   Count="{Binding TurnBasicUpTo5thMantic, Mode=TwoWay}"
                                   LabelText="Turn basic miracle up to 5th mantic" />
        <controls:PlusMinusControl AllowMultiple="True"
                                   Count="{Binding TurnBasicMantic, Mode=TwoWay}"
                                   LabelText="Turn basic miracle mantic" />
        <controls:PlusMinusControl AllowMultiple="True"
                                   Count="{Binding TurnAdvancedUpTo6thMantic, Mode=TwoWay}"
                                   LabelText="Turn advanced up to 6th miracle mantic" />
        <controls:PlusMinusControl AllowMultiple="True"
                                   Count="{Binding TurnAdvancedAbove6thMantic, Mode=TwoWay}"
                                   LabelText="Turn advanced miracle mantic" />

        <Label FontAttributes="Bold"
               Text="True believer guilds" />

        <Button Text="Search and Select Guilds"
                Clicked="OnSearchTrueBelieverGuildsClicked" />

        <Label Text="No true-believer guilds added yet."
               Opacity="0.7"
               IsVisible="{Binding HasTrueBelieverGuilds, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TrueBelieverGuilds}"
                             Spacing="8">
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <Border Padding="8,6"
                      BackgroundColor="{Binding RowBackgroundColor}"
                      StrokeThickness="0"
                      StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <controls:PlusMinusControl Grid.Column="0"
                                             LabelText="{Binding GuildName}"
                                             AllowMultiple="True"
                                             Min="0"
                                             Count="{Binding Count, Mode=TwoWay}" />
                  <Button Grid.Column="1"
                          Text="&#xF2ED;"
                          FontFamily="FASolid"
                          FontSize="14"
                          Padding="0"
                          BackgroundColor="Transparent"
                          TextColor="{StaticResource SubtleTextColor}"
                          HeightRequest="24"
                          WidthRequest="24"
                          MinimumHeightRequest="0"
                          MinimumWidthRequest="0"
                          VerticalOptions="Center"
                          Clicked="OnDeleteTrueBelieverGuildClicked"
                          CommandParameter="{Binding .}" />
                </Grid>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
    <controls:StickyFooterControl Grid.Row="1"
                                  BreakdownItems="{Binding Source={x:Reference RootPage}, Path=FooterBreakdownItems}"
                                  ButtonText="Return to Calculator"
                                  RemoveContributionCommand="{Binding Source={x:Reference RootPage}, Path=CalculatorContext.RemoveContributionCommand}"
                                  ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnFromConfigCommand}"
                                  ReturnCommandParameter="{x:Reference RootPage}"
                                  Total="{Binding TotalWithBase}" />
  </Grid>
</cfg:ConfigPageBase>
