<?xml version="1.0" encoding="utf-8" ?>
<cfg:ConfigPageBase x:Class="labyItems.Pages.Calculator.EvocationConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:cfg="clr-namespace:labyItems.Pages.Configs"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:conv="clr-namespace:labyItems.Converters"
  xmlns:enums="clr-namespace:labyItems.Models.Enums" x:Name="RootPage" Title="Evocation Config" x:TypeArguments="cfg:EvocationConfig">
  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:IntConverter x:Key="IntConverter" />
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </ContentPage.Resources>
  <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
      <VerticalStackLayout Padding="20" Spacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <Label Grid.Column="0" FontAttributes="Bold" FontSize="20" Text="{Binding Title}" />
          <Button Grid.Column="1" Clicked="OnSearchEvocation" Text="Search" />
        </Grid>
        <controls:PlusMinusControl AllowMultiple="True" Count="{Binding BasicPerDay, Mode=TwoWay}" IsVisible="{Binding ShowBasicPerDay}" LabelText="Cast basic times per day" />

        <controls:PlusMinusControl AllowMultiple="True" Count="{Binding AdvancedPerDay, Mode=TwoWay}" IsVisible="{Binding ShowAdvancedPerDay}" LabelText="Cast advanced times per day" />

        <controls:CheckboxControl IsChecked="{Binding AddBasic}" IsVisible="{Binding ShowBasicPerDay}" LabelText="Add basic evocation to base list" />

        <controls:CheckboxControl IsChecked="{Binding AddAdvanced}" IsVisible="{Binding ShowAdvancedPerDay}" LabelText="Add advanced evocation to base list" />

        <controls:CheckboxControl IsChecked="{Binding AddPrep}" LabelText="Add to base list with 30s prep" />
        <controls:DictionarySlider KeyFormat="Additional {0} EP store" MaxCount="12" MinCount="0" Multiplier="4" SelectedCount="{Binding GeneralEpStore, Mode=TwoWay}" ValueFormat="" VerticalOptions="Center" />
        <Grid ColumnDefinitions="Auto,*">
          <controls:DictionarySearchBar Grid.Column="0" x:Name="FieldSearch" x:TypeArguments="enums:EvocationFields" PlaceholderText="Pick a field" ItemsSource="{controls:EnumDictionary Type={x:Type enums:EvocationFields}, Exclude='Grey'}" SelectedValue="{Binding SelectedField, Mode=TwoWay}"/>
          <!-- SelectedValue="{Binding CastingLevelsColour, Mode=TwoWay}"/> -->
          <controls:DictionarySlider Grid.Column="1" FormatArg1="{Binding SelectedValue, Source={x:Reference FieldPicker}}" KeyFormat="Additional {0} {1} EP store" MaxCount="12" MinCount="0" Multiplier="3" SelectedCount="{Binding FieldEpStore, Mode=TwoWay}" ValueFormat="" VerticalOptions="Center" />
        </Grid>
        <controls:PlusMinusControl AllowMultiple="True" Count="{Binding DrawOnEpPerDay, Mode=TwoWay}" LabelText="Draw on EP per day" />
      </VerticalStackLayout>
    </ScrollView>
    <controls:StickyFooterControl Grid.Row="1" BreakdownItems="{Binding BindingContext.BreakdownItems, Source={x:Reference RootPage}}" ButtonText="Return to Calculator" RemoveContributionCommand="{Binding BindingContext.RemoveContributionCommand, Source={x:Reference RootPage}}" ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnFromConfigCommand}" ReturnCommandParameter="{x:Reference RootPage}" Total="{Binding TotalWithBase}" />
  </Grid>
</cfg:ConfigPageBase>
