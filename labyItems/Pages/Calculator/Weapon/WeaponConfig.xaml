<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.Calculator.WeaponConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  Title="Configure Weapon">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">

      <Label Text="Weapon Cost Calculator" FontSize="20" FontAttributes="Bold" />

      <!-- Base power / profile -->
      <Label Text="Base power profile" />
      <Picker
        x:Name="BasePicker"
        Title="Select base power"
        SelectedIndexChanged="OnBaseChanged">
        <Picker.Items>
          <x:String>— None —</x:String>

          <!-- Magic -->
          <x:String>+0 Magic (any one colour/hue incl. grey) — 20</x:String>
          <x:String>+0 Magic, +1 vs one type — 25</x:String>
          <x:String>+0 Magic, +1 vs one group — 30</x:String>
          <x:String>+1 Magic — 40</x:String>
          <x:String>+2 Magic — 60</x:String>
          <x:String>+0 Pure Magic — 40</x:String>

          <!-- Spirit -->
          <x:String>+0 Spirit (any one alignment) — 25</x:String>
          <x:String>+0 Spirit, +1 vs one type — 30</x:String>
          <x:String>+0 Spirit, +1 vs one group — 35</x:String>
          <x:String>+1 Spirit — 50</x:String>
          <x:String>+2 Spirit — 75</x:String>
          <x:String>+0 Pure Spirit — 45</x:String>

          <!-- Mantic -->
          <x:String>+0 Mantic (any one colour and any one alignment) — 50</x:String>
          <x:String>+1 Mantic — 100</x:String>
          <x:String>+0 Pure Mantic — 90</x:String>

          <!-- Physical -->
          <x:String>+1 Physical — 20</x:String>
        </Picker.Items>
      </Picker>

      <!-- Magic/Spirit specific modifiers -->
      <Label Text="Modifiers" FontAttributes="Bold" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding MagicalColoursCount, Mode=TwoWay}"
        LabelText="Add non-grey magical colours/hues (+3 per colour) — only if Magic base" />

      <controls:CheckboxControl
        IsChecked="{Binding SpiritualNonOpposite}"
        LabelText="Add non-opposite alignment to spiritual weapon (+5) — only if Spirit base" />

      <!-- General add-ons -->
      <Label Text="Special options" FontAttributes="Bold" />

      <controls:CheckboxControl
        IsChecked="{Binding MagicTurnsPureDaily}"
        LabelText="Magic/Spirit weapon turns pure 1/day for 5 minutes (+5)" />

      <controls:CheckboxControl
        IsChecked="{Binding ManticTurnsPureDaily}"
        LabelText="Mantic weapon turns pure 1/day for 5 minutes (+10)" />

      <controls:CheckboxControl
        IsChecked="{Binding AdventurePermDamageDaily}"
        LabelText="Inflicts adventure perm damage 1/day for 5 minutes (+25)" />

      <controls:CheckboxControl
        IsChecked="{Binding ThruPacAlways}"
        LabelText="Inflicts damage 'thru' PAC at all times (+30)" />

      <controls:CheckboxControl
        IsChecked="{Binding BladeSharpenTooGreat}"
        LabelText="Weapon can be blade sharpened even though too great in size (+5)" />

      <controls:CheckboxControl
        IsChecked="{Binding SupernaturalBladeSharpen}"
        LabelText="Supernatural weapon can be blade sharpened (+10)" />

      <controls:CheckboxControl
        IsChecked="{Binding CutThroughAuraDaily}"
        LabelText="Cut through Aura of Defence 1/day for 5 minutes (+25)" />

      <!-- Results (auto-updating) -->
      <Label Text="Results" FontAttributes="Bold" />
      <Label Text="{Binding Breakdown}" LineBreakMode="WordWrap" />
      <Label
        FontAttributes="Bold"
        FontSize="18"
        Text="{Binding Total, StringFormat='Total ISP: {0}'}" />

      <!-- Return -->
      <Button Clicked="OnReturn" Text="Return" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
