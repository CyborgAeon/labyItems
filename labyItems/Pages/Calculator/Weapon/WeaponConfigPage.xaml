<?xml version="1.0" encoding="utf-8" ?>
<cfg:ConfigPageBase x:Class="labyItems.Pages.Calculator.WeaponConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:cfg="clr-namespace:labyItems.Pages.Configs"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:conv="clr-namespace:labyItems.Converters"
  xmlns:enums="clr-namespace:labyItems.Models.Enums"
  x:Name="RootPage" Title="Weapon" x:TypeArguments="cfg:WeaponConfig">
  <cfg:ConfigPageBase.Resources>
    <ResourceDictionary>
      <conv:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    </ResourceDictionary>
  </cfg:ConfigPageBase.Resources>
  <Grid>
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
      <VerticalStackLayout Padding="20" Spacing="14">
        <controls:ChipGroup Items="{Binding BaseTypes}" SelectedItem="{Binding SelectedBaseType, Mode=TwoWay}" VerticalOptions="Center"/>

        <VerticalStackLayout IsVisible="{Binding ShowMagicBaseOptions}" Spacing="6">
          <Label FontAttributes="Bold" Text="Magic power profile" />
          <RadioButton Content="+0 Magic" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.Magic0}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.Magic0}}" />
          <RadioButton Content="+0 Magic, +1 vs one type" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.Magic0Plus1VsType}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.Magic0Plus1VsType}}" />
          <RadioButton Content="+0 Magic, +1 vs one group" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.Magic0Plus1VsGroup}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.Magic0Plus1VsGroup}}" />
          <RadioButton Content="+1 Magic" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.MagicPlus1}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.MagicPlus1}}" />
          <RadioButton Content="+2 Magic" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.MagicPlus2}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.MagicPlus2}}" />
          <RadioButton Content="+0 Pure Magic" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.PureMagic0}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.PureMagic0}}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding ShowSpiritBaseOptions}" Spacing="6">
          <Label FontAttributes="Bold" Text="Spirit power profile" />
          <RadioButton Content="+0 Spirit" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.Spirit0}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.Spirit0}}" />
          <RadioButton Content="+0 Spirit, +1 vs one type" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.Spirit0Plus1VsType}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.Spirit0Plus1VsType}}" />
          <RadioButton Content="+0 Spirit, +1 vs one group" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.Spirit0Plus1VsGroup}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.Spirit0Plus1VsGroup}}" />
          <RadioButton Content="+1 Spirit" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.SpiritPlus1}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.SpiritPlus1}}" />
          <RadioButton Content="+2 Spirit" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.SpiritPlus2}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.SpiritPlus2}}" />
          <RadioButton Content="+0 Pure Spirit" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.PureSpirit0}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.PureSpirit0}}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding ShowManticBaseOptions}" Spacing="6">
          <Label FontAttributes="Bold" Text="Mantic power profile" />
          <RadioButton Content="+0 Mantic" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.Mantic0}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.Mantic0}}" />
          <RadioButton Content="+1 Mantic" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.ManticPlus1}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.ManticPlus1}}" />
          <RadioButton Content="+0 Pure Mantic" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.PureMantic0}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.PureMantic0}}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding ShowPhysicalBaseOptions}" Spacing="6">
          <Label FontAttributes="Bold" Text="Physical power profile" />
          <RadioButton Content="+1 Physical" GroupName="WeaponBaseGroup" Value="{x:Static enums:WeaponBaseOption.PhysicalPlus1}" IsChecked="{Binding WeaponBase, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:WeaponBaseOption.PhysicalPlus1}}" />
        </VerticalStackLayout>

        <controls:DictionarySearchBar x:Name="WeaponSearch" x:TypeArguments="enums:WeaponType" AllowCustomOptions="True" PlaceholderText="Pick a weapon" ItemsSource="{controls:EnumDictionary Type={x:Type enums:WeaponType}}" SelectedText="{Binding WeaponTypeText, Mode=TwoWay}"/>
        <Entry IsVisible="{Binding ShowMagicVsType}" Placeholder="Enter Type (e.g. Undead)" Text="{Binding MagicVsType, Mode=TwoWay}"/>
        <Entry IsVisible="{Binding ShowMagicVsGroup}" Placeholder="Enter Group (e.g. Bandits)" Text="{Binding MagicVsGroup, Mode=TwoWay}"/>
        <Entry IsVisible="{Binding ShowSpiritVsType}" Placeholder="Enter Type (e.g. Undead)" Text="{Binding SpiritVsType, Mode=TwoWay}"/>
        <Entry IsVisible="{Binding ShowSpiritVsGroup}" Placeholder="Enter Group (e.g. Bandits)" Text="{Binding SpiritVsGroup, Mode=TwoWay}"/>
        <Label IsVisible="{Binding ShowExtraColours}" Text="{Binding ExtraColoursCountLabel}"/>
        <controls:ListColourPickerControl CountLabelFormat="{}{0} Extra colours chosen" CountLabelText="{Binding ExtraColoursCountLabel, Mode=OneWayToSource}" IsVisible="{Binding ShowExtraColours}" Items="{Binding ExtraColours, Mode=TwoWay}" SummaryText="{Binding ExtraColoursSummary, Mode=OneWayToSource}" ValueCount="{Binding ExtraColoursCount, Mode=OneWayToSource}"/>
        <Label IsVisible="{Binding ShowExtraAlignments}" Text="{Binding ExtraAlignmentsCountLabel}"/>
        <controls:ListAlignmentPickerControl CountLabelFormat="{}{0} Extra alignments (non-opposite) chosen" CountLabelText="{Binding ExtraAlignmentsCountLabel, Mode=OneWayToSource}" IsVisible="{Binding ShowExtraAlignments}" Items="{Binding ExtraAlignments, Mode=TwoWay}" SummaryText="{Binding ExtraAlignmentsSummary, Mode=OneWayToSource}" ValueCount="{Binding ExtraAlignmentsCount, Mode=OneWayToSource}"/>

        <controls:PlusMinusControl AllowMultiple="True" Count="{Binding MagicTurnsPureDailyCount, Mode=TwoWay}" IsVisible="{Binding IsMagicBase}" LabelText="Magic weapon turns pure (5 minutes)"/>
        <controls:PlusMinusControl AllowMultiple="True" Count="{Binding SpiritTurnsPureDailyCount, Mode=TwoWay}" IsVisible="{Binding IsSpiritBase}" LabelText="Spirit weapon turns pure (5 minutes)"/>
        <controls:PlusMinusControl AllowMultiple="True" Count="{Binding ManticTurnsPureDailyCount, Mode=TwoWay}" IsVisible="{Binding IsManticBase}" LabelText="Mantic weapon turns pure (5 minutes)"/>

        <controls:CheckboxControl IsChecked="{Binding ThruPacAlways}" LabelText="Inflicts 'through'"/>

        <controls:CheckboxControl IsChecked="{Binding BladeSharpenTooGreat}" LabelText="Oversized Weapon can be sharpened"/>

        <controls:CheckboxControl IsVisible="{Binding IsSupernatural}" IsChecked="{Binding SupernaturalBladeSharpen}" LabelText="Supernatural weapon can be blade sharpened"/>
        <controls:PlusMinusControl AllowMultiple="True" Count="{Binding CutThroughAuraDaily, Mode=TwoWay}" LabelText="Cut through Aura of Defence for 5 minutes"/>

        <!--  Results (auto-updating)  -->
        <!-- <Label FontAttributes="Bold" Text="Results" />
        <Label LineBreakMode="WordWrap" Text="{Binding Breakdown}" />
        <Label FontAttributes="Bold" FontSize="18" Text="{Binding TotalWithBase, StringFormat='Total ISP: {0}'}" />
          Ffs, this bit is perfect - this is what I want to show in the fuckin' footer when expanded.-->

      </VerticalStackLayout>
    </ScrollView>
    <controls:StickyFooterControl Grid.Row="1" BreakdownItems="{Binding Source={x:Reference RootPage}, Path=FooterBreakdownItems}" ButtonText="Add to item" RemoveContributionCommand="{Binding Source={x:Reference RootPage}, Path=CalculatorContext.RemoveContributionCommand}" ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnFromConfigCommand}" ReturnCommandParameter="{x:Reference RootPage}" Total="{Binding Source={x:Reference RootPage}, Path=FooterRunningTotal}" IsReturnEnabled="{Binding CanSubmit}"/>
    </Grid>
  </Grid>
</cfg:ConfigPageBase>
