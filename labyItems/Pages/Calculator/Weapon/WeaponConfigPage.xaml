<?xml version="1.0" encoding="utf-8" ?>
<cfg:ConfigPageBase
  x:Class="labyItems.Pages.Calculator.WeaponConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:cfg="clr-namespace:labyItems.Pages.Configs"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:conv="clr-namespace:labyItems.Converters"
  x:Name="RootPage"
  Title="Configure Weapon"
  x:TypeArguments="cfg:WeaponConfig">
  <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
      <VerticalStackLayout Padding="20" Spacing="14">

        <Label
          FontAttributes="Bold"
          FontSize="20"
          Text="Weapon Cost Calculator" />

        <Label Text="Base power profile" />
        <controls:WeaponBasePicker 
          SelectedValue="{Binding WeaponBase, Mode=TwoWay}" />
        <Entry
          IsVisible="{Binding ShowMagicVsType}"
          Placeholder="Enter Type (e.g. Undead)"
          Text="{Binding MagicVsType, Mode=TwoWay}" />
        <Entry
          IsVisible="{Binding ShowMagicVsGroup}"
          Placeholder="Enter Group (e.g. Humanoid)"
          Text="{Binding MagicVsGroup, Mode=TwoWay}" />
        <Entry
          IsVisible="{Binding ShowSpiritVsType}"
          Placeholder="Enter Type (e.g. Undead)"
          Text="{Binding SpiritVsType, Mode=TwoWay}" />
        <Entry
          IsVisible="{Binding ShowSpiritVsGroup}"
          Placeholder="Enter Group (e.g. Humanoid)"
          Text="{Binding SpiritVsGroup, Mode=TwoWay}" />

        <!--  Multi-select colours / alignments  -->
        <controls:ListColourPickerControl
          CountLabelText="{Binding ExtraColoursCountLabel, Mode=OneWayToSource}"
          IsVisible="{Binding ShowExtraColours}"
          Items="{Binding ExtraColours, Mode=TwoWay}"
          SummaryText="{Binding ExtraColoursSummary, Mode=OneWayToSource}"
          ValueCount="{Binding ExtraColoursCount, Mode=OneWayToSource}" />

        <controls:ListAlignmentPickerControl
          CountLabelText="{Binding ExtraAlignmentsCountLabel, Mode=OneWayToSource}"
          IsVisible="{Binding ShowExtraAlignments}"
          Items="{Binding ExtraAlignments, Mode=TwoWay}"
          SummaryText="{Binding ExtraAlignmentsSummary, Mode=OneWayToSource}"
          ValueCount="{Binding ExtraAlignmentsCount, Mode=OneWayToSource}" />

        <!--  General add-ons  -->
        <Label FontAttributes="Bold" Text="Special options" />

        <controls:CheckboxControl IsChecked="{Binding MagicTurnsPureDaily}" LabelText="Magic/Spirit weapon turns pure 1/day for 5 minutes (+5)" />

        <controls:CheckboxControl IsChecked="{Binding ManticTurnsPureDaily}" LabelText="Mantic weapon turns pure 1/day for 5 minutes (+10)" />

        <controls:CheckboxControl IsChecked="{Binding AdventurePermDamageDaily}" LabelText="Inflicts adventure perm damage 1/day for 5 minutes (+25)" />

        <controls:CheckboxControl IsChecked="{Binding ThruPacAlways}" LabelText="Inflicts damage 'thru' PAC at all times (+30)" />

        <controls:CheckboxControl IsChecked="{Binding BladeSharpenTooGreat}" LabelText="Weapon can be blade sharpened even though too great in size (+5)" />

        <controls:CheckboxControl IsChecked="{Binding SupernaturalBladeSharpen}" LabelText="Supernatural weapon can be blade sharpened (+10)" />

        <controls:CheckboxControl IsChecked="{Binding CutThroughAuraDaily}" LabelText="Cut through Aura of Defence 1/day for 5 minutes (+25)" />

        <!--  Results (auto-updating)  -->
        <Label FontAttributes="Bold" Text="Results" />
        <Label LineBreakMode="WordWrap" Text="{Binding Breakdown}" />
        <Label
          FontAttributes="Bold"
          FontSize="18"
          Text="{Binding TotalWithBase, StringFormat='Total ISP: {0}'}" />

      </VerticalStackLayout>
    </ScrollView>
    <controls:StickyFooterControl
      Grid.Row="1"
      BreakdownItems="{Binding BindingContext.BreakdownItems, Source={x:Reference RootPage}}"
      ButtonText="Return to Calculator"
      RemoveContributionCommand="{Binding BindingContext.RemoveContributionCommand, Source={x:Reference RootPage}}"
      ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnFromConfigCommand}"
      ReturnCommandParameter="{x:Reference RootPage}"
      Total="{Binding TotalWithBase}" />
  </Grid>
</cfg:ConfigPageBase>
