<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calculator.NeuronicEntryConfigModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    Title="Edit neuronic settings">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20"
                                 Spacing="12">
                <Label Text="{Binding DisplayName}"
                       FontAttributes="Bold"
                       FontSize="18"/>
                <Label Text="{Binding TypeSummary}"
                       FontSize="12"
                       Opacity="0.75"
                       IsVisible="{Binding HasTypeSummary}"/>

                <controls:PlusMinusControl AllowMultiple="True"
                                           Count="{Binding UsesPerDay, Mode=TwoWay}"
                                           LabelText="Use times per day" />

                <controls:CheckboxControl IsChecked="{Binding AddToBaseList, Mode=TwoWay}"
                                          LabelText="Add neuronic to base list" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              Padding="16"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Clicked="OnCancelClicked"/>
            <Button Grid.Column="1"
                    Text="Save"
                    Clicked="OnSaveClicked"/>
        </Grid>
    </Grid>
</ContentPage>
