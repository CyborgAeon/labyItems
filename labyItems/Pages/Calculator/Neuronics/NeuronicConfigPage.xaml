<?xml version="1.0" encoding="utf-8" ?>
<cfg:ConfigPageBase x:Class="labyItems.Pages.Calculator.NeuronicConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:cfg="clr-namespace:labyItems.Pages.Configs"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:conv="clr-namespace:labyItems.Converters"
  xmlns:calc="clr-namespace:labyItems.Pages.Calculator"
  x:Name="RootPage"
  Title="Configure Neuronics"
  NavigationPage.HasNavigationBar="False"
  Shell.NavBarIsVisible="False"
  x:TypeArguments="cfg:NeuronicConfig">
  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ResourceDictionary>
  </ContentPage.Resources>
  <Grid>
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
      <VerticalStackLayout Padding="20" Spacing="14">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
          <controls:BackNavigationButton Command="{Binding Source={x:Reference RootPage}, Path=BackNavigationCommand}" />
          <Label Grid.Column="1"
                 FontAttributes="Bold"
                 FontSize="28"
                 Text="Neuronics"
                 VerticalTextAlignment="Center" />
        </Grid>

        <controls:DictionarySearchBar x:Name="NeuronicSearch"
                                      x:TypeArguments="calc:NeuronicSearchOption"
                                      ItemsSource="{Binding Source={x:Reference RootPage}, Path=NeuronicLookup}"
                                      SelectedValue="{Binding Source={x:Reference RootPage}, Path=SelectedSearchNeuronic, Mode=TwoWay}"
                                      PlaceholderText="Search neuronic abilities"
                                      SelectionDisplayMemberPath="Name"
                                      ResultSelectedCommand="{Binding Source={x:Reference RootPage}, Path=AddSelectedNeuronicCommand}"
                                      ClearAfterResultSelection="True"
                                      KeyboardAvoidanceEnabled="True"
                                      IsEnabled="{Binding Source={x:Reference RootPage}, Path=IsLoading, Converter={StaticResource InverseBoolConverter}}" />

        <Label Text="No neuronics selected yet."
               Opacity="0.7"
               IsVisible="{Binding HasSelectedNeuronics, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

        <controls:ConfigSelectionList ItemsSource="{Binding SelectedNeuronics}"
                                      EditCommand="{Binding Source={x:Reference RootPage}, Path=EditNeuronicCommand}"
                                      InfoCommand="{Binding Source={x:Reference RootPage}, Path=ViewNeuronicInfoCommand}"
                                      DeleteCommand="{Binding Source={x:Reference RootPage}, Path=DeleteNeuronicCommand}" />
      </VerticalStackLayout>
    </ScrollView>

    <Grid Grid.Row="0"
          IsVisible="{Binding Source={x:Reference RootPage}, Path=IsLoading}"
          BackgroundColor="{StaticResource White}"
          Opacity="0.9">
      <VerticalStackLayout VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Spacing="16">
        <ActivityIndicator IsRunning="{Binding Source={x:Reference RootPage}, Path=IsLoading}"
                           Color="{StaticResource Primary}" />
        <Label Text="Loading neuronics..."
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />
      </VerticalStackLayout>
    </Grid>

    <controls:StickyFooterControl Grid.Row="1"
                                  BreakdownItems="{Binding Source={x:Reference RootPage}, Path=FooterBreakdownItems}"
                                  ButtonText="Add to item"
                                  RemoveContributionCommand="{Binding Source={x:Reference RootPage}, Path=CalculatorContext.RemoveContributionCommand}"
                                  ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnFromConfigCommand}"
                                  ReturnCommandParameter="{x:Reference RootPage}"
                                  Total="{Binding Source={x:Reference RootPage}, Path=FooterRunningTotal}" />
    </Grid>
  </Grid>
</cfg:ConfigPageBase>
