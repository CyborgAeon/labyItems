<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.Calculator.CalcNav.ArmourNav"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  x:Name="RootPage"
  Title="Armour / Shield">

  <!--  Outer layout for the whole tab  -->
  <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
      <VerticalStackLayout Padding="8,16,8,8" Spacing="10">

        <!--  Armour / Shield selection area  -->
        <VerticalStackLayout x:Name="ArmourCategoryPage" Spacing="10">
          <Button Clicked="OnShield" Text="Shield" />
          <Label x:Name="ShieldPickedLabel" IsVisible="False" />

          <Button Clicked="OnArmour" Text="Armour" />
          <Label x:Name="ArmourPickedLabel" IsVisible="False" />
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
    <controls:StickyFooterControl
        Grid.Row="1"
        ButtonText="Return to Form"
        ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnToFormCommand}"
        ReturnCommandParameter="{x:Reference RootPage}"
        Total="{Binding Source={x:Reference RootPage}, Path=BindingContext.Total}" />
  </Grid>
</ContentPage>
