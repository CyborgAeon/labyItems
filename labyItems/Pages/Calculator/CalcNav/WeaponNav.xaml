<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calculator.CalcNav.WeaponNav"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Weapon">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Button Text="Configure Weapon"
                    Clicked="OnWeapon" />

            <Label x:Name="WeaponPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(weapon picks will appear here)" />

            <Label x:Name="TotalLabel"
                   FontAttributes="Bold"
                   Text="Total: 0 ISP" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
