<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calculator.CalcNav.CharmNav"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
    Title="Charm">
<Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="16" Spacing="12">
            <Button Text="General Charm"
                    Clicked="OnCharmGeneral" />
            <Button Text="EarthPower Charm"
                    Clicked="OnCharmEarthPower" />
            <Button Text="Magical Charm"
                    Clicked="OnCharmMagic" />
            <Button Text="Spiritual Charm"
                    Clicked="OnCharmSpirit" />

            <Label x:Name="EarthPowerCharmPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(earth power picks will appear here)" />

            <Label x:Name="GeneralCharmPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(general charm picks will appear here)" />

            <Label x:Name="MagicCharmPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(magic charm picks will appear here)" />

            <Label x:Name="SpiritCharmPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(spiritual charm picks will appear here)" />
            <!-- Per-tab total -->
            <Label x:Name="TotalLabel"
                   FontAttributes="Bold"
                   Text="Total: 0 ISP" />
        </VerticalStackLayout>
    </ScrollView>
     <controls:StickyFooterControl
      Grid.Row="1"
      ButtonText="Return to Form"
      ReturnCommand="{Binding ReturnToFormCommand}"
      Total="{Binding Total}" />
  </Grid>
</ContentPage>
