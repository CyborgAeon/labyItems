<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calculator.CalcNav.CharmNav"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Charm">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Action buttons -->
            <Button Text="Earth Power"
                    Clicked="OnCharmEarthPower" />
            <Button Text="General Charm"
                    Clicked="OnCharmGeneral" />
            <Button Text="Magic Charm"
                    Clicked="OnCharmMagic" />

            <!-- Picked summaries per charm 'group' (optional) -->
            <Label x:Name="EarthPowerCharmPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(earth power picks will appear here)" />

            <Label x:Name="GeneralCharmPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(general charm picks will appear here)" />

            <Label x:Name="MagicCharmPickedLabel"
                   IsVisible="False"
                   LineBreakMode="WordWrap"
                   Text="(magic charm picks will appear here)" />

            <!-- Per-tab total -->
            <Label x:Name="TotalLabel"
                   FontAttributes="Bold"
                   Text="Total: 0 ISP" />

            <!-- Optional: Return button if used as standalone pushed page -->
            <!-- <Button Text="Done" Clicked="OnReturn" /> -->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
