<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calculator.CalcNav.LifeConfigPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    Title="Life">
<Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Select Item-Life"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Reusable slider -->
            <controls:DictionarySlider
                x:Name="LifeSlider"
                KeyFormat="Life: {0}"
                ValueFormat="ISP: {0}" />
        </VerticalStackLayout>
    </ScrollView>
     <controls:StickyFooterControl
      Grid.Row="1"
      ButtonText="Return to Form"
      ReturnCommand="{Binding ReturnToFormCommand}"
      Total="{Binding Total}" />
  </Grid>
</ContentPage>
