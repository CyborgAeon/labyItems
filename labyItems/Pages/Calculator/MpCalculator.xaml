<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
  x:Class="labyItems.Pages.Calculator.MpCalculator"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:local="clr-namespace:labyItems.Pages.Calculator"
  Title="MP Calculator">
  <local:MpBasicPage Title="Basic" />
  <ContentPage Title="Crew">
    <ScrollView>
      <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Crew" FontAttributes="Bold" FontSize="18" />
      </VerticalStackLayout>
    </ScrollView>
  </ContentPage>
  <ContentPage Title="Themeday">
    <ScrollView>
      <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Themeday" FontAttributes="Bold" FontSize="18" />
      </VerticalStackLayout>
    </ScrollView>
  </ContentPage>
</TabbedPage>
