<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="labyItems.Pages.Calculator.IspCalculator"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:labyItems.Controls"
             x:Name="Root"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="Item Breakdown">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,32"
                                 Spacing="18">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                    <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label FontAttributes="Bold"
                               FontSize="28"
                               Text="Item breakdown" />
                        <Label Text="Build an item from modular components, then save or email it."
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Grid>

                <Border Padding="18"
                        Stroke="{StaticResource SurfaceBorderColor}"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="12">
                        <Label FontAttributes="Bold"
                               FontSize="18"
                               Text="Item details" />
                        <Entry Placeholder="Item name"
                               Text="{Binding Source={x:Reference Root}, Path=ItemName}" />
                        <Entry Placeholder="Phys-rep"
                               Text="{Binding Source={x:Reference Root}, Path=PhysicalRepresentation}" />
                    </VerticalStackLayout>
                </Border>

                <Button Clicked="OnAddComponentClicked"
                        CornerRadius="18"
                        HeightRequest="52"
                        Text="Add component" />

                <CollectionView ItemsSource="{Binding Source={x:Reference Root}, Path=ComponentCards}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border Padding="18"
                                Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeShape="RoundRectangle 18">
                            <Label Text="No components yet. Add the first component to start building the item."
                                   TextColor="{StaticResource Gray500}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16"
                                    Margin="0,0,0,12"
                                    Stroke="{StaticResource SurfaceBorderColor}"
                                    StrokeShape="RoundRectangle 18">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="10"
                                      RowDefinitions="Auto,Auto,Auto">
                                    <Label FontAttributes="Bold"
                                           FontSize="18"
                                           Text="{Binding Title}" />
                                    <Button Grid.Column="1"
                                            Clicked="OnEditComponentClicked"
                                            CommandParameter="{Binding .}"
                                            FontFamily="FASolid"
                                            FontSize="16"
                                            HeightRequest="36"
                                            Text="&#xF1FC;"
                                            WidthRequest="36" />
                                    <Button Grid.Column="2"
                                            Clicked="OnDeleteComponentClicked"
                                            CommandParameter="{Binding .}"
                                            FontFamily="FASolid"
                                            FontSize="16"
                                            HeightRequest="36"
                                            Text="&#xF2ED;"
                                            WidthRequest="36" />

                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="3"
                                           Text="{Binding Summary}"
                                           TextColor="{StaticResource Gray500}" />

                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="3"
                                           FontAttributes="Bold"
                                           Text="{Binding TotalText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border Padding="18"
                        Stroke="{StaticResource SurfaceBorderColor}"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label FontAttributes="Bold"
                                       FontSize="18"
                                       Text="Total ISP" />
                                <Label FontAttributes="Bold"
                                       FontSize="20"
                                       Text="{Binding Source={x:Reference Root}, Path=FormattedTotal}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Clicked="OnToggleBreakdownClicked"
                                    FontFamily="FASolid"
                                    FontSize="14"
                                    HeightRequest="36"
                                    Text="{Binding Source={x:Reference Root}, Path=BreakdownChevronGlyph}"
                                    WidthRequest="36" />
                        </Grid>

                        <controls:AnimatedExpandView IsExpanded="{Binding Source={x:Reference Root}, Path=IsBreakdownExpanded}">
                            <CollectionView ItemsSource="{Binding Source={x:Reference Root}, Path=BreakdownItems}"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto"
                                              Padding="0,4">
                                            <Label Text="{Binding Text}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding RunningTotal}"
                                                   TextColor="{StaticResource Gray500}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </controls:AnimatedExpandView>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Button Clicked="OnSaveItemClicked"
                            CornerRadius="18"
                            HeightRequest="52"
                            Text="Save item" />
                    <Button Grid.Column="1"
                            Clicked="OnEmailDeskClicked"
                            CornerRadius="18"
                            HeightRequest="52"
                            Text="Email to desk" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.ItemsIsp}" />
    </Grid>
</ContentPage>
