<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="labyItems.Pages.Calculator.IspCalculator"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:labyItems.Controls"
             x:Name="Root"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="Item Breakdown">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,32"
                                 Spacing="18">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                    <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label FontAttributes="Bold"
                               FontSize="28"
                               Text="Item breakdown" />
                        <Label Text="Build an item from modular components, then save or email it."
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="12">
                   <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                        <Label FontAttributes="Bold"
                               FontSize="18"
                               Text="Item details"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1"
                                Clicked="OnAddComponentClicked"
                                HorizontalOptions="End"
                                Padding="12,6"
                                Text="+ Add component" />
                   </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Entry Placeholder="Item name"
                               Text="{Binding Source={x:Reference Root}, Path=ItemName}" />
                        <Entry Grid.Column="1"
                               Placeholder="Phys-rep"
                               Text="{Binding Source={x:Reference Root}, Path=PhysicalRepresentation}" />
                    </Grid>

                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding Source={x:Reference Root}, Path=ComponentCards}"
                                SelectionMode="None"
                                HeightRequest="220">
                    <CollectionView.EmptyView>
                        <Border Padding="18"
                                Stroke="{StaticResource SurfaceBorderColor}"
                                StrokeShape="RoundRectangle 18">
                            <Label Text="No components yet. Add the first component to start building the item."
                                   TextColor="{StaticResource Gray500}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                                                        <Border Padding="10,8"
                                                                        Margin="0,0,0,8"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                            ColumnSpacing="8">
                                                                        <Label Text="{Binding AppliedConfigurationText}"
                                                                                     FontSize="14"
                                                                                     MaxLines="1"
                                                                                     LineBreakMode="TailTruncation"
                                                                                     VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Clicked="OnEditComponentClicked"
                                            CommandParameter="{Binding .}"
                                            FontFamily="FASolid"
                                            FontSize="12"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource SubtleTextColor}"
                                            HeightRequest="18"
                                            Text="&#xF1FC;"
                                            WidthRequest="18"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            VerticalOptions="Center" />
                                    <Button Grid.Column="2"
                                            Clicked="OnDeleteComponentClicked"
                                            CommandParameter="{Binding .}"
                                            FontFamily="FASolid"
                                            FontSize="12"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource SubtleTextColor}"
                                            HeightRequest="18"
                                            Text="&#xF2ED;"
                                            WidthRequest="18"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            VerticalOptions="Center" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <controls:ExpandableSectionCard HeaderText="{Binding Source={x:Reference Root}, Path=FormattedTotal}"
                                                IsExpanded="{Binding Source={x:Reference Root}, Path=IsBreakdownExpanded}">
                    <controls:ExpandableSectionCard.BodyContent>
                        <CollectionView ItemsSource="{Binding Source={x:Reference Root}, Path=BreakdownItems}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto"
                                          Padding="0,4">
                                        <Label Text="{Binding Text}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding RunningTotal}"
                                               TextColor="{StaticResource Gray500}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </controls:ExpandableSectionCard.BodyContent>
                </controls:ExpandableSectionCard>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Button Clicked="OnSaveItemClicked"
                            CornerRadius="18"
                            HeightRequest="52"
                            Text="Save item" />
                    <Button Grid.Column="1"
                            Clicked="OnEmailDeskClicked"
                            CornerRadius="18"
                            HeightRequest="52"
                            Text="Email to desk" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.ItemsIsp}" />
    </Grid>
</ContentPage>
