<TabbedPage 
            x:Class="labyItems.Pages.Calculator.IspCalculator"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:controls="clr-namespace:labyItems.Controls"
            xmlns:local="clr-namespace:labyItems.Pages.Calculator.CalcNav"
            Title="ISP Calculator"
            Root="Calculator">
    <local:ArmourNav     x:Name="ArmourCategoryPage"     Title="Armor"  />
    <local:WeaponNav     x:Name="WeaponCategoryPage"     Title="Weapon" />
    <local:CharmNav      x:Name="CharmCategoryPage"      Title="Charm"  />
    <local:ConsumNav x:Name="ConsumableCategoryPage" Title="1-use" />
    <local:LifeConfigPage       x:Name="LifeCategoryPage"       Title="Life"   />
        <VerticalStackLayout Spacing="6">
            <Label x:Name="TotalLabel"
                   FontAttributes="Bold"
                   Text="Total: 0 ISP" />

            <Button Clicked="OnReturn"
                    CornerRadius="12"
                    HeightRequest="50"
                    Text="Return to Form" />
        </VerticalStackLayout>
</TabbedPage>