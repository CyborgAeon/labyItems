<?xml version="1.0" encoding="utf-8" ?>
<cfg:ConfigPageBase
  x:Class="labyItems.Pages.Calculator.ConsumableConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:cfg="clr-namespace:labyItems.Pages.Configs"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:conv="clr-namespace:labyItems.Converters"
  x:Name="RootPage"
  x:TypeArguments="cfg:ConsumableConfig"
  Title="Configure Consumable">

<Grid RowDefinitions="*,Auto">
  <ScrollView Grid.Row="0">
    <VerticalStackLayout Padding="20" Spacing="14">

      <Label Text="Consumable Cost Calculator" FontSize="20" FontAttributes="Bold" />

      <!-- Type + Search -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Picker
          x:Name="TypePicker"
          Title="(optional) Select type"
          SelectedIndexChanged="OnTypeChanged">
          <Picker.Items>
            <x:String>— None —</x:String>
            <x:String>batch of potions</x:String>
            <x:String>magical scroll</x:String>
            <x:String>spiritual scroll</x:String>
            <x:String>druidic talisman</x:String>
            <x:String>neuronic shard</x:String>
          </Picker.Items>
        </Picker>

        <Button
          Grid.Column="1"
          Clicked="OnSearch"
          Text="Search" />
      </Grid>

      <!-- What was selected -->
      <Label Text="Selected" FontAttributes="Bold" />
      <Label Text="{Binding SelectedText}" LineBreakMode="WordWrap" />

      <!-- Modifiers -->
      <Label Text="Modifiers" FontAttributes="Bold" />

      <!-- a neuronic focussing crystal = cost 2, allow multiples -->
      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding FocussingCrystals, Mode=TwoWay}"
        LabelText="Neuronic focussing crystal (+2 each)" />

      <!-- 500 grulls = +1 per selection, allow multiples -->
      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding Batches500Grulls, Mode=TwoWay}"
        LabelText="500 grulls (+1 each)" />

      <!-- Results (auto-updating) -->
      <Label Text="Results" FontAttributes="Bold" />
      <Label Text="{Binding Breakdown}" LineBreakMode="WordWrap" />
      <Label
        FontAttributes="Bold"
        FontSize="18"
        Text="{Binding TotalWithBase, StringFormat='Total ISP: {0}'}" />

      <!-- Return -->
      <Button Clicked="OnReturn" Text="Return" />

    </VerticalStackLayout>
  </ScrollView>
<controls:StickyFooterControl
      Grid.Row="1"
      ButtonText="Return to Calculator"
      ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnFromConfigCommand}"
      ReturnCommandParameter="{x:Reference RootPage}"
      Total="{Binding TotalWithBase}"
      BreakdownItems="{Binding Source={x:Reference RootPage}, Path=FooterBreakdownItems}"
      RemoveContributionCommand="{Binding Source={x:Reference RootPage}, Path=CalculatorContext.RemoveContributionCommand}" />
  </Grid>
</cfg:ConfigPageBase>
