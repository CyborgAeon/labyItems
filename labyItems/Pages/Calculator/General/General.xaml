<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.Calculator.General"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  Title="General">

  <VerticalStackLayout Padding="16" Spacing="12">
    <SearchBar
      x:Name="Search"
      Placeholder="Search by name or table"
      TextChanged="OnSearchChanged" />

    <CollectionView
      x:Name="Results"
      SelectionChanged="OnPick"
      SelectionMode="Single">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border
            Margin="12"
            Padding="16"
            BackgroundColor="#21FFFFFF"
            StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <!--  Top row  -->
              <Label
                Grid.Row="0"
                Grid.Column="0"
                FontSize="12"
                Text="{Binding TableText}"
                TextColor="Black"
                Opacity="0.8"
                VerticalOptions="Start" />

              <Label
                Grid.Row="0"
                Grid.Column="1"
                FontSize="12"
                HorizontalOptions="End"
                Text="{Binding CostText}"
                TextColor="Black"
                Opacity="0.8"
                VerticalOptions="Start" />
              <Label
                Grid.Row="1"
                Grid.ColumnSpan="2"
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="StartAndExpand"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Description}"
                TextColor="Black"
                VerticalOptions="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </VerticalStackLayout>
</ContentPage>
