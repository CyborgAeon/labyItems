<?xml version="1.0" encoding="utf-8" ?>
<cfg:ConfigPageBase
  x:Class="labyItems.Pages.Calculator.ShieldConfigPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:conv="clr-namespace:labyItems.Converters"
  xmlns:controls="clr-namespace:labyItems.Controls"
  xmlns:cfg="clr-namespace:labyItems.Pages.Configs"
  xmlns:toolset="clr-namespace:labyItems.Controls"
  Title="Configure Shield"
  x:TypeArguments="cfg:ShieldConfig">

  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:IntConverter x:Key="IntConverter" />
    </ResourceDictionary>
  </ContentPage.Resources>

  <Grid>
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
      <VerticalStackLayout Padding="16" Spacing="12">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="12">
          <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
          <Label Grid.Column="1"
                 FontAttributes="Bold"
                 FontSize="28"
                 Text="Shield"
                 VerticalTextAlignment="Center" />
        </Grid>

        <Label Text="Shield Cost Calculator" FontSize="20" FontAttributes="Bold" />

        <!-- Shield selection -->
        <Label Text="Shield type" />
        <controls:ChipGroup
          Items="{Binding ShieldTypes}"
          SelectedItem="{Binding SelectedShieldType, Mode=TwoWay}"
          VerticalOptions="Center" />
        <controls:ListColourPickerControl
          IsVisible="{Binding ShowShieldColours}"
          Items="{Binding ShieldColours}"
          MaxItems="3"
          ValueCount="{Binding ShieldColourCount, Mode=OneWayToSource}" />
        <controls:ListAlignmentPickerControl
          IsVisible="{Binding ShowShieldAlignments}"
          Items="{Binding ShieldAlignments}"
          MaxItems="2"
          ValueCount="{Binding ShieldAlignmentCount, Mode=OneWayToSource}" />

        <controls:DictionarySliderHeader KeyText="{Binding KeyText, Source={x:Reference ShieldPacSlider}}" ValueText="{Binding ValueText, Source={x:Reference ShieldPacSlider}}" />
        <controls:DictionarySlider
          x:Name="ShieldPacSlider"
          ItemsSource="{Binding PacOptions}"
          KeyFormat="PAC {0}"
          SelectedIndex="{Binding PAC, Mode=TwoWay}"
          ValueFormat="ISP: {0}" />
        <controls:DictionarySliderHeader KeyText="{Binding KeyText, Source={x:Reference ShieldDacSlider}}" ValueText="{Binding ValueText, Source={x:Reference ShieldDacSlider}}" />
        <controls:DictionarySlider
          x:Name="ShieldDacSlider"
          ItemsSource="{Binding DacOptions}"
          KeyFormat="DAC {0}"
          SelectedIndex="{Binding DAC, Mode=TwoWay}"
          ValueFormat="ISP: {0}" />
        <controls:DictionarySliderHeader KeyText="{Binding KeyText, Source={x:Reference ShieldMacSlider}}" ValueText="{Binding ValueText, Source={x:Reference ShieldMacSlider}}" />
        <controls:DictionarySlider
          x:Name="ShieldMacSlider"
          ItemsSource="{Binding MacOptions}"
          KeyFormat="MAC {0}"
          SelectedIndex="{Binding MAC, Mode=TwoWay}"
          ValueFormat="ISP: {0}" />
        <controls:ListColourPickerControl
          IsVisible="{Binding ShowMacColours}"
          Items="{Binding MacColours}"
          MaxItems="2"
          ValueCount="{Binding MacColoursCount, Mode=OneWayToSource}" />
        <controls:DictionarySliderHeader KeyText="{Binding KeyText, Source={x:Reference ShieldSacSlider}}" ValueText="{Binding ValueText, Source={x:Reference ShieldSacSlider}}" />
        <controls:DictionarySlider
          x:Name="ShieldSacSlider"
          ItemsSource="{Binding SacOptions}"
          KeyFormat="SAC {0}"
          SelectedIndex="{Binding SAC, Mode=TwoWay}"
          ValueFormat="ISP: {0}" />
        <controls:ListAlignmentPickerControl
          IsVisible="{Binding ShowSacAlignment}"
          Items="{Binding SacAlignments}"
          MaxItems="2"
          ValueCount="{Binding SacAlignmentCount, Mode=OneWayToSource}" />
      </VerticalStackLayout>
    </ScrollView>
    <controls:StickyFooterControl
      Grid.Row="1"
      Total="{Binding Source={x:Reference RootPage}, Path=FooterRunningTotal}"
      ButtonText="Add to item"
      ReturnCommand="{Binding Source={x:Reference RootPage}, Path=ReturnFromConfigCommand}"
      ReturnCommandParameter="{x:Reference RootPage}"
      BreakdownItems="{Binding Source={x:Reference RootPage}, Path=FooterBreakdownItems}"
      RemoveContributionCommand="{Binding CalculatorContext.RemoveContributionCommand, Source={x:Reference RootPage}}" />
    </Grid>
    <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                    SelectedRoute="{x:Static toolset:ToolsetRouteKeys.ItemsIsp}" />
  </Grid>
</cfg:ConfigPageBase>
