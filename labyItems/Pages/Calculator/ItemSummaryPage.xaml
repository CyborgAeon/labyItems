<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calculator.ItemSummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Item Summary">
    
    <VerticalStackLayout Spacing="0" Padding="0">
        <!-- Header with Running Total and Finished Total -->
        <Frame
            BorderColor="#E0E0E0"
            CornerRadius="0"
            HasShadow="False"
            Padding="20"
            Margin="0"
            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2E2E2E}">
            <VerticalStackLayout Spacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="12"
                        TextColor="Gray"
                        Text="Running Total" />
                    <Label
                        FontSize="24"
                        FontAttributes="Bold"
                        x:Name="RunningTotalLabel"
                        Text="0" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="12"
                        TextColor="Gray"
                        Text="Finished Total" />
                    <Label
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#2196F3"
                        x:Name="FinishedTotalLabel"
                        Text="0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Items List -->
        <ScrollView Padding="0">
            <VerticalStackLayout
                Padding="12"
                Spacing="8"
                x:Name="ItemsContainer">
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>
