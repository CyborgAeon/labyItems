<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.Calculator.IspComponentTypePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Choose Component">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,32"
                                 Spacing="18">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                    <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label FontAttributes="Bold"
                               FontSize="28"
                               Text="Add component" />
                        <Label Text="Choose a component type to add."
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="ComponentList"
                      ColumnDefinitions="*"
                      ColumnSpacing="0"
                      RowSpacing="12" />

                <Border Padding="14,10"
                        BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"
                        Stroke="{StaticResource SurfaceBorderColor}"
                        StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10">
                        <Label FontFamily="FASolid"
                               FontSize="16"
                               Text="&#xF05A;"
                               TextColor="{StaticResource Primary}"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Column="1"
                               Text="You can add multiple of any type."
                               TextColor="{StaticResource Gray500}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                        SelectedRoute="{x:Static controls:ToolsetRouteKeys.ItemsIsp}" />
    </Grid>
</ContentPage>
