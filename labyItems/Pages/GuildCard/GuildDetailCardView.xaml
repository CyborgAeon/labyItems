<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Pages.GuildCard.GuildDetailCardView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers"
 xmlns:controls="clr-namespace:labyItems.Controls">
 <VerticalStackLayout Spacing="14">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
   <VerticalStackLayout Spacing="3" VerticalOptions="Center">
    <Label Text="{Binding Name, Source={x:Reference Root}}" FontSize="28" FontAttributes="Bold" LineBreakMode="WordWrap"/>
    <Label Text="{Binding TypeDisplayText, Source={x:Reference Root}}" FontSize="15" TextColor="{StaticResource MutedTextColor}"/>
   </VerticalStackLayout>
   <Border Grid.Column="1" WidthRequest="52" HeightRequest="52" Padding="0" Stroke="{StaticResource SurfaceBorderColor}" StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}">
    <Grid><Label Text="{Binding Icon, Source={x:Reference Root}}" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ShowIcon, Source={x:Reference Root}}"/><Image Source="{Binding Logo, Source={x:Reference Root}}" Aspect="AspectFit" WidthRequest="48" HeightRequest="48" IsVisible="{Binding ShowLogo, Source={x:Reference Root}}"/></Grid>
   </Border>
  </Grid>
  <Frame Padding="8,4" CornerRadius="10" HasShadow="False" HorizontalOptions="Start" BackgroundColor="#FFF3D6" BorderColor="#E8C878" IsVisible="{Binding Has30KGift, Source={x:Reference Root}}">
   <HorizontalStackLayout Spacing="5"><Label Text="{x:Static helpers:FontAwesomeGlyphs.Star}" FontFamily="FASolid" FontSize="11"/><Label Text="Has 30K Gift" FontSize="12" FontAttributes="Bold"/></HorizontalStackLayout>
  </Frame>
  <Border Stroke="{StaticResource SurfaceBorderColor}" StrokeShape="RoundRectangle 10" Padding="14,10">
   <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAvailabilityTapped"/></Border.GestureRecognizers>
   <VerticalStackLayout Spacing="8">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
     <Label Text="{Binding PrimaryAvailability.Glyph, Source={x:Reference Root}}" FontFamily="FASolid" FontSize="21" TextColor="{StaticResource SubtleTextColor}" VerticalTextAlignment="Center"/>
     <VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="AVAILABLE TO" Style="{StaticResource KeyInfoLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding PrimaryAvailabilityText, Source={x:Reference Root}}" FontSize="16" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation"/></VerticalStackLayout>
     <controls:ChevronIconView Grid.Column="2" IsExpanded="{Binding IsAvailabilityExpanded, Source={x:Reference Root}}" AnimateRotation="True" GlyphSize="14" IconSize="32" IsVisible="{Binding HasMultipleAvailabilityRequirements, Source={x:Reference Root}}"/>
    </Grid>
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdditionalAvailabilityRequirements, Source={x:Reference Root}}" IsVisible="{Binding IsAvailabilityExpanded, Source={x:Reference Root}}" Spacing="8">
     <BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="32,*" ColumnSpacing="10"><Label Text="{Binding Glyph}" FontFamily="FASolid" FontSize="18" TextColor="{StaticResource SubtleTextColor}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="{Binding Text}" FontSize="16" FontAttributes="Bold" LineBreakMode="WordWrap"/></Grid></DataTemplate></BindableLayout.ItemTemplate>
    </VerticalStackLayout>
   </VerticalStackLayout>
  </Border>
  <controls:LoadingIndicator IsRunning="{Binding IsDetailsLoading, Source={x:Reference Root}}" Message="Loading guild details..." IsVisible="{Binding IsDetailsLoading, Source={x:Reference Root}}"/>
  <Grid x:Name="ResponsiveBody" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="24">
   <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="WidthStates">
    <VisualState x:Name="Phone"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters>
     <Setter TargetName="NarrativeColumn" Property="Grid.Row" Value="0"/><Setter TargetName="NarrativeColumn" Property="Grid.Column" Value="0"/><Setter TargetName="NarrativeColumn" Property="Grid.ColumnSpan" Value="2"/>
     <Setter TargetName="BenefitsColumn" Property="Grid.Row" Value="1"/><Setter TargetName="BenefitsColumn" Property="Grid.Column" Value="0"/><Setter TargetName="BenefitsColumn" Property="Grid.ColumnSpan" Value="2"/><Setter TargetName="WideDivider" Property="IsVisible" Value="False"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers><VisualState.Setters>
     <Setter TargetName="NarrativeColumn" Property="Grid.Row" Value="0"/><Setter TargetName="NarrativeColumn" Property="Grid.Column" Value="0"/><Setter TargetName="NarrativeColumn" Property="Grid.ColumnSpan" Value="1"/>
     <Setter TargetName="BenefitsColumn" Property="Grid.Row" Value="0"/><Setter TargetName="BenefitsColumn" Property="Grid.Column" Value="1"/><Setter TargetName="BenefitsColumn" Property="Grid.ColumnSpan" Value="1"/><Setter TargetName="WideDivider" Property="IsVisible" Value="True"/>
    </VisualState.Setters></VisualState>
   </VisualStateGroup></VisualStateManager.VisualStateGroups>
   <VerticalStackLayout x:Name="NarrativeColumn" Spacing="16" BindableLayout.ItemsSource="{Binding LoreSections, Source={x:Reference Root}}">
    <BindableLayout.ItemTemplate><DataTemplate><VerticalStackLayout Spacing="6"><VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleCommand}"/></VerticalStackLayout.GestureRecognizers><Label Text="{Binding Header}" Style="{StaticResource SectionHeaderLabelStyle}"/><Label Text="{Binding Text}" FontSize="16" MaxLines="{Binding MaxLines}" LineBreakMode="TailTruncation"/><Label Text="{Binding ToggleLabel}" FontSize="13" TextColor="{StaticResource MutedTextColor}" IsVisible="{Binding ShowToggle}"/></VerticalStackLayout></DataTemplate></BindableLayout.ItemTemplate>
   </VerticalStackLayout>
   <BoxView x:Name="WideDivider" Grid.Column="1" HorizontalOptions="Start" Margin="-12,0,0,0" WidthRequest="1" Color="{StaticResource SurfaceBorderColor}"/>
   <VerticalStackLayout x:Name="BenefitsColumn" Grid.Column="1" Spacing="14">
    <Grid ColumnDefinitions="*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleBenefitsTapped"/></Grid.GestureRecognizers><Label Text="BENEFITS" Style="{StaticResource SectionHeaderLabelStyle}"/><controls:ChevronIconView Grid.Column="1" IsExpanded="{Binding IsBenefitsExpanded, Source={x:Reference Root}}" AnimateRotation="True" GlyphSize="14" IconSize="28"/></Grid>
    <controls:AnimatedExpandView IsExpanded="{Binding IsBenefitsExpanded, Source={x:Reference Root}}" AnimationName="GuildDetailBenefitsExpand"><VerticalStackLayout Spacing="14">
    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasBasic, Source={x:Reference Root}}"><Label Text="Basic" FontAttributes="Bold" FontSize="16"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding BasicBenefitRows, Source={x:Reference Root}}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding DisplayText}" PrimaryTextSize="15" RowBackgroundColor="{Binding RowBackgroundColor}" ShowInfo="{Binding HasDetails}" ActionCommandParameter="{Binding .}" InfoClicked="OnBenefitInfoClicked" RowClicked="OnBenefitInfoClicked"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
    <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" IsVisible="{Binding HasIntermediate, Source={x:Reference Root}}"/>
    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasIntermediate, Source={x:Reference Root}}"><Label Text="Intermediate" FontAttributes="Bold" FontSize="16"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding IntermediateBenefitRows, Source={x:Reference Root}}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding DisplayText}" PrimaryTextSize="15" RowBackgroundColor="{Binding RowBackgroundColor}" ShowInfo="{Binding HasDetails}" ActionCommandParameter="{Binding .}" InfoClicked="OnBenefitInfoClicked" RowClicked="OnBenefitInfoClicked"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
    <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" IsVisible="{Binding HasAdvanced, Source={x:Reference Root}}"/>
    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasAdvanced, Source={x:Reference Root}}"><Label Text="Advanced" FontAttributes="Bold" FontSize="16"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvancedBenefitRows, Source={x:Reference Root}}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding DisplayText}" PrimaryTextSize="15" RowBackgroundColor="{Binding RowBackgroundColor}" ShowInfo="{Binding HasDetails}" ActionCommandParameter="{Binding .}" InfoClicked="OnBenefitInfoClicked" RowClicked="OnBenefitInfoClicked"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
    </VerticalStackLayout></controls:AnimatedExpandView>
    <VerticalStackLayout Spacing="7" IsVisible="{Binding HasMiracles, Source={x:Reference Root}}"><Grid ColumnDefinitions="*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleMiraclesTapped"/></Grid.GestureRecognizers><Label Text="MIRACLES" Style="{StaticResource SectionHeaderLabelStyle}"/><controls:ChevronIconView Grid.Column="1" IsExpanded="{Binding IsMiraclesExpanded, Source={x:Reference Root}}" AnimateRotation="True" GlyphSize="14" IconSize="28"/></Grid><controls:AnimatedExpandView IsExpanded="{Binding IsMiraclesExpanded, Source={x:Reference Root}}" AnimationName="GuildDetailMiraclesExpand"><VerticalStackLayout BindableLayout.ItemsSource="{Binding MiracleRows, Source={x:Reference Root}}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate><controls:ListItemRowView PrimaryText="{Binding Name}" PrimaryTextSize="15" SecondaryText="{Binding LevelText}" ShowSecondaryText="True" ShowInfo="True" ActionCommandParameter="{Binding .}" InfoClicked="OnMiracleInfoClicked" RowClicked="OnMiracleInfoClicked"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></controls:AnimatedExpandView></VerticalStackLayout>
    <VerticalStackLayout Spacing="7" IsVisible="{Binding HasCityBenefits, Source={x:Reference Root}}"><Label Text="CITY BENEFITS" Style="{StaticResource SectionHeaderLabelStyle}"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding CityBenefits, Source={x:Reference Root}}" Spacing="7"><BindableLayout.ItemTemplate><DataTemplate><VerticalStackLayout Spacing="2"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding EffectsText}" FontSize="15" LineBreakMode="WordWrap"/></VerticalStackLayout></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasDenominationalMiracle, Source={x:Reference Root}}" BindingContext="{Binding DenominationalMiracle, Source={x:Reference Root}}"><Label Text="DENOMINATIONAL MIRACLE" Style="{StaticResource SectionHeaderLabelStyle}"/><Border Stroke="{StaticResource SurfaceBorderColor}" StrokeShape="RoundRectangle 8" Padding="10" BackgroundColor="#F9FAFB"><VerticalStackLayout Spacing="10"><Label Text="{Binding Note}" FontAttributes="Italic" IsVisible="{Binding HasNote}"/><Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3"><Label Grid.ColumnSpan="4" Text="NAME" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Name}" FontSize="16" FontAttributes="Bold"/><Label Grid.Row="2" Text="COST" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Row="2" Grid.Column="1" Text="ALIGNMENT" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Row="2" Grid.Column="2" Text="DURATION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Row="2" Grid.Column="3" Text="RANGE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Grid.Row="3" Text="{Binding Cost}"/><Label Grid.Row="3" Grid.Column="1" Text="{Binding Alignment}"/><Label Grid.Row="3" Grid.Column="2" Text="{Binding Duration}"/><Label Grid.Row="3" Grid.Column="3" Text="{Binding Range}"/></Grid><VerticalStackLayout Spacing="3"><Label Text="DESCRIPTION" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding Description}" FontSize="15" LineBreakMode="WordWrap"/></VerticalStackLayout><VerticalStackLayout Spacing="3"><Label Text="VERBAL" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding Verbal}" FontSize="15" LineBreakMode="WordWrap"/></VerticalStackLayout><Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><VerticalStackLayout><Label Text="SPHERE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding Sphere}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="GESTURE" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding Gesture}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="ADVANCED" Style="{StaticResource KeyInfoLabelStyle}"/><Label Text="{Binding IsAdvancedText}"/></VerticalStackLayout></Grid></VerticalStackLayout></Border></VerticalStackLayout>
   </VerticalStackLayout>
  </Grid>
 </VerticalStackLayout>
</ContentView>
