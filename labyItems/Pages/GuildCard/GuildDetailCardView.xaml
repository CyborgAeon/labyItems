<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Pages.GuildCard.GuildDetailCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:helpers="clr-namespace:labyItems.Helpers">

    <Frame CornerRadius="16"
           Padding="18"
           HasShadow="True"
           BorderColor="{StaticResource SurfaceBorderColor}"
           BackgroundColor="{StaticResource White}">
        <VerticalStackLayout Spacing="16">

            <!-- Header Section -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Start">
                <Frame Grid.Column="0"
                       WidthRequest="48"
                       HeightRequest="48"
                       CornerRadius="24"
                       Padding="0"
                       HasShadow="False"
                       BorderColor="{StaticResource SurfaceBorderColor}"
                       BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}">
                    <Grid>
                        <Label Text="{Binding Icon, Source={x:Reference Root}}"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding ShowIcon, Source={x:Reference Root}}" />
                        <Image Source="{Binding Logo, Source={x:Reference Root}}"
                               Aspect="AspectFill"
                               WidthRequest="48"
                               HeightRequest="48"
                               IsVisible="{Binding ShowLogo, Source={x:Reference Root}}" />
                    </Grid>
                </Frame>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Name, Source={x:Reference Root}}"
                           FontSize="22"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap" />
                    <Label Text="{Binding Type, Source={x:Reference Root}}"
                           FontSize="14"
                           FontAttributes="Italic"
                           Opacity="0.75" />
                    <Label Text="{Binding ChoiceSetNoticeText, Source={x:Reference Root}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentMaroonColor}"
                           IsVisible="{Binding HasChoiceSetNotice, Source={x:Reference Root}}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Loading Indicator -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding IsDetailsLoading, Source={x:Reference Root}}">
                <controls:LoadingIndicator IsRunning="{Binding IsDetailsLoading, Source={x:Reference Root}}"
                                           Message="Loading guild details..." />
            </VerticalStackLayout>

            <!-- Key Info Box: Ethos / PreReqs / Restrictions -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasOverviewInfo, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" />

                <VerticalStackLayout Spacing="4"
                                     IsVisible="{Binding HasEthos, Source={x:Reference Root}}">
                    <Label Text="ETHOS" Style="{StaticResource KeyInfoLabelStyle}" />
                    <Label Text="{Binding Ethos, Source={x:Reference Root}}"
                           FontSize="13"
                           Opacity="0.85" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4"
                                     IsVisible="{Binding HasPreRequisites, Source={x:Reference Root}}">
                    <Label Text="PREREQUISITES" Style="{StaticResource KeyInfoLabelStyle}" />
                    <Label Text="{Binding PreRequisites, Source={x:Reference Root}}"
                           FontSize="13"
                           Opacity="0.85" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4"
                                     IsVisible="{Binding HasRestrictions, Source={x:Reference Root}}">
                    <Label Text="RESTRICTIONS" Style="{StaticResource KeyInfoLabelStyle}" />
                    <Label Text="{Binding Restrictions, Source={x:Reference Root}}"
                           FontSize="13"
                           Opacity="0.85" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Lore Section -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasLore, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" />
                <Label Text="LORE &amp; BACKGROUND"
                       Style="{StaticResource SectionHeaderLabelStyle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding LoreSections, Source={x:Reference Root}}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="3">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Header}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       Opacity="0.9" />
                                <Label Text="{Binding Text}"
                                       FontSize="13"
                                       Opacity="0.85"
                                       MaxLines="{Binding MaxLines}" />
                                <Label Text="{Binding ToggleLabel}"
                                       FontSize="12"
                                       TextColor="{StaticResource AccentMaroonColor}"
                                       IsVisible="{Binding ShowToggle}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Miracles List Section -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasMiracles, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" />
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="MIRACLES"
                           Style="{StaticResource SectionHeaderLabelStyle}"
                           VerticalOptions="Center" />
                    <controls:ChevronIconView Grid.Column="1"
                                              IsExpanded="{Binding IsMiraclesExpanded, Source={x:Reference Root}}"
                                              AnimateRotation="True"
                                              GlyphSize="14"
                                              GlyphColor="{StaticResource MutedTextColor}"
                                              VerticalOptions="Center">
                        <controls:ChevronIconView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleMiraclesTapped" />
                        </controls:ChevronIconView.GestureRecognizers>
                    </controls:ChevronIconView>
                </Grid>

                <controls:AnimatedExpandView IsExpanded="{Binding IsMiraclesExpanded, Source={x:Reference Root}}">
                    <Border Stroke="{StaticResource SoftStrokeColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#F9FAFB"
                            Padding="8">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="6">
                            <Grid ColumnDefinitions="44,*,Auto"
                                  ColumnSpacing="8"
                                  Padding="6,2">
                                <Label Text="Lvl" FontAttributes="Bold" FontSize="12" Opacity="0.75" />
                                <Label Grid.Column="1" Text="Name" FontAttributes="Bold" FontSize="12" Opacity="0.75" />
                                <Label Grid.Column="2" Text="Info" FontAttributes="Bold" FontSize="12" Opacity="0.75" HorizontalTextAlignment="Center" />
                            </Grid>
                            <VerticalStackLayout Grid.Row="1"
                                                 BindableLayout.ItemsSource="{Binding MiracleRows, Source={x:Reference Root}}"
                                                 Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{Binding RowBackgroundColor}">
                                            <Grid Padding="8,6"
                                                  ColumnDefinitions="44,*,Auto"
                                                  ColumnSpacing="8">
                                                <Label Text="{Binding LevelText}" FontSize="13" Opacity="0.85" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalTextAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Text="&#xF05A;"
                                                        FontFamily="FASolid"
                                                        FontSize="13"
                                                        Padding="0"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{StaticResource SubtleTextColor}"
                                                        HeightRequest="22"
                                                        WidthRequest="22"
                                                        MinimumHeightRequest="0"
                                                        MinimumWidthRequest="0"
                                                        VerticalOptions="Center"
                                                        Clicked="OnMiracleInfoClicked"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </controls:AnimatedExpandView>
            </VerticalStackLayout>

            <!-- Basic Benefits -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasBasic, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" />
                <Label Text="BASIC BENEFITS"
                       Style="{StaticResource SectionHeaderLabelStyle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BasicBenefitRows, Source={x:Reference Root}}"
                                     Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource SoftStrokeColor}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#F9FAFB"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding DisplayText}" FontSize="13" LineBreakMode="WordWrap" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Text="&#xF05A;"
                                            FontFamily="FASolid"
                                            FontSize="13"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource SubtleTextColor}"
                                            HeightRequest="22"
                                            WidthRequest="22"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            VerticalOptions="Center"
                                            Clicked="OnBenefitInfoClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Intermediate Benefits -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasIntermediate, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" />
                <Label Text="INTERMEDIATE BENEFITS"
                       Style="{StaticResource SectionHeaderLabelStyle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding IntermediateBenefitRows, Source={x:Reference Root}}"
                                     Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource SoftStrokeColor}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#F9FAFB"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding DisplayText}" FontSize="13" LineBreakMode="WordWrap" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Text="&#xF05A;"
                                            FontFamily="FASolid"
                                            FontSize="13"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource SubtleTextColor}"
                                            HeightRequest="22"
                                            WidthRequest="22"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            VerticalOptions="Center"
                                            Clicked="OnBenefitInfoClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Advanced Benefits -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasAdvanced, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" />
                <Label Text="ADVANCED BENEFITS"
                       Style="{StaticResource SectionHeaderLabelStyle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AdvancedBenefitRows, Source={x:Reference Root}}"
                                     Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource SoftStrokeColor}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#F9FAFB"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding DisplayText}" FontSize="13" LineBreakMode="WordWrap" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Text="&#xF05A;"
                                            FontFamily="FASolid"
                                            FontSize="13"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource SubtleTextColor}"
                                            HeightRequest="22"
                                            WidthRequest="22"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            VerticalOptions="Center"
                                            Clicked="OnBenefitInfoClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- City Benefits -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasCityBenefits, Source={x:Reference Root}}">
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceBorderColor}" />
                <Label Text="CITY BENEFITS"
                       Style="{StaticResource SectionHeaderLabelStyle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CityBenefits, Source={x:Reference Root}}"
                                     Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource SoftStrokeColor}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#F9FAFB"
                                    Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding EffectsText}" FontSize="12" Opacity="0.8" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Frame>
</ContentView>
