<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.MakeSheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:labyItems.Pages">

  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="8">

      <!-- Headers you set from the Character passed to the ctor -->
      <Label x:Name="PlayerNameHeader"   FontSize="18" FontAttributes="Bold" />
      <Label x:Name="CharacterNameHeader" />
      <Label x:Name="CharacterClassHeader" />
      <Label Text="Base Make Chance (%)" />
      <HorizontalStackLayout Spacing="8">
        <Entry Keyboard="Numeric" WidthRequest="120" Text="{Binding Sheet.BaseMakeChancePercent}" />
        <Button Text="Recalc" Command="{Binding RecalcCommand}" />
      </HorizontalStackLayout>

      <Label Text="Final Normal Chance (%)" />
      <Entry Keyboard="Numeric" Text="{Binding Sheet.FinalNormalChancePercent}" />

      <!-- Add your CollectionViews etc. here … -->

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
