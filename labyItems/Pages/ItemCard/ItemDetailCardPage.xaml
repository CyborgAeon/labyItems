<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="labyItems.Pages.ItemCard.ItemDetailCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:itemCard="clr-namespace:labyItems.Pages.ItemCard"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
    <controls:DetailPageHeader x:Name="DetailHeader" HeaderText="Item"/>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16">
            <itemCard:ItemDetailCardView x:Name="ItemDetails"/>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
