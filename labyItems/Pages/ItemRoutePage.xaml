<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.ItemRoutePage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  Title="Home"
  NavigationPage.HasNavigationBar="False"
  Shell.NavBarIsVisible="False">
  <Grid>
    <ScrollView>
      <VerticalStackLayout Padding="20,20,20,32"
                           Spacing="22">
        <Grid ColumnDefinitions="Auto,*"
              VerticalOptions="Start">
          <Button Clicked="OnToggleMenuClicked"
                  FontSize="28"
                  HeightRequest="48"
                  Padding="8,0"
                  Text="&#x2630;"
                  TextColor="{StaticResource Gray950}"
                  WidthRequest="48">
            <Button.BackgroundColor>Transparent</Button.BackgroundColor>
          </Button>

          <Label Grid.Column="1"
                 FontAttributes="Italic"
                 FontSize="14"
                 HorizontalTextAlignment="End"
                 Text="Laby tools"
                 TextColor="{StaticResource Gray500}"
                 VerticalTextAlignment="Center" />
        </Grid>

        <Border BackgroundColor="{StaticResource Primary}"
                Padding="24"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
          <VerticalStackLayout Spacing="10">
            <Label FontAttributes="Bold"
                   FontSize="34"
                   Text="Home"
                   TextColor="{StaticResource White}" />
            <Label FontSize="18"
                   Text="Welcome back, admin."
                   TextColor="{StaticResource White}" />
            <Label FontAttributes="Italic"
                   FontSize="16"
                   Text="Use the menu to jump into characters, calculators, search, trading, or your item tools."
                   TextColor="#F8EDED" />
          </VerticalStackLayout>
        </Border>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="14"
              RowDefinitions="Auto,Auto"
              RowSpacing="14">
          <Border Grid.Row="0"
                  Grid.Column="0"
                  Padding="18"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="8">
              <Label FontAttributes="Bold"
                     FontSize="20"
                     Text="Branding Refresh" />
              <Label Text="Libre Caslon Text is now the default app voice, while specialist rune and glyph fonts stay untouched where they are explicitly chosen." />
            </VerticalStackLayout>
          </Border>

          <Border Grid.Row="0"
                  Grid.Column="1"
                  Padding="18"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="8">
              <Label FontAttributes="Bold"
                     FontSize="20"
                     Text="Quick Start" />
              <Label Text="Open the burger menu in the top-left to reach the same destinations that previously lived on this screen." />
            </VerticalStackLayout>
          </Border>

          <Border Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Padding="18"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="8">
              <Label FontAttributes="Bold"
                     FontSize="20"
                     Text="Session" />
              <Label>
                <Label.FormattedText>
                  <FormattedString>
                    <Span Text="Signed in as " />
                    <Span FontAttributes="Bold" Text="admin" />
                    <Span Text=" using the temporary placeholder login while authentication is being integrated." />
                  </FormattedString>
                </Label.FormattedText>
              </Label>
            </VerticalStackLayout>
          </Border>
        </Grid>
      </VerticalStackLayout>
    </ScrollView>

    <Grid x:Name="MenuOverlay"
          BackgroundColor="#66000000"
          ColumnDefinitions="300,*"
          IsVisible="False">
      <Border BackgroundColor="{StaticResource White}"
              Padding="18,22"
              StrokeThickness="0">
        <ScrollView>
          <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <Label FontAttributes="Bold"
                     FontSize="26"
                     Text="Navigate"
                     VerticalTextAlignment="Center" />
              <Button Grid.Column="1"
                      Clicked="OnCloseMenuClicked"
                      FontSize="24"
                      Padding="4"
                      Text="&#x2715;"
                      TextColor="{StaticResource Gray950}">
                <Button.BackgroundColor>Transparent</Button.BackgroundColor>
              </Button>
            </Grid>

            <Label FontAttributes="Italic"
                   FontSize="14"
                   Margin="0,0,0,8"
                   TextColor="{StaticResource Gray500}" />

            <Button Clicked="OnMakeCharacterClicked" Text="Create a Character" />
            <Button x:Name="CharacterWalletButton" Clicked="OnCharacterWalletClicked" IsEnabled="False" Text="Character Wallet" />
            <Button Clicked="OnSearchClicked" Text="Search" />
            <Button Clicked="OnGuildSearchClicked" Text="Guild Search" />
            <Button Clicked="OnCreateNonStandardClicked" Text="Create New Non-Standard" />
            <Button Clicked="OnCalculateIspClicked" Text="Calculate Item ISP" />
            <Button Clicked="OnCreateMpClicked" Text="Create MP Item" />
            <Button Clicked="OnBuildScrollClicked" Text="Build Scroll" />
            <Button Clicked="OnInitiateTradeClicked" Text="Initiate Trade" />
            <Button Clicked="OnItemWalletClicked" Text="Item Wallet" />
          </VerticalStackLayout>
        </ScrollView>
      </Border>

      <BoxView Grid.Column="1"
               BackgroundColor="Transparent">
        <BoxView.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnCloseMenuTapped" />
        </BoxView.GestureRecognizers>
      </BoxView>
    </Grid>
  </Grid>
</ContentPage>
