<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.ItemRoutePage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  Title="Create Item"
  NavigationPage.HasNavigationBar="False"
  Shell.NavBarIsVisible="False">
  <ScrollView>
    <VerticalStackLayout Padding="20"
                         Spacing="12">
      <Button
        Clicked="OnMakeCharacterClicked"
        Text="Create a Character"/>
      <Button
        x:Name="CharacterWalletButton"
        Clicked="OnCharacterWalletClicked"
        Text="Character Wallet"
        IsEnabled="False"/>
      <Button
        Clicked="OnSearchClicked"
        Text="Search"/>
      <Button
        Clicked="OnGuildSearchClicked"
        Text="Guild Search"/>
      <Button
        Clicked="OnCreateNonStandardClicked"
        Text="Create New Non-Standard"/>
      <Button
        Clicked="OnCalculateIspClicked"
        Text="Calculate Item ISP"/>
      <Button
        Clicked="OnCreateMpClicked"
        Text="Create MP Item"/>
      <Button
        Clicked="OnBuildScrollClicked"
        Text="Build Scroll"/>
      <Button
        Clicked="OnInitiateTradeClicked"
        Text="Initiate Trade"/>
      <Button
        Clicked="OnItemWalletClicked"
        Text="Item Wallet"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
