<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.ItemRoutePage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  Title="Create Item">
  <VerticalStackLayout Padding="20" Spacing="12">
    <Button
      Clicked="OnMakeCharacterClicked"
      Text="Character Wizard" />
    <Button
      x:Name="CharacterWalletButton"
      Clicked="OnCharacterWalletClicked"
      Text="Character Wallet"
      IsEnabled="False" />
    <Button
      Clicked="OnSearchClicked"
      Text="Search" />
    <Button
      Clicked="OnCreateIspClicked"
      Text="Create ISP Item" />
    <Button
      Clicked="OnCreateMpClicked"
      Text="Create MP Item" />
  </VerticalStackLayout>
</ContentPage>
