<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.ItemRoutePage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  x:Name="RootPage"
  Title="Home"
  NavigationPage.HasNavigationBar="False"
  Shell.NavBarIsVisible="False">
  <Grid>
    <ScrollView>
      <VerticalStackLayout Padding="20,20,20,32"
                           Spacing="22">
        <Grid ColumnDefinitions="Auto,*"
              VerticalOptions="Start">
          <controls:BurgerMenuButton Command="{Binding Source={x:Reference ToolsetMenu}, Path=OpenMenuCommand}" />

          <Label Grid.Column="1"
                 FontAttributes="Italic"
                 FontSize="14"
                 HorizontalTextAlignment="End"
                 Text="Laby tools"
                 TextColor="{StaticResource Gray500}"
                 VerticalTextAlignment="Center" />
        </Grid>

        <Border BackgroundColor="{StaticResource Primary}"
                Padding="24"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
          <VerticalStackLayout Spacing="10">
            <Label FontAttributes="Bold"
                   FontSize="34"
                   Text="Home"
                   TextColor="{StaticResource White}" />
            <Label FontSize="18"
                   Text="Welcome back, admin."
                   TextColor="{StaticResource White}" />
            <Label FontAttributes="Italic"
                   FontSize="16"
                   Text="Use the menu to jump into characters, calculators, search, trading, item tools, and the unified calendar."
                   TextColor="#F8EDED" />
          </VerticalStackLayout>
        </Border>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="14"
              RowDefinitions="Auto,Auto"
              RowSpacing="14">
          <Border Grid.Row="0"
                  Grid.Column="0"
                  x:Name="NonStandardDashboardCard"
                  Padding="18"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeShape="RoundRectangle 18">
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnOpenNonStandardDashboardTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="8">
              <Label FontAttributes="Bold"
                     FontSize="20"
                     Text="Creations Hub" />
              <Label Text="Create and manage your registered points apps for abilities, classes, races and more." />
            </VerticalStackLayout>
          </Border>

          <Border Grid.Row="0"
                  Grid.Column="1"
                  x:Name="CalendarCard"
                  Padding="18"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeShape="RoundRectangle 18">
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnOpenCalendarTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="12">
              <Label FontAttributes="Bold"
                     FontSize="20"
                     Text="Calendar" />
              <Label Text="View month-by-month bookings, inspect event details, and create new events from one unified calendar." />
            </VerticalStackLayout>
          </Border>

          <Border Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Padding="18"
                  Stroke="{StaticResource SurfaceBorderColor}"
                  StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="8">
              <Label FontAttributes="Bold"
                     FontSize="20"
                     Text="Session" />
              <Label>
                <Label.FormattedText>
                  <FormattedString>
                    <Span Text="Signed in as " />
                    <Span FontAttributes="Bold" Text="admin" />
                    <Span Text=" using the temporary placeholder login while authentication is being integrated." />
                  </FormattedString>
                </Label.FormattedText>
              </Label>
            </VerticalStackLayout>
          </Border>
        </Grid>
      </VerticalStackLayout>
    </ScrollView>

    <controls:ToolsetNavigationMenu x:Name="ToolsetMenu"
                                    SelectedRoute="{x:Static controls:ToolsetRouteKeys.Home}" />

    <Grid x:Name="LoadingOverlay"
          BackgroundColor="#66000000"
          IsVisible="{Binding Source={x:Reference RootPage}, Path=IsBusy}">
      <VerticalStackLayout VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Spacing="16"
                           Padding="24">
        <ActivityIndicator IsRunning="True"
                           Color="{StaticResource Primary}"
                           WidthRequest="48"
                           HeightRequest="48" />
        <Label Text="Loading tool..."
               FontAttributes="Bold"
               TextColor="White"
               HorizontalTextAlignment="Center" />
      </VerticalStackLayout>
    </Grid>
  </Grid>
</ContentPage>
