<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.SpellConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  Title="Configure Spell">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <!--  Title / selected Spell  -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <Label
        FontAttributes="Bold"
        FontSize="20"
        Text="{Binding Title}" />
        <Button
          Grid.Column="2"
          Clicked="OnSearchSpell"
          Text="Search" />
      </Grid>

        <controls:PlusMinusControl
          Grid.Column="1"
          AllowMultiple="True"
          Count="{Binding Power, Mode=TwoWay}"
          LabelText="Mana cost override" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding BasicPerDay, Mode=TwoWay}"
        LabelText="Basic innate times per day" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding AdvancedPerDay, Mode=TwoWay}"
        LabelText="Advanced innate times per day" />

      <!--  Base list additions  -->
      <CheckBox IsChecked="{Binding AddBasic}" />
      <Label Text="Add basic to base list (+15)" />

      <CheckBox IsChecked="{Binding AddAdvanced}" />
      <Label Text="Add advanced to base list (+18)" />

      <CheckBox IsChecked="{Binding AddPrep}" />
      <Label Text="Add to base list with 30s prep (+50%)" />

      <!--  Mantic options  -->
      <Label FontAttributes="Bold" Text="Mantic options" />
      <CheckBox IsChecked="{Binding IsMantic}" />
      <Label Text="Innate is Mantic" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding MakeSpellUnder7thMantic, Mode=TwoWay}"
        LabelText="Make spell under 7th Mantic" />
      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding MakeBasicSpellMantic, Mode=TwoWay}"
        LabelText="Make basic spell Mantic" />
      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding MakeAdvancedSpellMantic, Mode=TwoWay}"
        LabelText="Make advanced spell Mantic" />

      <!--  Additional power knobs  -->
      <Label FontAttributes="Bold" Text="Additional power" />
      
      <controls:PlusMinusControl LabelText="Additional power" AllowMultiple="True" Count="{Binding AdditionalPower, Mode=TwoWay}" />
      <controls:PlusMinusControl LabelText="Additional power of sphere" AllowMultiple="True" Count="{Binding AdditionalPowerOfSphere, Mode=TwoWay}" />

      <!--  Flags  -->
      <CheckBox IsChecked="{Binding PowerStoreRegenerates}" />
      <Label Text="Power store regenerates" />

      <CheckBox IsChecked="{Binding IsTeachingScroll}" />
      <Label Text="Is teaching scroll" />

      <!--  Total  -->
      <Label
        FontAttributes="Bold"
        FontSize="18"
        Text="{Binding Total, StringFormat='Total ISP: {0}'}" />

      <Button Clicked="OnReturn" Text="Return" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
