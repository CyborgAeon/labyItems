<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="labyItems.Pages.SpellConfigPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:controls="clr-namespace:labyItems.Controls"
  Title="Configure Spell">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">

      <!-- Header: title + search -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Label
          Grid.Column="0"
          FontAttributes="Bold"
          FontSize="20"
          Text="{Binding Title}" />
        <Button
          Grid.Column="1"
          Clicked="OnSearchSpell"
          Text="Search" />
      </Grid>

      <!-- Optional: override spell Power (mana cost) -->
      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding Power, Mode=TwoWay}"
        LabelText="Mana cost override" />

      <!-- Innates (per day) -->
      <Label Text="Innates (x/day)" FontAttributes="Bold" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding BasicPerDay, Mode=TwoWay}"
        LabelText="Casts basic handbook spell x/day (2 × Power × count)" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding PublishedPerDay, Mode=TwoWay}"
        LabelText="Casts wizard’s any published spell x/day (3 × Power × count)" />

      <controls:CheckboxControl
        IsChecked="{Binding InnateIsMantic}"
        LabelText="Innate spell (from above) is mantic (×4 above cost)" />

      <!-- Additional mana -->
      <Label Text="Additional mana" FontAttributes="Bold" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding AdditionalMana4, Mode=TwoWay}"
        LabelText="Additional mana (+4 each)" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <controls:PlusMinusControl
          Grid.Column="0"
          AllowMultiple="True"
          Count="{Binding AdditionalMana3, Mode=TwoWay}"
          LabelText="Additional mana of colour (+3 each)" />
        <Entry
          Grid.Column="1"
          WidthRequest="140"
          Placeholder="Colour/hue"
          Text="{Binding AdditionalMana3Colour, Mode=TwoWay}" />
      </Grid>

      <!-- Power store / base list -->
      <Label Text="Base list / power store" FontAttributes="Bold" />

      <controls:CheckboxControl
        IsChecked="{Binding PowerStoreRegenerates}"
        LabelText="Power store regenerates at 1/15 minutes (+25)" />

      <controls:CheckboxControl
        IsChecked="{Binding AddBasicToBaseList}"
        LabelText="Add basic spell to base list at the start of the day (+15)" />

      <controls:CheckboxControl
        IsChecked="{Binding AddAdvancedToBaseList}"
        LabelText="Add advanced spell to base list at the start of the day (+18)" />

      <!-- Mantic conversions -->
      <Label Text="Mantic conversions" FontAttributes="Bold" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding TurnHandbookToSixthMantic, Mode=TwoWay}"
        LabelText="Turn handbook spell to 6th mantic x/day (+40 each)" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding TurnAnyBasicMantic, Mode=TwoWay}"
        LabelText="Turn any basic spell mantic x/day (+50 each)" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding TurnAnyPublishedToSixthMantic, Mode=TwoWay}"
        LabelText="Turn any published spell to 6th mantic x/day (+60 each)" />

      <controls:PlusMinusControl
        AllowMultiple="True"
        Count="{Binding TurnAnyPublishedMantic, Mode=TwoWay}"
        LabelText="Turn any published spell mantic x/day (+80 each)" />

      <!-- Teaching scroll/scripture -->
      <controls:CheckboxControl
        IsChecked="{Binding IsTeachingScroll}"
        LabelText="Teaching scroll/scripture of chosen spell (+2 × Power)" />

      <!-- Results -->
      <Label Text="{Binding Breakdown}" LineBreakMode="WordWrap" />
      <Label FontAttributes="Bold" FontSize="18"
             Text="{Binding Total, StringFormat='Total ISP: {0}'}" />

      <Button Clicked="OnReturn" Text="Return" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
