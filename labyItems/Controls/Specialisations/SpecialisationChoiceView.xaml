<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.Specialisations.SpecialisationChoiceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border x:Name="ChoiceBorder"
            Padding="12,10"
            MinimumHeightRequest="44"
            Stroke="{StaticResource SurfaceBorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 7"
            BackgroundColor="{StaticResource White}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
            <Label Text="{Binding Text, Source={x:Reference Root}}" LineBreakMode="WordWrap">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected, Source={x:Reference Root}}" Value="True">
                        <Setter Property="FontAttributes" Value="Bold"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{Binding SecondaryText, Source={x:Reference Root}}"
                   FontSize="12" Opacity="0.75" LineBreakMode="WordWrap"
                   IsVisible="{Binding SecondaryText.Length, Source={x:Reference Root}, Converter={StaticResource GreaterThanZeroConverter}}"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
