<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.Specialisations.SpecialisationSectionView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:labyItems.Controls"
             xmlns:helpers="clr-namespace:labyItems.Helpers">
    <Border x:Name="Container" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1"
            StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}">
        <Grid RowDefinitions="Auto,Auto">
            <Grid x:Name="Header" Padding="12,9" ColumnDefinitions="38,*,Auto" ColumnSpacing="10">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnHeaderTapped"/></Grid.GestureRecognizers>
                <Border x:Name="Indicator" HeightRequest="30" WidthRequest="30" StrokeThickness="0"
                        StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Gray500}">
                    <Grid>
                        <Label x:Name="NumberLabel" Text="{Binding SectionNumber, Source={x:Reference Root}}"
                               TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        <Label x:Name="CheckLabel" Text="{x:Static helpers:FontAwesomeGlyphs.Check}" FontFamily="FASolid"
                               TextColor="White" Opacity="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding Title, Source={x:Reference Root}}" FontAttributes="Bold" FontSize="16" LineBreakMode="WordWrap"/>
                    <Label Text="{Binding StatusText, Source={x:Reference Root}}" FontSize="12" Opacity="0.72" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Label x:Name="Chevron" Grid.Column="2" Text="{x:Static helpers:FontAwesomeGlyphs.ChevronRight}"
                       FontFamily="FASolid" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center"/>
            </Grid>
            <controls:AnimatedExpandView Grid.Row="1" IsExpanded="{Binding IsExpanded, Source={x:Reference Root}}">
                <ContentPresenter Padding="12" Content="{Binding SectionContent, Source={x:Reference Root}}"/>
            </controls:AnimatedExpandView>
        </Grid>
    </Border>
</ContentView>
