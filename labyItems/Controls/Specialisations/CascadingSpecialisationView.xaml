<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.Specialisations.CascadingSpecialisationView"
             x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout x:Name="SectionsHost" Spacing="12"
                         BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                         BindableLayout.ItemTemplateSelector="{Binding ItemTemplateSelector, Source={x:Reference Root}}"/>
</ContentView>
