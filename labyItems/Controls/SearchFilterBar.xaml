<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.SearchFilterBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:labyItems.Helpers">
    <Border Stroke="{StaticResource SurfaceBorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10"
            BackgroundColor="#F9FAFB"
            Padding="8,4"
            VerticalOptions="Center">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Entry ClearButtonVisibility="WhileEditing"
                   Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                   Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="{x:Static helpers:FontAwesomeGlyphs.Filter}"
                    FontFamily="FASolid"
                    FontSize="13"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource SubtleTextColor}"
                    HeightRequest="24"
                    WidthRequest="24"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    VerticalOptions="Center"
                    Command="{Binding OpenFiltersCommand, Source={x:Reference Root}}" />
        </Grid>
    </Border>
</ContentView>
