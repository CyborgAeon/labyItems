<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.AdvanceSectionActionRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border Stroke="{StaticResource SurfaceBorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10"
            BackgroundColor="#F9FAFB"
            Padding="10,8">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnRowTapped"/>
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
            <Label Text="{Binding IconGlyph, Source={x:Reference Root}}"
                   FontFamily="FASolid"
                   FontSize="14"
                   TextColor="{StaticResource SubtleTextColor}"
                   VerticalOptions="Center"/>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="1">
                <Label Text="{Binding Heading, Source={x:Reference Root}}"
                       FontAttributes="Bold"/>
                <Label Text="{Binding Subheading, Source={x:Reference Root}}"
                       FontSize="11"
                       Opacity="0.7"
                       IsVisible="{Binding HasSubheading, Source={x:Reference Root}}"/>
            </VerticalStackLayout>

            <Grid Grid.Column="2">
                <Button Text="{Binding ActionGlyph, Source={x:Reference Root}}"
                        FontFamily="FASolid"
                        FontSize="12"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource SubtleTextColor}"
                        HeightRequest="22"
                        WidthRequest="22"
                        MinimumHeightRequest="0"
                        MinimumWidthRequest="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="{Binding ShowActionGlyph, Source={x:Reference Root}}"
                        Clicked="OnActionButtonClicked"/>
                <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference Root}}"
                                   IsVisible="{Binding IsLoading, Source={x:Reference Root}}"
                                   Color="{StaticResource SubtleTextColor}"
                                   HeightRequest="18"
                                   WidthRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
            </Grid>
        </Grid>
    </Border>
</ContentView>
