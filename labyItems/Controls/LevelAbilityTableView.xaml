<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.LevelAbilityTableView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:labyItems.Models.ViewModels">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="CompactCards" Property="IsVisible" Value="True"/>
                        <Setter TargetName="WideTable" Property="IsVisible" Value="False"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="CompactCards" Property="IsVisible" Value="False"/>
                        <Setter TargetName="WideTable" Property="IsVisible" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Phone layout: each level is a self-contained, readable group rather than
             one row in a table whose useful column is squeezed to a few words. -->
        <VerticalStackLayout x:Name="CompactCards"
                             BindableLayout.ItemsSource="{Binding Source={x:Reference Root}, Path=ItemsSource}"
                             Spacing="8">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="viewModels:LevelAbilityRowVm">
                    <Border Padding="12,10"
                            Stroke="{StaticResource SurfaceBorderColor}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource White}">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="8"
                              ColumnSpacing="8">
                            <Label Text="{Binding StageHeading}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   VerticalTextAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Text="&#xF05A;"
                                    FontFamily="FASolid"
                                    FontSize="14"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource AccentMaroonColor}"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                    SemanticProperties.Description="Open ability details"
                                    IsVisible="{Binding HasAbilityDetails}"
                                    Clicked="OnInfoClicked"
                                    CommandParameter="{Binding .}"/>

                            <HorizontalStackLayout Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Spacing="14"
                                                   IsVisible="{Binding Source={x:Reference Root}, Path=ShowBodyAndLoc}">
                                <Label Text="{Binding Body, StringFormat='Body  {0}'}"
                                       TextColor="{StaticResource MutedTextColor}"/>
                                <Label Text="{Binding Loc, StringFormat='Loc  {0}'}"
                                       TextColor="{StaticResource MutedTextColor}"/>
                                <Label Text="{Binding WeaponSkills, StringFormat='WS  {0}'}"
                                       TextColor="{StaticResource MutedTextColor}"
                                       IsVisible="{Binding Source={x:Reference Root}, Path=ShowWeaponSkillsColumn}"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="3">
                                <Label Text="{Binding Source={x:Reference Root}, Path=AbilitiesHeaderText}"
                                       FontSize="11"
                                       TextTransform="Uppercase"
                                       TextColor="{StaticResource MutedTextColor}"/>
                                <Label Text="{Binding AbilitiesDisplayText}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Tablet/desktop layout keeps the denser comparison table. -->
        <VerticalStackLayout x:Name="WideTable" Spacing="2" IsVisible="False">
        <Grid ColumnSpacing="8"
              Opacity="0.7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding Source={x:Reference Root}, Path=WeaponSkillColumnWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Text="Stage"/>
            <Label Grid.Column="1"
                   Text="Body"
                   IsVisible="{Binding Source={x:Reference Root}, Path=ShowBodyAndLoc}"
                   WidthRequest="36"/>
            <Label Grid.Column="2"
                   Text="Loc"
                   IsVisible="{Binding Source={x:Reference Root}, Path=ShowBodyAndLoc}"
                   WidthRequest="36"/>
            <Label Grid.Column="3"
                   Text="WS"
                   IsVisible="{Binding Source={x:Reference Root}, Path=ShowWeaponSkillsColumn}"/>
            <Label Grid.Column="4"
                   Text="{Binding Source={x:Reference Root}, Path=AbilitiesHeaderText}"/>
            <Label Grid.Column="5"
                   Text="Info"
                   HorizontalTextAlignment="Center"/>
        </Grid>

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Source={x:Reference Root}, Path=ItemsSource}"
                             Spacing="2">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="viewModels:LevelAbilityRowVm">
                    <Grid ColumnSpacing="8"
                          Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding Source={x:Reference Root}, Path=WeaponSkillColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="{Binding StageText}"/>
                        <Label Grid.Column="1"
                               Text="{Binding Body}"
                               IsVisible="{Binding Source={x:Reference Root}, Path=ShowBodyAndLoc}"
                               WidthRequest="36"/>
                        <Label Grid.Column="2"
                               Text="{Binding Loc}"
                               IsVisible="{Binding Source={x:Reference Root}, Path=ShowBodyAndLoc}"
                               WidthRequest="36"/>
                        <Label Grid.Column="3"
                               Text="{Binding WeaponSkills}"
                               Opacity="0.8"
                               IsVisible="{Binding Source={x:Reference Root}, Path=ShowWeaponSkillsColumn}"/>
                        <Label Grid.Column="4"
                               Text="{Binding AbilitiesText}"
                               Opacity="0.8"
                               LineBreakMode="WordWrap"/>
                        <Button Grid.Column="5"
                                Text="&#xF05A;"
                                FontFamily="FASolid"
                                FontSize="12"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SubtleTextColor}"
                                HeightRequest="44"
                                WidthRequest="44"
                                SemanticProperties.Description="Open ability details"
                                VerticalOptions="Center"
                                IsVisible="{Binding HasAbilityDetails}"
                                Clicked="OnInfoClicked"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>
