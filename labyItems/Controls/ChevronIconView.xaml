<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.ChevronIconView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    WidthRequest="{Binding IconSize, Source={x:Reference Root}}"
    HeightRequest="{Binding IconSize, Source={x:Reference Root}}">

    <Label x:Name="ChevronLabel"
           FontFamily="FASolid"
           FontSize="{Binding GlyphSize, Source={x:Reference Root}}"
           HorizontalOptions="Center"
           HorizontalTextAlignment="Center"
           InputTransparent="True"
           Text="{Binding Glyph, Source={x:Reference Root}}"
           TextColor="{Binding GlyphColor, Source={x:Reference Root}}"
           VerticalOptions="Center"
           VerticalTextAlignment="Center" />
</ContentView>
