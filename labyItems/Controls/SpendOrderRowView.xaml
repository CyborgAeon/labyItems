<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.SpendOrderRowView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:labyItems.Helpers">
    <Border Padding="6,8"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="{Binding Row.BorderThickness, Source={x:Reference Root}}"
            Stroke="{Binding Row.BorderColor, Source={x:Reference Root}}"
            BackgroundColor="{Binding Row.RowBackgroundColor, Source={x:Reference Root}}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="5">
            <Button Grid.Column="0"
                    Text="{x:Static helpers:FontAwesomeGlyphs.GripVertical}"
                    FontFamily="FASolid"
                    FontSize="13"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource MutedTextColor}">
                <Button.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnHandlePanUpdated" />
                </Button.GestureRecognizers>
            </Button>
            <Label Grid.Column="1" Text="{Binding Row.PositionText, Source={x:Reference Root}}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Border Grid.Column="2" Padding="6,3" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{Binding Row.TypeBackgroundColor, Source={x:Reference Root}}" VerticalOptions="Center">
                <Label Text="{Binding Row.TypeText, Source={x:Reference Root}}" FontSize="11" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
            </Border>
            <Label Grid.Column="3" Text="{Binding Row.Name, Source={x:Reference Root}}" FontSize="13" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
            <Label Grid.Column="4" Text="{Binding Row.CostText, Source={x:Reference Root}}" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Label Grid.Column="5" Text="{Binding Row.TotalText, Source={x:Reference Root}}" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Button Grid.Column="6"
                    Text="{x:Static helpers:FontAwesomeGlyphs.MoreVertical}"
                    FontFamily="FASolid"
                    FontSize="13"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource SubtleTextColor}"
                    Clicked="OnOptionsClicked" />
            <Button Grid.Column="1" Grid.ColumnSpan="5"
                    x:Name="SelectionSurface"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Opacity="0.01"
                    Pressed="OnSelectionPressed"
                    Released="OnSelectionReleased" />
        </Grid>
    </Border>
</ContentView>
