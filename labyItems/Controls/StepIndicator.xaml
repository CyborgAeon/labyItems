<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.StepIndicator" x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid Padding="2,16" RowDefinitions="Auto" ColumnDefinitions="*">
        <Grid x:Name="StepsHost" RowDefinitions="Auto" ColumnDefinitions="*">
            <BoxView x:Name="LineBg" HeightRequest="2" VerticalOptions="Center" HorizontalOptions="Fill" Opacity="1" />
            <BoxView x:Name="LineFg" HeightRequest="2" VerticalOptions="Center" HorizontalOptions="Start" Opacity="1" WidthRequest="0" />
            <Grid x:Name="StepsGrid" RowDefinitions="Auto" ColumnDefinitions="" ColumnSpacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
            </Grid>

        </Grid>
    </Grid>
</ContentView>
