<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.ClassBracketIconView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <Grid WidthRequest="{Binding IconSize, Source={x:Reference Root}}"
          HeightRequest="{Binding IconSize, Source={x:Reference Root}}">
        <Border IsVisible="{Binding ShowImage, Source={x:Reference Root}}"
                Stroke="{Binding BorderColor, Source={x:Reference Root}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 999"
                BackgroundColor="{StaticResource SurfaceMutedBackgroundColor}"
                Padding="0">
            <Image Source="{Binding AvatarImageSource, Source={x:Reference Root}}"
                   Aspect="AspectFill"
                   WidthRequest="{Binding IconSize, Source={x:Reference Root}}"
                   HeightRequest="{Binding IconSize, Source={x:Reference Root}}" />
        </Border>

        <Border IsVisible="{Binding ShowSingleIcon, Source={x:Reference Root}}"
                Stroke="{Binding BorderColor, Source={x:Reference Root}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 999"
                BackgroundColor="{Binding SingleBackground, Source={x:Reference Root}}"
                Padding="0">
            <Label Text="{Binding SingleGlyph, Source={x:Reference Root}}"
                   FontFamily="{Binding SingleIconFontFamily, Source={x:Reference Root}}"
                   FontSize="{Binding GlyphFontSize, Source={x:Reference Root}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Border>

        <controls:SplitEmojiIcon IsVisible="{Binding ShowSplitIcon, Source={x:Reference Root}}"
                                 WidthRequest="{Binding IconSize, Source={x:Reference Root}}"
                                 HeightRequest="{Binding IconSize, Source={x:Reference Root}}"
                                 LeftEmoji="{Binding SplitLeftGlyph, Source={x:Reference Root}}"
                                 RightEmoji="{Binding SplitRightGlyph, Source={x:Reference Root}}"
                                 LeftColor="{Binding SplitLeftBackground, Source={x:Reference Root}}"
                                 RightColor="{Binding SplitRightBackground, Source={x:Reference Root}}"
                                 BorderColor="{Binding BorderColor, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
