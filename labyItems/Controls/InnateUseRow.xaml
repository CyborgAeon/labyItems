<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.InnateUseRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    VerticalOptions="Center">
    <Frame Padding="12"
           CornerRadius="12"
           HasShadow="False"
           BorderColor="#E5E7EB">
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="4">
            <Label Text="{Binding Name}"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"/>

            <Label Grid.Column="1"
                   x:Name="UsesLabel"
                   Text="{Binding UsesLabel}"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"
                   HorizontalOptions="End"
                   Margin="0,0,4,0"/>
            <Button Grid.Column="2"
                    Text="Use"
                    Padding="10,4"
                    ContentLayout="Left,6"
                    Command="{Binding UseCommand}">
                <Button.ImageSource>
                    <FontImageSource Glyph="⚡" Size="14" Color="Black"/>
                </Button.ImageSource>
            </Button>
        </Grid>
    </Frame>
</ContentView>
