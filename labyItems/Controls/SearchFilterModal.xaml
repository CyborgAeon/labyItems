<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.SearchFilterModal" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:labyItems.Controls">
 <Grid IsVisible="{Binding IsOpen, Source={x:Reference Root}}" BackgroundColor="#66000000">
  <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelCommand, Source={x:Reference Root}}"/></Grid.GestureRecognizers>
  <Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="360" MaximumWidthRequest="420" MaximumHeightRequest="560" Stroke="{StaticResource SurfaceBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="14">
   <Border.GestureRecognizers><TapGestureRecognizer/></Border.GestureRecognizers>
   <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <Label Text="Filters" FontAttributes="Bold" FontSize="18"/>
    <ScrollView Grid.Row="1"><VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections, Source={x:Reference Root}}" Spacing="12"><BindableLayout.ItemTemplate><DataTemplate><VerticalStackLayout Spacing="6"><Grid ColumnDefinitions="*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleExpandedCommand}"/></Grid.GestureRecognizers><Label Text="{Binding Title}" FontAttributes="Bold" FontSize="13"/><controls:ChevronIconView Grid.Column="1" IsExpanded="{Binding IsExpanded}" AnimateRotation="True" GlyphSize="14" GlyphColor="{StaticResource Gray950}" HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True"/></Grid><controls:AnimatedExpandView IsExpanded="{Binding IsExpanded}"><FlexLayout BindableLayout.ItemsSource="{Binding Chips}" Wrap="Wrap" Direction="Row" AlignItems="Start" JustifyContent="Start"><BindableLayout.ItemTemplate><DataTemplate><Border Style="{StaticResource SelectableFilterPillBorderStyle}" Margin="0,0,8,8"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleChipCommand, Source={x:Reference Root}}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Label Text="{Binding Label}" Style="{StaticResource FilterPillLabelStyle}"/></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout></controls:AnimatedExpandView></VerticalStackLayout></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></ScrollView>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Button Text="Cancel" Command="{Binding CancelCommand, Source={x:Reference Root}}"/><Button Grid.Column="2" Text="Search" Command="{Binding ApplyCommand, Source={x:Reference Root}}"/></Grid>
   </Grid>
  </Border>
 </Grid>
</ContentView>
