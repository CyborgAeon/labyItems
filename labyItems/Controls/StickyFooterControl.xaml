<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.StickyFooterControl"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:conv="clr-namespace:labyItems.Converters" x:Name="Root">

  <ContentView.Resources>
    <conv:BoolToRotationConverter x:Key="BoolToRotationConverter" />
  </ContentView.Resources>

  <Border Padding="12,8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Stroke="#22000000" StrokeThickness="1">
    <VerticalStackLayout Spacing="8">
      <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="8">
        <Label Grid.Column="0" FontSize="30" HorizontalTextAlignment="End" Rotation="{Binding Source={x:Reference Root}, Path=IsExpanded, Converter={StaticResource BoolToRotationConverter}}" Text="›" VerticalTextAlignment="Center">
          <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnToggleExpanded" />
          </Label.GestureRecognizers>
        </Label>
        <Label Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" Text="{Binding Source={x:Reference Root}, Path=FormattedTotal}"/>
        <Button Grid.Column="2" Clicked="OnReturnClicked" CornerRadius="10" HeightRequest="44" IsEnabled="{Binding Source={x:Reference Root}, Path=IsEnabled}" Text="{Binding Source={x:Reference Root}, Path=ButtonText}" />
      </Grid>

      <CollectionView IsVisible="{Binding Source={x:Reference Root}, Path=IsExpanded}" ItemsSource="{Binding Source={x:Reference Root}, Path=BreakdownItems}">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Label>
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="{Binding Text}" />
                  <Span Text=" (" TextColor="Gray" />
                  <Span Text="{Binding RunningTotal}" TextColor="Gray" />
                  <Span Text=")" TextColor="Gray" />
                </FormattedString>
              </Label.FormattedText>
            </Label>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>
  </Border>
</ContentView>
