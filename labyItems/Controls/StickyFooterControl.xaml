<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="labyItems.Controls.StickyFooterControl"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:labyItems.Converters"
             x:Name="Root">

  <ContentView.Resources>
    <conv:BoolToRotationConverter x:Key="BoolToRotationConverter"/>
  </ContentView.Resources>

  <Border Padding="12,8"
          BackgroundColor="#FFFFFF"
          Stroke="#22000000"
          StrokeThickness="1">
    <Border.GestureRecognizers>
      <TapGestureRecognizer Tapped="OnToggleExpanded"/>
    </Border.GestureRecognizers>
    <VerticalStackLayout Spacing="8">
      <Grid ColumnDefinitions="18,*,Auto"
            ColumnSpacing="8">
        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              ColumnDefinitions="18,*"
              ColumnSpacing="8"
              BackgroundColor="Transparent">
          <Label Grid.Column="0"
                 FontSize="30"
                 HorizontalTextAlignment="End"
                 InputTransparent="True"
                 Rotation="{Binding Source={x:Reference Root}, Path=IsExpanded, Converter={StaticResource BoolToRotationConverter}}"
                 Text="›"
                 VerticalTextAlignment="Center"/>
          <Label Grid.Column="1"
                 VerticalOptions="Center"
                 FontAttributes="Bold"
                 InputTransparent="True"
                 Text="{Binding Source={x:Reference Root}, Path=FormattedTotal}"/>
        </Grid>
        <Button Grid.Column="2"
                Clicked="OnReturnClicked"
                CornerRadius="10"
                HeightRequest="44"
                IsEnabled="{Binding Source={x:Reference Root}, Path=IsReturnEnabled}"
                Text="{Binding Source={x:Reference Root}, Path=ButtonText}"/>
      </Grid>

      <CollectionView IsVisible="{Binding Source={x:Reference Root}, Path=IsExpanded}"
                      ItemsSource="{Binding Source={x:Reference Root}, Path=BreakdownItems}">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Label>
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="{Binding Text}"/>
                  <Span Text=" ("
                        TextColor="Gray"/>
                  <Span Text="{Binding RunningTotal}"
                        TextColor="Gray"/>
                  <Span Text=")"
                        TextColor="Gray"/>
                </FormattedString>
              </Label.FormattedText>
            </Label>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>
  </Border>
</ContentView>
