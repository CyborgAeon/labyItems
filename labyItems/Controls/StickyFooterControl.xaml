<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.StickyFooterControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:labyItems.Converters"
    x:Name="Root">

  <ContentView.Resources>
    <conv:BoolToRotationConverter x:Key="BoolToRotationConverter" />
  </ContentView.Resources>

  <Border
      StrokeThickness="1"
      Stroke="#22000000"
      BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
      Padding="12,8">
    <VerticalStackLayout Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Label
          Text="›"
          FontSize="18"
          VerticalTextAlignment="Center"
          Rotation="{Binding Source={x:Reference Root}, Path=IsExpanded, Converter={StaticResource BoolToRotationConverter}}">
          <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnToggleExpanded" />
          </Label.GestureRecognizers>
        </Label>
        <Label
          Grid.Column="1"
          VerticalOptions="Center"
          FontAttributes="Bold"
          Text="{Binding Source={x:Reference Root}, Path=FormattedTotal}" />
        <Button Grid.Column="2"
                HeightRequest="44"
                CornerRadius="10"
                Text="{Binding Source={x:Reference Root}, Path=ButtonText}"
                Clicked="OnReturnClicked" 
                IsEnabled="{Binding Source={x:Reference Root}, Path=IsEnabled}"/>
      </Grid>

      <CollectionView
        IsVisible="{Binding Source={x:Reference Root}, Path=IsExpanded}"
        ItemsSource="{Binding Source={x:Reference Root}, Path=BreakdownItems}">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" Padding="0,2">
              <Label>
                <Label.FormattedText>
                  <FormattedString>
                    <Span Text="{Binding Text}" />
                    <Span Text=" (" TextColor="Gray" />
                    <Span Text="{Binding RunningTotal}" TextColor="Gray" />
                    <Span Text=")" TextColor="Gray" />
                  </FormattedString>
                </Label.FormattedText>
              </Label>
              <Button Grid.Column="1"
                      Text="🗑️"
                      Padding="8,4"
                      Command="{Binding Source={x:Reference Root}, Path=RemoveContributionCommand}"
                      CommandParameter="{Binding Id}" 
                      IsEnabled="{Binding Source={x:Reference Root}, Path=IsEnabled}"/>
            </Grid>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>
  </Border>
</ContentView>
