<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.SearchHeaderControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
        <Label
            Grid.Column="0"
            FontAttributes="Bold"
            FontSize="20"
            Text="{Binding Title, Source={x:Reference Root}}"
            VerticalOptions="Center" />
        <Button
            Grid.Column="2"
            Text="{Binding ButtonText, Source={x:Reference Root}}"
            Command="{Binding SearchCommand, Source={x:Reference Root}}"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
