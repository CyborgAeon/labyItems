<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.GlyphIconButtonView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    WidthRequest="{Binding ButtonSize, Source={x:Reference Root}}"
    HeightRequest="{Binding ButtonSize, Source={x:Reference Root}}">

    <Grid BackgroundColor="Transparent"
          Padding="{Binding IconPadding, Source={x:Reference Root}}">
        <Label Text="{Binding Glyph, Source={x:Reference Root}}"
               FontFamily="{Binding GlyphFontFamily, Source={x:Reference Root}}"
               FontSize="{Binding GlyphSize, Source={x:Reference Root}}"
               TextColor="{Binding GlyphColor, Source={x:Reference Root}}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center" />
    </Grid>
</ContentView>
