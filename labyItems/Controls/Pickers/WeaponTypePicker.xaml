<?xml version="1.0" encoding="utf-8" ?>
<controls:EnumPicker
    x:Class="labyItems.Controls.WeaponTypePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:enums="clr-namespace:labyItems.Models.Enums"
    x:Name="Root"
    x:TypeArguments="enums:WeaponType">

    <VerticalStackLayout x:Name="Container" Spacing="10">
        <VerticalStackLayout.Triggers>
            <DataTrigger
                TargetType="VerticalStackLayout"
                Binding="{Binding Source={x:Reference Root}, Path=IsCompact}"
                Value="True">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </DataTrigger>
        </VerticalStackLayout.Triggers>

        <Label
            FontAttributes="Bold"
            Text="{Binding LabelText, Source={x:Reference Root}}"
            TextColor="{StaticResource Gray900}" />

        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="0">
            <Border
                x:Name="InputBorder"
                Padding="12,10"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Background="{StaticResource White}">
                <Border.Triggers>
                    <DataTrigger
                        TargetType="Border"
                        Binding="{Binding Source={x:Reference Root}, Path=IsCompact}"
                        Value="True">
                        <Setter Property="StrokeThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleTapped" />
                    </Grid.GestureRecognizers>

                    <Label
                        Text="TYPE"
                        Padding="6,2"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}" />

                    <Entry
                        Grid.Column="1"
                        x:Name="SearchEntry"
                        BackgroundColor="Transparent"
                        Placeholder="{Binding PlaceholderText, Source={x:Reference Root}}"
                        TextColor="{StaticResource Gray900}"
                        PlaceholderColor="{StaticResource Gray400}"
                        Margin="0" />

                    <Label
                        Grid.Column="2"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Text="v"
                        FontSize="18"
                        TextColor="{StaticResource Primary}" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="4"
                StrokeThickness="1"
                Stroke="{StaticResource Gray200}"
                Background="{StaticResource White}"
                IsVisible="{Binding AreSuggestionsVisible, Source={x:Reference Root}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}" Opacity="0.12" Radius="10" Offset="0,2" />
                </Border.Shadow>
                <CollectionView
                    x:Name="SuggestionsView"
                    HeightRequest="240"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12,10"
                                Stroke="{StaticResource Gray200}"
                                StrokeThickness="1"
                                Background="{StaticResource White}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <BoxView
                                        WidthRequest="10"
                                        HeightRequest="10"
                                        VerticalOptions="Center"
                                        CornerRadius="3"
                                        Color="{StaticResource Primary}" />
                                    <Label
                                        VerticalOptions="Center"
                                        TextColor="{StaticResource Gray900}"
                                        Text="{Binding ., Converter={StaticResource DisplayConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </VerticalStackLayout>
</controls:EnumPicker>
