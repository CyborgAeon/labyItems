<?xml version="1.0" encoding="utf-8" ?>
<controls:EnumPicker
    x:Class="labyItems.Controls.SpherePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:conv="clr-namespace:labyItems.Converters"
    xmlns:enums="clr-namespace:labyItems.Models.Enums"
    x:Name="Root"
    x:TypeArguments="enums:SpiritualSpheres">
    <VerticalStackLayout Spacing="4">
        <Label Text="{Binding LabelText, Source={x:Reference Root}}" />
        <Picker
            x:Name="InnerPicker"
            ItemsSource="{Binding Options, Source={x:Reference Root}}"
            SelectedItem="{Binding SelectedValue, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</controls:EnumPicker>
