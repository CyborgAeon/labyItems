<?xml version="1.0" encoding="utf-8" ?>
<controls:EnumPicker
    x:Class="labyItems.Controls.WeaponBasePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:enums="clr-namespace:labyItems.Models.Enums"
    x:Name="Root"
    x:TypeArguments="enums:WeaponBaseOption">

    <VerticalStackLayout Spacing="10">
        <Label
            FontAttributes="Bold"
            Text="{Binding LabelText, Source={x:Reference Root}}"
            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="0">
            <Border
                Padding="12,10"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleTapped" />
                    </Grid.GestureRecognizers>

                    <Label
                        Text="BASE"
                        Padding="6,2"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />

                    <Entry
                        Grid.Column="1"
                        x:Name="SearchEntry"
                        BackgroundColor="Transparent"
                        Placeholder="{Binding PlaceholderText, Source={x:Reference Root}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                        Margin="0" />

                    <Label
                        Grid.Column="2"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Text="v"
                        FontSize="18"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="4"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                IsVisible="{Binding AreSuggestionsVisible, Source={x:Reference Root}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}" Opacity="0.12" Radius="10" Offset="0,2" />
                </Border.Shadow>

                <CollectionView
                    x:Name="SuggestionsView"
                    HeightRequest="240"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12,10"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <BoxView
                                        WidthRequest="10"
                                        HeightRequest="10"
                                        VerticalOptions="Center"
                                        CornerRadius="3"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                                    <Label
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                        Text="{Binding ., Converter={StaticResource DisplayConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </VerticalStackLayout>
</controls:EnumPicker>
