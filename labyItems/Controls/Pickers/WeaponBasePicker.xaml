<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.WeaponBasePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="4">
        <Label
            Text="{Binding LabelText, Source={x:Reference Root}}"
            FontAttributes="Bold" />

        <Picker
            x:Name="WeaponBasePickerControl"
            Title="Select weapon base"
            SelectedIndexChanged="OnPickerChanged" />
    </VerticalStackLayout>
</ContentView>
