<controls:EnumPicker
    x:Class="labyItems.Controls.ElfInnateLevelPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls"
    xmlns:enums="clr-namespace:labyItems.Models.Enums"
    x:Name="Root"
    x:TypeArguments="enums:ElfInnateLevel">

    <VerticalStackLayout Spacing="4">
        <Label Text="{Binding LabelText, Source={x:Reference Root}}" />
        <Picker
            x:Name="InnerPicker"
            ItemsSource="{Binding Options, Source={x:Reference Root}}"
            SelectedItem="{Binding SelectedValue, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</controls:EnumPicker>
