<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.LevelValueStripView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="7">
        <Label Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource SectionHeaderLabelStyle}"/>
        <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
               TextColor="{StaticResource MutedTextColor}"
               FontSize="13"
               IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}"/>
        <Border Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 9"
                BackgroundColor="#F9FAFB"
                Padding="0">
            <FlexLayout BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                        Direction="Row"
                        Wrap="NoWrap"
                        JustifyContent="SpaceBetween">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,7"
                              FlexLayout.Grow="1"
                              FlexLayout.Basis="0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCellTapped"/>
                            </Grid.GestureRecognizers>
                            <BoxView WidthRequest="1"
                                     HorizontalOptions="Start"
                                     Margin="-8,-7,0,-7"
                                     Color="{StaticResource SurfaceBorderColor}"
                                     IsVisible="{Binding ShowDivider}"/>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding LevelText}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding ValueText}"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
