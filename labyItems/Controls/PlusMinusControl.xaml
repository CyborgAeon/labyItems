<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  x:Class="labyItems.Controls.PlusMinusControl"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Name="Root">
  <Grid
    Padding="0,4"
    ColumnDefinitions="*,Auto,Auto,Auto"
    ColumnSpacing="4"
    VerticalOptions="Center">
    <Label
      x:Name="Label"
      FontAttributes="Bold"
      FontSize="16"
      HorizontalOptions="Start"
      HorizontalTextAlignment="Start"
      LineBreakMode="TailTruncation"
      Text="{Binding LabelText, Source={x:Reference Name=Root}}"
      VerticalOptions="Center"
      VerticalTextAlignment="Center" />
    <Button
      Grid.Column="1"
      Padding="4,0"
      Clicked="OnMinus"
      HorizontalOptions="End"
      Text="-"
      VerticalOptions="Center"
      WidthRequest="32" />
    <Label
      Grid.Column="2"
      HorizontalOptions="Center"
      HorizontalTextAlignment="Center"
      Text="{Binding Source={x:Reference Root}, Path=Count}"
      VerticalOptions="Center"
      VerticalTextAlignment="Center"
      WidthRequest="30" />
    <!--  Bind to *this control’s* Count via x:Reference, not BindingContext  -->
    <Button
      Grid.Column="3"
      Padding="4,0"
      Clicked="OnPlus"
      HorizontalOptions="End"
      Text="+"
      VerticalOptions="Center"
      WidthRequest="32" />
  </Grid>
</ContentView>
