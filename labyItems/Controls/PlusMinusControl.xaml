<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="labyItems.Controls.PlusMinusControl"
             x:Name="Root">
  <HorizontalStackLayout Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
    <Button Text="-" Clicked="OnMinus"/>
    <Label Text="{Binding Source={x:Reference Root}, Path=Count}"
           WidthRequest="24" HorizontalTextAlignment="Center" />
    <Button Text="+" Clicked="OnPlus"/>
  </HorizontalStackLayout>
</ContentView>
