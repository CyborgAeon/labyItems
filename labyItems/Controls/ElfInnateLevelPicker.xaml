<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.ElfInnateLevelPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="4">
        <Label
            Text="{Binding LabelText, Source={x:Reference Root}}"
            FontAttributes="Bold" />
        <Picker
            x:Name="InnatePicker"
            Title="Select innate level"
            ItemsSource="{Binding Levels, Source={x:Reference Root}}"
            ItemDisplayBinding="{Binding .}"
            SelectedItem="{Binding SelectedLevel, Source={x:Reference Root}, Mode=TwoWay}" />
    </VerticalStackLayout>
</ContentView>
