<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.ToolsetNavigationMenu"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <ContentView.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Gray950}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </ContentView.Resources>

    <Grid x:Name="MenuOverlay"
          BackgroundColor="#66000000"
          ColumnDefinitions="300,*"
          IsVisible="False"
          Opacity="0">
        <Border x:Name="MenuPanel"
                BackgroundColor="{StaticResource White}"
                Padding="18,22"
                Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
                >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,28,28,0" />
            </Border.StrokeShape>
            <ScrollView>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label FontAttributes="Bold"
                               FontSize="26"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Text="Navigate"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1"
                                Clicked="OnCloseMenuClicked"
                                FontSize="24"
                                Padding="4"
                                Text="&#x2715;"
                                TextColor="{StaticResource Gray950}">
                            <Button.BackgroundColor>Transparent</Button.BackgroundColor>
                        </Button>
                    </Grid>

                    <Border x:Name="HomeRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF015;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Home"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="CharactersRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMakeCharacterTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF007;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Characters"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="ItemsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="28,*,24"
                                  ColumnSpacing="8">
                                <Label FontFamily="FASolid"
                                       FontSize="18"
                                       Text="&#xF468;"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Start"
                                       Text="Items"
                                       VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemsGroupTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <controls:ChevronIconView Grid.Column="2"
                                                          IsExpanded="{Binding Source={x:Reference Root}, Path=ItemsExpanded}"
                                                          AnimateRotation="True"
                                                          GlyphSize="14"
                                                          GlyphColor="{StaticResource Gray950}"
                                                          HorizontalOptions="End"
                                                          VerticalOptions="Center">
                                    <controls:ChevronIconView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemsGroupTapped" />
                                    </controls:ChevronIconView.GestureRecognizers>
                                </controls:ChevronIconView>
                            </Grid>

                            <controls:AnimatedExpandView IsExpanded="{Binding Source={x:Reference Root}, Path=ItemsExpanded}">
                                <VerticalStackLayout Padding="16,0,0,0"
                                                     Spacing="6">
                                    <Border x:Name="CalculateIspRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCalculateIspTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*"
                                              ColumnSpacing="8">
                                            <Label FontFamily="FASolid"
                                                   FontSize="16"
                                                   HorizontalTextAlignment="Center"
                                                   Text="&#xF1EC;"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   Text="Calculate ISP"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CreateMpRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCreateMpTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*"
                                              ColumnSpacing="8">
                                            <Label FontFamily="FASolid"
                                                   FontSize="16"
                                                   HorizontalTextAlignment="Center"
                                                   Text="&#xF6D5;"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   Text="Create MP Item"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ScrollBuilderRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnScrollBuilderTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*"
                                              ColumnSpacing="8">
                                            <Label FontFamily="FASolid"
                                                   FontSize="16"
                                                   HorizontalTextAlignment="Center"
                                                   Text="&#xF70E;"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   Text="scroll builder"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CraftingRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCraftingTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*"
                                              ColumnSpacing="8">
                                            <Label FontFamily="FASolid"
                                                   FontSize="16"
                                                   HorizontalTextAlignment="Center"
                                                   Text="&#xF7D9;"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   Text="Crafting"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ItemWalletRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnItemWalletTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*"
                                              ColumnSpacing="8">
                                            <Label FontFamily="FASolid"
                                                   FontSize="16"
                                                   HorizontalTextAlignment="Center"
                                                   Text="&#xF555;"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   Text="Item Wallet"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </controls:AnimatedExpandView>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="CreationsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenNonStandardDashboardTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF53F;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Creations"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="CalendarRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenCalendarTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF073;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Calendar"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="SearchRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF002;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Search"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="GuildsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGuildSearchTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF0C0;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Guilds"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="TradeRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInitiateTradeTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF362;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Trade"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="SettingsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF013;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   Text="Settings"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <BoxView Grid.Column="1"
                 BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseMenuTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
    </Grid>
</ContentView>
