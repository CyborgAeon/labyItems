<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="labyItems.Controls.ToolsetNavigationMenu"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:labyItems.Controls">

    <ContentView.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Gray950}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </ContentView.Resources>

    <Grid x:Name="MenuOverlay"
          BackgroundColor="#66000000"
          ColumnDefinitions="300,*"
          IsVisible="False"
          Opacity="0">
        <Border x:Name="MenuPanel"
                BackgroundColor="{StaticResource White}"
                Padding="18,22"
                Stroke="{StaticResource SurfaceBorderColor}"
                StrokeThickness="1"
            StrokeShape="RoundRectangle 0,28,28,0">
            <ScrollView>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label FontAttributes="Bold"
                               FontSize="26"
                               Text="Navigate"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1"
                                Clicked="OnCloseMenuClicked"
                                FontSize="24"
                                Padding="4"
                                Text="&#x2715;"
                                TextColor="{StaticResource Gray950}">
                            <Button.BackgroundColor>Transparent</Button.BackgroundColor>
                        </Button>
                    </Grid>

                    <Border x:Name="HomeRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF015;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnHomeClicked"
                                    HorizontalOptions="Center"
                                    Text="Home" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="CharactersRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF007;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnMakeCharacterClicked"
                                    HorizontalOptions="Center"
                                    Text="Characters" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="ItemsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="28,*,Auto">
                                <Label FontFamily="FASolid"
                                       FontSize="18"
                                       Text="&#xF468;"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                                <Button Grid.Column="1"
                                        Clicked="OnItemsGroupClicked"
                                        HorizontalOptions="Center"
                                        Text="Items" />
                                <Button Grid.Column="2"
                                        Clicked="OnItemsGroupClicked"
                                        FontFamily="FASolid"
                                        FontSize="14"
                                        HorizontalOptions="End"
                                        Padding="6"
                                        Text="{Binding Source={x:Reference Root}, Path=ItemsChevronGlyph}">
                                    <Button.BackgroundColor>Transparent</Button.BackgroundColor>
                                </Button>
                            </Grid>

                            <controls:AnimatedExpandView IsExpanded="{Binding Source={x:Reference Root}, Path=ItemsExpanded}">
                                <VerticalStackLayout Padding="16,0,0,0"
                                                     Spacing="6">
                                    <Border x:Name="CalculateIspRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Button Clicked="OnCalculateIspClicked"
                                                HorizontalOptions="Fill"
                                                Text="Calculate ISP" />
                                    </Border>
                                    <Border x:Name="CreateMpRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Button Clicked="OnCreateMpClicked"
                                                HorizontalOptions="Fill"
                                                Text="Create MP Item" />
                                    </Border>
                                    <Border x:Name="ItemWalletRow"
                                            Padding="10,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Button Clicked="OnItemWalletClicked"
                                                HorizontalOptions="Fill"
                                                Text="Item Wallet" />
                                    </Border>
                                </VerticalStackLayout>
                            </controls:AnimatedExpandView>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="CreationsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF53F;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnOpenNonStandardDashboardClicked"
                                    HorizontalOptions="Center"
                                    Text="Creations" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="CalendarRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF073;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnOpenCalendarClicked"
                                    HorizontalOptions="Center"
                                    Text="Calendar" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="SearchRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF002;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnSearchClicked"
                                    HorizontalOptions="Center"
                                    Text="Search" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="GuildsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF0C0;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnGuildSearchClicked"
                                    HorizontalOptions="Center"
                                    Text="Guilds" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="TradeRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF362;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnInitiateTradeClicked"
                                    HorizontalOptions="Center"
                                    Text="Trade" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>

                    <Border x:Name="SettingsRow"
                            Padding="12,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="28,*,24"
                              ColumnSpacing="8">
                            <Label FontFamily="FASolid"
                                   FontSize="18"
                                   Text="&#xF013;"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Clicked="OnSettingsClicked"
                                    HorizontalOptions="Center"
                                    Text="Settings" />
                            <Label Grid.Column="2"
                                   Opacity="0"
                                   Text="v" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <BoxView Grid.Column="1"
                 BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseMenuTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
    </Grid>
</ContentView>
